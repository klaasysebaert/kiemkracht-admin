    oCallerDoc = HuidigDataDocument()
    If IsNull(oCallerDoc) Then
        MsgBox "Geen kiemkracht-data-bestand actief. Open kiemkracht-data.ods " & _
               "of kiemkracht-data-dev.ods en start de macro vanuit dat venster.", 16, "Fout"
        Exit Sub
    End If

    dVandaag = Now()
    iWeek    = DatePart("ww", dVandaag, 2, 2)
    iJaar    = Year(dVandaag)

    ' --- Maand kiezen: standaard de huidige maand, aanpasbaar ---
    ' Het bestand bevat enkel koffiebestellingen die in de gekozen maand
    ' (Belgische tijd) geplaatst zijn. De bestands-/mapnaam blijft op week.
    iFiltMaand = Month(dVandaag)
    iFiltJaar  = Year(dVandaag)

    saMaanden(1)  = "januari"  : saMaanden(2)  = "februari"
    saMaanden(3)  = "maart"    : saMaanden(4)  = "april"
    saMaanden(5)  = "mei"      : saMaanden(6)  = "juni"
    saMaanden(7)  = "juli"     : saMaanden(8)  = "augustus"
    saMaanden(9)  = "september": saMaanden(10) = "oktober"
    saMaanden(11) = "november" : saMaanden(12) = "december"

    sDefaultMaand = Right("0" & iFiltMaand, 2) & "/" & iFiltJaar
    sMaandIn = InputBox( _
        "Welke maand verwerken? Alle koffiebestellingen die in die maand " & _
        "geplaatst zijn, komen in het bestand." & Chr(10) & Chr(10) & _
        "Formaat MM/JJJJ — ENTER = " & saMaanden(iFiltMaand) & " " & iFiltJaar & ".", _
        "KoffieWeekbestand - maand kiezen", sDefaultMaand)

    If sMaandIn = "" Then Exit Sub   ' Annuleren of leeg veld = stoppen

    ' Parse MM/JJJJ (ook M/JJJJ en MM-JJJJ toegelaten)
    sMaandIn = Trim(sMaandIn)
    iSep = InStr(sMaandIn, "/")
    If iSep = 0 Then iSep = InStr(sMaandIn, "-")
    If iSep > 0 Then
        sM = Trim(Left(sMaandIn, iSep - 1))
        sJ = Trim(Mid(sMaandIn, iSep + 1))
    End If
    If iSep = 0 Or Not IsNumeric(sM) Or Not IsNumeric(sJ) Then
        MsgBox "Ongeldige invoer: " & sMaandIn & Chr(10) & _
               "Verwacht MM/JJJJ, bv. 06/2026.", 16, "KoffieWeekbestand"
        Exit Sub
    End If
    If CInt(sM) < 1 Or CInt(sM) > 12 Or CInt(sJ) < 2020 Or CInt(sJ) > 2100 Then
        MsgBox "Ongeldige maand/jaar: " & sMaandIn & Chr(10) & _
               "Verwacht MM/JJJJ, bv. 06/2026.", 16, "KoffieWeekbestand"
        Exit Sub
    End If
    iFiltMaand = CInt(sM)
    iFiltJaar  = CInt(sJ)
    sFiltDatum = iFiltJaar & "-" & Right("0" & iFiltMaand, 2) & "-01"

    If BepaalOmgeving() = "dev" Then sOmgSuffix = "-dev" Else sOmgSuffix = ""

    Dim sWeekMap As String
    sWeekMap = JaarMap(iJaar) & iJaar & "_week_" & iWeek & "_koffie\"
    If Not FileExists(sWeekMap) Then MkDir(sWeekMap)

    sBestand = sWeekMap & "koffie_week_" & iWeek & "_" & iJaar & sOmgSuffix & ".ods"

    On Error GoTo VerbindingsFout
    oConnG = MaakDBVerbindingNaar("postgres")
    oConnK = MaakDBVerbindingNaar("koffie")
    On Error GoTo 0

    ' --- Stap 1: bestellingen uit koffie-DB ---
    oStmt = oConnK.createStatement()
    oRS = oStmt.executeQuery( _
        "SELECT id, COALESCE(klant_id::text,''), voornaam, familienaam, " & _
        "       klant_email, COALESCE(telefoon,''), afhaalpunt, " & _
        "       COALESCE(vragen_opmerkingen,''), " & _
        "       to_char(aangemaakt AT TIME ZONE 'Europe/Brussels', 'DD/MM/YYYY HH24:MI') " & _
        "FROM koffie_bestellingen " & _
        "WHERE date_trunc('month', aangemaakt AT TIME ZONE 'Europe/Brussels') " & _
        "      = DATE '" & sFiltDatum & "' " & _
        "ORDER BY aangemaakt")
    nBest = 0
    Do While oRS.next()
        bId(nBest)      = CLng(oRS.getString(1))
        bKlantId(nBest) = oRS.getString(2)
        bVoor(nBest)    = oRS.getString(3)
        bFam(nBest)     = oRS.getString(4)
        bEmail(nBest)   = oRS.getString(5)
        bTel(nBest)     = oRS.getString(6)
        bAfh(nBest)     = oRS.getString(7)
        bOpm(nBest)     = oRS.getString(8)
        bBesteld(nBest) = oRS.getString(9)
        nBest = nBest + 1
    Loop
    oRS.close() : oStmt.close()

    ' --- Stap 2: productdefinitie (18 SKU's in matrix-volgorde) ---
    soorten(0) = "el_dorado" : soorten(1) = "el_presso" : soorten(2) = "el_locco"
    soortLabels(0) = "El Dorado" : soortLabels(1) = "El Presso" : soortLabels(2) = "El Locco"
    vormen(0) = "gemalen"  : vormen(1) = "bonen"
    gewSlt(0) = "250g" : gewLab(0) = "x250g" : gewPrijs(0) = 7.5
    gewSlt(1) = "500g" : gewLab(1) = "x500g" : gewPrijs(1) = 15
    gewSlt(2) = "1kg"  : gewLab(2) = "x1kg"  : gewPrijs(2) = 29

    p = 0
    For iVorm = 0 To 1
        For iSrt = 0 To 2
            For iGew = 0 To 2
                sleutels(p) = soorten(iSrt) & "_" & vormen(iVorm) & "_" & gewSlt(iGew)
                labels(p)   = soortLabels(iSrt) & " " & vormen(iVorm)
                gewicht(p)  = gewLab(iGew)
                prijzen(p)  = gewPrijs(iGew)
                p = p + 1
            Next iGew
        Next iSrt
    Next iVorm

    ' --- Stap 3: bestelregels koppelen aan kolom-index ---
    ' Vaste koffie-matrix (kolommen 0-17) + dynamische extra kolommen voor
    ' alle overige bestelde producten (honing, latere categorieën). Labels,
    ' gewicht en prijs komen uit de gedenormaliseerde regel zelf, zodat ook
    ' intussen gewijzigde/verwijderde producten correct verschijnen; de
    ' kolomvolgorde volgt producten.sortering (onbekende sleutels achteraan).
    For b = 0 To nBest - 1
        For p = 0 To 97
            bAant(b, p) = 0
        Next p
    Next b
    nExtra = 0

    oStmt = oConnK.createStatement()
    oRS = oStmt.executeQuery( _
        "SELECT r.bestelling_id, r.product_sleutel, r.aantal, " & _
        "       r.soort, r.vorm, r.gewicht_label, r.eenheidsprijs_eur " & _
        "FROM koffie_bestelregels r " & _
        "LEFT JOIN producten p ON p.sleutel = r.product_sleutel " & _
        "ORDER BY COALESCE(p.sortering, 999999), r.product_sleutel, r.id")
    Do While oRS.next()
        lBId   = CLng(oRS.getString(1))
        sSl    = oRS.getString(2)
        iAant  = CInt(oRS.getString(3))
        sSoort = oRS.getString(4)
        sVorm  = oRS.getString(5)
        sGewL  = oRS.getString(6)
        dPrijs = Val(oRS.getString(7))   ' Val: punt-decimaal, locale-onafhankelijk

        ' Alleen bestellingen uit de gekozen maand (zit in bId).
        bIdx = -1
        For b = 0 To nBest - 1
            If bId(b) = lBId Then
                bIdx = b
                Exit For
            End If
        Next b

        If bIdx >= 0 Then
            ' Kolom zoeken: eerst de vaste koffie-matrix...
            pIdx = -1
            For p = 0 To 17
                If sleutels(p) = sSl Then
                    pIdx = p
                    Exit For
                End If
            Next p
            ' ...dan reeds aangemaakte extra kolommen...
            If pIdx = -1 Then
                For e = 0 To nExtra - 1
                    If eSl(e) = sSl Then
                        pIdx = 18 + e
                        Exit For
                    End If
                Next e
            End If
            ' ...anders een nieuwe extra kolom aanmaken.
            If pIdx = -1 And nExtra <= 79 Then
                eSl(nExtra)    = sSl
                eLab(nExtra)   = Trim(sSoort & " " & sVorm)   ' vorm leeg bij honing
                eGew(nExtra)   = sGewL
                ePrijs(nExtra) = dPrijs
                pIdx = 18 + nExtra
                nExtra = nExtra + 1
            End If
            If pIdx >= 0 Then bAant(bIdx, pIdx) = bAant(bIdx, pIdx) + iAant
        End If
    Loop
    oRS.close() : oStmt.close()
    nProdTot = 18 + nExtra

    ' --- Stap 4a: afhaalpunten-map uit groenten-DB (fallback-match) ---
    For b = 0 To nBest - 1
        bType(b) = ""
        bKlaarDag(b) = ""
    Next b

    nAp = 0
    oStmt = oConnG.createStatement()
    oRS = oStmt.executeQuery( _
        "SELECT COALESCE(naam,''), COALESCE(naam_publiek,''), " & _
        "       COALESCE(dag_klaarmaken, dag_afhaling, '') " & _
        "FROM afhaalpunten")
    Do While oRS.next()
        apNaam(nAp)    = oRS.getString(1)
        apNaamPub(nAp) = oRS.getString(2)
        apDag(nAp)     = oRS.getString(3)
        nAp = nAp + 1
    Loop
    oRS.close() : oStmt.close()

    ' --- Stap 4b: bestellingen met klant_id → type + dag via JOIN ---
    sIds = ""
    For b = 0 To nBest - 1
        If bKlantId(b) <> "" Then
            If sIds <> "" Then sIds = sIds & ","
            sIds = sIds & bKlantId(b)
        End If
    Next b

    If sIds <> "" Then
        oStmt = oConnG.createStatement()
        oRS = oStmt.executeQuery( _
            "SELECT k.id, COALESCE(k.type,''), " & _
            "       COALESCE(ap.dag_klaarmaken, ap.dag_afhaling, '') " & _
            "FROM klanten k " & _
            "LEFT JOIN afhaalpunten ap ON ap.id = k.afhaalpunt_id " & _
            "WHERE k.id IN (" & sIds & ")")
        Do While oRS.next()
            sId  = oRS.getString(1)
            sTyp = oRS.getString(2)
            sDag = oRS.getString(3)
            For b = 0 To nBest - 1
                If bKlantId(b) = sId Then
                    bType(b)     = sTyp
                    bKlaarDag(b) = sDag
                End If
            Next b
        Loop
        oRS.close() : oStmt.close()
    End If

    ' --- Stap 4c: fallback-match via afhaalpunt-string ---
    For b = 0 To nBest - 1
        If bKlaarDag(b) = "" And bAfh(b) <> "" Then
            sZoek = LCase(bAfh(b))
            For i = 0 To nAp - 1
                If apNaam(i) <> "" Then
                    If LCase(apNaam(i)) = sZoek Or LCase(apNaamPub(i)) = sZoek _
                       Or InStr(sZoek, LCase(apNaam(i))) > 0 Then
                        bKlaarDag(b) = apDag(i)
                        Exit For
                    End If
                End If
            Next i
        End If
    Next b

    ' --- Stap 4d: korte afhaalpuntnaam (zoals in de groenten-lijsten) ---
    ' Het formulier bewaart de lange publieke naam (naam_publiek) als
    ' afhaalpunt-string. Map die terug naar de interne korte naam
    ' (afhaalpunten.naam), zodat weekbestand en orderpicking dezelfde korte
    ' naam tonen als bij de groenten. Geen match (bv. grondvast-vrije tekst)
    ' → lange naam behouden.
    For b = 0 To nBest - 1
        bAfhKort(b) = bAfh(b)
        If bAfh(b) <> "" Then
            sZoek = LCase(bAfh(b))
            For i = 0 To nAp - 1
                If apNaam(i) <> "" Then
                    If LCase(apNaamPub(i)) = sZoek Or LCase(apNaam(i)) = sZoek _
                       Or (apNaamPub(i) <> "" And InStr(sZoek, LCase(apNaamPub(i))) > 0) Then
                        bAfhKort(b) = apNaam(i)
                        Exit For
                    End If
                End If
            Next i
        End If
    Next b

    oConnG.close()
    oConnK.close()

    ' =============================================
    ' SPREADSHEET OPBOUWEN
    ' =============================================
    oDesktop = CreateUnoService("com.sun.star.frame.Desktop")
    Dim aLaadProps(0) As New com.sun.star.beans.PropertyValue
    aLaadProps(0).Name  = "Hidden"
    aLaadProps(0).Value = False
    oNieuwDoc = oDesktop.loadComponentFromURL("private:factory/scalc", "_blank", 0, aLaadProps())
    oSheet = oNieuwDoc.Sheets.getByIndex(0)
    oSheet.Name = "Koffie week " & iWeek

    ' Producthoofding (rij 0/1/2): vaste koffie-matrix + extra kolommen
    For p = 0 To nProdTot - 1
        If p <= 17 Then
            oSheet.getCellByPosition(cProd0 + p, 0).setString(labels(p))
            oSheet.getCellByPosition(cProd0 + p, 1).setValue(prijzen(p))
            oSheet.getCellByPosition(cProd0 + p, 2).setString(gewicht(p))
        Else
            oSheet.getCellByPosition(cProd0 + p, 0).setString(eLab(p - 18))
            oSheet.getCellByPosition(cProd0 + p, 1).setValue(ePrijs(p - 18))
            oSheet.getCellByPosition(cProd0 + p, 2).setString(eGew(p - 18))
        End If
    Next p

    ' Klantkolom-titels (rij 3)
    r = 3
    oSheet.getCellByPosition(cNaam,  r).setString("voornaam + naam")
    oSheet.getCellByPosition(cAfh,   r).setString("afhaalpunt")
    oSheet.getCellByPosition(cKlDag, r).setString("dag klaarmaken")
    oSheet.getCellByPosition(cTyp,   r).setString("type")
    oSheet.getCellByPosition(cOpm,   r).setString("vragen_opmerkingen")
    oSheet.getCellByPosition(cEmail, r).setString("email")
    oSheet.getCellByPosition(cTel,     r).setString("telefoon")
    oSheet.getCellByPosition(cKlId,    r).setString("klant_id")
    oSheet.getCellByPosition(cBesteld, r).setString("besteld op")

    ' Bestelregels (rij 4 en verder)
    For b = 0 To nBest - 1
        r = 4 + b
        oSheet.getCellByPosition(cNaam,  r).setString(Trim(bVoor(b) & " " & bFam(b)))
        oSheet.getCellByPosition(cAfh,   r).setString(bAfhKort(b))
        oSheet.getCellByPosition(cKlDag, r).setString(bKlaarDag(b))
        oSheet.getCellByPosition(cTyp,   r).setString(bType(b))
        oSheet.getCellByPosition(cOpm,   r).setString(bOpm(b))
        oSheet.getCellByPosition(cEmail, r).setString(bEmail(b))
        oSheet.getCellByPosition(cTel,     r).setString(bTel(b))
        oSheet.getCellByPosition(cBesteld, r).setString(bBesteld(b))
        If bKlantId(b) <> "" Then
            oSheet.getCellByPosition(cKlId, r).setValue(CDbl(bKlantId(b)))
        End If
        For p = 0 To nProdTot - 1
            If bAant(b, p) > 0 Then
                oSheet.getCellByPosition(cProd0 + p, r).setValue(bAant(b, p))
            End If
        Next p
    Next b

    ' --- Kolomtotalen in rij 4 (vanaf J4, alle productkolommen): som per
    ' product. De som loopt tot 10 rijen onder de laatste bestelling, zodat
    ' handmatig bijgevoegde bestelregels automatisch meegeteld worden. ---
    iSomTot = nBest + 14        ' laatste bestelrij (= nBest+4) + 10 extra rijen
    For p = 0 To nProdTot - 1
        sKol = KolomLetter(cProd0 + p)
        oSheet.getCellByPosition(cProd0 + p, 3).setFormula( _
            "=SUM(" & sKol & "5:" & sKol & iSomTot & ")")
    Next p

    ' Opslaan
    sUrl = ConvertToURL(sBestand)

    ' Sluit een eventueel reeds open exemplaar van dit bestand (bv. nog open
    ' van een vorige run): storeAsURL faalt anders met "AlreadyExists" omdat
    ' de URL al aan een open venster gekoppeld is. Nooit het data-document.
    If FileExists(sBestand) Then
        oEnum = StarDesktop.Components.createEnumeration()
        Do While oEnum.hasMoreElements()
            oComp = oEnum.nextElement()
            If HasUnoInterfaces(oComp, "com.sun.star.lang.XServiceInfo") Then
                If oComp.supportsService("com.sun.star.sheet.SpreadsheetDocument") Then
                    If sUrl = oComp.getURL() And Not (oComp Is oCallerDoc) Then
                        oComp.close(True)
                    End If
                End If
            End If
        Loop
    End If

    Dim aSaveProps(0) As New com.sun.star.beans.PropertyValue
    aSaveProps(0).Name  = "FilterName"
    aSaveProps(0).Value = "calc8"
    ' storeAsURL (niet storeToURL): koppelt het open venster aan dit bestand,
    ' zodat het bestand-met-naam open blijft i.p.v. een "Geen titel"-document.
    oNieuwDoc.storeAsURL(sUrl, aSaveProps())

    SluitSSHTunnels()
    MsgBox "Koffie-weekbestand opgeslagen:" & Chr(10) & sBestand & Chr(10) & _
           Chr(10) & nBest & " bestelling(en) uit " & saMaanden(iFiltMaand) & " " & _
           iFiltJaar & " verwerkt.", 64, "KoffieWeekbestand"
    Exit Sub

VerbindingsFout:
    MsgBox "Verbindingsfout: " & Err & " - " & Error & Chr(10) & _
           "Controleer of de SSH-tunnel actief is.", 16, "Fout"
    SluitSSHTunnels()
End Sub

' =============================================
' Kiemkracht - Weekbestand: rij-koppeling herstellen
' ---------------------------------------------
' Het afrekeningstabblad is een SPIEGEL van het datablad met één vast
' contract: afrekening-rij N kijkt naar datablad-rij N. Dat contract
' overleeft handwerk niet. Verplaats, wis of voeg je een rij in het
' datablad in, dan verschuift LibreOffice elke verwijzing mee met de
' BRON-CEL i.p.v. met de rij, en loopt de spiegel uit de pas:
'   - afrekening-rij N kijkt plots naar datablad-rij N+1 (of N-1, ...)
'   - een verwijderde rij laat een #VERW!-weesrij achter
'   - een verplaatste klant staat twee keer in de afrekening
'   - datablad-kolom X (= afrekening.C<rij>) wijst naar de buurklant
'   - datablad-kolom W verliest zijn Blad2.I-eenheidsverwijzingen
' De bedragen kloppen dan stil niet meer: WEEKTOTAAL (H5) en de
' maandafrekening rekenen met de rij van iemand anders.
'
' Deze macro herschrijft die formules vanaf nul volgens het contract:
'   - afrekening rij 7..laatste : A,B,C,D,E,F, W, Y..AV, AY, AZ..BK
'   - datablad kolom W (samenvatting) + X (euro losse) op elke klantrij
' Ze raakt NIETS anders aan: hoeveelheden, weglatingen, pakketprijzen
' (B2:B5), het tabblad pakketwaardes en alle handmatige correcties in
' het datablad blijven staan. Er wordt niets uit de database gehaald.
'
' Draaien: open het weekbestand en start deze macro vanuit dat venster.
' Veilig om meermaals te draaien.
' =============================================
Sub HerstelWeekbestandFormules()
    Const cGroent0     = 24
    Const nGroentSlots = 24

    Dim oDoc As Object, oAfr As Object
    oDoc = ThisComponent
    If IsNull(oDoc) Then Exit Sub
    If Not HasUnoInterfaces(oDoc, "com.sun.star.lang.XServiceInfo") Then
        MsgBox "Geen rekenblad actief.", 16, "Formules herstellen"
        Exit Sub
    End If
    If Not oDoc.supportsService("com.sun.star.sheet.SpreadsheetDocument") Then
        MsgBox "Geen rekenblad actief.", 16, "Formules herstellen"
        Exit Sub
    End If
    If Not oDoc.Sheets.hasByName("Blad2") Or Not oDoc.Sheets.hasByName("afrekening") _
       Or Not oDoc.Sheets.hasByName("pakketwaardes") Then
        MsgBox "Dit lijkt geen weekbestand: tabblad Blad2, afrekening of " & _
               "pakketwaardes ontbreekt. Open het weekbestand en start de " & _
               "macro vanuit dat venster.", 16, "Formules herstellen"
        Exit Sub
    End If

    ' Oude-structuur-controle: de 24-slot-versie zet een koprij-formule in AV6.
    oAfr = oDoc.Sheets.getByName("afrekening")
    If oAfr.getCellByPosition(cGroent0 + nGroentSlots - 1, 5).getFormula() = "" Then
        If MsgBox("Dit weekbestand lijkt met een oudere versie gemaakt " & _
            "(geen koprij-formule in afrekening!AV6)." & Chr(10) & Chr(10) & _
            "Toch herstellen volgens de huidige structuur?", 4 + 48, _
            "Formules herstellen") <> 6 Then Exit Sub
    End If

    Dim sVerslag As String
    sVerslag = HerstelFormulesKern(oDoc)
    If Left(sVerslag, 5) = "FOUT:" Then
        MsgBox Mid(sVerslag, 6), 16, "Formules herstellen"
    Else
        MsgBox sVerslag & Chr(10) & Chr(10) & "Vergeet niet op te slaan.", 64, _
               "Formules herstellen"
    End If
End Sub

' Het eigenlijke herstelwerk, zonder één dialoogvenster: zo is de macro
' headless te draaien (test/controle) en blijft de Sub hierboven de enige
' plek met UI. Geeft het verslag terug, of een tekst die met "FOUT:" begint.
Function HerstelFormulesKern(oDoc As Object) As String
    On Error GoTo Fout

    ' Kolomindices (0-based) — identiek aan MaakWeekbestand
    Const cNaam        = 0    ' A voornaam + familienaam
    Const cAfh         = 1    ' B afhaalpunt
    Const cWBest       = 15   ' P klant_id
    Const cKG          = 17   ' R Klein pakket
    Const cGG          = 18   ' S Groot pakket
    Const cEGG         = 19   ' T Extra groot pakket
    Const cMINI        = 20   ' U Mini pakket
    Const cSamenv      = 22   ' W samenvatting (datablad) / detail losse (afrekening)
    Const cWaarde      = 23   ' X euro losse groenten
    Const cGroent0     = 24   ' Y eerste groente-slot
    Const nGroentSlots = 24   ' Y..AV
    Const cAnder       = 48   ' AW ander/opmerking
    Const cGeen        = 50   ' AY detail weglatingen
    Const cWeg0        = 51   ' AZ eerste weglating-slot
    Const nWegSlots    = 12   ' AZ..BK
    Const nExtra       = 10   ' extra lege rijen met formules klaar

    Dim oWk As Object, oAfr As Object, oPW As Object
    oWk  = oDoc.Sheets.getByIndex(0)
    oAfr = oDoc.Sheets.getByName("afrekening")
    oPW  = oDoc.Sheets.getByName("pakketwaardes")

    Dim sData As String
    sData = "'" & oWk.Name & "'"          ' bladnaam voor formules

    ' --- Laatste klantrij van het datablad zoeken (1-based) ---
    Dim oCur As Object
    oCur = oWk.createCursor()
    oCur.gotoEndOfUsedArea(False)
    Dim iEind As Integer, iLaatste As Integer, iRij As Integer
    iEind = oCur.RangeAddress.EndRow + 1
    iLaatste = 0
    For iRij = iEind To 7 Step -1
        If Trim(oWk.getCellByPosition(cNaam, iRij - 1).getString()) <> "" Then
            iLaatste = iRij
            Exit For
        End If
    Next iRij
    If iLaatste < 7 Then
        HerstelFormulesKern = "FOUT:Geen klantrijen gevonden in het datablad."
        Exit Function
    End If

    Dim nLaatsteForm As Integer
    nLaatsteForm = iLaatste + nExtra      ' laatste rij (1-based) met formules

    ' --- Aantal rijen in 'pakketwaardes' (bron voor de weglatingswaarde) ---
    Dim nPW As Integer
    nPW = 0
    For iRij = 2 To 200
        If Trim(oPW.getCellByPosition(0, iRij - 1).getString()) = "" Then Exit For
        nPW = nPW + 1
    Next iRij
    Dim nPwRijen As Integer : nPwRijen = nPW : If nPwRijen < 1 Then nPwRijen = 1

    ' --- Vaste formule-onderdelen ---
    Dim sFG As String, sLG As String, sWegF As String, sWegL As String
    Dim sEenRng As String, sPwVal As String, sPwKey As String
    sFG     = KolomLetter(cGroent0)                          ' Y
    sLG     = KolomLetter(cGroent0 + nGroentSlots - 1)       ' AV
    sWegF   = KolomLetter(cWeg0)                             ' AZ
    sWegL   = KolomLetter(cWeg0 + nWegSlots - 1)             ' BK
    sEenRng = "Blad2.A$100:" & KolomLetter(nGroentSlots - 1) & "$100"
    sPwVal  = "pakketwaardes.$B$2:$E$" & (nPwRijen + 1)
    sPwKey  = "pakketwaardes.$A$2:$A$" & (nPwRijen + 1)

    ' Valuta-opmaak (opnieuw zetten op de herschreven bereiken)
    Dim oFmtsA As Object : oFmtsA = oDoc.getNumberFormats()
    Dim oLocA As New com.sun.star.lang.Locale
    oLocA.Language = "nl" : oLocA.Country = "BE"
    Dim nCur As Long, sCurFmt As String
    sCurFmt = "#.##0,00"" " & Chr(8364) & """"
    nCur = oFmtsA.queryKey(sCurFmt, oLocA, False)
    If nCur = -1 Then nCur = oFmtsA.addNew(sCurFmt, oLocA)

    oDoc.lockControllers()
    oDoc.enableAutomaticCalculation(False)

    ' --- 1. AFREKENING: elke rij spiegelt de datablad-rij met hetzelfde nummer ---
    Dim ar As Integer, asr As Integer, g As Integer, wSlot As Integer
    Dim sGuard As String, sCol As String, sFmtCol As String, sWegColA As String
    For ar = 6 To nLaatsteForm - 1
        asr = ar + 1                       ' 1-based rijnummer, identiek op beide bladen

        sGuard = "OR(" & sData & ".A" & asr & "="""";" & _
                 sData & "." & KolomLetter(cAfh) & asr & "=""afhaalpunt/dag"")"

        ' A: naam/afhaalpunt spiegelen (leeg -> leeg, niet 0)
        oAfr.getCellByPosition(cNaam, ar).setFormula( _
            "=IF(" & sData & ".A" & asr & "="""";"""";" & sData & ".A" & asr & ")")
        ' F: klant_id uit kolom P
        oAfr.getCellByPosition(5, ar).setFormula( _
            "=IF(" & sData & "." & KolomLetter(cWBest) & asr & "="""";"""";" & _
            sData & "." & KolomLetter(cWBest) & asr & ")")
        ' B: pakket-bedrag = pakkettype x pakketprijs-cel bovenaan
        oAfr.getCellByPosition(1, ar).setFormula( _
            "=IF(" & sGuard & ";"""";" & _
            sData & "." & KolomLetter(cKG)   & asr & "*$B$2+" & _
            sData & "." & KolomLetter(cGG)   & asr & "*$B$3+" & _
            sData & "." & KolomLetter(cEGG)  & asr & "*$B$4+" & _
            sData & "." & KolomLetter(cMINI) & asr & "*$B$5)")
        ' Y..AV: geleverde hoeveelheid x prijs/eenheid (rij 3)
        For g = 0 To nGroentSlots - 1
            sCol = KolomLetter(cGroent0 + g)
            oAfr.getCellByPosition(cGroent0 + g, ar).setFormula( _
                "=IF(" & sData & "." & sCol & asr & "="""";"""";" & _
                sData & "." & sCol & asr & "*" & sData & "." & sCol & "$3)")
        Next g
        ' C: losse-groenten-totaal
        oAfr.getCellByPosition(2, ar).setFormula( _
            "=IF(" & sGuard & ";"""";SUM(" & sFG & asr & ":" & sLG & asr & "))")
        ' W: detail losse groenten (matrixformule)
        oAfr.getCellRangeByName(KolomLetter(cSamenv) & asr).setArrayFormula( _
            "=TEXTJOIN(CHAR(10);1;IF(" & sData & "." & sFG & asr & ":" & sLG & asr & "="""";"""";" & _
            sData & "." & sFG & "$2:" & sLG & "$2&"": ""&" & sData & "." & sFG & asr & ":" & sLG & asr & _
            "&"" ""&" & sEenRng & "&"" " & Chr(224) & " ""&" & _
            "TEXT(" & sData & "." & sFG & "$3:" & sLG & "$3;""0,00"")&"" " & Chr(8364) & " = ""&" & _
            "TEXT(" & sData & "." & sFG & asr & ":" & sLG & asr & "*" & sData & "." & sFG & "$3:" & sLG & "$3;""0,00"")&"" " & Chr(8364) & """))")
        ' AZ..BK: in-pakket-waarde van elke weglating, opgezocht in 'pakketwaardes'
        sFmtCol = "IF(" & sData & "." & KolomLetter(cKG)   & asr & ">0;1;" & _
                  "IF(" & sData & "." & KolomLetter(cGG)   & asr & ">0;2;" & _
                  "IF(" & sData & "." & KolomLetter(cEGG)  & asr & ">0;3;" & _
                  "IF(" & sData & "." & KolomLetter(cMINI) & asr & ">0;4;0))))"
        For wSlot = 0 To nWegSlots - 1
            sWegColA = KolomLetter(cWeg0 + wSlot)
            oAfr.getCellByPosition(cWeg0 + wSlot, ar).setFormula( _
                "=IF(" & sData & "." & sWegColA & asr & "="""";"""";" & _
                "IFERROR(INDEX(" & sPwVal & ";MATCH(" & sData & "." & sWegColA & "$3;" & sPwKey & ";0);" & _
                sFmtCol & ");0))")
        Next wSlot
        ' D: vast weglatingen-totaal
        oAfr.getCellByPosition(3, ar).setFormula( _
            "=IF(" & sGuard & ";"""";SUM(" & sWegF & asr & ":" & sWegL & asr & "))")
        ' AY: detail weglatingen als tekst (matrixformule)
        oAfr.getCellRangeByName(KolomLetter(cGeen) & asr).setArrayFormula( _
            "=TEXTJOIN(CHAR(10);1;IF(" & sData & "." & sWegF & asr & ":" & sWegL & asr & "="""";"""";" & _
            """Geen ""&LOWER(" & sWegF & "$6:" & sWegL & "$6)&"": -""&" & _
            "TEXT(" & sWegF & asr & ":" & sWegL & asr & ";""0,00"")&"" " & Chr(8364) & """))")
        ' E: TOTAAL
        oAfr.getCellByPosition(4, ar).setFormula( _
            "=IF(" & sGuard & ";"""";B" & asr & "+C" & asr & "-D" & asr & ")")
    Next ar

    ' Weesrijen onder de spiegel wissen: een achtergebleven #VERW!-rij van een
    ' verwijderde klant vervuilt anders H4 (weglatingen) en dus het WEEKTOTAAL.
    Dim oCurA As Object
    oCurA = oAfr.createCursor()
    oCurA.gotoEndOfUsedArea(False)
    Dim iEindAfr As Integer, nGewist As Integer
    iEindAfr = oCurA.RangeAddress.EndRow + 1
    nGewist = 0
    If iEindAfr > nLaatsteForm Then
        nGewist = iEindAfr - nLaatsteForm
        oAfr.getCellRangeByName("A" & (nLaatsteForm + 1) & ":" & _
            KolomLetter(cWeg0 + nWegSlots - 1) & iEindAfr).clearContents( _
            com.sun.star.sheet.CellFlags.VALUE + com.sun.star.sheet.CellFlags.DATETIME + _
            com.sun.star.sheet.CellFlags.STRING + com.sun.star.sheet.CellFlags.FORMULA)
    End If

    ' Valuta-opmaak op de herschreven bereiken
    oAfr.getCellRangeByName("B7:E" & nLaatsteForm).NumberFormat = nCur
    oAfr.getCellRangeByName(sFG & "7:" & sLG & nLaatsteForm).NumberFormat = nCur
    oAfr.getCellRangeByName(sWegF & "7:" & sWegL & nLaatsteForm).NumberFormat = nCur

    ' --- 2. DATABLAD: kolom W (samenvatting) + X (euro losse) per klantrij ---
    Dim nKlant As Integer, nIdDubbel As Integer
    Dim sNaamR As String, sAfhR As String, sFmlSv As String
    Dim sgCol As String, swCol As String
    Dim oCelSv As Object, oCelWa As Object
    Dim sIds As String, sId As String, sDubbel As String
    nKlant = 0 : nIdDubbel = 0 : sIds = "|" : sDubbel = ""
    For iRij = 7 To iLaatste
        sNaamR = Trim(oWk.getCellByPosition(cNaam, iRij - 1).getString())
        sAfhR  = Trim(oWk.getCellByPosition(cAfh,  iRij - 1).getString())
        If sNaamR <> "" And sAfhR <> "afhaalpunt/dag" Then
            nKlant = nKlant + 1

            ' W: levende samenvatting (naam, afhaalpunt, formaat, groenten,
            '    ander/opmerking, weglatingen) — eenheid uit Blad2.I<slot>
            sFmlSv = "=A" & iRij & "&"" (""&B" & iRij & "&""): ""&" & _
                "IF(" & KolomLetter(cKG)   & iRij & ">0;""klein"";" & _
                "IF(" & KolomLetter(cGG)   & iRij & ">0;""groot"";" & _
                "IF(" & KolomLetter(cEGG)  & iRij & ">0;""extra groot"";" & _
                "IF(" & KolomLetter(cMINI) & iRij & ">0;""mini"";""geen pakket""))))"
            For g = 0 To nGroentSlots - 1
                sgCol = KolomLetter(cGroent0 + g)
                sFmlSv = sFmlSv & "&IF(" & sgCol & iRij & "="""";"""";CHAR(10)&" & _
                    sgCol & "$2&"": ""&" & sgCol & iRij & "&"" ""&Blad2.I" & (g + 1) & ")"
            Next g
            sFmlSv = sFmlSv & "&IF(" & KolomLetter(cAnder) & iRij & "="""";"""";CHAR(10)&" & _
                """ander/opmerking: ""&" & KolomLetter(cAnder) & iRij & ")"
            For wSlot = 0 To nWegSlots - 1
                swCol = KolomLetter(cWeg0 + wSlot)
                sFmlSv = sFmlSv & "&IF(" & swCol & iRij & "="""";"""";CHAR(10)&""Geen: ""&" & swCol & "$3)"
            Next wSlot
            oCelSv = oWk.getCellByPosition(cSamenv, iRij - 1)
            oCelSv.setFormula(sFmlSv)
            oCelSv.IsTextWrapped = True

            ' X: euro losse groenten = het losse-totaal uit de eigen afrekening-rij
            oCelWa = oWk.getCellByPosition(cWaarde, iRij - 1)
            oCelWa.setFormula("=afrekening.C" & iRij)
            oCelWa.NumberFormat = nCur

            ' Dubbel klant_id opsporen (een verplaatste rij die twee keer staat)
            sId = Trim(oWk.getCellByPosition(cWBest, iRij - 1).getString())
            If sId <> "" Then
                If InStr(sIds, "|" & sId & "|") > 0 Then
                    nIdDubbel = nIdDubbel + 1
                    If Len(sDubbel) < 200 Then sDubbel = sDubbel & sId & " (rij " & iRij & "), "
                Else
                    sIds = sIds & sId & "|"
                End If
            End If
        End If
    Next iRij

    oDoc.enableAutomaticCalculation(True)
    oDoc.calculateAll()
    oDoc.unlockControllers()

    ' --- Verslag ---
    Dim sMelding As String
    sMelding = "Formules hersteld in " & oWk.Name & "." & Chr(10) & Chr(10) & _
        "Datablad     : rij 7 t/m " & iLaatste & ", " & nKlant & " klantrijen" & Chr(10) & _
        "               kolom W + X herschreven" & Chr(10) & _
        "Afrekening   : rij 7 t/m " & nLaatsteForm & " herschreven" & Chr(10)
    If nGewist > 0 Then
        sMelding = sMelding & "               " & nGewist & " weesrij(en) eronder gewist" & Chr(10)
    End If
    sMelding = sMelding & Chr(10) & _
        "Pakketten    : " & Format(oAfr.getCellByPosition(7, 1).getValue(), "#,##0.00") & " " & Chr(8364) & Chr(10) & _
        "Bijbestelling: " & Format(oAfr.getCellByPosition(7, 2).getValue(), "#,##0.00") & " " & Chr(8364) & Chr(10) & _
        "Weglatingen  : " & Format(oAfr.getCellByPosition(7, 3).getValue(), "#,##0.00") & " " & Chr(8364) & Chr(10) & _
        "WEEKTOTAAL   : " & Format(oAfr.getCellByPosition(7, 4).getValue(), "#,##0.00") & " " & Chr(8364)
    If nIdDubbel > 0 Then
        sMelding = sMelding & Chr(10) & Chr(10) & _
            "LET OP: " & nIdDubbel & " klant_id staat dubbel in het datablad — " & _
            "die klant wordt twee keer aangerekend:" & Chr(10) & sDubbel
    End If
    HerstelFormulesKern = sMelding
    Exit Function

Fout:
    On Error Resume Next
    oDoc.enableAutomaticCalculation(True)
    oDoc.unlockControllers()
    HerstelFormulesKern = "FOUT:Fout bij het herstellen: " & Err & " - " & Error & _
                          Chr(10) & "(regel " & Erl & ")"
End Function


' =============================================
' Kiemkracht - Weekbestand: spiegel controleren
' ---------------------------------------------
' Poort vóór MaakMaandbestand. Controleert per weekbestand of het contract
' "afrekening-rij N = datablad-rij N" nog geldt, en of de bedragen kloppen.
'
' WAAROM NIET ENKEL OP klant_id CONTROLEREN
' Een verschoven afrekening-rij is meestal intern consistent: álle cellen van
' die rij wijzen naar dezelfde (verkeerde) datarij, kolom F inbegrepen. De
' koppeling op klant_id in MaakMaandbestand vindt dan nog steeds het juiste
' bedrag bij de juiste klant. Maar dat is een eigenschap van de schade, geen
' garantie: kolom F is zelf een formule met precies dezelfde kwetsbaarheid als
' de bedragen ernaast. Zodra F en de bedragkolommen uit elkaar lopen, krijg je
' het juiste etiket op andermans geld — en dát ziet een klant_id-controle per
' definitie niet, want ze vertrouwt net die cel.
'
' Daarom controleert deze functie twee dingen naast elkaar:
'   1. UITLIJNING  - staat op afrekening-rij r dezelfde naam en hetzelfde
'                    klant_id als op datablad-rij r?
'   2. HERREKENING - kloppen pakket (B), losse groenten (C) en weglatingen (D)
'                    met wat je uit de RUWE datablad-cijfers berekent?
' De tweede vangt wat de eerste niet kan zien, en omgekeerd.
'
' Geeft "" terug als alles klopt, anders een leesbaar verslag.
' Dialoogvrij, zodat de aanroeper beslist wat er met de melding gebeurt.
' =============================================
Function ControleerWeekSpiegel(oWeek As Object) As String
    On Error GoTo Fout

    Const cNaam        = 0    ' A
    Const cAfh         = 1    ' B
    Const cWBest       = 15   ' P klant_id
    Const cKG          = 17   ' R
    Const cGG          = 18   ' S
    Const cEGG         = 19   ' T
    Const cMINI        = 20   ' U
    Const cGroent0     = 24   ' Y
    Const nGroentSlots = 24   ' Y..AV
    Const cWeg0        = 51   ' AZ
    Const nWegSlots    = 12   ' AZ..BK
    Const caPak        = 1    ' afrekening B
    Const caLos        = 2    ' afrekening C
    Const caWeg        = 3    ' afrekening D
    Const caKid        = 5    ' afrekening F
    Const dTol         = 0.005

    If Not oWeek.Sheets.hasByName("afrekening") Then
        ControleerWeekSpiegel = "Geen tabblad 'afrekening' in dit weekbestand."
        Exit Function
    End If

    Dim oWk As Object, oAfr As Object
    oWk  = oWeek.Sheets.getByIndex(0)
    oAfr = oWeek.Sheets.getByName("afrekening")

    ' --- Laatste klantrij ---
    Dim oCur As Object
    oCur = oWk.createCursor()
    oCur.gotoEndOfUsedArea(False)
    Dim iEind As Integer, iLaatste As Integer, r As Integer
    iEind = oCur.RangeAddress.EndRow + 1
    iLaatste = 0
    For r = iEind To 7 Step -1
        If Trim(oWk.getCellByPosition(cNaam, r - 1).getString()) <> "" Then
            iLaatste = r
            Exit For
        End If
    Next r
    If iLaatste < 7 Then
        ControleerWeekSpiegel = "Geen klantrijen gevonden in het datablad."
        Exit Function
    End If

    ' --- Prijzen en waarden inlezen ---
    Dim dPrijsPak(3) As Double, iP As Integer
    For iP = 0 To 3
        dPrijsPak(iP) = oAfr.getCellByPosition(1, iP + 1).getValue()   ' B2:B5
    Next iP

    Dim dPrijsGr(nGroentSlots) As Double, g As Integer
    For g = 0 To nGroentSlots - 1
        dPrijsGr(g) = oWk.getCellByPosition(cGroent0 + g, 2).getValue()  ' rij 3
    Next g

    ' pakketwaardes: naam -> waarde per formaat (KG/GG/EGG/MINI)
    Dim bHeeftPW As Boolean : bHeeftPW = oWeek.Sheets.hasByName("pakketwaardes")
    Dim pwNaam(200) As String, pwVal(200, 3) As Double, nPW As Integer
    Dim oPW As Object, iPw As Integer, iK As Integer
    nPW = 0
    If bHeeftPW Then
        oPW = oWeek.Sheets.getByName("pakketwaardes")
        For iPw = 2 To 200
            If Trim(oPW.getCellByPosition(0, iPw - 1).getString()) = "" Then Exit For
            pwNaam(nPW) = Trim(oPW.getCellByPosition(0, iPw - 1).getString())
            For iK = 0 To 3
                pwVal(nPW, iK) = oPW.getCellByPosition(iK + 1, iPw - 1).getValue()
            Next iK
            nPW = nPW + 1
        Next iPw
    End If

    ' weglating-namen uit rij 3 van het datablad
    Dim sWegNaam(nWegSlots) As String, w As Integer
    For w = 0 To nWegSlots - 1
        sWegNaam(w) = Trim(oWk.getCellByPosition(cWeg0 + w, 2).getString())
    Next w

    ' --- Rij voor rij ---
    Dim nKlant As Integer, nMisUit As Integer, nMisBedrag As Integer
    Dim sVb As String, nVb As Integer
    Dim sNaamD As String, sNaamA As String, sKidD As String, sKidA As String
    Dim sAfhD As String
    Dim dPak As Double, dLos As Double, dWeg As Double
    Dim dPakA As Double, dLosA As Double, dWegA As Double
    Dim iFmt As Integer, q As Double, iPwi As Integer
    Dim sIds As String, sId As String, nDubbel As Integer, sDubbelLijst As String
    nKlant = 0 : nMisUit = 0 : nMisBedrag = 0 : nVb = 0 : sVb = ""
    nDubbel = 0 : sIds = "|" : sDubbelLijst = ""

    For r = 7 To iLaatste
        sNaamD = Trim(oWk.getCellByPosition(cNaam, r - 1).getString())
        sAfhD  = Trim(oWk.getCellByPosition(cAfh,  r - 1).getString())
        If sNaamD = "" Or sAfhD = "afhaalpunt/dag" Then GoTo VolgendeControleRij
        nKlant = nKlant + 1

        ' 1. UITLIJNING
        sNaamA = Trim(oAfr.getCellByPosition(cNaam,  r - 1).getString())
        sKidD  = Trim(oWk.getCellByPosition(cWBest,  r - 1).getString())
        sKidA  = Trim(oAfr.getCellByPosition(caKid,  r - 1).getString())
        If sNaamA <> sNaamD Or sKidA <> sKidD Then
            nMisUit = nMisUit + 1
            If nVb < 6 Then
                nVb = nVb + 1
                sVb = sVb & "   rij " & r & "  " & Left(sNaamD & Space(22), 22) & _
                      " afrekening toont: " & sNaamA
                If sKidA <> sKidD Then sVb = sVb & " (klant_id " & sKidA & " i.p.v. " & sKidD & ")"
                sVb = sVb & Chr(10)
            End If
            GoTo VolgendeControleRij   ' bedrag vergelijken heeft hier geen zin meer
        End If

        ' 2. HERREKENING uit de ruwe datablad-cijfers
        iFmt = -1
        dPak = 0
        If oWk.getCellByPosition(cKG,   r - 1).getValue() > 0 Then iFmt = 0
        If oWk.getCellByPosition(cGG,   r - 1).getValue() > 0 And iFmt = -1 Then iFmt = 1
        If oWk.getCellByPosition(cEGG,  r - 1).getValue() > 0 And iFmt = -1 Then iFmt = 2
        If oWk.getCellByPosition(cMINI, r - 1).getValue() > 0 And iFmt = -1 Then iFmt = 3
        dPak = oWk.getCellByPosition(cKG,   r - 1).getValue() * dPrijsPak(0) + _
               oWk.getCellByPosition(cGG,   r - 1).getValue() * dPrijsPak(1) + _
               oWk.getCellByPosition(cEGG,  r - 1).getValue() * dPrijsPak(2) + _
               oWk.getCellByPosition(cMINI, r - 1).getValue() * dPrijsPak(3)

        dLos = 0
        For g = 0 To nGroentSlots - 1
            q = oWk.getCellByPosition(cGroent0 + g, r - 1).getValue()
            If q <> 0 Then dLos = dLos + q * dPrijsGr(g)
        Next g

        dWeg = 0
        If bHeeftPW And iFmt >= 0 Then
            For w = 0 To nWegSlots - 1
                If Trim(oWk.getCellByPosition(cWeg0 + w, r - 1).getString()) = "" Then GoTo VolgendeWegSlot
                If sWegNaam(w) = "" Then GoTo VolgendeWegSlot
                For iPwi = 0 To nPW - 1
                    If pwNaam(iPwi) = sWegNaam(w) Then
                        dWeg = dWeg + pwVal(iPwi, iFmt)
                        Exit For
                    End If
                Next iPwi
                VolgendeWegSlot:
            Next w
        End If

        dPakA = oAfr.getCellByPosition(caPak, r - 1).getValue()
        dLosA = oAfr.getCellByPosition(caLos, r - 1).getValue()
        dWegA = oAfr.getCellByPosition(caWeg, r - 1).getValue()

        If Abs(dPakA - dPak) > dTol Or Abs(dLosA - dLos) > dTol Or _
           (bHeeftPW And Abs(dWegA - dWeg) > dTol) Then
            nMisBedrag = nMisBedrag + 1
            If nVb < 6 Then
                nVb = nVb + 1
                sVb = sVb & "   rij " & r & "  " & Left(sNaamD & Space(22), 22)
                If Abs(dPakA - dPak) > dTol Then _
                    sVb = sVb & " pakket " & Format(dPakA, "0.00") & " i.p.v. " & Format(dPak, "0.00")
                If Abs(dLosA - dLos) > dTol Then _
                    sVb = sVb & " losse " & Format(dLosA, "0.00") & " i.p.v. " & Format(dLos, "0.00")
                If bHeeftPW And Abs(dWegA - dWeg) > dTol Then _
                    sVb = sVb & " weglating " & Format(dWegA, "0.00") & " i.p.v. " & Format(dWeg, "0.00")
                sVb = sVb & Chr(10)
            End If
        End If

        VolgendeControleRij:
    Next r

    ' --- Dubbele klant_id's in de spiegel (de andere stille fout) ---
    Dim arB As Integer, ar2 As Integer
    arB = 0 : ar2 = 7
    Do While arB < 50 And ar2 < 5000
        sId = Trim(oAfr.getCellByPosition(caKid, ar2 - 1).getString())
        If sId = "" And Trim(oAfr.getCellByPosition(cNaam, ar2 - 1).getString()) = "" Then
            arB = arB + 1
        Else
            arB = 0
            If sId <> "" Then
                If InStr(sIds, "|" & sId & "|") > 0 Then
                    nDubbel = nDubbel + 1
                    If Len(sDubbelLijst) < 120 Then sDubbelLijst = sDubbelLijst & sId & " (rij " & ar2 & "), "
                Else
                    sIds = sIds & sId & "|"
                End If
            End If
        End If
        ar2 = ar2 + 1
    Loop

    If nMisUit = 0 And nMisBedrag = 0 And nDubbel = 0 Then
        ControleerWeekSpiegel = ""
        Exit Function
    End If

    Dim sM As String
    sM = "De afrekening klopt niet met het datablad (" & nKlant & " klantrijen nagekeken):" & Chr(10) & Chr(10)
    If nMisUit > 0    Then sM = sM & "  " & nMisUit    & " rij(en) met een verkeerde koppeling" & Chr(10)
    If nMisBedrag > 0 Then sM = sM & "  " & nMisBedrag & " rij(en) met een verkeerd bedrag" & Chr(10)
    If nDubbel > 0    Then sM = sM & "  " & nDubbel    & " klant_id staat dubbel: " & sDubbelLijst & Chr(10)
    If Not bHeeftPW   Then sM = sM & "  (geen tabblad 'pakketwaardes': weglatingen niet nagerekend)" & Chr(10)
    If sVb <> "" Then sM = sM & Chr(10) & sVb
    ControleerWeekSpiegel = sM
    Exit Function

Fout:
    ControleerWeekSpiegel = "Controle kon niet worden uitgevoerd: " & Err & " - " & Error & _
                            " (regel " & Erl & ")"
End Function
