    Shell "cmd.exe /c taskkill /F /IM ssh.exe"

    MsgBox "Klant '" & sVoornaam & " " & sFamilienaam & "' succesvol toegevoegd.", 64, "Klaar"

    ' Invoervelden leegmaken
    Dim iRij As Integer
