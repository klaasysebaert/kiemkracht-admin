    veldNamen(8)  = "email2"           : veldNamen(9)  = "email3"
    veldNamen(10) = "email4"           : veldNamen(11) = "telefoon"
    veldNamen(12) = "opmerkingen"      : veldNamen(13) = "opmerkingen_volgend"
    veldNamen(14) = "opmerking_status" : veldNamen(15) = "nooit_groenten"
    veldNamen(16) = "email_afrekening"       : veldNamen(17) = "voornaam_afrekening"
    veldNamen(18) = "familienaam_afrekening" : veldNamen(19) = "nooit_afrekening"
    veldNamen(20) = "mail_opt_out"           : veldNamen(21) = "mail_opt_out_reden"
    veldNamen(22) = "koffie_opt_out"         : veldNamen(23) = "koffie_opt_out_reden"

    Dim klantenIdCol As Integer : klantenIdCol = -1
    Dim kVeldCol(23) As Integer
    Dim vi As Integer
    For vi = 0 To 23 : kVeldCol(vi) = -1 : Next vi

    Dim hIdx As Integer : hIdx = 0
    Do While oKlanten.getCellByPosition(hIdx, 0).getString() <> ""
        Dim hNaam As String : hNaam = oKlanten.getCellByPosition(hIdx, 0).getString()
        If hNaam = "id" Then klantenIdCol = hIdx
        For vi = 0 To 23
            If hNaam = veldNamen(vi) Then kVeldCol(vi) = hIdx
        Next vi
        hIdx = hIdx + 1
    Loop

    If klantenIdCol = -1 Then
        MsgBox "Kolom 'id' niet gevonden in tabblad klanten." & Chr(10) & _
               "Voer eerst LaadAlleTabellen uit.", 16, "Fout"
        Exit Sub
    End If

    ' === Stap 2: klanten-tabblad in arrays laden ===
    Dim kID(2000)       As Long
    Dim kVals(2000, 23) As String
    Dim nKlanten As Integer : nKlanten = 0
    Dim kr As Integer : kr = 1
    Do While oKlanten.getCellByPosition(klantenIdCol, kr).getString() <> ""
        kID(nKlanten) = CLng(oKlanten.getCellByPosition(klantenIdCol, kr).getValue())
        For vi = 0 To 23
            If kVeldCol(vi) >= 0 Then
                If vi = 4 Then
                    If oKlanten.getCellByPosition(kVeldCol(vi), kr).getString() = "" Then
                        kVals(nKlanten, vi) = ""
                    Else
                        Dim dAfhaal As Double
                        dAfhaal = oKlanten.getCellByPosition(kVeldCol(vi), kr).getValue()
                        kVals(nKlanten, vi) = CStr(CLng(dAfhaal))
                    End If
                Else
                    kVals(nKlanten, vi) = Trim(oKlanten.getCellByPosition(kVeldCol(vi), kr).getString())
                End If
            End If
        Next vi
        nKlanten = nKlanten + 1
        kr = kr + 1
    Loop

    ' === Stap 3: pre-pass — vergelijken zonder DB, resultaat opslaan ===
    Dim bGewijzigd(2000) As Boolean
    Dim aKIdx(2000)      As Integer
    Dim nGewijzigd As Integer : nGewijzigd = 0
    Dim nTotaal    As Integer : nTotaal    = 0
    Dim sProblemen As String  : sProblemen = ""
    Dim nProblemen As Integer : nProblemen = 0
    Dim r As Integer : r = 1

    Do While oKB.getCellByPosition(2, r).getValue() <> 0
        Dim nID As Long : nID = CLng(oKB.getCellByPosition(2, r).getValue())

        Dim kIdx As Integer : kIdx = -1
        Dim ki As Integer
        For ki = 0 To nKlanten - 1
            If kID(ki) = nID Then kIdx = ki : Exit For
        Next ki

        Dim bWijz As Boolean : bWijz = (kIdx = -1)
        If Not bWijz Then
            For vi = 0 To 23
                If kVals(kIdx, vi) <> Trim(oKB.getCellByPosition(KBKolom(vi), r).getString()) Then
                    bWijz = True : Exit For
                End If
            Next vi
        End If
        ' afhaalpunt_alternatieven (kolom AA=26) is géén klanten-kolom en dus niet
        ' in kVals — vergelijken tegen de eigen snapshot in kolom AB=27 (backlog #27).
        If Not bWijz Then
            If Trim(oKB.getCellByPosition(26, r).getString()) <> Trim(oKB.getCellByPosition(27, r).getString()) Then
                bWijz = True
            End If
        End If

        bGewijzigd(r) = bWijz
        aKIdx(r)      = kIdx
        If bWijz Then nGewijzigd = nGewijzigd + 1
        nTotaal = nTotaal + 1

        ' Validatie: een gewijzigde abonnee mag geen leeg formaat hebben — anders
        ' krijgt de klant in het weekbestand geen pakket en toont de landings-
        ' pagina-melding 'klein' bij gebrek aan beter. Liever menselijk laten
        ' kiezen dan stilletjes default zetten.
        If bWijz Then
            Dim sValType_p As String : sValType_p = LCase(Trim(oKB.getCellByPosition(KBKolom(5), r).getString()))
            Dim sValFmt_p  As String : sValFmt_p  = Trim(oKB.getCellByPosition(KBKolom(6), r).getString())
            If (sValType_p = "abonnee" Or Left(sValType_p, 8) = "abonnee-") And sValFmt_p = "" Then
                Dim sValNm_p As String
                sValNm_p = Trim(oKB.getCellByPosition(KBKolom(0), r).getString()) & " " & _
                           Trim(oKB.getCellByPosition(KBKolom(1), r).getString())
                sProblemen = sProblemen & Chr(10) & "  rij " & (r + 1) & ": " & sValNm_p & _
                             " (id " & nID & ", type " & sValType_p & ")"
                nProblemen = nProblemen + 1
            End If
        End If

        r = r + 1
    Loop

    ' Blokkeer als er gewijzigde abonnees zijn zonder formaat
    If nProblemen > 0 Then
        MsgBox nProblemen & " gewijzigde abonnee(s) zonder formaat:" & Chr(10) & sProblemen & Chr(10) & Chr(10) & _
               "Vul de kolom 'formaat' aan met 'klein', 'groot', 'extra-groot' of 'mini' en start de macro opnieuw.", _
               16, "Validatiefout"
        Exit Sub
    End If

    ' === Popup 2: exacte wijzigingstelling ===
    nAntw = MsgBox( _
        "Deze actie zal de gegevens wijzigen van " & nGewijzigd & " klant(en)" & Chr(10) & _
        "(van " & nTotaal & " vergeleken met het klanten-tabblad)." & Chr(10) & Chr(10) & _
        "Akkoord?", _
        1, "SchrijfWijzigingenTerug")
    If nAntw <> 1 Then Exit Sub

    If nGewijzigd = 0 Then
        MsgBox "Geen wijzigingen gevonden. Niets verstuurd.", 64, "SchrijfWijzigingenTerug"
        Exit Sub
    End If

    ' === Pas na bevestiging: DB-verbinding (juiste omgeving) ===
    On Error GoTo VerbindingsFout2
    Dim oConn As Object
    oConn = MaakDBVerbinding()
    On Error GoTo 0

    ' === Stap 4: UPDATE enkel gewijzigde rijen ===
    Dim oStmt As Object : oStmt = oConn.createStatement()
    Dim nUpdates As Integer : nUpdates = 0

    ' Afhaalpunt-alternatieven (backlog #27): namen uit kolom AA vooraf
    ' opzoeken/valideren tegen afhaalpunten (naam, naam_publiek of rechtstreeks
    ' het afhaalpunt_id — zelfde invoervrijheid als het afhaalpunt_verlof-tabblad),
    ' vóór er iets weggeschreven wordt — bij een onbekende naam/id breekt de macro
    ' af zonder één enkele UPDATE uit te voeren.
    Dim apNaam(200) As String, apId(200) As Long, nAp As Integer : nAp = 0
    Dim oApRS As Object : oApRS = oStmt.executeQuery("SELECT id, naam, naam_publiek FROM afhaalpunten")
    Do While oApRS.next()
        apId(nAp)   = oApRS.getLong(1)
        apNaam(nAp) = LCase(Trim(oApRS.getString(2)))
        nAp = nAp + 1
        Dim sNP As String : sNP = LCase(Trim(oApRS.getString(3)))
        If sNP <> "" And sNP <> apNaam(nAp - 1) Then
            apId(nAp)   = apId(nAp - 1)
            apNaam(nAp) = sNP
            nAp = nAp + 1
        End If
    Loop
    oApRS.close()

    Dim sAltIdsCsv(2000) As String
    Dim sAltFout As String : sAltFout = ""
    Dim nAltFout As Integer : nAltFout = 0
    Dim rAlt As Integer : rAlt = 1
    Do While rAlt <= nTotaal
        sAltIdsCsv(rAlt) = ""
        If bGewijzigd(rAlt) Then
            Dim sAltCsv As String : sAltCsv = Trim(oKB.getCellByPosition(26, rAlt).getString())
            If sAltCsv <> "" Then
                Dim aAltNamen() As String : aAltNamen = Split(sAltCsv, ",")
                Dim iAlt As Integer
                Dim sIds As String : sIds = ""
                For iAlt = 0 To UBound(aAltNamen)
                    Dim sNaamAlt As String : sNaamAlt = LCase(Trim(aAltNamen(iAlt)))
                    If sNaamAlt <> "" Then
                        Dim lFoundId As Long : lFoundId = -1
                        Dim jAp As Integer
                        If IsNumeric(sNaamAlt) Then
                            ' Rechtstreeks een afhaalpunt_id — moet wél bestaan.
                            Dim lAltIdKand As Long : lAltIdKand = CLng(sNaamAlt)
                            For jAp = 0 To nAp - 1
                                If apId(jAp) = lAltIdKand Then lFoundId = lAltIdKand : Exit For
                            Next jAp
                        Else
                            For jAp = 0 To nAp - 1
                                If apNaam(jAp) = sNaamAlt Then lFoundId = apId(jAp) : Exit For
                            Next jAp
                        End If
                        If lFoundId = -1 Then
                            sAltFout = sAltFout & Chr(10) & "  rij " & (rAlt + 1) & _
                                       ": onbekend afhaalpunt '" & Trim(aAltNamen(iAlt)) & "'"
                            nAltFout = nAltFout + 1
                        ElseIf InStr("," & sIds & ",", "," & CStr(lFoundId) & ",") = 0 Then
                            ' Dubbels stil overslaan: hetzelfde punt kan twee keer
                            ' opduiken (id én naam, of naam én naam_publiek) en de
                            ' PK (klant_id, afhaalpunt_id) zou daar op breken.
                            If sIds <> "" Then sIds = sIds & ","
                            sIds = sIds & CStr(lFoundId)
                        End If
                    End If
                Next iAlt
                sAltIdsCsv(rAlt) = sIds
            End If
        End If
        rAlt = rAlt + 1
    Loop

    If nAltFout > 0 Then
        MsgBox nAltFout & " ongeldige afhaalpunt-verwijzing(en) in kolom AA (afhaalpunt_alternatieven):" & Chr(10) & _
               sAltFout & Chr(10) & Chr(10) & _
               "Gebruik het afhaalpunt_id (bv. 18) of een naam die exact overeenkomt met " & _
               "afhaalpunten.naam of naam_publiek. " & _
               "Corrigeer en start de macro opnieuw. Er is nog niets weggeschreven.", 16, "Validatiefout"
        oStmt.close()
        oConn.close()
        Exit Sub
    End If

    r = 1
    Do While r <= nTotaal
        If bGewijzigd(r) Then
            nID = CLng(oKB.getCellByPosition(2, r).getValue())

            Dim sVoornaam     As String : sVoornaam     = oKB.getCellByPosition(KBKolom(0),  r).getString()
            Dim sFamilienaam  As String : sFamilienaam  = oKB.getCellByPosition(KBKolom(1),  r).getString()
            Dim sVoornaam2    As String : sVoornaam2    = oKB.getCellByPosition(KBKolom(2),  r).getString()
            Dim sFamilienaam2 As String : sFamilienaam2 = oKB.getCellByPosition(KBKolom(3),  r).getString()
            Dim sAfhaalId     As String : sAfhaalId     = Trim(oKB.getCellByPosition(KBKolom(4),  r).getString())
            Dim sType         As String : sType         = oKB.getCellByPosition(KBKolom(5),  r).getString()
            Dim sFormaat      As String : sFormaat      = oKB.getCellByPosition(KBKolom(6),  r).getString()
            Dim sEmail1       As String : sEmail1       = oKB.getCellByPosition(KBKolom(7),  r).getString()
            Dim sEmail2       As String : sEmail2       = oKB.getCellByPosition(KBKolom(8),  r).getString()
            Dim sEmail3       As String : sEmail3       = oKB.getCellByPosition(KBKolom(9),  r).getString()
            Dim sEmail4       As String : sEmail4       = oKB.getCellByPosition(KBKolom(10), r).getString()
            Dim sTelefoon     As String : sTelefoon     = oKB.getCellByPosition(KBKolom(11), r).getString()
            Dim sOpmerk       As String : sOpmerk       = oKB.getCellByPosition(KBKolom(12), r).getString()
            Dim sOpmerkVolg   As String : sOpmerkVolg   = oKB.getCellByPosition(KBKolom(13), r).getString()
            Dim sOpmerkStat   As String : sOpmerkStat   = oKB.getCellByPosition(KBKolom(14), r).getString()
            Dim sNooit        As String : sNooit        = Trim(oKB.getCellByPosition(KBKolom(15), r).getString())
            Dim sEmailAfr     As String : sEmailAfr     = Trim(oKB.getCellByPosition(KBKolom(16), r).getString())
            Dim sVoorAfr      As String : sVoorAfr      = Trim(oKB.getCellByPosition(KBKolom(17), r).getString())
            Dim sFamAfr       As String : sFamAfr       = Trim(oKB.getCellByPosition(KBKolom(18), r).getString())
            Dim sNooitAfr     As String : sNooitAfr     = Trim(oKB.getCellByPosition(KBKolom(19), r).getString())

            Dim sAfhaalSql As String
            If sAfhaalId = "" Or Not IsNumeric(sAfhaalId) Then
                sAfhaalSql = "NULL"
            Else
                sAfhaalSql = CStr(CLng(sAfhaalId))
            End If

            Dim sNooitSql As String
            Select Case LCase(sNooit)
                Case "t", "true", "1", "ja"   : sNooitSql = "TRUE"
                Case "f", "false", "0", "nee" : sNooitSql = "FALSE"
                Case Else                      : sNooitSql = "NULL"
            End Select

            ' nooit_afrekening (boolean NOT NULL): elke niet-lege, niet-expliciet-
            ' onwaar waarde telt als aan — zo werkt "x", "ja" of het klant_id zelf.
            Dim sNooitAfrSql As String
            Select Case LCase(sNooitAfr)
                Case "", "f", "false", "0", "nee" : sNooitAfrSql = "FALSE"
                Case Else                          : sNooitAfrSql = "TRUE"
            End Select

            ' Relatie-status (klant-niveau) afleiden uit het bewerkte type.
            Dim sStatusKlant As String
            Select Case sType
                Case "stop-tijdelijk"  : sStatusKlant = "gepauzeerd"
                Case "stop-definitief" : sStatusKlant = "gestopt"
                Case "on_hold"         : sStatusKlant = "on_hold"
                Case Else              : sStatusKlant = "actief"   ' abonnee* / weekperweek*
            End Select

            ' Un-stop via klanten_beheer: bij terug 'actief' óók de pauze-window
            ' wissen. Anders laat de achtergebleven window (pauze_tot NULL wordt
            ' nooit auto-hervat) de nachtelijke flip-cron de status weer op
            ' 'gestopt'/'gepauzeerd' zetten -> type terug 'stop-*'. Zo blijft
            ' klanten_beheer self-sufficient om iemand uit een stop te halen.
            Dim sPauzeClause As String : sPauzeClause = ""
            If sStatusKlant = "actief" Then
                sPauzeClause = "pauze_vanaf_jaar = NULL, pauze_vanaf_week = NULL, " & _
                               "pauze_tot_jaar = NULL, pauze_tot_week = NULL, " & _
                               "opvolg_datum = NULL, opvolg_gemaild_op = NULL, "
            ElseIf sStatusKlant = "gestopt" Then
                ' Expliciet stop-definitief via klanten_beheer: einde en opvolging
                ' wissen, anders zet de recompute (opvolg_datum-bewust) de status
                ' weer op 'gepauzeerd'.
                sPauzeClause = "pauze_tot_jaar = NULL, pauze_tot_week = NULL, " & _
                               "opvolg_datum = NULL, opvolg_gemaild_op = NULL, "
            End If

            ' Opt-outs (mail/koffie) — vi 20-23, kolommen AC-AF. Vlag zelf
            ' ongewijzigd: enkel de reden bijwerken. Vlag flipt aan: zelfde
            ' zij-effecten als een handmatige uitschrijving (uitschrijven.php,
            ' GET/one-click-tak). Vlag flipt uit: exact de "ongedaan maken"-
            ' semantiek van uitschrijven.php (herstelSubmit-tak).
            Dim kIdxRow As Integer : kIdxRow = aKIdx(r)
            Dim sMailOptNw   As String : sMailOptNw   = Trim(oKB.getCellByPosition(KBKolom(20), r).getString())
            Dim sMailRedenNw As String : sMailRedenNw = Trim(oKB.getCellByPosition(KBKolom(21), r).getString())
            Dim sKoffOptNw   As String : sKoffOptNw   = Trim(oKB.getCellByPosition(KBKolom(22), r).getString())
            Dim sKoffRedenNw As String : sKoffRedenNw = Trim(oKB.getCellByPosition(KBKolom(23), r).getString())

            Dim bMailOptNw As Boolean : bMailOptNw = IsAanKB(sMailOptNw)
            Dim bKoffOptNw As Boolean : bKoffOptNw = IsAanKB(sKoffOptNw)
            Dim bMailOptOud As Boolean, bKoffOptOud As Boolean
            If kIdxRow >= 0 Then
                bMailOptOud = IsAanKB(kVals(kIdxRow, 20))
                bKoffOptOud = IsAanKB(kVals(kIdxRow, 22))
            Else
                bMailOptOud = False
                bKoffOptOud = False
            End If

            Dim sMailOptClause As String
            If bMailOptNw = bMailOptOud Then
                sMailOptClause = ", mail_opt_out_reden = " & SqlStr(sMailRedenNw)
            ElseIf bMailOptNw And Not bMailOptOud Then
                sMailOptClause = ", mail_opt_out = TRUE, mail_opt_out_op = COALESCE(mail_opt_out_op, now()), " & _
                                  "mail_opt_out_reden = " & SqlStr(sMailRedenNw) & ", " & _
                                  "mail_opt_out_methode = COALESCE(mail_opt_out_methode, 'beheer'), " & _
                                  "mail_opt_out_gemeld = FALSE"
            Else
                sMailOptClause = ", mail_opt_out = FALSE, mail_opt_out_op = NULL, mail_opt_out_reden = NULL, " & _
                                  "mail_opt_out_methode = NULL, mail_opt_out_gemeld = FALSE"
            End If

            Dim sKoffOptClause As String
            If bKoffOptNw = bKoffOptOud Then
                sKoffOptClause = ", koffie_opt_out_reden = " & SqlStr(sKoffRedenNw)
            ElseIf bKoffOptNw And Not bKoffOptOud Then
                sKoffOptClause = ", koffie_opt_out = TRUE, koffie_opt_out_op = COALESCE(koffie_opt_out_op, now()), " & _
                                  "koffie_opt_out_reden = " & SqlStr(sKoffRedenNw) & ", " & _
                                  "koffie_opt_out_methode = COALESCE(koffie_opt_out_methode, 'beheer'), " & _
                                  "koffie_opt_out_gemeld = FALSE"
            Else
                sKoffOptClause = ", koffie_opt_out = FALSE, koffie_opt_out_op = NULL, koffie_opt_out_reden = NULL, " & _
                                  "koffie_opt_out_methode = NULL, koffie_opt_out_gemeld = FALSE"
            End If

            Dim sSQL As String
            sSQL = "UPDATE klanten SET " & _
                   "voornaam = "             & SqlStr(sVoornaam)     & ", " & _
                   "familienaam = "          & SqlStr(sFamilienaam)  & ", " & _
                   "voornaam2 = "            & SqlStr(sVoornaam2)    & ", " & _
                   "familienaam2 = "         & SqlStr(sFamilienaam2) & ", " & _
                   "afhaalpunt_id = "        & sAfhaalSql            & ", " & _
                   "type = "                 & SqlStr(sType)         & ", " & _
                   "formaat = "              & SqlStr(sFormaat)      & ", " & _
                   "status = '"              & sStatusKlant & "', "          & _
                   sPauzeClause                                             & _
                   "email1 = "               & SqlStr(sEmail1)       & ", " & _
                   "email2 = "               & SqlStr(sEmail2)       & ", " & _
                   "email3 = "               & SqlStr(sEmail3)       & ", " & _
                   "email4 = "               & SqlStr(sEmail4)       & ", " & _
                   "telefoon = "             & SqlStr(sTelefoon)     & ", " & _
                   "opmerkingen = "          & SqlStr(sOpmerk)       & ", " & _
                   "opmerkingen_volgend = "  & SqlStr(sOpmerkVolg)   & ", " & _
                   "opmerking_status = "     & SqlStr(sOpmerkStat)   & ", " & _
                   "email_afrekening = "     & SqlStr(sEmailAfr)     & ", " & _
                   "voornaam_afrekening = "  & SqlStr(sVoorAfr)      & ", " & _
                   "familienaam_afrekening = " & SqlStr(sFamAfr)     & ", " & _
                   "nooit_afrekening = "     & sNooitAfrSql          & ", " & _
                   "nooit_groenten = "       & sNooitSql & _
                   sMailOptClause & sKoffOptClause & _
                   " WHERE id = "            & CStr(nID)

            oStmt.executeUpdate(sSQL)
            nUpdates = nUpdates + 1

            ' Primair abonnement synchroniseren met het bewerkte type/formaat.
            ' Enkel bron='primair' wordt aangeraakt; handmatige combo-'extra'-rijen
            ' blijven ongemoeid (klantenbeheer-tabblad is nog niet combo-bewerkbaar — backlog #22).
            oStmt.executeUpdate("DELETE FROM abonnementen WHERE klant_id = " & CStr(nID) & " AND bron = 'primair'")
            If Left(sType, 7) = "abonnee" And _
               (sFormaat = "klein" Or sFormaat = "groot" Or sFormaat = "extra-groot" Or sFormaat = "mini") Then
                Dim sRitmeBeh As String, sStatusBeh As String
                If InStr(sType, "onpare-week") > 0 Then
                    sRitmeBeh = "onpare-week"
                ElseIf InStr(sType, "pare-week") > 0 Then
                    sRitmeBeh = "pare-week"
                Else
                    sRitmeBeh = "wekelijks"
                End If
                If InStr(sType, "-toekomst") > 0 Then sStatusBeh = "toekomst" Else sStatusBeh = "actief"
                oStmt.executeUpdate("INSERT INTO abonnementen " & _
                    "(klant_id, ritme, formaat, status, bron) VALUES (" & _
                    CStr(nID) & ", '" & sRitmeBeh & "', '" & sFormaat & "', '" & sStatusBeh & "', 'primair')")
            End If

            ' Afhaalpunt-alternatieven synchroniseren (backlog #27) — idempotente
            ' DELETE+INSERT op elke gewijzigde rij, namen al gevalideerd/gerezolveerd
            ' naar id's in sAltIdsCsv() vóór deze lus (zie hierboven).
            oStmt.executeUpdate("DELETE FROM klant_afhaalpunt_alternatieven WHERE klant_id = " & CStr(nID))
            If sAltIdsCsv(r) <> "" Then
                Dim aAltIds() As String : aAltIds = Split(sAltIdsCsv(r), ",")
                Dim iAltIns As Integer
                For iAltIns = 0 To UBound(aAltIds)
                    oStmt.executeUpdate("INSERT INTO klant_afhaalpunt_alternatieven (klant_id, afhaalpunt_id) VALUES (" & _
                        CStr(nID) & ", " & aAltIds(iAltIns) & ")")
                Next iAltIns
            End If
        End If
        r = r + 1
    Loop

    oStmt.close()
    oConn.close()

    ' === Stap 5: klanten-sheet bijwerken als nieuwe vergelijkingsbasis ===
    ' Zo herkent de volgende vergelijking een teruggedraaide waarde opnieuw als wijziging.
    Dim rSync As Integer : rSync = 1
    Do While rSync <= nTotaal
        If bGewijzigd(rSync) And aKIdx(rSync) >= 0 Then
            Dim kRow As Integer : kRow = aKIdx(rSync) + 1
            Dim viS As Integer
            ' 0-23: alle velden, incl. *_afrekening/nooit_afrekening (16-19) en
            ' de opt-outs (20-23). FIX 2026-07-21: liep vroeger tot 15, waardoor
            ' 16-19 nooit teruggeschreven werden naar het klanten-tabblad — de
            ' vergelijkingsbasis bleef daar verouderd, en elke volgende run
            ' herkende diezelfde klant opnieuw (ten onrechte) als gewijzigd,
            ' tot een verse LaadAlleTabellen. Enkel de teller/extra UPDATE's
            ' waren geraakt (SQL leest altijd de live klanten_beheer-cel, nooit
            ' deze verouderde basis) — geen foute klantgegevens, wel onnodige
            ' DELETE+INSERT-churn op abonnementen (aangemaakt_op/gewijzigd_op
            ' reset voor vals-gemelde klanten).
            For viS = 0 To 23
                If kVeldCol(viS) >= 0 Then
                    If viS = 4 Then
                        Dim sAfhSync As String
                        sAfhSync = Trim(oKB.getCellByPosition(KBKolom(4), rSync).getString())
                        If sAfhSync = "" Or Not IsNumeric(sAfhSync) Then
                            oKlanten.getCellByPosition(kVeldCol(viS), kRow).setString("")
                        Else
                            oKlanten.getCellByPosition(kVeldCol(viS), kRow).setValue(CLng(sAfhSync))
                        End If
                    Else
                        oKlanten.getCellByPosition(kVeldCol(viS), kRow).setString( _
                            oKB.getCellByPosition(KBKolom(viS), rSync).getString())
                    End If
                End If
            Next viS
        End If
        rSync = rSync + 1
    Loop

    ' Afhaalpunt-alternatieven-snapshot (kolom AB=27) bijwerken naar AA=26,
    ' onafhankelijk van aKIdx (self-contained binnen klanten_beheer zelf) —
    ' zo herkent de volgende run een teruggedraaide alternatieven-waarde weer.
    Dim rSyncAlt As Integer : rSyncAlt = 1
    Do While rSyncAlt <= nTotaal
        If bGewijzigd(rSyncAlt) Then
            oKB.getCellByPosition(27, rSyncAlt).setString(oKB.getCellByPosition(26, rSyncAlt).getString())
        End If
        rSyncAlt = rSyncAlt + 1
    Loop

    MsgBox nUpdates & " klant(en) bijgewerkt in postgres.", 64, "Klaar"
    SluitSSHTunnels()
    Exit Sub

VerbindingsFout2:
    MsgBox "Verbindingsfout: " & Err & " - " & Error & Chr(10) & _
           "Controleer of de SSH-tunnel actief is (poort 5433).", 16, "Fout"
    SluitSSHTunnels()
End Sub

' =============================================
' Helper: LibreOffice datumcel → SQL-string 'YYYY-MM-DD' of NULL
' =============================================
Function SqlDateCell(oCell As Object) As String
    If oCell.getType() = 0 Then
        SqlDateCell = "NULL"
    ElseIf oCell.getType() = 1 Then
        Dim dBase As Date : dBase = CDate("1899-12-30")
        Dim dResult As Date : dResult = dBase + CLng(oCell.getValue())
        SqlDateCell = "'" & Format(dResult, "YYYY-MM-DD") & "'"
    Else
        Dim s As String : s = Trim(oCell.getString())
        If s = "" Then
            SqlDateCell = "NULL"
        Else
            SqlDateCell = "'" & Replace(s, "'", "''") & "'"
        End If
    End If
End Function

' =============================================
' Kiemkracht - Nieuwe klant toevoegen
' Leest gegevens uit tabblad "klant_nieuw" G7:G32
' en voegt een rij in in de postgres-tabel klanten.
' =============================================
Sub VoegNieuweKlantToe()

    Dim oDoc As Object
    oDoc = HuidigDataDocument()
    If IsNull(oDoc) Then
        MsgBox "Geen kiemkracht-data-bestand actief. Open kiemkracht-data.ods " & _
               "of kiemkracht-data-dev.ods en start de macro vanuit dat venster.", 16, "Fout"
        Exit Sub
    End If
    If Not oDoc.Sheets.hasByName("klant_nieuw") Then
        MsgBox "Tabblad 'klant_nieuw' niet gevonden.", 16, "Fout"
        Exit Sub
    End If
    Dim oSheet As Object : oSheet = oDoc.Sheets.getByName("klant_nieuw")

    Const COL_G = 6  ' kolom G = index 6

    ' Rij 7 (index 6) = id → overgeslagen (auto-increment)
    Dim sVoornaam      As String : sVoornaam      = Trim(oSheet.getCellByPosition(COL_G,  7).getString())
    Dim sFamilienaam   As String : sFamilienaam   = Trim(oSheet.getCellByPosition(COL_G,  8).getString())
    Dim sAanspreking   As String : sAanspreking   = Trim(oSheet.getCellByPosition(COL_G,  9).getString())
    Dim sKlantType     As String : sKlantType     = Trim(oSheet.getCellByPosition(COL_G, 10).getString())
    Dim sBedrijfsnaam  As String : sBedrijfsnaam  = Trim(oSheet.getCellByPosition(COL_G, 11).getString())
    Dim sBtwNummer     As String : sBtwNummer     = Trim(oSheet.getCellByPosition(COL_G, 12).getString())
    Dim sFactAdres     As String : sFactAdres     = Trim(oSheet.getCellByPosition(COL_G, 13).getString())
    Dim sEmail1        As String : sEmail1        = Trim(oSheet.getCellByPosition(COL_G, 14).getString())
    Dim sEmail2        As String : sEmail2        = Trim(oSheet.getCellByPosition(COL_G, 15).getString())
    Dim sEmail3        As String : sEmail3        = Trim(oSheet.getCellByPosition(COL_G, 16).getString())
    Dim sEmail4        As String : sEmail4        = Trim(oSheet.getCellByPosition(COL_G, 17).getString())
    Dim sTelefoon      As String : sTelefoon      = Trim(oSheet.getCellByPosition(COL_G, 18).getString())
    Dim sType          As String : sType          = Trim(oSheet.getCellByPosition(COL_G, 19).getString())
    Dim sFormaat       As String : sFormaat       = Trim(oSheet.getCellByPosition(COL_G, 20).getString())
    Dim sAfhaalpuntId  As String : sAfhaalpuntId  = Trim(oSheet.getCellByPosition(COL_G, 21).getString())
    Dim sNooitGroenten As String : sNooitGroenten = Trim(oSheet.getCellByPosition(COL_G, 22).getString())
    ' Rij 24-25 = datumvelden (type VALUE als celdatum, TEXT als tekst)
    Dim sKlantSindsSql  As String : sKlantSindsSql  = SqlDateCell(oSheet.getCellByPosition(COL_G, 23))
    ' Klant_sinds leeg gelaten? Vul automatisch met vandaag (formaat YYYY-MM-DD).
    If sKlantSindsSql = "NULL" Then
        sKlantSindsSql = "'" & Format(Now(), "YYYY-MM-DD") & "'"
    End If
    Dim sLaatsteBestSql As String : sLaatsteBestSql = SqlDateCell(oSheet.getCellByPosition(COL_G, 24))
    Dim sOpmerkingen   As String : sOpmerkingen   = Trim(oSheet.getCellByPosition(COL_G, 25).getString())
    Dim sOpmerkVolg    As String : sOpmerkVolg    = Trim(oSheet.getCellByPosition(COL_G, 26).getString())
    Dim sOpmerkStat    As String : sOpmerkStat    = Trim(oSheet.getCellByPosition(COL_G, 27).getString())
    ' Rij 29-30 (index 28-29) = aangemaakt_op / gewijzigd_op → overgeslagen (DEFAULT now())
    Dim sVoornaam2     As String : sVoornaam2     = Trim(oSheet.getCellByPosition(COL_G, 30).getString())
    Dim sFamilienaam2  As String : sFamilienaam2  = Trim(oSheet.getCellByPosition(COL_G, 31).getString())

    ' Verplichte velden
    If sVoornaam = "" Then
        MsgBox "Voornaam is verplicht (G8).", 16, "Validatiefout"
        Exit Sub
    End If
    If sType = "" Then
        MsgBox "Type is verplicht (G20): bv. 'abonnee', 'weekperweek', 'stop-definitief'.", 16, "Validatiefout"
        Exit Sub
    End If
    ' Formaat verplicht voor abonnees: anders krijgt de klant in het weekbestand
    ' geen pakket toegewezen ('CASE k.formaat WHEN ... ELSE ""' in MaakWeekbestand)
    ' en toont haar landingspagina-melding 'klein' bij gebrek aan beter (fallback
    ' op de frontend). Liever menselijk laten kiezen dan stilletjes default zetten.
    Dim sTypeLC As String : sTypeLC = LCase(sType)
    Dim bIsAbonnee As Boolean
    bIsAbonnee = (sTypeLC = "abonnee" Or Left(sTypeLC, 8) = "abonnee-")
    If bIsAbonnee And sFormaat = "" Then
        MsgBox "Formaat is verplicht voor een abonnee (G21):" & Chr(10) & _
               "kies 'klein', 'groot', 'extra-groot' of 'mini'.", 16, "Validatiefout"
        Exit Sub
    End If
    If sAanspreking = "" Then sAanspreking = "jouw"
    If sKlantType   = "" Then sKlantType   = "particulier"

    ' Relatie-status (klant-niveau) afleiden uit het type.
    Dim sStatusKlant As String
    Select Case sTypeLC
        Case "stop-tijdelijk"  : sStatusKlant = "gepauzeerd"
        Case "stop-definitief" : sStatusKlant = "gestopt"
        Case "on_hold"         : sStatusKlant = "on_hold"
        Case Else              : sStatusKlant = "actief"   ' abonnee* / weekperweek*
    End Select

    ' afhaalpunt_id: integer of NULL
    Dim sAfhaalpuntSql As String
    If sAfhaalpuntId = "" Then
        sAfhaalpuntSql = "NULL"
    Else
        On Error GoTo AfhaalpuntFout
        sAfhaalpuntSql = CStr(CLng(sAfhaalpuntId))
        On Error GoTo 0
    End If

    ' Bevestiging
    Dim sInfo As String
    sInfo = "Naam:   " & sVoornaam & " " & sFamilienaam & Chr(10) & _
            "Email:  " & sEmail1 & Chr(10) & _
            "Type:   " & sType & " / " & sKlantType
    If MsgBox("Nieuwe klant toevoegen?" & Chr(10) & Chr(10) & sInfo, 33, "Bevestig") <> 1 Then
        Exit Sub
    End If

    On Error GoTo VerbindingsFout3
    Dim oConn As Object
    oConn = MaakDBVerbinding()
    Dim oStmt As Object : oStmt = oConn.createStatement()

    Dim sSQL As String
    sSQL = "INSERT INTO klanten " & _
           "(voornaam, familienaam, aanspreking, klant_type, bedrijfsnaam, btw_nummer, " & _
           "facturatie_adres, email1, email2, email3, email4, telefoon, type, formaat, status, " & _
           "afhaalpunt_id, nooit_groenten, klant_sinds, laatste_bestelling, " & _
           "opmerkingen, opmerkingen_volgend, opmerking_status, voornaam2, familienaam2) " & _
           "VALUES (" & _
           SqlStr(sVoornaam)      & ", " & SqlStr(sFamilienaam)  & ", " & SqlStr(sAanspreking) & ", " & _
           SqlStr(sKlantType)     & ", " & SqlStr(sBedrijfsnaam) & ", " & SqlStr(sBtwNummer)   & ", " & _
           SqlStr(sFactAdres)     & ", " & SqlStr(sEmail1)       & ", " & SqlStr(sEmail2)       & ", " & _
           SqlStr(sEmail3)        & ", " & SqlStr(sEmail4)       & ", " & SqlStr(sTelefoon)     & ", " & _
           SqlStr(sType)          & ", " & SqlStr(sFormaat)      & ", '" & sStatusKlant & "', " & _
           sAfhaalpuntSql         & ", " & SqlStr(sNooitGroenten) & ", " & _
           sKlantSindsSql         & ", " & sLaatsteBestSql        & ", " & _
           SqlStr(sOpmerkingen)   & ", " & SqlStr(sOpmerkVolg)   & ", " & SqlStr(sOpmerkStat)  & ", " & _
           SqlStr(sVoornaam2)     & ", " & SqlStr(sFamilienaam2) & _
           ") RETURNING id"

    ' RETURNING id zodat we meteen het primaire abonnement kunnen aanmaken.
    Dim oRSNew As Object : oRSNew = oStmt.executeQuery(sSQL)
    Dim nNewId As Long : nNewId = 0
    If oRSNew.next() Then nNewId = CLng(oRSNew.getString(1))
    oRSNew.close()

    ' Primair abonnement voor een nieuwe abonnee (formaat is hierboven verplicht gesteld).
    If bIsAbonnee And nNewId > 0 And _
       (sFormaat = "klein" Or sFormaat = "groot" Or sFormaat = "extra-groot" Or sFormaat = "mini") Then
        Dim sRitmeNw As String, sStatusNw As String
        If InStr(sTypeLC, "onpare-week") > 0 Then
            sRitmeNw = "onpare-week"
        ElseIf InStr(sTypeLC, "pare-week") > 0 Then
            sRitmeNw = "pare-week"
        Else
            sRitmeNw = "wekelijks"
        End If
        If InStr(sTypeLC, "-toekomst") > 0 Then sStatusNw = "toekomst" Else sStatusNw = "actief"
        oStmt.executeUpdate("INSERT INTO abonnementen " & _
            "(klant_id, ritme, formaat, status, bron) VALUES (" & _
            CStr(nNewId) & ", '" & sRitmeNw & "', '" & sFormaat & "', '" & sStatusNw & "', 'primair')")
    End If

    oStmt.close()
    oConn.close()
    SluitSSHTunnels()

    MsgBox "Klant '" & sVoornaam & " " & sFamilienaam & "' succesvol toegevoegd.", 64, "Klaar"

    ' Invoervelden leegmaken
    Dim iRij As Integer
    For iRij = 7 To 31
        oSheet.getCellByPosition(COL_G, iRij).setString("")
    Next iRij

    Exit Sub

AfhaalpuntFout:
    MsgBox "Afhaalpunt_id (G22) moet een geheel getal zijn of leeg.", 16, "Validatiefout"
    Exit Sub

VerbindingsFout3:
    MsgBox "Databasefout: " & Err & " - " & Error, 16, "Fout"
    SluitSSHTunnels()

End Sub

' =============================================
' Helper: ISO-weeknummer (1-53) van een datum.
' =============================================
Function ISOWeek(d As Date) As Integer
    ' Donderdag van de week waarin d valt (WeekDay type 2: ma=1 .. zo=7)
    Dim dThu As Date : dThu = d - (WeekDay(d, 2) - 1) + 3
    Dim dJan1 As Date : dJan1 = DateSerial(Year(dThu), 1, 1)
    ' Dagen van 1 januari tot de eerste donderdag van dat jaar
    Dim iOffset As Integer : iOffset = (4 - WeekDay(dJan1, 2) + 7) Mod 7
    Dim dEersteDo As Date : dEersteDo = dJan1 + iOffset
    ISOWeek = (dThu - dEersteDo) \ 7 + 1
End Function

' =============================================
' Helper: donderdag-datum van het eerstvolgende voorkomen
' van ISO-weeknummer iWeek, gerekend vanaf vandaag.
' Geeft 0 als het weeknummer niet gevonden wordt.
' =============================================
Function WeekNaarDonderdag(iWeek As Integer) As Date
    Dim dToday As Date : dToday = Date
    Dim dThuNu As Date : dThuNu = dToday - (WeekDay(dToday, 2) - 1) + 3
    Dim n As Integer
    For n = 0 To 60
        Dim dCand As Date : dCand = dThuNu + 7 * n
        If ISOWeek(dCand) = iWeek Then
            WeekNaarDonderdag = dCand
            Exit Function
        End If
    Next n
    WeekNaarDonderdag = 0
End Function

' =============================================
' Helper: parseert weekinvoer "W22-W24, W26" naar een
' CSV-string van weeknummers "22,23,24,26".
'   bEnkel = True  -> slechts één week toegelaten (stop/start)
' Lege invoer -> "". Bij een fout -> "" en sFout ingevuld.
' =============================================
' Parseert week-met-optioneel-formaat invoer voor vooruitbestellingen.
' Syntax: "W22-W24:groot, W26:klein, W28" (W is optioneel, hoofdletter
' ongevoelig, spaties genegeerd). Formaat per week optioneel — zonder
' ":formaat" blijft de overeenkomstige slot in sFormatenCsv leeg, waarna
' de caller terugvalt op klant.formaat.
'
' ByRef-resultaten zijn parallelle CSV's:
'   sWekenCsv     = "22,23,24,26,28"
'   sFormatenCsv  = "groot,groot,groot,klein,"        (leeg = default)
'
' Returnt True bij succes, False bij fout (sFout krijgt dan een
' leesbare boodschap).
Function ParseerWekenMetFormaat(sInvoer As String, _
                                 ByRef sWekenCsv As String, _
                                 ByRef sFormatenCsv As String, _
                                 ByRef sFout As String) As Boolean
    sFout = ""
    sWekenCsv = ""
    sFormatenCsv = ""
    Dim s As String : s = Trim(sInvoer)
    If s = "" Then
        ParseerWekenMetFormaat = True
        Exit Function
    End If
    s = Replace(s, " ", "")

    Dim aDelen() As String : aDelen = Split(s, ",")
    Dim i As Integer
    For i = 0 To UBound(aDelen)
        Dim sDeel As String : sDeel = aDelen(i)
        If sDeel <> "" Then
            ' Splits op ":" — formaat optioneel
            Dim sWeekDeel As String, sFormaat As String
            Dim iColon As Integer : iColon = InStr(sDeel, ":")
            If iColon > 0 Then
                sWeekDeel = Left(sDeel, iColon - 1)
                sFormaat  = LCase(Mid(sDeel, iColon + 1))
                If sFormaat <> "klein" And sFormaat <> "groot" _
                   And sFormaat <> "extra-groot" And sFormaat <> "mini" Then
                    sFout = "ongeldig formaat '" & sFormaat & _
                            "' (klein/groot/extra-groot/mini)"
                    ParseerWekenMetFormaat = False : Exit Function
                End If
            Else
                sWeekDeel = sDeel
                sFormaat  = ""
            End If

            sWeekDeel = Replace(sWeekDeel, "W", "")
            sWeekDeel = Replace(sWeekDeel, "w", "")

            If InStr(sWeekDeel, "-") > 0 Then
                Dim aR() As String : aR = Split(sWeekDeel, "-")
                If UBound(aR) <> 1 Or Not IsNumeric(aR(0)) Or Not IsNumeric(aR(1)) Then
                    sFout = "ongeldig bereik '" & sWeekDeel & "'"
                    ParseerWekenMetFormaat = False : Exit Function
                End If
                Dim wVan As Integer : wVan = CInt(aR(0))
                Dim wTot As Integer : wTot = CInt(aR(1))
                If wVan < 1 Or wVan > 53 Or wTot < 1 Or wTot > 53 Then
                    sFout = "weeknummer buiten 1-53 in '" & sWeekDeel & "'"
                    ParseerWekenMetFormaat = False : Exit Function
                End If
                If wTot < wVan Then
                    sFout = "bereik '" & sWeekDeel & "' loopt over een jaargrens — splits het op"
                    ParseerWekenMetFormaat = False : Exit Function
                End If
                Dim w As Integer
                For w = wVan To wTot
                    If sWekenCsv <> "" Then
                        sWekenCsv    = sWekenCsv    & ","
                        sFormatenCsv = sFormatenCsv & ","
                    End If
                    sWekenCsv    = sWekenCsv    & CStr(w)
                    sFormatenCsv = sFormatenCsv & sFormaat
                Next w
            Else
                If Not IsNumeric(sWeekDeel) Then
                    sFout = "ongeldig weeknummer '" & sWeekDeel & "'"
                    ParseerWekenMetFormaat = False : Exit Function
                End If
                Dim wE As Integer : wE = CInt(sWeekDeel)
                If wE < 1 Or wE > 53 Then
                    sFout = "weeknummer buiten 1-53: '" & sWeekDeel & "'"
                    ParseerWekenMetFormaat = False : Exit Function
                End If
                If sWekenCsv <> "" Then
                    sWekenCsv    = sWekenCsv    & ","
                    sFormatenCsv = sFormatenCsv & ","
                End If
                sWekenCsv    = sWekenCsv    & CStr(wE)
                sFormatenCsv = sFormatenCsv & sFormaat
            End If
        End If
    Next i

    ParseerWekenMetFormaat = True
End Function

Function ParseerWeken(sInvoer As String, bEnkel As Boolean, ByRef sFout As String) As String
    sFout = ""
    Dim s As String : s = Trim(sInvoer)
    If s = "" Then
        ParseerWeken = ""
        Exit Function
    End If
    s = Replace(s, "W", "")
    s = Replace(s, "w", "")
    s = Replace(s, " ", "")

    Dim aDelen() As String : aDelen = Split(s, ",")
    If bEnkel And UBound(aDelen) > 0 Then
        sFout = "hier mag maar één week staan"
        ParseerWeken = ""
        Exit Function
    End If

    Dim sResult As String : sResult = ""
    Dim i As Integer
    For i = 0 To UBound(aDelen)
        Dim sDeel As String : sDeel = aDelen(i)
        If sDeel = "" Then
            ' lege sectie (dubbele komma) negeren
        ElseIf InStr(sDeel, "-") > 0 Then
            If bEnkel Then
                sFout = "hier mag geen bereik staan"
                ParseerWeken = "" : Exit Function
            End If
            Dim aR() As String : aR = Split(sDeel, "-")
            If UBound(aR) <> 1 Or Not IsNumeric(aR(0)) Or Not IsNumeric(aR(1)) Then
                sFout = "ongeldig bereik '" & sDeel & "'"
                ParseerWeken = "" : Exit Function
            End If
            Dim wVan As Integer : wVan = CInt(aR(0))
            Dim wTot As Integer : wTot = CInt(aR(1))
            If wVan < 1 Or wVan > 53 Or wTot < 1 Or wTot > 53 Then
                sFout = "weeknummer buiten 1-53 in '" & sDeel & "'"
                ParseerWeken = "" : Exit Function
            End If
            If wTot < wVan Then
                sFout = "bereik '" & sDeel & "' loopt over een jaargrens — splits het op"
                ParseerWeken = "" : Exit Function
            End If
            Dim w As Integer
            For w = wVan To wTot
                If sResult <> "" Then sResult = sResult & ","
                sResult = sResult & CStr(w)
            Next w
        Else
            If Not IsNumeric(sDeel) Then
                sFout = "ongeldig weeknummer '" & sDeel & "'"
                ParseerWeken = "" : Exit Function
            End If
            Dim wE As Integer : wE = CInt(sDeel)
            If wE < 1 Or wE > 53 Then
                sFout = "weeknummer buiten 1-53: '" & sDeel & "'"
                ParseerWeken = "" : Exit Function
            End If
            If sResult <> "" Then sResult = sResult & ","
            sResult = sResult & CStr(wE)
        End If
    Next i
    ParseerWeken = sResult
End Function

' =============================================
' Kiemkracht - Annulaties / stopzetting / vooruitbestellingen
'               / abonnementstart verwerken
' Tabblad "klanten_stop_start":
'   - kolommen A-P : formules met klantgegevens, één rij per klant
'                    (rij 1 = weeklegende, rij 2 = kolomhoofden, data vanaf rij 7)
'   - één kolom in A-P heeft de kop "klant_id"
'   - kolom Q = annulaties           (tekst, bv. "W22-W24, W26")
'   - kolom R = stopzetting          (één week,  bv. "W30")
'   - kolom S = stop-doel            (definitief / tijdelijk / weekperweek;
'               leeg = definitief — header-gedetecteerd op kop "stop-doel")
'   - kolom T = herstart-week        (één week; verplicht bij doel=tijdelijk,
'               optioneel bij doel=weekperweek (klant wordt dan in die week weer
'               abonnee); header-gedetecteerd op kop "herstart-week")
'   - kolom U = vooruitbestellingen  (tekst, bv. "W22-W24:groot, W26:klein, W28")
'               Formaat per week optioneel (na ":"); zonder formaat valt
'               het terug op klant.formaat. Geldige formaten: klein /
'               groot / extra-groot / mini.
'   - kolom V = start abonnement     (één week,  bv. "W38")
'   - kolom W = abonnementstype      (verplicht bij een start: abonnee /
'               abonnee-pare-week / abonnee-onpare-week)
'   - kolom X = formaat              (verplicht bij een start: klein /
'               groot / extra-groot / mini)
' INSERT't in postgres-tabellen annulaties / vooruitbestellingen, en zet voor
' stop/pauze/downgrade de abonnement-eind + klanten-pauzewindow (zie stop-tak).
' Bij een start zet de macro de klant bovendien op een toekomst-
' abonneetype (klanten.type = '<W>-toekomst', formaat = '<X>'); een
' VPS-cron schakelt dat op de startweek om naar het echte type.
' Bestaande (klant_id, jaar, week) worden overgeslagen; de verwerkte
' cellen Q-X worden daarna leeggemaakt.
' Elke rij die deze macro in annulaties/vooruitbestellingen schrijft krijgt
' bron = 'macro' (kolom bron, migraties 23/24: formulier = klant via het
' bestelformulier, macro = hier, admin = klantfiche).
' =============================================
Sub VerwerkStopStart()

    Const COL_ANN   = 16   ' Q
    Const COL_STOP  = 17   ' R
    Const COL_VB    = 20   ' U (na invoegen van stop-doel/herstart-week op S/T)
    Const COL_START = 21   ' V
    Const COL_TYPE  = 22   ' W
    Const COL_FORMAAT = 23 ' X
    Const DATA_RIJ0 = 6    ' rij 7 = eerste datarij
    Const MAX_RIJ   = 1000
    Const MAX_ITEM  = 12000

    Dim oDoc As Object
    oDoc = HuidigDataDocument()
    If IsNull(oDoc) Then
        MsgBox "Geen kiemkracht-data-bestand actief. Open kiemkracht-data.ods " & _
               "of kiemkracht-data-dev.ods en start de macro vanuit dat venster.", 16, "Fout"
        Exit Sub
    End If
    If Not oDoc.Sheets.hasByName("klanten_stop_start") Then
        MsgBox "Tabblad 'klanten_stop_start' niet gevonden.", 16, "Fout"
        Exit Sub
    End If
    Dim oSheet As Object : oSheet = oDoc.Sheets.getByName("klanten_stop_start")

    ' --- klant_id-kolom zoeken in de kophoek (rij 1 of 2, kolom A-P) ---
    Dim iIdCol As Integer : iIdCol = -1
    Dim hr As Integer, hc As Integer
    For hr = 0 To 1
        For hc = 0 To 15
            If LCase(Trim(oSheet.getCellByPosition(hc, hr).getString())) = "klant_id" Then
                iIdCol = hc
            End If
        Next hc
    Next hr
    If iIdCol = -1 Then
        MsgBox "Geen kolom met de kop 'klant_id' gevonden in A-P (rij 1 of 2)." & Chr(10) & _
               "Geef één van je formulekolommen die kop.", 16, "Fout"
        Exit Sub
    End If

    ' --- optionele kolommen 'stop-doel' en 'herstart-week' (header-gedetecteerd) ---
    Dim iDoelCol As Integer : iDoelCol = -1
    Dim iHerstartCol As Integer : iHerstartCol = -1
    Dim hdr As Integer, hdc As Integer, sHdr As String
    For hdr = 0 To 5
        For hdc = 0 To 40
            sHdr = LCase(Trim(oSheet.getCellByPosition(hdc, hdr).getString()))
            If sHdr = "stop-doel" Then iDoelCol = hdc
            If sHdr = "herstart-week" Or sHdr = "herstart" Then iHerstartCol = hdc
        Next hdc
    Next hdr

    ' === Fase 1: invoerrijen verzamelen en parseren ===
    Dim riRij(MAX_RIJ)   As Integer
    Dim riKlant(MAX_RIJ) As Long
    Dim riAnn(MAX_RIJ)   As String
    Dim riStop(MAX_RIJ)  As Integer
    Dim riVb(MAX_RIJ)    As String      ' CSV met weken (bv. "22,23,24,26")
    Dim riVbFmt(MAX_RIJ) As String      ' CSV met formaten parallel aan riVb (lege slot = klant.formaat)
    Dim riStart(MAX_RIJ) As Integer
    Dim riType(MAX_RIJ)  As String
    Dim riFmt(MAX_RIJ)   As String
    Dim riDoel(MAX_RIJ)     As String    ' '' / definitief / tijdelijk / weekperweek
    Dim riHerstart(MAX_RIJ) As Integer   ' herstart-week (enkel bij doel=tijdelijk)
    Dim nRij As Integer : nRij = 0

    Dim r As Integer
    For r = DATA_RIJ0 To DATA_RIJ0 + MAX_RIJ - 1
        Dim sAnn   As String : sAnn   = Trim(oSheet.getCellByPosition(COL_ANN,   r).getString())
        Dim sStop  As String : sStop  = Trim(oSheet.getCellByPosition(COL_STOP,  r).getString())
        Dim sVb    As String : sVb    = Trim(oSheet.getCellByPosition(COL_VB,    r).getString())
        Dim sStart As String : sStart = Trim(oSheet.getCellByPosition(COL_START, r).getString())
        Dim sDoel As String : sDoel = ""
        If iDoelCol >= 0 Then sDoel = LCase(Trim(oSheet.getCellByPosition(iDoelCol, r).getString()))
        Dim sHerstart As String : sHerstart = ""
        If iHerstartCol >= 0 Then sHerstart = Trim(oSheet.getCellByPosition(iHerstartCol, r).getString())

        If sAnn <> "" Or sStop <> "" Or sVb <> "" Or sStart <> "" Then
            Dim dKlant As Double : dKlant = oSheet.getCellByPosition(iIdCol, r).getValue()
            If dKlant < 1 Then
                MsgBox "Rij " & (r + 1) & ": er staat invoer in Q-T maar geen geldig klant_id." & Chr(10) & _
                       "Controleer of je in de juiste rij staat.", 16, "Fout"
                Exit Sub
            End If

            Dim sFout As String
            Dim sAnnCsv   As String : sAnnCsv   = ParseerWeken(sAnn, False, sFout)
            If sFout <> "" Then
                MsgBox "Rij " & (r + 1) & ", kolom Q (annulaties): " & sFout, 16, "Fout"
                Exit Sub
            End If
            Dim sVbCsv As String, sVbFmtCsv As String
            If Not ParseerWekenMetFormaat(sVb, sVbCsv, sVbFmtCsv, sFout) Then
                MsgBox "Rij " & (r + 1) & ", kolom S (vooruitbestellingen): " & sFout, 16, "Fout"
                Exit Sub
            End If
            Dim sStopCsv  As String : sStopCsv  = ParseerWeken(sStop, True, sFout)
            If sFout <> "" Then
                MsgBox "Rij " & (r + 1) & ", kolom R (stopzetting): " & sFout, 16, "Fout"
                Exit Sub
            End If
            Dim sStartCsv As String : sStartCsv = ParseerWeken(sStart, True, sFout)
            If sFout <> "" Then
                MsgBox "Rij " & (r + 1) & ", kolom T (start abonnement): " & sFout, 16, "Fout"
                Exit Sub
            End If

            ' Kolom U (abonnementstype) en V (formaat): verplicht bij een start
            Dim sTypeIn As String : sTypeIn = Trim(oSheet.getCellByPosition(COL_TYPE,    r).getString())
            Dim sFmtIn  As String : sFmtIn  = Trim(oSheet.getCellByPosition(COL_FORMAAT, r).getString())
            If sStart <> "" Then
                If sTypeIn <> "abonnee" And sTypeIn <> "abonnee-pare-week" _
                   And sTypeIn <> "abonnee-onpare-week" Then
                    MsgBox "Rij " & (r + 1) & ", kolom U: een startweek vereist een geldig " & _
                           "abonnementstype:" & Chr(10) & _
                           "abonnee / abonnee-pare-week / abonnee-onpare-week.", 16, "Fout"
                    Exit Sub
                End If
                If sFmtIn <> "klein" And sFmtIn <> "groot" _
                   And sFmtIn <> "extra-groot" And sFmtIn <> "mini" Then
                    MsgBox "Rij " & (r + 1) & ", kolom V: een startweek vereist een geldig " & _
                           "formaat:" & Chr(10) & "klein / groot / extra-groot / mini.", 16, "Fout"
                    Exit Sub
                End If
            ElseIf sTypeIn <> "" Or sFmtIn <> "" Then
                MsgBox "Rij " & (r + 1) & ": type/formaat (kolom U/V) horen bij een " & _
                       "startweek in kolom T. Vul de startweek aan of maak U/V leeg.", 16, "Fout"
                Exit Sub
            End If

            ' Kolom stop-doel / herstart-week: enkel geldig bij een stopweek (kolom R)
            Dim sDoelN As String : sDoelN = sDoel
            Dim iHerstartN As Integer : iHerstartN = 0
            If sStop <> "" Then
                If sDoelN = "" Then sDoelN = "definitief"
                If sDoelN <> "definitief" And sDoelN <> "tijdelijk" And sDoelN <> "weekperweek" Then
                    MsgBox "Rij " & (r + 1) & ", stop-doel: ongeldig doel '" & sDoel & "'." & Chr(10) & _
                           "Gebruik: definitief / tijdelijk / weekperweek (of leeg = definitief).", 16, "Fout"
                    Exit Sub
                End If
                If sDoelN = "tijdelijk" Then
                    ' Herstart-week optioneel: leeg = tijdelijk stoppen zonder afgesproken
                    ' herstart -> open pauze + opvolgdatum ~2 maanden na de stopweek
                    ' (digest-mail via pauze-herinnering.php + macro ToonOpvolgingen).
                    If sHerstart <> "" Then
                        Dim sHerCsv As String : sHerCsv = ParseerWeken(sHerstart, True, sFout)
                        If sFout <> "" Or sHerCsv = "" Then
                            MsgBox "Rij " & (r + 1) & ": ongeldige herstart-week bij doel 'tijdelijk'.", 16, "Fout"
                            Exit Sub
                        End If
                        iHerstartN = CInt(sHerCsv)
                    End If
                ElseIf sDoelN = "weekperweek" And sHerstart <> "" Then
                    ' weekperweek met optionele herstart-week: klant wordt in die week weer
                    ' volwaardig abonnee; de mail-poort blijft open in de tussentijd (aanbod-los).
                    sHerCsv = ParseerWeken(sHerstart, True, sFout)
                    If sFout <> "" Or sHerCsv = "" Then
                        MsgBox "Rij " & (r + 1) & ": ongeldige herstart-week bij doel 'weekperweek'.", 16, "Fout"
                        Exit Sub
                    End If
                    iHerstartN = CInt(sHerCsv)
                ElseIf sDoelN = "definitief" And sHerstart <> "" Then
                    MsgBox "Rij " & (r + 1) & ": een herstart-week hoort niet bij doel 'definitief'.", 16, "Fout"
                    Exit Sub
                End If
            ElseIf sDoel <> "" Or sHerstart <> "" Then
                MsgBox "Rij " & (r + 1) & ": stop-doel/herstart-week horen bij een stopweek in kolom R.", 16, "Fout"
                Exit Sub
            End If

            riRij(nRij)   = r
            riKlant(nRij) = CLng(dKlant)
            riAnn(nRij)   = sAnnCsv
            riVb(nRij)    = sVbCsv
            riVbFmt(nRij) = sVbFmtCsv
            riType(nRij)  = sTypeIn
            riFmt(nRij)   = sFmtIn
            riDoel(nRij)     = sDoelN
            riHerstart(nRij) = iHerstartN
            If sStopCsv  = "" Then riStop(nRij)  = 0 Else riStop(nRij)  = CInt(sStopCsv)
            If sStartCsv = "" Then riStart(nRij) = 0 Else riStart(nRij) = CInt(sStartCsv)
            nRij = nRij + 1
        End If
    Next r

    If nRij = 0 Then
        MsgBox "Geen invoer gevonden in de kolommen Q-T.", 64, "VerwerkStopStart"
        Exit Sub
    End If

    ' === Fase 2: DB-verbinding + klantgegevens + bestaande records ===
    On Error GoTo VerbindingsFoutSS
    Dim oConn As Object
    oConn = MaakDBVerbinding()
    On Error GoTo 0

    Dim oStmt As Object, oRS As Object

    Dim klId(5000)      As Long
    Dim klVn(5000)      As String
    Dim klVn2(5000)     As String
    Dim klFn(5000)      As String
    Dim klMail(5000)    As String
    Dim klFormaat(5000) As String
    Dim nKl As Integer : nKl = 0
    oStmt = oConn.createStatement()
    oRS = oStmt.executeQuery("SELECT id, voornaam, familienaam, email1, formaat, COALESCE(voornaam2,'') FROM klanten")
    Do While oRS.next()
        klId(nKl)      = CLng(oRS.getString(1))
        klVn(nKl)      = oRS.getString(2)
        klFn(nKl)      = oRS.getString(3)
        klMail(nKl)    = oRS.getString(4)
        klFormaat(nKl) = oRS.getString(5)
        klVn2(nKl)     = oRS.getString(6)
        nKl = nKl + 1
    Loop
    oRS.close() : oStmt.close()

    ' Bestaande (klant_id, jaar, week) als doorzoekbare sleutelreeksen
    Dim sBestAnn As String : sBestAnn = "|"
    oStmt = oConn.createStatement()
    oRS = oStmt.executeQuery("SELECT klant_id, jaar, week_annulatie FROM annulaties " & _
                             "WHERE klant_id IS NOT NULL AND week_annulatie IS NOT NULL")
    Do While oRS.next()
        sBestAnn = sBestAnn & oRS.getString(1) & "#" & oRS.getString(2) & "#" & oRS.getString(3) & "|"
    Loop
    oRS.close() : oStmt.close()

    Dim sBestVb As String : sBestVb = "|"
    oStmt = oConn.createStatement()
    oRS = oStmt.executeQuery("SELECT klant_id, jaar, week_bestelling FROM vooruitbestellingen " & _
                             "WHERE klant_id IS NOT NULL AND week_bestelling IS NOT NULL")
    Do While oRS.next()
        sBestVb = sBestVb & oRS.getString(1) & "#" & oRS.getString(2) & "#" & oRS.getString(3) & "|"
    Loop
    oRS.close() : oStmt.close()

    ' === Fase 3: INSERT-opdrachten opbouwen (jaar/datum berekenen, dubbels filteren) ===
    Dim aSql(MAX_ITEM) As String
    Dim nItem As Integer : nItem = 0
    Dim nAnn As Integer, nStopz As Integer, nVb As Integer, nStart As Integer, nDup As Integer
    Dim nOpvolg As Integer   ' tijdelijke stops zonder herstart-week (open pauze + opvolging)

    ' Mail-eligible records: parallel aan de INSERTs voor Q/R/S/T-kolommen.
    ' Worden later (optioneel, na bevestigingsdialoog) als HTTP-POST verstuurd.
    Dim mEmail(MAX_ITEM)    As String
    Dim mVoor(MAX_ITEM)     As String
    Dim mVoor2(MAX_ITEM)    As String
    Dim mKlantId(MAX_ITEM)  As Long
    Dim mWeek(MAX_ITEM)     As Integer
    Dim mType(MAX_ITEM)     As String    ' "annulatie" / "stopzetting" / "vooruitbestelling" / "abonnementsstart"
    Dim mFormaat(MAX_ITEM)  As String    ' enkel relevant voor vooruitbestelling/abonnementsstart
    Dim mDatum(MAX_ITEM)    As String    ' YYYY-MM-DD
    Dim mJaar(MAX_ITEM)     As Integer
    Dim mDoel(MAX_ITEM)     As String    ' stop-doel (enkel bij "stopzetting"): definitief/tijdelijk/weekperweek
    Dim mHerstartW(MAX_ITEM) As Integer  ' herstart-week (0 = geen) — stuurt de pauze-variant van de mail
    Dim mHerstartJ(MAX_ITEM) As Integer
    Dim nMail As Integer : nMail = 0

    Dim i As Integer, k As Integer, kIdx As Integer
    Dim aW() As String, wi As Integer, w As Integer
    Dim dDo As Date, iJaar As Integer
    Dim sSleutel As String, sDatum As String
    Dim sVnQ As String, sFnQ As String, sMailQ As String, sFmtQ As String, sKid As String

    For i = 0 To nRij - 1
        kIdx = -1
        For k = 0 To nKl - 1
            If klId(k) = riKlant(i) Then kIdx = k : Exit For
        Next k
        If kIdx = -1 Then
            oConn.close()
            SluitSSHTunnels()
            MsgBox "Rij " & (riRij(i) + 1) & ": klant_id " & riKlant(i) & _
                   " bestaat niet in de klanten-tabel.", 16, "Fout"
            Exit Sub
        End If

        sVnQ   = SqlStr(klVn(kIdx))
        sFnQ   = SqlStr(klFn(kIdx))
        sMailQ = SqlStr(klMail(kIdx))
        sFmtQ  = SqlStr(klFormaat(kIdx))
        sKid   = CStr(riKlant(i))

        ' --- annulaties (kolom Q) ---
        If riAnn(i) <> "" Then
            aW = Split(riAnn(i), ",")
            For wi = 0 To UBound(aW)
                w = CInt(aW(wi))
                dDo = WeekNaarDonderdag(w)
                iJaar = Year(dDo)
                sDatum = Format(dDo, "YYYY-MM-DD")
                sSleutel = sKid & "#" & iJaar & "#" & w
                If InStr(sBestAnn, "|" & sSleutel & "|") > 0 Then
                    nDup = nDup + 1
                Else
                    aSql(nItem) = "INSERT INTO annulaties " & _
                        "(voornaam, familienaam, klant_email, klant_id, datum, " & _
                        "week_annulatie, week_stopzetten_abonnement, jaar, bron) VALUES (" & _
                        sVnQ & ", " & sFnQ & ", " & sMailQ & ", " & sKid & ", '" & sDatum & "', " & _
                        w & ", NULL, " & iJaar & ", 'macro')"
                    nItem = nItem + 1
                    sBestAnn = sBestAnn & sSleutel & "|"
                    nAnn = nAnn + 1

                    ' Mail-eligible (alleen als klant een email1 heeft)
                    If klMail(kIdx) <> "" Then
                        mEmail(nMail)    = klMail(kIdx)
                        mVoor(nMail)     = klVn(kIdx)
                        mVoor2(nMail)    = klVn2(kIdx)
                        mKlantId(nMail)  = riKlant(i)
                        mWeek(nMail)     = w
                        mType(nMail)     = "annulatie"
                        mFormaat(nMail)  = ""
                        mDatum(nMail)    = sDatum
                        mJaar(nMail)     = iJaar
                        nMail = nMail + 1
                    End If
                End If
            Next wi
        End If

        ' --- stopzetting / pauze / downgrade (kolom R + stop-doel) ---
        If riStop(i) > 0 Then
            w = riStop(i)
            dDo = WeekNaarDonderdag(w)
            iJaar = Year(dDo)
            sDatum = Format(dDo, "YYYY-MM-DD")

            Dim sDoelI As String : sDoelI = riDoel(i)
            If sDoelI = "" Then sDoelI = "definitief"

            ' Herstart-week/-jaar vooraf berekenen (0/0 = geen afgesproken herstart) —
            ' nodig voor zowel de registratie-rij hieronder als de klanten/abonnementen-
            ' writes verderop.
            Dim hW As Integer : hW = riHerstart(i)
            Dim iHJaar As Integer : iHJaar = 0
            If hW > 0 Then
                Dim dHo As Date : dHo = WeekNaarDonderdag(hW)
                iHJaar = Year(dHo)
            End If

            ' Registratie-rij in annulaties: maakt de stop zichtbaar in het
            ' tabblad 'annulaties' van kiemkracht-data.ods (zoals de formulier-
            ' stop). week_stopzetten_abonnement ALLEEN bij definitief/tijdelijk-
            ' open — het Fase-0-mailmerge-vangnet sluit zo'n rij de rest van het
            ' jaar uit, en dat mag niet voor weekperweek of tijdelijk-met-herstart
            ' (die klanten moeten later weer aanbodsmails krijgen). De windows
            ' blijven de bron van waarheid; dedup via dezelfde sleutel als kolom Q.
            ' herstart_jaar/-week (migratie 17): zuiver documentair zodat de
            ' afgesproken hervatting zichtbaar is in dit tabblad — casus 2026-07-10
            ' (klant 3197) toonde enkel "29" zonder enig spoor van de herstart-week.
            Dim sStopzCol As String
            If sDoelI = "weekperweek" Or hW > 0 Then
                sStopzCol = "NULL"
            Else
                sStopzCol = CStr(w)
            End If
            Dim sHerstartColsN As String, sHerstartColsV As String
            If hW > 0 Then
                sHerstartColsN = ", herstart_jaar, herstart_week"
                sHerstartColsV = ", " & iHJaar & ", " & hW
            Else
                sHerstartColsN = "" : sHerstartColsV = ""
            End If
            sSleutel = sKid & "#" & iJaar & "#" & w
            If InStr(sBestAnn, "|" & sSleutel & "|") = 0 Then
                aSql(nItem) = "INSERT INTO annulaties " & _
                    "(voornaam, familienaam, klant_email, klant_id, datum, " & _
                    "week_annulatie, week_stopzetten_abonnement, jaar, stop_doel, bron" & sHerstartColsN & ") VALUES (" & _
                    sVnQ & ", " & sFnQ & ", " & sMailQ & ", " & sKid & ", '" & sDatum & "', " & _
                    w & ", " & sStopzCol & ", " & iJaar & ", '" & sDoelI & "', 'macro'" & sHerstartColsV & ")"
                nItem = nItem + 1
                sBestAnn = sBestAnn & sSleutel & "|"
            End If

            ' Levering-window sluiten: lopende primair-abonnementen eindigen op week w.
            aSql(nItem) = "UPDATE abonnementen SET eind_jaar = " & iJaar & ", eind_week = " & w & _
                ", gewijzigd_op = now() WHERE klant_id = " & sKid & " AND bron = 'primair' AND eind_jaar IS NULL"
            nItem = nItem + 1

            If sDoelI = "definitief" Then
                ' Relatie-poort dicht zonder einde => gestopt. Eventuele lopende
                ' opvolging (eerdere tijdelijke stop zonder herstart) vervalt.
                aSql(nItem) = "UPDATE klanten SET pauze_vanaf_jaar = " & iJaar & ", pauze_vanaf_week = " & w & _
                    ", pauze_tot_jaar = NULL, pauze_tot_week = NULL" & _
                    ", opvolg_datum = NULL, opvolg_gemaild_op = NULL WHERE id = " & sKid
                nItem = nItem + 1
            Else
                ' tijdelijk of weekperweek (met optionele herstart): hW/iHJaar
                ' zijn hierboven al berekend (0/0 = geen afgesproken herstart).
                If sDoelI = "tijdelijk" Then
                    If hW > 0 Then
                        ' Relatie-poort dicht met einde => gepauzeerd; opent weer in de herstart-week.
                        aSql(nItem) = "UPDATE klanten SET pauze_vanaf_jaar = " & iJaar & ", pauze_vanaf_week = " & w & _
                            ", pauze_tot_jaar = " & iHJaar & ", pauze_tot_week = " & hW & _
                            ", opvolg_datum = NULL, opvolg_gemaild_op = NULL WHERE id = " & sKid
                        nItem = nItem + 1
                    Else
                        ' Geen herstart-week: open pauze (gepauzeerd, poort dicht) +
                        ' opvolgdatum 2 maanden na de stopweek. De maandag-cron
                        ' (pauze-herinnering.php) mailt dan een digest naar Klaas en
                        ' ToonOpvolgingen toont de klant tot de opvolging afgevinkt is.
                        Dim sOpvolg As String
                        sOpvolg = Format(DateAdd("m", 2, dDo), "YYYY-MM-DD")
                        aSql(nItem) = "UPDATE klanten SET pauze_vanaf_jaar = " & iJaar & ", pauze_vanaf_week = " & w & _
                            ", pauze_tot_jaar = NULL, pauze_tot_week = NULL" & _
                            ", opvolg_datum = '" & sOpvolg & "', opvolg_gemaild_op = NULL WHERE id = " & sKid
                        nItem = nItem + 1
                        nOpvolg = nOpvolg + 1
                    End If
                Else
                    ' weekperweek: geen pauzewindow; klant blijft actief en krijgt aanbod-los.
                    ' klanten.type wordt door de cron op 'weekperweek' afgeleid zolang geen abonnement actief is.
                End If

                ' Opvolger-abonnement vanaf de herstart-week (zelfde ritme/formaat) — voor
                ' zowel tijdelijk als weekperweek-met-herstart. Zonder herstart-week (hW=0)
                ' gebeurt er niets extra (= blijvende weekperweek).
                If hW > 0 Then
                    aSql(nItem) = "INSERT INTO abonnementen (klant_id, ritme, formaat, status, bron, start_jaar, start_week) " & _
                        "SELECT " & sKid & ", a.ritme, a.formaat, 'actief', 'primair', " & iHJaar & ", " & hW & _
                        " FROM abonnementen a WHERE a.klant_id = " & sKid & " AND a.bron = 'primair' ORDER BY a.id DESC LIMIT 1"
                    nItem = nItem + 1
                End If
            End If

            nStopz = nStopz + 1

            ' Mail-eligible (stopzetting-bevestiging, alleen als klant een email1 heeft).
            ' Doel + herstart-week gaan mee zodat de mail de juiste variant kiest
            ' (pauze-met-herstart / weekperweek / tijdelijk-open / definitief) —
            ' let op: riDoel/riHerstart gebruiken, niet hW (stale over rijen heen).
            If klMail(kIdx) <> "" Then
                mEmail(nMail)    = klMail(kIdx)
                mVoor(nMail)     = klVn(kIdx)
                mVoor2(nMail)    = klVn2(kIdx)
                mKlantId(nMail)  = riKlant(i)
                mWeek(nMail)     = w
                mType(nMail)     = "stopzetting"
                mFormaat(nMail)  = ""
                mDatum(nMail)    = sDatum
                mJaar(nMail)     = iJaar
                mDoel(nMail)     = sDoelI
                If sDoelI <> "definitief" And riHerstart(i) > 0 Then
                    mHerstartW(nMail) = riHerstart(i)
                    mHerstartJ(nMail) = Year(WeekNaarDonderdag(riHerstart(i)))
                Else
                    mHerstartW(nMail) = 0
                    mHerstartJ(nMail) = 0
                End If
                nMail = nMail + 1
            End If
        End If

        ' --- vooruitbestellingen (kolom S) ---
        If riVb(i) <> "" Then
            aW = Split(riVb(i), ",")
            Dim aWFmt() As String : aWFmt = Split(riVbFmt(i), ",")
            For wi = 0 To UBound(aW)
                w = CInt(aW(wi))
                dDo = WeekNaarDonderdag(w)
                iJaar = Year(dDo)
                sDatum = Format(dDo, "YYYY-MM-DD")
                sSleutel = sKid & "#" & iJaar & "#" & w
                If InStr(sBestVb, "|" & sSleutel & "|") > 0 Then
                    nDup = nDup + 1
                Else
                    ' Formaat: per-week-keuze (kolom S na ":") of klant.formaat als fallback
                    Dim sFmtVoorWeek As String
                    sFmtVoorWeek = ""
                    If wi <= UBound(aWFmt) Then sFmtVoorWeek = aWFmt(wi)
                    If sFmtVoorWeek = "" Then sFmtVoorWeek = klFormaat(kIdx)
                    Dim sFmtVoorWeekQ As String : sFmtVoorWeekQ = SqlStr(sFmtVoorWeek)

                    aSql(nItem) = "INSERT INTO vooruitbestellingen " & _
                        "(voornaam, familienaam, klant_email, klant_id, formaat, datum, " & _
                        "week_bestelling, week_start_abonnement, jaar, bron) VALUES (" & _
                        sVnQ & ", " & sFnQ & ", " & sMailQ & ", " & sKid & ", " & sFmtVoorWeekQ & ", '" & _
                        sDatum & "', " & w & ", NULL, " & iJaar & ", 'macro')"
                    nItem = nItem + 1
                    sBestVb = sBestVb & sSleutel & "|"
                    nVb = nVb + 1

                    ' Mail-eligible (alleen als klant een email1 heeft)
                    If klMail(kIdx) <> "" Then
                        mEmail(nMail)    = klMail(kIdx)
                        mVoor(nMail)     = klVn(kIdx)
                        mVoor2(nMail)    = klVn2(kIdx)
                        mKlantId(nMail)  = riKlant(i)
                        mWeek(nMail)     = w
                        mType(nMail)     = "vooruitbestelling"
                        mFormaat(nMail)  = sFmtVoorWeek
                        mDatum(nMail)    = sDatum
                        mJaar(nMail)     = iJaar
                        nMail = nMail + 1
                    End If
                End If
            Next wi
        End If

        ' --- start abonnement (kolom T) ---
        If riStart(i) > 0 Then
            w = riStart(i)
            dDo = WeekNaarDonderdag(w)
            iJaar = Year(dDo)
            sDatum = Format(dDo, "YYYY-MM-DD")
            sSleutel = sKid & "#" & iJaar & "#" & w
            If InStr(sBestVb, "|" & sSleutel & "|") > 0 Then
                nDup = nDup + 1
            Else
                aSql(nItem) = "INSERT INTO vooruitbestellingen " & _
                    "(voornaam, familienaam, klant_email, klant_id, formaat, datum, " & _
                    "week_bestelling, week_start_abonnement, jaar, bron) VALUES (" & _
                    sVnQ & ", " & sFnQ & ", " & sMailQ & ", " & sKid & ", '" & riFmt(i) & "', '" & _
                    sDatum & "', " & w & ", " & w & ", " & iJaar & ", 'macro')"
                nItem = nItem + 1
                ' Klant in toekomst-toestand zetten; de VPS-cron schakelt om op de startweek
                ' (legacy klanten.type blijft transitie-mirror tot Fase F). Een start
                ' beantwoordt ook een eventuele lopende opvolging -> wissen.
                aSql(nItem) = "UPDATE klanten SET type = '" & riType(i) & "-toekomst', " & _
                    "formaat = '" & riFmt(i) & "'" & _
                    ", opvolg_datum = NULL, opvolg_gemaild_op = NULL WHERE id = " & sKid
                nItem = nItem + 1
                ' Herstart van een gestopte/gepauzeerde klant: het pauzewindow eindigt
                ' op de startweek (mail-poort opent dan weer; de nachtelijke recompute
                ' ruimt het verstreken window daarna op). Klanten zonder window blijven
                ' onaangeroerd door de WHERE-guard.
                aSql(nItem) = "UPDATE klanten SET pauze_tot_jaar = " & iJaar & ", pauze_tot_week = " & w & _
                    " WHERE id = " & sKid & " AND pauze_vanaf_jaar IS NOT NULL"
                nItem = nItem + 1
                ' Nieuw model: primair abonnement als toekomst-rij. Combo-'extra'-rijen
                ' blijven ongemoeid (DELETE enkel bron='primair'). De flip-cron zet
                ' status 'toekomst'->'actief' zodra (start_jaar,start_week) bereikt is.
                Dim sRitmeStart As String
                Select Case riType(i)
                    Case "abonnee-pare-week"   : sRitmeStart = "pare-week"
                    Case "abonnee-onpare-week" : sRitmeStart = "onpare-week"
                    Case Else                  : sRitmeStart = "wekelijks"
                End Select
                aSql(nItem) = "DELETE FROM abonnementen WHERE klant_id = " & sKid & " AND bron = 'primair'"
                nItem = nItem + 1
                aSql(nItem) = "INSERT INTO abonnementen " & _
                    "(klant_id, ritme, formaat, status, bron, start_jaar, start_week) VALUES (" & _
                    sKid & ", '" & sRitmeStart & "', '" & riFmt(i) & "', 'toekomst', 'primair', " & _
                    iJaar & ", " & w & ")"
                nItem = nItem + 1
                sBestVb = sBestVb & sSleutel & "|"
                nStart = nStart + 1

                ' Mail-eligible (alleen als klant een email1 heeft)
                If klMail(kIdx) <> "" Then
                    mEmail(nMail)    = klMail(kIdx)
                    mVoor(nMail)     = klVn(kIdx)
                    mVoor2(nMail)    = klVn2(kIdx)
                    mKlantId(nMail)  = riKlant(i)
                    mWeek(nMail)     = w
                    mType(nMail)     = "abonnementsstart"
                    mFormaat(nMail)  = riFmt(i)
                    mDatum(nMail)    = sDatum
                    mJaar(nMail)     = iJaar
                    nMail = nMail + 1
                End If
            End If
        End If
    Next i

    ' === Fase 4: bevestiging (of melding dat alles al bestond) ===
    If nItem = 0 Then
        oConn.close()
        For i = 0 To nRij - 1
            oSheet.getCellByPosition(COL_ANN,   riRij(i)).setString("")
            oSheet.getCellByPosition(COL_STOP,  riRij(i)).setString("")
            oSheet.getCellByPosition(COL_VB,    riRij(i)).setString("")
            oSheet.getCellByPosition(COL_START, riRij(i)).setString("")
            If iDoelCol >= 0     Then oSheet.getCellByPosition(iDoelCol,     riRij(i)).setString("")
            If iHerstartCol >= 0 Then oSheet.getCellByPosition(iHerstartCol, riRij(i)).setString("")
        Next i
        SluitSSHTunnels()
        MsgBox "Alle " & nDup & " ingevoerde week(en) stonden al in de database." & Chr(10) & _
               "De invoercellen zijn leeggemaakt.", 64, "VerwerkStopStart"
        Exit Sub
    End If

    Dim sVraag As String
    sVraag = "Te verwerken in de database:" & Chr(10) & Chr(10) & _
             "  Annulaties:           " & nAnn   & Chr(10) & _
             "  Stopzettingen:        " & nStopz & Chr(10) & _
             "  Vooruitbestellingen:  " & nVb    & Chr(10) & _
             "  Abonnementstarts:     " & nStart & Chr(10) & Chr(10)
    If nDup > 0 Then
        sVraag = sVraag & nDup & " week(en) worden overgeslagen (staan al in de DB)." & Chr(10) & Chr(10)
    End If
    If nStart > 0 Then
        sVraag = sVraag & "Elke start zet de klant ook op een toekomst-abonneetype." & Chr(10) & Chr(10)
    End If
    If nOpvolg > 0 Then
        sVraag = sVraag & nOpvolg & " tijdelijke stop(s) zonder herstart-week: je krijgt " & _
                 "2 maanden na de stopweek een opvolg-sein (mail + ToonOpvolgingen)." & Chr(10) & Chr(10)
    End If
    sVraag = sVraag & "Akkoord?"
    If MsgBox(sVraag, 33, "VerwerkStopStart") <> 1 Then
        oConn.close()
        SluitSSHTunnels()
        Exit Sub
    End If

    ' Tweede vraag: bevestigingsmails versturen? Enkel als er kandidaten zijn.
    Dim bStuurMails As Boolean : bStuurMails = False
    If nMail > 0 Then
        ' Tel het WERKELIJKE aantal mails (zelfde bundeling als Fase 5b):
        ' alle annulaties van dezelfde klant gaan in één mail, de rest is
        ' één mail per item. nMail zelf telt per week en overschat dus.
        Dim nMailEcht As Integer : nMailEcht = 0
        Dim bAnnTeld(MAX_ITEM) As Boolean
        Dim mt As Integer, mt2 As Integer
        For mt = 0 To nMail - 1
            If mType(mt) = "annulatie" Then
                If Not bAnnTeld(mt) Then
                    For mt2 = mt To nMail - 1
                        If mType(mt2) = "annulatie" And mKlantId(mt2) = mKlantId(mt) Then bAnnTeld(mt2) = True
                    Next mt2
                    nMailEcht = nMailEcht + 1
                End If
            Else
                nMailEcht = nMailEcht + 1
            End If
        Next mt

        Dim sUrl As String
        If BepaalOmgeving() = "dev" Then
            sUrl = "https://bestel.dev.kiemkracht.be"
        Else
            sUrl = "https://bestel.kiemkracht.be"
        End If
        Dim sMailVraag As String
        Dim sMailWoord As String
        If nMailEcht = 1 Then sMailWoord = "1 bevestigingsmail" Else sMailWoord = nMailEcht & " bevestigingsmails"
        sMailVraag = "Wil je ook " & sMailWoord & " versturen?" & Chr(10) & _
                     "(annulaties + stopzettingen + vooruitbestellingen + abonnementsstarts — klanten zonder email1 zijn overgeslagen; meerdere annulatieweken van dezelfde klant gaan in één mail)" & Chr(10) & Chr(10) & _
                     "Doelomgeving: " & sUrl & Chr(10) & Chr(10) & _
                     "Ja = inserts + mails" & Chr(10) & _
                     "Nee = enkel inserts, geen mails"
        If MsgBox(sMailVraag, 36, "VerwerkStopStart") = 6 Then bStuurMails = True
    End If

    ' === Fase 5: uitvoeren ===
    On Error GoTo UitvoerFout
    oStmt = oConn.createStatement()
    Dim it As Integer
    For it = 0 To nItem - 1
        oStmt.executeUpdate(aSql(it))
    Next it
    ' Leidt klanten.type/status meteen af (dezelfde recompute als de nachtelijke
    ' flip-cron, nu gebundeld in de Postgres-functie flip_abonnementen()) zodat
    ' klanten_beheer/LaadAlleTabellen direct de juiste toestand toont i.p.v. tot
    ' 6:00 te wachten. Enkel reeds-actieve wijzigingen flippen; toekomst-stops en
    ' -starts blijven terecht ongewijzigd tot hun week aanbreekt. Raakt enkel de
    ' omgeving waarmee de macro verbonden is (de cron blijft prod EN dev doen).
    Dim oFlipRS As Object
    oFlipRS = oStmt.executeQuery("SELECT flip_abonnementen()")
    oFlipRS.close()
    oStmt.close()
    oConn.close()
    On Error GoTo 0

    ' === Fase 5b: mails versturen (na succesvolle inserts) ===
    Dim nMailOk As Integer : nMailOk = 0
    Dim nMailFout As Integer : nMailFout = 0
    If bStuurMails Then
        Dim m As Integer
        Dim bAnnGedaan(MAX_ITEM) As Boolean   ' annulatie-record al in een bundel meegestuurd
        For m = 0 To nMail - 1
            Dim bOk As Boolean : bOk = False
            Select Case mType(m)
                Case "annulatie"
                    ' Alle annulaties van dezelfde klant in één gebundelde mail.
                    If Not bAnnGedaan(m) Then
                        Dim sItems As String : sItems = ""
                        Dim mm As Integer
                        For mm = m To nMail - 1
                            If mType(mm) = "annulatie" And mKlantId(mm) = mKlantId(m) And Not bAnnGedaan(mm) Then
                                If sItems <> "" Then sItems = sItems & ","
                                sItems = sItems & "{""week"":" & mWeek(mm) & ",""jaar"":" & mJaar(mm) & "}"
                                bAnnGedaan(mm) = True
                            End If
                        Next mm
                        bOk = VerstuurAnnulatieBundel(mEmail(m), mVoor(m), mVoor2(m), mKlantId(m), sItems)
                        If bOk Then nMailOk = nMailOk + 1 Else nMailFout = nMailFout + 1
                    End If
                Case "stopzetting"
                    bOk = VerstuurAnnulatieMail(mEmail(m), mVoor(m), mVoor2(m), mWeek(m), mJaar(m), _
                                                mDatum(m), mWeek(m), mKlantId(m), _
                                                mDoel(m), mHerstartW(m), mHerstartJ(m))
                    If bOk Then nMailOk = nMailOk + 1 Else nMailFout = nMailFout + 1
                Case "vooruitbestelling", "abonnementsstart"
                    Dim iWeekStart As Integer
                    If mType(m) = "abonnementsstart" Then iWeekStart = mWeek(m) Else iWeekStart = 0
                    bOk = VerstuurVooruitbestellingMail(mEmail(m), mVoor(m), mVoor2(m), mWeek(m), mJaar(m), _
                                                        mDatum(m), iWeekStart, mKlantId(m), mFormaat(m))
                    If bOk Then nMailOk = nMailOk + 1 Else nMailFout = nMailFout + 1
            End Select
        Next m
    End If

    ' Verwerkte invoercellen leegmaken
    For i = 0 To nRij - 1
        oSheet.getCellByPosition(COL_ANN,     riRij(i)).setString("")
        oSheet.getCellByPosition(COL_STOP,    riRij(i)).setString("")
        oSheet.getCellByPosition(COL_VB,      riRij(i)).setString("")
        oSheet.getCellByPosition(COL_START,   riRij(i)).setString("")
        oSheet.getCellByPosition(COL_TYPE,    riRij(i)).setString("")
        oSheet.getCellByPosition(COL_FORMAAT, riRij(i)).setString("")
        If iDoelCol >= 0     Then oSheet.getCellByPosition(iDoelCol,     riRij(i)).setString("")
        If iHerstartCol >= 0 Then oSheet.getCellByPosition(iHerstartCol, riRij(i)).setString("")
    Next i

    SluitSSHTunnels()
    Dim sKlaar As String
    sKlaar = "Verwerkt: " & nAnn & " annulaties, " & nStopz & " stopzettingen, " & _
             nVb & " vooruitbestellingen, " & nStart & " abonnementstarts."
    If nStart > 0 Then
        sKlaar = sKlaar & Chr(10) & nStart & " klant(en) op een toekomst-abonneetype gezet."
    End If
    If bStuurMails Then
        sKlaar = sKlaar & Chr(10) & Chr(10) & "Bevestigingsmails: " & nMailOk & " ok, " & nMailFout & " fout."
    End If
    MsgBox sKlaar, 64, "Klaar"
    Exit Sub

UitvoerFout:
    MsgBox "Databasefout tijdens het wegschrijven: " & Err & " - " & Error & Chr(10) & Chr(10) & _
           "Niet alle records zijn verwerkt. De invoer is bewaard — draai de macro " & _
           "opnieuw; reeds verwerkte weken worden automatisch overgeslagen.", 16, "Fout"
    SluitSSHTunnels()
    Exit Sub

VerbindingsFoutSS:
    MsgBox "Verbindingsfout: " & Err & " - " & Error, 16, "Fout"
    SluitSSHTunnels()

End Sub

' ---------------------------------------------------------------------------
' VerwerkAfhaalpuntVerlof — backlog #27. Leest het tabblad 'afhaalpunt_verlof'
' (kolommen via kophoek gedetecteerd: afhaalpunt / gesloten-vanaf-jaar /
' gesloten-vanaf-week / open-vanaf-jaar / open-vanaf-week / alternatieven /
' opmerking) en schrijft elke rij als een sluiting weg naar afhaalpunt_sluitingen.
' Eén rij zet meteen de hele groep klanten van dat afhaalpunt om — zij krijgen
' dan in het bestelformulier de keuze uit de opgegeven alternatieven, vanaf de
' gesloten-week tot (niet: tot-en-met) de open-week — "vanaf" i.p.v. "tot" om
' de Nederlandse tot/tot-en-met-verwarring te vermijden.
' Gebouwd naar het skelet van VerwerkStopStart (validatie zonder DB, dan
' verbinden, vergelijken met bestaande rijen, bevestigen, uitvoeren, invoer
' wissen). Een rij met een bestaande sleutel (afhaalpunt + gesloten-vanaf-week)
' werkt die sluiting bij; zo dient het tabblad ook om te corrigeren.
' ---------------------------------------------------------------------------
Sub VerwerkAfhaalpuntVerlof()

    Const MAX_RIJ = 500

    Dim oDoc As Object
    oDoc = HuidigDataDocument()
    If IsNull(oDoc) Then
        MsgBox "Geen kiemkracht-data-bestand actief. Open kiemkracht-data.ods " & _
               "of kiemkracht-data-dev.ods en start de macro vanuit dat venster.", 16, "Fout"
        Exit Sub
    End If
    If Not oDoc.Sheets.hasByName("afhaalpunt_verlof") Then
        MsgBox "Tabblad 'afhaalpunt_verlof' niet gevonden.", 16, "Fout"
        Exit Sub
    End If
    Dim oSheet As Object : oSheet = oDoc.Sheets.getByName("afhaalpunt_verlof")

    ' --- Kolommen zoeken via de kophoek (rij 1-2, kolom A-P) ---
    ' "gesloten-vanaf" / "open-vanaf" i.p.v. "vanaf"/"tot": "vanaf" is in het
    ' Nederlands ondubbelzinnig (inclusief startpunt), "tot" wordt vaak verward
    ' met "tot en met" — zie backlog #27. Venster is [gesloten-vanaf, open-vanaf).
    Dim iApCol As Integer : iApCol = -1
    Dim iVanafJCol As Integer : iVanafJCol = -1
    Dim iVanafWCol As Integer : iVanafWCol = -1
    Dim iTotJCol As Integer : iTotJCol = -1
    Dim iTotWCol As Integer : iTotWCol = -1
    Dim iAltCol As Integer : iAltCol = -1
    Dim iOpmCol As Integer : iOpmCol = -1
    Dim iLaatsteHeaderRij As Integer : iLaatsteHeaderRij = 0
    Dim hr As Integer, hc As Integer, sHdr As String
    For hr = 0 To 1
        For hc = 0 To 15
            sHdr = LCase(Trim(oSheet.getCellByPosition(hc, hr).getString()))
            Select Case sHdr
                Case "afhaalpunt"          : iApCol = hc         : iLaatsteHeaderRij = hr
                Case "gesloten-vanaf-jaar" : iVanafJCol = hc      : iLaatsteHeaderRij = hr
                Case "gesloten-vanaf-week" : iVanafWCol = hc      : iLaatsteHeaderRij = hr
                Case "open-vanaf-jaar"     : iTotJCol = hc        : iLaatsteHeaderRij = hr
                Case "open-vanaf-week"     : iTotWCol = hc        : iLaatsteHeaderRij = hr
                Case "alternatieven"       : iAltCol = hc         : iLaatsteHeaderRij = hr
                Case "opmerking"           : iOpmCol = hc         : iLaatsteHeaderRij = hr
            End Select
        Next hc
    Next hr
    If iApCol = -1 Or iVanafJCol = -1 Or iVanafWCol = -1 Or iTotJCol = -1 Or _
       iTotWCol = -1 Or iAltCol = -1 Then
        MsgBox "Niet alle verplichte kolomkoppen gevonden (afhaalpunt / gesloten-vanaf-jaar / " & _
               "gesloten-vanaf-week / open-vanaf-jaar / open-vanaf-week / alternatieven) " & _
               "in rij 1-2, kolom A-P.", 16, "Fout"
        Exit Sub
    End If

    ' Eerste datarij = meteen na de laatst gevonden kolomkop (werkt met 1 of 2
    ' headerrijen; bij dit tabblad meestal gewoon rij 1 header, rij 2 data).
    Dim iDataRij0 As Integer : iDataRij0 = iLaatsteHeaderRij + 1

    ' === Fase 1: invoerrijen verzamelen + basisvalidatie (geen DB nodig) ===
    Dim riRij(MAX_RIJ)    As Integer
    Dim riApNaam(MAX_RIJ) As String
    Dim riVanafJ(MAX_RIJ) As Integer
    Dim riVanafW(MAX_RIJ) As Integer
    Dim riTotJ(MAX_RIJ)   As Integer
    Dim riTotW(MAX_RIJ)   As Integer
    Dim riAltCsv(MAX_RIJ) As String
    Dim riOpm(MAX_RIJ)    As String
    Dim nRij As Integer : nRij = 0

    Dim r As Integer
    For r = iDataRij0 To iDataRij0 + MAX_RIJ - 1
        Dim sAp     As String : sAp     = Trim(oSheet.getCellByPosition(iApCol,     r).getString())
        Dim sVj     As String : sVj     = Trim(oSheet.getCellByPosition(iVanafJCol, r).getString())
        Dim sVw     As String : sVw     = Trim(oSheet.getCellByPosition(iVanafWCol, r).getString())
        Dim sTj     As String : sTj     = Trim(oSheet.getCellByPosition(iTotJCol,   r).getString())
        Dim sTw     As String : sTw     = Trim(oSheet.getCellByPosition(iTotWCol,   r).getString())
        Dim sAltRaw As String : sAltRaw = Trim(oSheet.getCellByPosition(iAltCol,    r).getString())
        Dim sOpmRaw As String : sOpmRaw = ""
        If iOpmCol >= 0 Then sOpmRaw = Trim(oSheet.getCellByPosition(iOpmCol, r).getString())

        If sAp <> "" Or sVj <> "" Or sVw <> "" Or sTj <> "" Or sTw <> "" Or sAltRaw <> "" Then
            If sAp = "" Or sVj = "" Or sVw = "" Or sTj = "" Or sTw = "" Or sAltRaw = "" Then
                MsgBox "Rij " & (r + 1) & ": afhaalpunt, gesloten-vanaf-jaar, gesloten-vanaf-week, " & _
                       "open-vanaf-jaar, open-vanaf-week en alternatieven moeten allemaal ingevuld zijn.", 16, "Fout"
                Exit Sub
            End If
            If Not IsNumeric(sVj) Or Not IsNumeric(sVw) Or Not IsNumeric(sTj) Or Not IsNumeric(sTw) Then
                MsgBox "Rij " & (r + 1) & ": gesloten-vanaf-jaar/gesloten-vanaf-week/open-vanaf-jaar/" & _
                       "open-vanaf-week moeten getallen zijn.", 16, "Fout"
                Exit Sub
            End If
            Dim iVj As Integer : iVj = CInt(sVj)
            Dim iVw As Integer : iVw = CInt(sVw)
            Dim iTj As Integer : iTj = CInt(sTj)
            Dim iTw As Integer : iTw = CInt(sTw)
            If iVw < 1 Or iVw > 53 Or iTw < 1 Or iTw > 53 Then
                MsgBox "Rij " & (r + 1) & ": gesloten-vanaf-week/open-vanaf-week moet tussen 1 en 53 liggen.", 16, "Fout"
                Exit Sub
            End If
            If (iTj * 100 + iTw) <= (iVj * 100 + iVw) Then
                MsgBox "Rij " & (r + 1) & ": open-vanaf-jaar/open-vanaf-week moet ná " & _
                       "gesloten-vanaf-jaar/gesloten-vanaf-week liggen.", 16, "Fout"
                Exit Sub
            End If

            riRij(nRij)    = r
            riApNaam(nRij) = sAp
            riVanafJ(nRij) = iVj
            riVanafW(nRij) = iVw
            riTotJ(nRij)   = iTj
            riTotW(nRij)   = iTw
            riAltCsv(nRij) = sAltRaw
            riOpm(nRij)    = sOpmRaw
            nRij = nRij + 1
        End If
    Next r

    If nRij = 0 Then
        MsgBox "Geen invoer gevonden in tabblad 'afhaalpunt_verlof'.", 64, "VerwerkAfhaalpuntVerlof"
        Exit Sub
    End If

    ' === Fase 2: verbinden, namen opzoeken + valideren tegen afhaalpunten ===
    On Error GoTo VerbindingsFoutAV
    Dim oConn As Object
    oConn = MaakDBVerbinding()
    On Error GoTo 0

    Dim oStmt As Object : oStmt = oConn.createStatement()

    Dim apNaam(200) As String, apId(200) As Long, nAp As Integer : nAp = 0
    Dim oApRS As Object : oApRS = oStmt.executeQuery("SELECT id, naam, naam_publiek FROM afhaalpunten")
    Do While oApRS.next()
        apId(nAp)   = oApRS.getLong(1)
        apNaam(nAp) = LCase(Trim(oApRS.getString(2)))
        nAp = nAp + 1
        Dim sNP As String : sNP = LCase(Trim(oApRS.getString(3)))
        If sNP <> "" And sNP <> apNaam(nAp - 1) Then
            apId(nAp)   = apId(nAp - 1)
            apNaam(nAp) = sNP
            nAp = nAp + 1
        End If
    Loop
    oApRS.close()

    Dim riApId(MAX_RIJ)     As Long
    Dim riAltIdsCsv(MAX_RIJ) As String
    Dim sFoutAV As String : sFoutAV = ""
    Dim nFoutAV As Integer : nFoutAV = 0
    Dim i As Integer
    For i = 0 To nRij - 1
        Dim jAp As Integer
        Dim lApId As Long : lApId = -1
        Dim sApRaw As String : sApRaw = Trim(riApNaam(i))
        If IsNumeric(sApRaw) Then
            ' Rechtstreeks een afhaalpunt_id — moet wél bestaan.
            Dim lApIdKand As Long : lApIdKand = CLng(sApRaw)
            For jAp = 0 To nAp - 1
                If apId(jAp) = lApIdKand Then lApId = lApIdKand : Exit For
            Next jAp
        Else
            Dim sApZoek As String : sApZoek = LCase(sApRaw)
            For jAp = 0 To nAp - 1
                If apNaam(jAp) = sApZoek Then lApId = apId(jAp) : Exit For
            Next jAp
        End If
        If lApId = -1 Then
            sFoutAV = sFoutAV & Chr(10) & "  rij " & (riRij(i) + 1) & ": onbekend afhaalpunt '" & sApRaw & "'"
            nFoutAV = nFoutAV + 1
        Else
            riApId(i) = lApId
        End If

        Dim aAltNamen() As String : aAltNamen = Split(riAltCsv(i), ",")
        Dim iAlt As Integer, sIds As String : sIds = ""
        For iAlt = 0 To UBound(aAltNamen)
            Dim sAltRawItem As String : sAltRawItem = Trim(aAltNamen(iAlt))
            If sAltRawItem <> "" Then
                Dim lAltId As Long : lAltId = -1
                Dim jAlt As Integer
                If IsNumeric(sAltRawItem) Then
                    Dim lAltIdKand As Long : lAltIdKand = CLng(sAltRawItem)
                    For jAlt = 0 To nAp - 1
                        If apId(jAlt) = lAltIdKand Then lAltId = lAltIdKand : Exit For
                    Next jAlt
                Else
                    Dim sNaamAlt As String : sNaamAlt = LCase(sAltRawItem)
                    For jAlt = 0 To nAp - 1
                        If apNaam(jAlt) = sNaamAlt Then lAltId = apId(jAlt) : Exit For
                    Next jAlt
                End If
                If lAltId = -1 Then
                    sFoutAV = sFoutAV & Chr(10) & "  rij " & (riRij(i) + 1) & _
                              ": onbekend alternatief '" & sAltRawItem & "'"
                    nFoutAV = nFoutAV + 1
                ElseIf lApId <> -1 And lAltId = lApId Then
                    sFoutAV = sFoutAV & Chr(10) & "  rij " & (riRij(i) + 1) & _
                              ": alternatief '" & sAltRawItem & "' is hetzelfde als het afhaalpunt zelf"
                    nFoutAV = nFoutAV + 1
                Else
                    If sIds <> "" Then sIds = sIds & ","
                    sIds = sIds & CStr(lAltId)
                End If
            End If
        Next iAlt
        riAltIdsCsv(i) = sIds
    Next i

    If nFoutAV > 0 Then
        MsgBox nFoutAV & " fout(en) in tabblad 'afhaalpunt_verlof':" & Chr(10) & sFoutAV & Chr(10) & Chr(10) & _
               "Gebruik het afhaalpunt_id (een getal) of een naam die exact overeenkomt met " & _
               "afhaalpunten.naam of naam_publiek. Corrigeer en start de macro opnieuw. " & _
               "Er is nog niets weggeschreven.", 16, "Validatiefout"
        oStmt.close()
        oConn.close()
        Exit Sub
    End If

    ' === Fase 3: bestaande sluitingen opzoeken (sleutel = afhaalpunt_id,vanaf) ===
    ' Een rij waarvan de sleutel al bestaat wordt BIJGEWERKT, niet overgeslagen:
    ' zo corrigeer je een alternatievenlijst of een open-vanaf-week door de rij
    ' gewoon opnieuw in te typen. (Vroeger werd zo'n rij stil genegeerd én daarna
    ' tóch gewist, waardoor een correctie spoorloos verdween — je zag "niets
    ' nieuws" en een leeg tabblad, terwijl de database onveranderd bleef.)
    Dim sBestaandeSleutels As String : sBestaandeSleutels = "|"
    Dim oExistRS As Object
    oExistRS = oStmt.executeQuery("SELECT afhaalpunt_id, vanaf_jaar, vanaf_week FROM afhaalpunt_sluitingen")
    Do While oExistRS.next()
        sBestaandeSleutels = sBestaandeSleutels & oExistRS.getLong(1) & "#" & _
                              oExistRS.getInt(2) & "#" & oExistRS.getInt(3) & "|"
    Loop
    oExistRS.close()

    Dim bNieuw(MAX_RIJ) As Boolean
    Dim nNieuw As Integer : nNieuw = 0
    Dim nBij As Integer   : nBij = 0
    For i = 0 To nRij - 1
        Dim sSleutel As String : sSleutel = riApId(i) & "#" & riVanafJ(i) & "#" & riVanafW(i)
        bNieuw(i) = (InStr(sBestaandeSleutels, "|" & sSleutel & "|") = 0)
        If bNieuw(i) Then
            nNieuw = nNieuw + 1
        Else
            nBij = nBij + 1
        End If
    Next i

    Dim sVraagAV As String : sVraagAV = ""
    If nNieuw > 0 Then
        sVraagAV = nNieuw & " nieuwe afhaalpunt-sluiting(en) aanmaken."
    End If
    If nBij > 0 Then
        If sVraagAV <> "" Then sVraagAV = sVraagAV & Chr(10)
        sVraagAV = sVraagAV & nBij & " bestaande sluiting(en) bijwerken — " & _
                   "open-vanaf-week, alternatieven en opmerking worden overschreven."
    End If

    Dim nAntwAV As Integer
    nAntwAV = MsgBox(sVraagAV & Chr(10) & Chr(10) & "Akkoord?", 1, "VerwerkAfhaalpuntVerlof")
    If nAntwAV <> 1 Then
        oStmt.close()
        oConn.close()
        Exit Sub
    End If

    ' === Fase 4: uitvoeren ===
    On Error GoTo UitvoerFoutAV
    For i = 0 To nRij - 1
        Dim sAltArray As String
        If riAltIdsCsv(i) = "" Then
            sAltArray = "ARRAY[]::int[]"
        Else
            sAltArray = "ARRAY[" & riAltIdsCsv(i) & "]"
        End If
        If bNieuw(i) Then
            oStmt.executeUpdate( _
                "INSERT INTO afhaalpunt_sluitingen " & _
                "(afhaalpunt_id, vanaf_jaar, vanaf_week, tot_jaar, tot_week, alternatieven, opmerking) VALUES (" & _
                riApId(i) & ", " & riVanafJ(i) & ", " & riVanafW(i) & ", " & _
                riTotJ(i) & ", " & riTotW(i) & ", " & sAltArray & ", " & SqlStr(riOpm(i)) & ")")
        Else
            ' De alternatieven-volgorde is betekenisvol: de bestelpagina toont ze
            ' in exact deze volgorde (array_position in bepaalAfhaalpuntOpties).
            oStmt.executeUpdate( _
                "UPDATE afhaalpunt_sluitingen SET " & _
                "tot_jaar = " & riTotJ(i) & ", tot_week = " & riTotW(i) & ", " & _
                "alternatieven = " & sAltArray & ", opmerking = " & SqlStr(riOpm(i)) & " " & _
                "WHERE afhaalpunt_id = " & riApId(i) & _
                " AND vanaf_jaar = " & riVanafJ(i) & " AND vanaf_week = " & riVanafW(i))
        End If
    Next i
    On Error GoTo 0

    oStmt.close()
    oConn.close()

    ' Verwerkte invoercellen leegmaken — elke herkende rij is nu effectief
    ' aangemaakt of bijgewerkt, dus staat de gevraagde toestand in de database.
    For i = 0 To nRij - 1
        oSheet.getCellByPosition(iApCol,     riRij(i)).setString("")
        oSheet.getCellByPosition(iVanafJCol, riRij(i)).setString("")
        oSheet.getCellByPosition(iVanafWCol, riRij(i)).setString("")
        oSheet.getCellByPosition(iTotJCol,   riRij(i)).setString("")
        oSheet.getCellByPosition(iTotWCol,   riRij(i)).setString("")
        oSheet.getCellByPosition(iAltCol,    riRij(i)).setString("")
        If iOpmCol >= 0 Then oSheet.getCellByPosition(iOpmCol, riRij(i)).setString("")
    Next i

    SluitSSHTunnels()
    MsgBox nNieuw & " nieuwe sluiting(en) aangemaakt, " & nBij & " bijgewerkt " & _
           "(van " & nRij & " verwerkte rij(en)).", 64, "Klaar"
    Exit Sub

UitvoerFoutAV:
    MsgBox "Databasefout tijdens het wegschrijven: " & Err & " - " & Error, 16, "Fout"
    SluitSSHTunnels()
    Exit Sub

VerbindingsFoutAV:
    MsgBox "Verbindingsfout: " & Err & " - " & Error & Chr(10) & _
           "Controleer of de SSH-tunnel actief is.", 16, "Fout"
    SluitSSHTunnels()
End Sub

' =============================================
' Verstuur bevestigingsmail voor een annulatie of stopzetting via de
' postgres-proxy. Sync HTTP-POST naar /actie=annulatie_bevestiging_mail.
' Returnt True bij HTTP 200, anders False.
' iWeekStop = 0  -> gewone annulatie
' iWeekStop > 0  -> stopzetting (proxy kiest dan stopzet-template)
' sDoel + iHerstartWeek/Jaar sturen de variant van de stopzet-mail:
'   herstart-week > 0        -> pauze-tekst met automatische hervatting
'   doel = weekperweek       -> "aanbodsmail blijft komen"-zin
'   doel = tijdelijk, geen H -> "we contacteren je over ±2 maanden"-zin
' =============================================
Function VerstuurAnnulatieMail(sEmail As String, sVoornaam As String, sVoornaam2 As String, _
                                iWeek As Integer, iJaar As Integer, _
                                sDatum As String, iWeekStop As Integer, _
                                iKlantId As Long, _
                                Optional sDoel As String, _
                                Optional iHerstartWeek As Integer, _
                                Optional iHerstartJaar As Integer) As Boolean
    Dim sUrl As String
    If BepaalOmgeving() = "dev" Then
        sUrl = "https://bestel.dev.kiemkracht.be/postgres-proxy.php?actie=annulatie_bevestiging_mail"
    Else
        sUrl = "https://bestel.kiemkracht.be/postgres-proxy.php?actie=annulatie_bevestiging_mail"
    End If

    Dim sDoelN As String : sDoelN = ""
    If Not IsMissing(sDoel) Then sDoelN = sDoel
    Dim iHW As Integer : iHW = 0
    If Not IsMissing(iHerstartWeek) Then iHW = iHerstartWeek
    Dim iHJ As Integer : iHJ = 0
    If Not IsMissing(iHerstartJaar) Then iHJ = iHerstartJaar

    Dim sJson As String
    sJson = "{""Sleutel"":""Kiemkracht2026BestelFormulierSleutel""," & _
            """KlantEmail"":""" & JsonEsc(sEmail) & """," & _
            """Voornaam"":""" & JsonEsc(sVoornaam) & """," & _
            """Voornaam2"":""" & JsonEsc(sVoornaam2) & """," & _
            """KlantID"":" & iKlantId & "," & _
            """WeekAnnulatie"":" & iWeek & "," & _
            """Datum"":""" & sDatum & """," & _
            """Jaar"":" & iJaar
    If iWeekStop > 0 Then
        sJson = sJson & ",""WeekStopzettenAbonnement"":" & iWeekStop
    End If
    If iHW > 0 Then
        If iHJ = 0 Then iHJ = iJaar
        sJson = sJson & ",""HerstartWeek"":" & iHW & ",""HerstartJaar"":" & iHJ
    End If
    If sDoelN = "weekperweek" Then
        sJson = sJson & ",""MailBlijven"":1"
    ElseIf sDoelN = "tijdelijk" And iHW = 0 Then
        sJson = sJson & ",""OpvolgenOk"":1"
    End If
    sJson = sJson & "}"

    On Error GoTo HttpFout
    Dim http As Object
    http = createObject("MSXML2.ServerXMLHTTP.6.0")
    http.open("POST", sUrl, False)
    http.setRequestHeader("Content-Type", "application/json")
    http.send(sJson)
    VerstuurAnnulatieMail = (http.status = 200)
    Exit Function
HttpFout:
    VerstuurAnnulatieMail = False
End Function

