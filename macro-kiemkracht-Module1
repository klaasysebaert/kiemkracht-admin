Option Explicit

' =============================================
' OMGEVING & DATABASEVERBINDING — gedeelde helpers
' Eén centrale plek voor alle DB-macro's: bepaalt prod vs dev op
' basis van het open kiemkracht-data-bestand en geeft de juiste
' JDBC-verbinding terug.
' =============================================

' Module-level vlaggen: tunnel al gestart tijdens deze LO-sessie?
' Voorkomt dat een macro die meerdere DB-verbindingen nodig heeft
' (bv. KoffieWeekbestand: groenten + koffie) telkens een nieuwe
' ssh-tunnel opent in een extra cmd-venster.
Private mTunnelProdActief As Boolean
Private mTunnelDevActief  As Boolean

' Diagnose: welke stap/tabel was bezig toen er een fout optrad (zie LaadAlleTabellen).
Private mStap As String

' Geeft het ACTIEVE document terug als het een kiemkracht-data-bestand is,
' anders Null. ThisComponent = het venster waarin de macro gestart is — zo
' werkt alles op het bestand waarin je de macro oproept, ook met
' kiemkracht-data.ods en kiemkracht-data-dev.ods tegelijk open.
'
' Fallback: ThisComponent is onbetrouwbaar zodra er andere vensters openstaan
' (bv. een leeg "Geen titel"-venster wordt dan het actieve component, zonder URL).
' Lukt ThisComponent niet, dan scannen we alle open documenten. Staat er PRECIES
' één kiemkracht-data-bestand open, dan gebruiken we dat. Staan prod én dev allebei
' open, dan durven we niet te kiezen en geven we Null terug (de aanroeper toont de
' instructie om vanuit het juiste venster te starten).
Function HuidigDataDocument() As Object
    If IsDataDoc(ThisComponent) Then
        HuidigDataDocument = ThisComponent
        Exit Function
    End If

    Dim oEnum As Object, oC As Object, oGevonden As Object
    Dim nGevonden As Integer
    nGevonden = 0
    oEnum = StarDesktop.Components.createEnumeration()
    Do While oEnum.hasMoreElements()
        oC = oEnum.nextElement()
        If IsDataDoc(oC) Then
            nGevonden = nGevonden + 1
            oGevonden = oC
        End If
    Loop
    If nGevonden = 1 Then HuidigDataDocument = oGevonden
End Function

' True als oDoc een (opgeslagen) kiemkracht-data(-dev).ods Calc-document is.
Function IsDataDoc(oDoc As Object) As Boolean
    IsDataDoc = False
    If IsNull(oDoc) Then Exit Function
    If Not HasUnoInterfaces(oDoc, "com.sun.star.lang.XServiceInfo") Then Exit Function
    If Not oDoc.supportsService("com.sun.star.sheet.SpreadsheetDocument") Then Exit Function
    If InStr(LCase(oDoc.getURL()), "kiemkracht-data") > 0 Then IsDataDoc = True
End Function

' Geeft "dev" als het actieve bestand op "-dev.ods" eindigt, anders "prod".
' Geen kiemkracht-data-bestand actief -> "dev" (veilig: raakt nooit prod).
Function BepaalOmgeving() As String
    Dim oDoc As Object
    BepaalOmgeving = "dev"
    oDoc = HuidigDataDocument()
    If Not IsNull(oDoc) Then
        If InStr(LCase(oDoc.getURL()), "-dev.ods") = 0 Then
            BepaalOmgeving = "prod"
        End If
    End If
End Function

' Start de juiste SSH-tunnel en geeft een JDBC-verbinding terug.
' prod -> tunnel 5433, productiedatabase
' dev  -> tunnel 5434, staging-database (geanonimiseerde kopie van prod)
' Default-database = "postgres" (groenten). Voor andere DB's op dezelfde
' Postgres-instance (bv. "koffie"): MaakDBVerbindingNaar("koffie").
Function MaakDBVerbinding() As Object
    MaakDBVerbinding = MaakDBVerbindingNaar("postgres")
End Function

Function MaakDBVerbindingNaar(sDbNaam As String) As Object
    Dim sJdbcUrl     As String
    Dim sUser        As String
    Dim sPass        As String
    Dim bNetGestart  As Boolean
    bNetGestart = False

    If BepaalOmgeving() = "dev" Then
        ' Staging-DB via de socat-postgres-dev-bridge op de VPS (poort 5434).
        ' De bridge zoekt het container-IP per verbinding op — een hardgecodeerd
        ' IP hier brak telkens na een VPS-reboot/redeploy (containers krijgen
        ' dan nieuwe IP's; zo brak ook prod op 2026-07-02).
        If Not mTunnelDevActief Then
            Shell "cmd.exe /c start /min ssh -N -L 5434:localhost:5434 root@91.98.140.165 -i %USERPROFILE%\.ssh\id_ed25519"
            mTunnelDevActief = True
            bNetGestart = True
        End If
        sJdbcUrl = "jdbc:postgresql://localhost:5434/" & sDbNaam
        sUser    = "postgres"
        sPass    = "iKbZmOneZCodIWPqJLkqxv9c0hGhcMhCgmFPrSBppMYK1V3rSdm5AGAveApY4Eo2"
    Else
        If Not mTunnelProdActief Then
            Shell "cmd.exe /c start /min ssh -N -L 5433:localhost:5432 root@91.98.140.165"
            mTunnelProdActief = True
            bNetGestart = True
        End If
        sJdbcUrl = "jdbc:postgresql://localhost:5433/" & sDbNaam
        sUser    = "postgres"
        sPass    = "nAchtbr1l?0chtendst0ND4*0verjAs&"
    End If
    ' Enkel wachten als we net een nieuwe tunnel openden.
    If bNetGestart Then Wait 3000

    Dim aProps(2) As New com.sun.star.beans.PropertyValue
    aProps(0).Name  = "user"            : aProps(0).Value = sUser
    aProps(1).Name  = "password"        : aProps(1).Value = sPass
    aProps(2).Name  = "JavaDriverClass" : aProps(2).Value = "org.postgresql.Driver"

    Dim oManager As Object
    oManager = CreateUnoService("com.sun.star.sdbc.DriverManager")
    MaakDBVerbindingNaar = oManager.getConnectionWithInfo(sJdbcUrl, aProps())
End Function

' Sluit alle openstaande ssh-tunnels (cmd-vensters) en reset de
' module-level vlaggen. Alle DB-macro's roepen dit op het einde aan.
Sub SluitSSHTunnels()
    Shell "cmd.exe /c taskkill /F /IM ssh.exe"
    mTunnelProdActief = False
    mTunnelDevActief  = False
End Sub

Sub LaadAlleTabellen()

    ' =============================================
    ' Kiemkracht - Data loader
    ' Uitvoeren terwijl kiemkracht-data.ods open is
    ' Vereist: SSH-tunnel actief op poort 5433
    ' =============================================
    
    ' DB-verbinding en SSH-tunnel: zie MaakDBVerbinding()

    Dim oDoc       As Object
    Dim oSheets    As Object
    Dim oConn      As Object
    Dim oIndicator As Object
    Dim i          As Integer
    Dim sUit       As String     ' lijst nieuwe uitschrijvers (opt-out aanbodmail)
    Dim nUit       As Integer
    Dim sUitK      As String     ' lijst nieuwe koffie-uitschrijvers (koffie-opt-out)
    Dim nUitK      As Integer
    Dim bAutoCalc  As Boolean    ' stond automatische herberekening aan?
    Dim bLocked    As Boolean    ' zijn de controllers vergrendeld?
    sUit = "" : nUit = 0 : bAutoCalc = True : bLocked = False

    ' Tabellen om in te laden
    Dim tabellen(11)  As String
    tabellen(0)  = "afhaalpunten"
    tabellen(1)  = "annulaties"
    tabellen(2)  = "bestelling_weglatingen"
    tabellen(3)  = "bestellingen"
    tabellen(4)  = "bestelregels"
    tabellen(5)  = "groenten"
    tabellen(6)  = "klanten"
    tabellen(7)  = "pakket_inhoud"
    tabellen(8)  = "pakketten"
    tabellen(9)  = "vooruitbestellingen"
    tabellen(10) = "bestelling_overzicht"
    tabellen(11) = "verzonden_mails"

    ' Actief kiemkracht-data-bestand bepalen (prod of dev volgt dit bestand)
    oDoc = HuidigDataDocument()
    If IsNull(oDoc) Then
        MsgBox "Geen kiemkracht-data-bestand actief. Open kiemkracht-data.ods " & _
               "of kiemkracht-data-dev.ods en start de macro vanuit dat venster.", 16, "Fout"
        Exit Sub
    End If
    oSheets = oDoc.Sheets

    ' Startmelding
    MsgBox "Alle tabellen worden geladen." & Chr(10) & _
           "In de statusbalk links onderaan kan je de voortgang volgen.", 64, "LaadAlleTabellen"

    ' Voortgangsbalk in de statusbalk (onderaan het venster)
    oIndicator = oDoc.getCurrentController().getFrame().createStatusIndicator()
    oIndicator.start("Kiemkracht - tabellen laden", 100)
    oIndicator.setText("Verbinden met de database...")

    ' Vanaf hier ALTIJD via Opkuis afronden: zo worden schermvergrendeling en
    ' herberekening ook bij een fout halverwege netjes hersteld (geen bevroren
    ' scherm of hangende voortgangsbalk meer).
    On Error GoTo Opkuis

    ' Schermopbouw en automatische herberekening uit tijdens het laden — samen
    ' met setDataArray (zie helpers) is dit de grote snelheidswinst.
    bAutoCalc = oDoc.isAutomaticCalculationEnabled()
    oDoc.lockControllers()
    bLocked = True
    oDoc.enableAutomaticCalculation(False)

    ' JDBC-verbinding openen (juiste omgeving via MaakDBVerbinding)
    oConn = MaakDBVerbinding()

    ' Loop over elke tabel — bulk inladen via één setDataArray (zie LaadTabelSnel)
    Dim nTabellen As Integer : nTabellen = UBound(tabellen) + 1
    For i = 0 To UBound(tabellen)
        Dim sNaam As String
        sNaam = tabellen(i)
        oIndicator.setValue((i + 1) * 80 \ nTabellen)
        oIndicator.setText("Laden: " & sNaam & " (" & (i + 1) & "/" & nTabellen & ")")
        LaadTabelSnel(oSheets, oConn, sNaam)
    Next i

    ' klanten_beheer: geselecteerde kolommen, bulk via setDataArray (zie LaadKlantenBeheer)
    oIndicator.setValue(85)
    oIndicator.setText("Laden: klanten_beheer (12/12)")
    LaadKlantenBeheer(oSheets, oConn)

    ' --- Nieuwe uitschrijvers voor de aanbodmail (opt-out) verzamelen + markeren ---
    ' Defensief: op een nog niet-gemigreerde DB ontbreken de kolommen → stil overslaan.
    Dim oStu As Object, oRSu As Object
    On Error Resume Next
    oStu = oConn.createStatement()
    oRSu = oStu.executeQuery( _
        "SELECT voornaam, familienaam, COALESCE(email1,''), " & _
        "COALESCE(to_char(mail_opt_out_op,'DD/MM/YYYY'),''), COALESCE(mail_opt_out_reden,''), " & _
        "COALESCE(mail_opt_out_methode,''), COALESCE(type,'') " & _
        "FROM klanten WHERE mail_opt_out = true AND mail_opt_out_gemeld = false " & _
        "ORDER BY mail_opt_out_op")
    If Err = 0 Then
        Do While oRSu.next()
            nUit = nUit + 1
            sUit = sUit & "- " & Trim(oRSu.getString(1) & " " & oRSu.getString(2)) & _
                   " (" & oRSu.getString(3) & ")"
            If oRSu.getString(4) <> "" Then sUit = sUit & " - " & oRSu.getString(4)
            If oRSu.getString(6) <> "" Then sUit = sUit & " - via: " & oRSu.getString(6)
            If oRSu.getString(7) <> "" Then sUit = sUit & " - huidig type: " & oRSu.getString(7)
            If oRSu.getString(5) <> "" Then sUit = sUit & " - reden: " & oRSu.getString(5)
            sUit = sUit & Chr(10)
        Loop
        oRSu.close()
        oStu.close()
        If nUit > 0 Then
            oStu = oConn.createStatement()
            oStu.executeUpdate("UPDATE klanten SET mail_opt_out_gemeld = true " & _
                "WHERE mail_opt_out = true AND mail_opt_out_gemeld = false")
            oStu.close()
        End If
    End If

    ' --- Nieuwe KOFFIE-uitschrijvers (aparte opt-out, los van groenten) ---
    oStu = oConn.createStatement()
    oRSu = oStu.executeQuery( _
        "SELECT voornaam, familienaam, COALESCE(email1,''), " & _
        "COALESCE(to_char(koffie_opt_out_op,'DD/MM/YYYY'),''), COALESCE(koffie_opt_out_reden,''), " & _
        "COALESCE(koffie_opt_out_methode,''), COALESCE(type,'') " & _
        "FROM klanten WHERE koffie_opt_out = true AND koffie_opt_out_gemeld = false " & _
        "ORDER BY koffie_opt_out_op")
    If Err = 0 Then
        Do While oRSu.next()
            nUitK = nUitK + 1
            sUitK = sUitK & "- " & Trim(oRSu.getString(1) & " " & oRSu.getString(2)) & _
                   " (" & oRSu.getString(3) & ")"
            If oRSu.getString(4) <> "" Then sUitK = sUitK & " - " & oRSu.getString(4)
            If oRSu.getString(6) <> "" Then sUitK = sUitK & " - via: " & oRSu.getString(6)
            If oRSu.getString(7) <> "" Then sUitK = sUitK & " - huidig type: " & oRSu.getString(7)
            If oRSu.getString(5) <> "" Then sUitK = sUitK & " - reden: " & oRSu.getString(5)
            sUitK = sUitK & Chr(10)
        Loop
        oRSu.close()
        oStu.close()
        If nUitK > 0 Then
            oStu = oConn.createStatement()
            oStu.executeUpdate("UPDATE klanten SET koffie_opt_out_gemeld = true " & _
                "WHERE koffie_opt_out = true AND koffie_opt_out_gemeld = false")
            oStu.close()
        End If
    End If
    On Error GoTo 0

    ' Het opt-out-blok hierboven zette de errorhandler uit (On Error GoTo 0);
    ' opnieuw arming zodat ook fouten in de afronding netjes opgekuist worden.
    On Error GoTo Opkuis
    oConn.close()

    ' Herberekenen en UI terug vrijgeven
    oDoc.calculateAll()
    oDoc.enableAutomaticCalculation(bAutoCalc)
    If bLocked Then
        oDoc.unlockControllers()
        bLocked = False
    End If

    oIndicator.setValue(100)
    oIndicator.end()
    MsgBox "Alle tabellen geladen!", 64, "Klaar"
    ' De uitleg staat in de body, niet in de titel: een MsgBox-titel kapt af
    ' op de eerste Chr(10), dus een tweede titelregel is onzichtbaar.
    If nUit > 0 Then MsgBox sUit & Chr(10) & UitschrijfAdvies("mail_opt_out (kolom AC)"), _
        48, nUit & " nieuwe uitschrijver(s) voor de aanbodmail"
    If nUitK > 0 Then MsgBox sUitK & Chr(10) & UitschrijfAdvies("koffie_opt_out (kolom AE)") & Chr(10) & _
        "Let op: wie enkel de KOFFIE-mails afmeldt, blijft gewoon groentenklant." & Chr(10) & _
        "Type op stop-definitief zetten is enkel aan de orde als hij zich ook" & Chr(10) & _
        "voor de groenten-aanbodmail uitschreef (of geen groenten afneemt).", _
        48, nUitK & " nieuwe KOFFIE-uitschrijver(s)"
    SluitSSHTunnels()
    Exit Sub

Opkuis:
    ' UI-staat ALTIJD herstellen, ook bij een fout halverwege — anders blijft het
    ' scherm vergrendeld en de voortgangsbalk hangen (zoals bij de nachtelijke hang).
    Dim sFout As String
    sFout = "Fout " & Err & " op regel " & Erl & ": " & Error & _
            Chr(10) & "Stap: " & mStap
    On Error Resume Next
    If Not IsNull(oConn) Then oConn.close()
    oDoc.enableAutomaticCalculation(bAutoCalc)
    If bLocked Then oDoc.unlockControllers()
    If Not IsNull(oIndicator) Then oIndicator.end()
    SluitSSHTunnels()
    On Error GoTo 0
    MsgBox sFout & Chr(10) & Chr(10) & _
           "De inlees is NIET volledig afgerond. Controleer of de SSH-tunnel/DB-" & _
           "verbinding actief is (poort 5433) en probeer opnieuw.", 16, "Laden mislukt"

End Sub


