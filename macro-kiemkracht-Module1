' ---------------------------------------------------------------------------
' LaadTabelSnel — laadt één DB-tabel volledig in een gelijknamig tabblad met
' één setDataArray-aanroep (veel sneller dan cel-per-cel). Numerieke SQL-types
' worden naar getal omgezet, de rest blijft tekst (zelfde gedrag als voorheen).
' ---------------------------------------------------------------------------
Private Sub LaadTabelSnel(oSheets As Object, oConn As Object, sNaam As String)
    Dim oSheet As Object, oStmt As Object, oRS As Object, oMeta As Object, oRange As Object
    Dim nKolommen As Integer, col As Integer, t As Integer
    Dim nRows As Long, r As Long
    Dim sVal As String, dVal As Double, bOk As Boolean
    Dim aOut As Variant, aRij As Variant
    Dim bNum() As Boolean

    ' Tabblad ophalen of aanmaken, daarna volledig leegmaken
    mStap = sNaam & " — tabblad leegmaken"
    If oSheets.hasByName(sNaam) Then
        oSheet = oSheets.getByName(sNaam)
    Else
        oSheets.insertNewByName(sNaam, oSheets.Count)
        oSheet = oSheets.getByName(sNaam)
    End If
    oSheet.clearContents(7)

    ' Aantal rijen vooraf, om het doelbereik (en dus het sjabloon) op maat te maken
    mStap = sNaam & " — rijen tellen"
    oStmt = oConn.createStatement()
    On Error Resume Next
    oStmt.QueryTimeOut = 60      ' faal i.p.v. eindeloos hangen bij een dode verbinding
    On Error GoTo 0
    oRS = oStmt.executeQuery("SELECT COUNT(*) FROM " & sNaam)
    nRows = 0
    If oRS.next() Then nRows = oRS.getInt(1)
    oRS.close()

    ' Gegevens + metadata ophalen. ORDER BY id: zonder expliciete sortering geeft
    ' Postgres de fysieke scanvolgorde terug (na deletes/vacuum dus NIET chrono-
    ' logisch) — nieuwe/backfilled rijen kunnen dan ergens middenin het tabblad
    ' opduiken i.p.v. onderaan. Casus 2026-07-08: backfill-rijen voor klant 3177/
    ' 3197 (annulaties) stonden op fysieke positie 64-65 van 114, niet aan het
    ' eind — leek zo alsof de rijen ontbraken. Alle 12 geladen tabellen hebben
    ' een id-kolom (geverifieerd), dus generiek toepasbaar.
    mStap = sNaam & " — query + kolommen"
    oRS   = oStmt.executeQuery("SELECT * FROM " & sNaam & " ORDER BY id")
    oMeta = oRS.getMetaData()
    nKolommen = oMeta.getColumnCount()

    ReDim bNum(nKolommen - 1)
    For col = 1 To nKolommen
        t = oMeta.getColumnType(col)
        bNum(col - 1) = (t >= 2 And t <= 8)   ' numerieke SQL-types
    Next col

    ' Sjabloon met de JUISTE UNO-structuur uit het doelbereik zelf halen
    ' (rij 0 = kop, rijen 1..nRows = data). We schrijven RECHTSTREEKS in de
    ' sjabloonrijen — geen geneste Basic-array opbouwen of aan een Sub doorgeven,
    ' want StarBasic verliest daarbij de rij-inhoud (aBronLen=0).
    mStap = sNaam & " — sjabloon (" & (nRows + 1) & " rijen x " & nKolommen & " kol)"
    oRange = oSheet.getCellRangeByPosition(0, 0, nKolommen - 1, nRows)
    aOut = oRange.getDataArray()

    ' Koprij
    aRij = aOut(0)
    For col = 1 To nKolommen
        aRij(col - 1) = oMeta.getColumnName(col)
    Next col
    aOut(0) = aRij

    ' Datarijen
    mStap = sNaam & " — rijen schrijven"
    r = 1
    Do While oRS.next()
        If r > UBound(aOut) Then Exit Do      ' veiligheid bij onverwachte drift
        aRij = aOut(r)
        For col = 1 To nKolommen
            sVal = oRS.getString(col)
            If oRS.wasNull() Then
                aRij(col - 1) = ""
            ElseIf bNum(col - 1) Then
                bOk = True
                On Error Resume Next
                dVal = CDbl(Replace(sVal, ".", ","))
                If Err <> 0 Then bOk = False
                On Error GoTo 0
                If bOk Then aRij(col - 1) = dVal Else aRij(col - 1) = sVal
            Else
                aRij(col - 1) = sVal
            End If
        Next col
        aOut(r) = aRij
        r = r + 1
    Loop
    oRS.close()
    oStmt.close()

    mStap = sNaam & " — wegschrijven"
    oRange.setDataArray(aOut)
End Sub


' ---------------------------------------------------------------------------
' LaadKlantenBeheer — schrijft de geselecteerde klanten-kolommen naar twee
' aaneengesloten blokken: F-J (5-9) en L-Z (11-25). Kolom K (10) bevat
' gebruikersformules en blijft ongemoeid. Bulk via setDataArray.
' ---------------------------------------------------------------------------
Private Sub LaadKlantenBeheer(oSheets As Object, oConn As Object)
    Dim oKB As Object, oStmt As Object, oRS As Object, oRngA As Object, oRngB As Object, oRngD As Object
    Dim kbKol(20) As String
    Dim j As Integer
    Dim nRows As Long, r As Long
    Dim sVal As String
    Dim aOutA As Variant, aOutB As Variant, aOutD As Variant, aRij As Variant, aRijD As Variant

    kbKol(0)  = "voornaam"         : kbKol(1)  = "familienaam"
    kbKol(2)  = "voornaam2"        : kbKol(3)  = "familienaam2"
    kbKol(4)  = "afhaalpunt_id"    : kbKol(5)  = "type"
    kbKol(6)  = "formaat"          : kbKol(7)  = "email1"
    kbKol(8)  = "email2"           : kbKol(9)  = "email3"
    kbKol(10) = "email4"           : kbKol(11) = "telefoon"
    kbKol(12) = "opmerkingen"      : kbKol(13) = "opmerkingen_volgend"
    kbKol(14) = "opmerking_status" : kbKol(15) = "nooit_groenten"
    kbKol(16) = "email_afrekening"       : kbKol(17) = "voornaam_afrekening"
    kbKol(18) = "familienaam_afrekening" : kbKol(19) = "nooit_afrekening"
    kbKol(20) = "afhaalpunt_alternatieven"   ' backlog #27, CSV van afhaalpunt-namen

    If oSheets.hasByName("klanten_beheer") Then
        oKB = oSheets.getByName("klanten_beheer")
    Else
        oSheets.insertNewByName("klanten_beheer", oSheets.Count)
        oKB = oSheets.getByName("klanten_beheer")
    End If

    ' F-J (5-9) en L-AB (11-27) wissen; K (10) bevat gebruikersformules.
    ' AB (27) = interne alternatieven-snapshot, zie onderaan deze Sub.
    ' AC-AF (28-31) = opt-outs (mail/koffie), zie onderaan deze Sub.
    oKB.getCellRangeByPosition(5,  0, 9,  10000).clearContents(7)
    oKB.getCellRangeByPosition(11, 0, 27, 10000).clearContents(7)
    oKB.getCellRangeByPosition(28, 0, 31, 10000).clearContents(7)

    ' Aantal rijen vooraf, om de sjablonen op maat te maken
    mStap = "klanten_beheer — rijen tellen"
    oStmt = oConn.createStatement()
    On Error Resume Next
    oStmt.QueryTimeOut = 60
    On Error GoTo 0
    oRS = oStmt.executeQuery("SELECT COUNT(*) FROM klanten")
    nRows = 0
    If oRS.next() Then nRows = oRS.getInt(1)
    oRS.close()

    ' Data (zelfde volgorde als klanten-tabblad: ORDER BY id, zie LaadTabelSnel)
    ' nooit_afrekening (boolean) bewust NIET gecast: getString geeft dan dezelfde
    ' waarde als het klanten-tabblad (SELECT *), zodat de wijzigingsvergelijking
    ' in SchrijfWijzigingenTerug geen valse verschillen ziet.
    oRS = oStmt.executeQuery( _
        "SELECT voornaam, familienaam, voornaam2, familienaam2, afhaalpunt_id, " & _
        "type, formaat, email1, email2, email3, email4, telefoon, " & _
        "opmerkingen, opmerkingen_volgend, opmerking_status, nooit_groenten, " & _
        "email_afrekening, voornaam_afrekening, familienaam_afrekening, nooit_afrekening, " & _
        "(SELECT string_agg(ap.naam, ',' ORDER BY ap.naam) FROM klant_afhaalpunt_alternatieven kaa " & _
        " JOIN afhaalpunten ap ON ap.id = kaa.afhaalpunt_id WHERE kaa.klant_id = klanten.id), " & _
        "mail_opt_out, mail_opt_out_reden, koffie_opt_out, koffie_opt_out_reden " & _
        "FROM klanten ORDER BY id")

    ' Twee sjablonen uit de doelbereiken zelf (juiste UNO-structuur); rechtstreeks
    ' invullen, geen geneste Basic-array opbouwen/doorgeven. F-J = querykolommen
    ' 1-5, L-AA = querykolommen 6-21.
    mStap = "klanten_beheer — sjablonen (" & (nRows + 1) & " rijen)"
    oRngA = oKB.getCellRangeByPosition(5,  0, 9,  nRows)
    oRngB = oKB.getCellRangeByPosition(11, 0, 26, nRows)
    oRngD = oKB.getCellRangeByPosition(28, 0, 31, nRows)
    aOutA = oRngA.getDataArray()
    aOutB = oRngB.getDataArray()
    aOutD = oRngD.getDataArray()

    ' Koprijen
    aRij = aOutA(0)
    For j = 0 To 4
        aRij(j) = kbKol(j)
    Next j
    aOutA(0) = aRij
    aRij = aOutB(0)
    For j = 0 To 15
        aRij(j) = kbKol(j + 5)
    Next j
    aOutB(0) = aRij
    aRijD = aOutD(0)
    aRijD(0) = "mail_opt_out"   : aRijD(1) = "mail_opt_out_reden"
    aRijD(2) = "koffie_opt_out" : aRijD(3) = "koffie_opt_out_reden"
    aOutD(0) = aRijD

    ' Datarijen — rechtstreeks in de sjabloonrijen schrijven
    mStap = "klanten_beheer — rijen schrijven"
    r = 1
    Do While oRS.next()
        If r > UBound(aOutA) Then Exit Do
        aRij = aOutA(r)
        For j = 0 To 4
            sVal = oRS.getString(j + 1)
            If oRS.wasNull() Then sVal = ""
            aRij(j) = sVal
        Next j
        aOutA(r) = aRij
        aRij = aOutB(r)
        For j = 0 To 15
            sVal = oRS.getString(j + 6)
            If oRS.wasNull() Then sVal = ""
            aRij(j) = sVal
        Next j
        aOutB(r) = aRij
        aRijD = aOutD(r)
        For j = 0 To 3
            sVal = oRS.getString(j + 22)
            If oRS.wasNull() Then sVal = ""
            aRijD(j) = sVal
        Next j
        aOutD(r) = aRijD
        r = r + 1
    Loop
    oRS.close()
    oStmt.close()

    mStap = "klanten_beheer — wegschrijven"
    oRngA.setDataArray(aOutA)
    oRngB.setDataArray(aOutB)
    oRngD.setDataArray(aOutD)

    ' Kolom AB (27) = verborgen "vorige waarde"-snapshot van de alternatieven
    ' (kolom AA, laatste veld in aOutB). SchrijfWijzigingenTerug vergelijkt
    ' AA tegen AB om een bewerking te detecteren — afhaalpunt_alternatieven
    ' is géén kolom op klanten, dus het klanten-tabblad kan hier niet als
    ' vergelijkingsbasis dienen zoals bij de andere velden.
    mStap = "klanten_beheer — alternatieven-snapshot"
    Dim oRngC As Object : oRngC = oKB.getCellRangeByPosition(27, 0, 27, nRows)
    Dim aOutC As Variant : aOutC = oRngC.getDataArray()
    Dim aRijC As Variant
    aRijC = aOutC(0) : aRijC(0) = "afhaalpunt_alternatieven_vorig (NIET AANPASSEN)" : aOutC(0) = aRijC
    Dim rC As Long
    For rC = 1 To UBound(aOutC)
        aRij = aOutB(rC)
        aRijC = aOutC(rC)
        aRijC(0) = aRij(15)
        aOutC(rC) = aRijC
    Next rC
    oRngC.setDataArray(aOutC)
End Sub


Sub MaakWeekbestand()

    ' =============================================
    ' Kiemkracht - Weekbestand aanmaken
    ' =============================================

    ' Actief kiemkracht-data-bestand vastleggen vóór aanmaak nieuw document
    ' (ThisComponent wijzigt daarna). Prod of dev volgt dit bestand.
    Dim oCallerDoc As Object
    oCallerDoc = HuidigDataDocument()
    If IsNull(oCallerDoc) Then
        MsgBox "Geen kiemkracht-data-bestand actief. Open kiemkracht-data.ods " & _
               "of kiemkracht-data-dev.ods en start de macro vanuit dat venster.", 16, "Fout"
        Exit Sub
    End If

    ' DB-verbinding en SSH-tunnel: zie MaakDBVerbinding()
    ' Bestandslocatie: zie JaarMap() — week-submappen zitten per jaar gegroepeerd.

    ' Weeknummer en datums: vanaf zaterdag → komende week, anders huidige week
    Dim dVandaag   As Date
    Dim iWeekdag   As Integer
    Dim dMaandag   As Date
    Dim dDonderdag As Date
    Dim dVrijdag   As Date
    Dim iWeek      As Integer
    Dim iJaar      As Integer

    dVandaag = Now()
    iWeekdag = Weekday(dVandaag, 1)  ' 1=zo, 2=ma, ..., 6=vr, 7=za

    If iWeekdag = 7 Then
        dMaandag = dVandaag + 2   ' za → ma volgende week
    ElseIf iWeekdag = 1 Then
        dMaandag = dVandaag + 1   ' zo → ma volgende week
    Else
        dMaandag = dVandaag - (Weekday(dVandaag, 2) - 1)  ' ma t/m vr: huidige week
    End If

    dDonderdag = dMaandag + 3
    dVrijdag   = dMaandag + 4
    iWeek = DatePart("ww", dDonderdag, 2, 2)
    iJaar = Year(dDonderdag)

    ' Dev-only: optioneel een andere (komende) week genereren om te testen,
    ' bv. een onpare week terwijl het een pare week is. Op prod ongewijzigd.
    ' ENTER (= de voorgevulde week) of Annuleren laat de berekende week staan.
    ' WeekNaarDonderdag zoekt vooruit, dus kies een week >= de huidige.
    If BepaalOmgeving() = "dev" Then
        Dim sWeekIn As String
        sWeekIn = InputBox("Weeknummer voor het weekbestand (ENTER = " & iWeek & "):" & Chr(10) & _
                           "Enkel om te testen op dev — kies een komende week.", _
                           "MaakWeekbestand (dev)", CStr(iWeek))
        If IsNumeric(sWeekIn) Then
            Dim iWeekIn As Integer : iWeekIn = CInt(sWeekIn)
            If iWeekIn >= 1 And iWeekIn <= 53 And iWeekIn <> iWeek Then
                Dim dDoOverride As Date : dDoOverride = WeekNaarDonderdag(iWeekIn)
                If dDoOverride > 0 Then
                    dDonderdag = dDoOverride
                    dMaandag   = dDonderdag - 3
                    dVrijdag   = dDonderdag + 1
                    iWeek      = iWeekIn
                    iJaar      = Year(dDonderdag)
                End If
            End If
        End If
    End If

    ' Pare of onpare week
    Dim sPareWeek As String
    If (iWeek Mod 2) = 0 Then
        sPareWeek = "pare week"
    Else
        sPareWeek = "onpare week"
    End If

    ' Maandnaam
    Dim saMaanden(12) As String
    saMaanden(1)  = "januari"  : saMaanden(2)  = "februari"
    saMaanden(3)  = "maart"    : saMaanden(4)  = "april"
    saMaanden(5)  = "mei"      : saMaanden(6)  = "juni"
    saMaanden(7)  = "juli"     : saMaanden(8)  = "augustus"
    saMaanden(9)  = "september": saMaanden(10) = "oktober"
    saMaanden(11) = "november" : saMaanden(12) = "december"
    Dim sMaand As String
    sMaand = saMaanden(Month(dDonderdag))

    ' Datum in formaat YYMMDD
    Dim sDatumKort As String
    sDatumKort = Right(CStr(iJaar), 2) & _
                 Right("0" & Month(dDonderdag), 2) & _
                 Right("0" & Day(dDonderdag), 2)

    ' Weekbestand-naam: de dev-omgeving krijgt een -dev-achtervoegsel zodat
    ' een dev-weekbestand niet botst met (of overschreven wordt door) het
    ' prod-weekbestand met dezelfde week.
    Dim sBestand   As String
    Dim sOmgSuffix As String
    If BepaalOmgeving() = "dev" Then sOmgSuffix = "-dev" Else sOmgSuffix = ""

    Dim sWeekMap As String
    sWeekMap = JaarMap(iJaar) & iJaar & "_week_" & iWeek & "\"
    If Not FileExists(sWeekMap) Then MkDir(sWeekMap)

    sBestand = sWeekMap & "week_" & iWeek & "_" & iJaar & sOmgSuffix & ".ods"

    ' JDBC-verbinding (juiste omgeving via MaakDBVerbinding)
    On Error GoTo VerbindingsFout
    Dim oConn As Object
    oConn = MaakDBVerbinding()
    On Error GoTo 0

    Dim oStmt As Object
    Dim oRS   As Object

    ' --- Stap 0: afhaalpunten volgorde (donderdag voor vrijdag, dan id) ---
    oStmt = oConn.createStatement()
    oRS = oStmt.executeQuery( _
        "SELECT naam, dag_klaarmaken FROM afhaalpunten " & _
        "ORDER BY dag_klaarmaken ASC, id_intern ASC")
    Dim afhNaam(20) As String
    Dim afhDag(20)  As String
    Dim nAfh As Integer
    nAfh = 0
    Do While oRS.next()
        afhNaam(nAfh) = oRS.getString(1)
        afhDag(nAfh)  = oRS.getString(2)
        nAfh = nAfh + 1
    Loop
    oRS.close() : oStmt.close()

    ' --- Stap 1: unieke groenten deze week (kolomhoofden) ---
    oStmt = oConn.createStatement()
    oRS = oStmt.executeQuery( _
        "SELECT naam, eenheid, BOOL_OR(per_stuk), MIN(prijs) FROM groenten " & _
        "WHERE weeknummer = " & iWeek & " AND jaar = " & iJaar & _
        " GROUP BY naam, eenheid" & _
        " ORDER BY MIN(volgorde), MIN(id)")
    Dim groentNaam(50) As String
    Dim groentEenh(50) As String
    Dim groentPerStuk(50) As Boolean   ' "x "-notatie nodig (Sheets-vinkje → groenten.per_stuk)
    Dim groentPrijs(50) As Double      ' prijs per eenheid (voor rij 3 + afrekening)
    Dim nGroenten As Integer
    nGroenten = 0
    Do While oRS.next()
        groentNaam(nGroenten)    = oRS.getString(1)
        groentEenh(nGroenten)    = oRS.getString(2)
        groentPerStuk(nGroenten) = oRS.getBoolean(3)
        groentPrijs(nGroenten)   = oRS.getDouble(4)
        nGroenten = nGroenten + 1
    Loop
    oRS.close() : oStmt.close()

    ' --- Stap 1b: vangnet voor bestelde groenten die niet (meer) in het aanbod staan ---
    ' De koppeling bestelregel → kolom loopt op NAAM (stap 5 hieronder). Hernoem je
    ' een losse groente in de cockpit terwijl er al besteld is — of haal je ze uit
    ' het aanbod — dan houden de al geplaatste bestelregels de OUDE naam en vallen ze
    ' hier STIL weg: die klanten krijgen hun groente niet en betalen ze niet. Gebeurd
    ' in week 32/2026 ("Meloen Charentais" → "Meloen Charentais (volop!)" tijdens het
    ' open bestelvenster: 22 klanten, 23 meloenen; achteraf rechtgezet in de DB).
    ' Daarom krijgt elke bestelde naam die deze week niet in 'groenten' staat achteraan
    ' een eigen kolom, met eenheid/prijs/x-notatie uit de recentste week (<= deze)
    ' waarin die naam wél bestond — anders 0,00 € / "stuk". Zelfde principe als het
    ' weglating-vangnet in stap 2. sHernoemRapport meldt het achteraf: twee kolommen
    ' samenvoegen (hernoeming) of de kolom net wél wissen (groente niet oogstbaar)
    ' blijft mensenwerk, maar vertrekt nu van zichtbare data i.p.v. van stille uitval.
    Dim sHernoemRapport As String
    Dim nHernoem        As Integer
    Dim lHnWeekNum      As Long
    Dim sHnNaam         As String
    Dim sHnStuks        As String
    Dim sHnInfo         As String
    sHernoemRapport = ""
    nHernoem   = 0
    lHnWeekNum = CLng(iJaar) * 100 + iWeek
    oStmt = oConn.createStatement()
    oRS = oStmt.executeQuery( _
        "SELECT x.naam, COALESCE(h.eenheid, 'stuk'), COALESCE(h.per_stuk, false), " & _
        "COALESCE(h.prijs, 0), x.klanten, x.stuks, (h.eenheid IS NULL) " & _
        "FROM (SELECT br.groente_naam AS naam, COUNT(*) AS klanten, SUM(br.aantal) AS stuks " & _
        "FROM bestelregels br " & _
        "INNER JOIN bestellingen bst ON bst.id = br.bestelling_id " & _
        "WHERE bst.weeknummer = " & iWeek & " AND bst.jaar = " & iJaar & " " & _
        "AND NOT EXISTS (SELECT 1 FROM groenten g WHERE g.jaar = bst.jaar " & _
        "AND g.weeknummer = bst.weeknummer AND g.naam = br.groente_naam) " & _
        "GROUP BY br.groente_naam) x " & _
        "LEFT JOIN LATERAL (SELECT g2.eenheid, g2.per_stuk, g2.prijs FROM groenten g2 " & _
        "WHERE g2.naam = x.naam AND (g2.jaar * 100 + g2.weeknummer) <= " & lHnWeekNum & " " & _
        "ORDER BY g2.jaar DESC, g2.weeknummer DESC LIMIT 1) h ON true " & _
        "ORDER BY x.naam")
    Do While oRS.next()
        sHnNaam  = oRS.getString(1)
        sHnStuks = oRS.getString(6)
        If Len(sHnStuks) > 3 And Right(sHnStuks, 3) = ".00" Then
            sHnStuks = Left(sHnStuks, Len(sHnStuks) - 3)
        End If
        sHnInfo  = oRS.getString(5) & " klant(en), " & sHnStuks & " besteld"
        nHernoem = nHernoem + 1
        ' Grens: er zijn 24 groente-slots vanaf kolom Y (nGroentSlots/cGroent0
        ' staan verderop bij de kolomindices) — daarna loopt de layout in de
        ' "ander"-kolom, dus dan enkel melden i.p.v. toevoegen.
        If nGroenten >= 24 Then
            sHernoemRapport = sHernoemRapport & "   - " & sHnNaam & " (" & sHnInfo & _
                ") — GEEN VRIJ SLOT MEER, met de hand opnemen!" & Chr(10)
        Else
            groentNaam(nGroenten)    = sHnNaam
            groentEenh(nGroenten)    = oRS.getString(2)
            groentPerStuk(nGroenten) = oRS.getBoolean(3)
            groentPrijs(nGroenten)   = oRS.getDouble(4)
            sHernoemRapport = sHernoemRapport & "   - " & sHnNaam & " (" & sHnInfo & _
                ") -> kolom " & KolomLetter(24 + nGroenten)
            If oRS.getBoolean(7) Then
                sHernoemRapport = sHernoemRapport & _
                    ", PRIJS ONBEKEND (0,00 " & Chr(8364) & ") - zelf invullen in rij 3"
            End If
            sHernoemRapport = sHernoemRapport & Chr(10)
            nGroenten = nGroenten + 1
        End If
    Loop
    oRS.close() : oStmt.close()

    ' --- Pakketprijzen (voor het afrekeningstabblad) ---
    Dim prijsKlein As Double, prijsGroot As Double
    Dim prijsEGroot As Double, prijsMini As Double
    oStmt = oConn.createStatement()
    oRS = oStmt.executeQuery("SELECT sleutel, prijs FROM pakketten")
    Do While oRS.next()
        Select Case oRS.getString(1)
            Case "klein"       : prijsKlein  = oRS.getDouble(2)
            Case "groot"       : prijsGroot  = oRS.getDouble(2)
            Case "extra-groot" : prijsEGroot = oRS.getDouble(2)
            Case "mini"        : prijsMini   = oRS.getDouble(2)
        End Select
    Loop
    oRS.close() : oStmt.close()

    ' --- Pakketwaardes per (formaat, groente) — bron voor weglatingen-verrekening ---
    ' Komt uit pakket_inhoud.waarde (gesynct vanuit Sheets "€ in pakket").
    ' Belandt in een bewerkbaar tabblad "pakketwaardes"; de afrekening verwijst
    ' ernaar zodat manuele bijsturing in het weekbestand meteen doorwerkt.
    ' ORDER BY pi.id (= invoeg-/Sheets-volgorde) i.p.v. alfabetisch: de groenten
    ' verschijnen in de volgorde van de Google Sheet (eerste voorkomen wint bij
    ' de dedup hieronder). Deze volgorde stuurt zowel het pakketwaardes-tabblad
    ' als de koprij van de weglating-kolommen aan.
    Dim pwNaam(200) As String
    Dim pwKG(200)   As Double, pwGG(200) As Double
    Dim pwEGG(200)  As Double, pwMINI(200) As Double
    Dim nPW         As Integer
    Dim sPwSleutel  As String, sPwNaam As String
    Dim dPwWaarde   As Double
    Dim iPwIdx      As Integer, iPw As Integer
    nPW = 0
    oStmt = oConn.createStatement()
    oRS = oStmt.executeQuery( _
        "SELECT p.sleutel, pi.groente_naam, pi.waarde " & _
        "FROM pakket_inhoud pi JOIN pakketten p ON p.id = pi.pakket_id " & _
        "WHERE pi.weeknummer = " & iWeek & " AND pi.jaar = " & iJaar & _
        " ORDER BY pi.id")
    Do While oRS.next()
        sPwSleutel = oRS.getString(1)
        sPwNaam    = oRS.getString(2)
        dPwWaarde  = oRS.getDouble(3)
        iPwIdx = -1
        For iPw = 0 To nPW - 1
            If pwNaam(iPw) = sPwNaam Then
                iPwIdx = iPw
                Exit For
            End If
        Next iPw
        If iPwIdx = -1 Then
            iPwIdx = nPW
            pwNaam(nPW) = sPwNaam
            pwKG(nPW) = 0 : pwGG(nPW) = 0 : pwEGG(nPW) = 0 : pwMINI(nPW) = 0
            nPW = nPW + 1
        End If
        Select Case sPwSleutel
            Case "klein"       : pwKG(iPwIdx)   = dPwWaarde
            Case "groot"       : pwGG(iPwIdx)   = dPwWaarde
            Case "extra-groot" : pwEGG(iPwIdx)  = dPwWaarde
            Case "mini"        : pwMINI(iPwIdx) = dPwWaarde
        End Select
    Loop
    oRS.close() : oStmt.close()

    ' --- Stap 2: weglating-slots = alle potentieel weg te laten groenten ---
    ' De koprij (rij 3) van de weglating-kolommen (AZ+) krijgt ALLE groenten die
    ' deze week in een pakket (kunnen) zitten — bron 'pakketwaardes' (pwNaam), in
    ' DB-/Sheets-volgorde — ook als geen enkele klant ze weglaat. Zo staan de
    ' juiste namen meteen klaar voor (handmatige) markering. De markeringen per
    ' klant (bWeg) komen nog steeds uit bestelling_weglatingen, op naam gematcht.
    ' Bovengrens: max. 12 verschillende pakketgroenten per week (= 12 weglating-
    ' kolommen); 20 geeft wat marge voor het vangnet hieronder.
    Dim wegNaam(20) As String
    Dim nWeg As Integer
    Dim iWg As Integer
    nWeg = 0
    For iWg = 0 To nPW - 1
        wegNaam(nWeg) = pwNaam(iWg)
        nWeg = nWeg + 1
    Next iWg
    ' Vangnet: een effectief weggelaten groente die (door een data-afwijking) niet
    ' in pakketwaardes zit, achteraan toevoegen zodat ze niet wegvalt.
    oStmt = oConn.createStatement()
    oRS = oStmt.executeQuery( _
        "SELECT DISTINCT bw.groente_naam FROM bestelling_weglatingen bw " & _
        "INNER JOIN bestellingen b ON b.id = bw.bestelling_id " & _
        "WHERE b.weeknummer = " & iWeek & " AND b.jaar = " & iJaar & _
        " ORDER BY bw.groente_naam")
    Dim sWgChk As String
    Dim bWgIn  As Boolean
    Do While oRS.next()
        sWgChk = oRS.getString(1)
        bWgIn = False
        For iWg = 0 To nWeg - 1
            If wegNaam(iWg) = sWgChk Then bWgIn = True : Exit For
        Next iWg
        If Not bWgIn And nWeg < 20 Then
            wegNaam(nWeg) = sWgChk
            nWeg = nWeg + 1
        End If
    Loop
    oRS.close() : oStmt.close()

    ' Aantal weglating-slots: altijd minstens 12 kolommen klaar (zoals de 24
    ' groente-slots), zodat een handmatig toegevoegde weglating-groente meteen
    ' meeloopt. nWeg blijft het aantal ECHTE weglatingen (namen + markeringen).
    Dim nWegSlots As Integer
    nWegSlots = nWeg
    If nWegSlots < 12 Then nWegSlots = 12

    ' --- Stap 3: bestellingen + abonnees zonder bestelling deze week ---
    ' Ritme-set die in DEZE week (pariteit) een pakket oplevert. Een abonnement
    ' met ritme 'wekelijks' telt altijd mee; 'pare-week'/'onpare-week' enkel in de
    ' overeenkomstige pariteit. Vervangt de oude type-gebaseerde sPareFilter/
    ' sTak3Types: het ritme zit nu in abonnementen.ritme, de relatie-status in
    ' klanten.status (weekperweek = status 'actief' zonder actieve abonnement-rij).
    ' TAK 2 = abonnees met een ritme dat deze week matcht; TAK 3 = actieve klanten
    ' met een vooruitbestelling die NIET door TAK 2 gedekt worden (weekperweek,
    ' off-pariteit-abonnees, toekomst-abonnees).
    Dim sParRitmes As String
    If (iWeek Mod 2) = 0 Then
        sParRitmes = "'wekelijks','pare-week'"
    Else
        sParRitmes = "'wekelijks','onpare-week'"
    End If
    ' Weeknummer (jaar*100+week) voor de pauze-conditie: een abonnement levert
    ' deze week zolang het niet gepauzeerd is vanaf een week <= deze.
    Dim iWeekNum As Long : iWeekNum = CLng(iJaar) * 100 + iWeek
    Dim sNietGepauzeerd As String
    sNietGepauzeerd = " AND (a.pauze_vanaf_week IS NULL OR " & _
                      "(a.pauze_vanaf_jaar * 100 + a.pauze_vanaf_week) > " & iWeekNum & ") "
    oStmt = oConn.createStatement()
    ' CTE vb_week: vooruitbestellingen voor deze week met naam→sleutel-mapping
    ' van het formaat-veld (DB slaat de pakketnaam op, bv. 'Groot pakket').
    ' Wordt in TAK 2 gebruikt als formaat-override op klant.formaat, en in
    ' TAK 3 (NIEUW) om weekperweek-/toekomst-klanten met een vooruitbestelling
    ' voor deze week alsnog op te nemen in het weekbestand zonder dat de
    ' klant via de bevestigingsmail expliciet hoeft te klikken.
    oRS = oStmt.executeQuery( _
        "WITH vb_week AS (" & _
        "  SELECT klant_id, LOWER(klant_email) AS email_l, " & _
        "    CASE LOWER(TRIM(REPLACE(formaat, ' pakket', ''))) " & _
        "      WHEN 'klein'       THEN 'klein' " & _
        "      WHEN 'groot'       THEN 'groot' " & _
        "      WHEN 'extra groot' THEN 'extra-groot' " & _
        "      WHEN 'extra-groot' THEN 'extra-groot' " & _
        "      WHEN 'mini'        THEN 'mini' " & _
        "    END AS sleutel " & _
        "  FROM vooruitbestellingen " & _
        "  WHERE jaar = " & iJaar & " AND week_bestelling = " & iWeek & _
        "    AND formaat IS NOT NULL" & _
        ") " & _
        "SELECT b.id, " & _
        "COALESCE(NULLIF(k.voornaam,''), b.voornaam) AS voornaam, " & _
        "COALESCE(NULLIF(k.familienaam,''), b.familienaam) AS familienaam, " & _
        "b.klant_email, " & _
        "COALESCE(kwap.naam, kap.naam, b.afhaalpunt) AS afhaalpunt, " & _
        "COALESCE(kwap.dag_klaarmaken, kap.dag_klaarmaken, b.leverdag) AS leverdag, " & _
        "b.pakket, b.pakket_inhoud, " & _
        "b.abonnement_wijziging, b.vragen_opmerkingen, " & _
        "COALESCE(k.klant_type,'') AS klant_type, " & _
        "COALESCE(k.formaat,'') AS formaat, " & _
        "COALESCE(k.telefoon,'') AS telefoon, " & _
        "COALESCE(k.id::text,'') AS klant_id, " & _
        "COALESCE(k.type,'') AS type, " & _
        "COALESCE(kwap.dag_klaarmaken, kap.dag_klaarmaken, bap.dag_klaarmaken,'') AS dag_klaarmaken, " & _
        "COALESCE(kwap.dag_afhaling, kap.dag_afhaling, bap.dag_afhaling,'') AS dag_afhaling, " & _
        "COALESCE(kwap.id_intern, kap.id_intern, bap.id_intern, 9999) AS id_intern_sort, " & _
        "COALESCE(k.id, 999999) AS klant_id_sort " & _
        "FROM bestellingen b " & _
        "LEFT JOIN klanten k ON (k.id = b.klant_id OR (b.klant_id IS NULL AND k.email1 = b.klant_email)) " & _
        "LEFT JOIN afhaalpunten kap ON kap.id = k.afhaalpunt_id " & _
        "LEFT JOIN afhaalpunten bap ON bap.naam = b.afhaalpunt " & _
        "LEFT JOIN klant_afhaalpunt_keuze kw ON kw.klant_id = k.id AND kw.jaar = " & iJaar & " AND kw.week = " & iWeek & " " & _
        "LEFT JOIN afhaalpunten kwap ON kwap.id = kw.afhaalpunt_id " & _
        "WHERE b.weeknummer = " & iWeek & " AND b.jaar = " & iJaar & _
        " AND NOT EXISTS (SELECT 1 FROM annulaties a " & _
        "   WHERE a.jaar = " & iJaar & " AND a.week_annulatie = " & iWeek & _
        "     AND (a.klant_id = b.klant_id OR (b.klant_id IS NULL AND LOWER(a.klant_email) = LOWER(b.klant_email)))) " & _
        " UNION ALL " & _
        "SELECT 0, k.voornaam, k.familienaam, k.email1, " & _
        "COALESCE(kwap.naam, ap.naam,''), COALESCE(kwap.dag_klaarmaken, ap.dag_klaarmaken,''), " & _
        "CASE COALESCE(vb.sleutel, a.formaat) " & _
        "  WHEN 'klein'       THEN 'klein pakket' " & _
        "  WHEN 'groot'       THEN 'groot pakket' " & _
        "  WHEN 'extra-groot' THEN 'extra groot pakket' " & _
        "  WHEN 'mini'        THEN 'mini pakket' ELSE '' END, " & _
        "'', '', '', " & _
        "COALESCE(k.klant_type,''), COALESCE(vb.sleutel, a.formaat), COALESCE(k.telefoon,''), COALESCE(k.id::text,''), " & _
        "COALESCE(k.type,''), " & _
        "COALESCE(kwap.dag_klaarmaken, ap.dag_klaarmaken,''), " & _
        "COALESCE(kwap.dag_afhaling, ap.dag_afhaling,''), " & _
        "COALESCE(kwap.id_intern, ap.id_intern, 9999), " & _
        "COALESCE(k.id, 999999) " & _
        "FROM abonnementen a JOIN klanten k ON k.id = a.klant_id " & _
        "LEFT JOIN afhaalpunten ap ON ap.id = k.afhaalpunt_id " & _
        "LEFT JOIN klant_afhaalpunt_keuze kw ON kw.klant_id = k.id AND kw.jaar = " & iJaar & " AND kw.week = " & iWeek & " " & _
        "LEFT JOIN afhaalpunten kwap ON kwap.id = kw.afhaalpunt_id " & _
        "LEFT JOIN vb_week vb ON (vb.klant_id = k.id OR (vb.klant_id IS NULL AND vb.email_l = LOWER(k.email1))) " & _
        "WHERE a.status = 'actief' AND a.ritme IN (" & sParRitmes & ") " & _
        " AND (a.eind_jaar IS NULL OR (a.eind_jaar * 100 + a.eind_week) > " & iWeekNum & ") " & _
        " AND (a.start_jaar IS NULL OR (a.start_jaar * 100 + a.start_week) <= " & iWeekNum & ") " & _
        sNietGepauzeerd & _
        " AND NOT EXISTS (SELECT 1 FROM bestellingen bx " & _
        "   WHERE bx.weeknummer = " & iWeek & " AND bx.jaar = " & iJaar & _
        "     AND (bx.klant_id = k.id OR (bx.klant_id IS NULL AND LOWER(bx.klant_email) = LOWER(k.email1)))) " & _
        " AND NOT EXISTS (SELECT 1 FROM annulaties a " & _
        "   WHERE a.jaar = " & iJaar & " AND a.week_annulatie = " & iWeek & _
        "     AND (a.klant_id = k.id OR (a.klant_id IS NULL AND LOWER(a.klant_email) = LOWER(k.email1)))) " & _
        " AND NOT EXISTS (SELECT 1 FROM annulaties ann " & _
        "   WHERE ann.jaar = " & iJaar & _
        "     AND ann.week_stopzetten_abonnement > 0 AND ann.week_stopzetten_abonnement <= " & iWeek & _
        "     AND (ann.klant_id = k.id OR (ann.klant_id IS NULL AND LOWER(ann.klant_email) = LOWER(k.email1)))) " & _
        " UNION ALL " & _
        "SELECT 0, k.voornaam, k.familienaam, k.email1, " & _
        "COALESCE(kwap.naam, ap.naam,''), COALESCE(kwap.dag_klaarmaken, ap.dag_klaarmaken,''), " & _
        "CASE vb.sleutel " & _
        "  WHEN 'klein'       THEN 'klein pakket' " & _
        "  WHEN 'groot'       THEN 'groot pakket' " & _
        "  WHEN 'extra-groot' THEN 'extra groot pakket' " & _
        "  WHEN 'mini'        THEN 'mini pakket' ELSE '' END, " & _
        "'', '', '', " & _
        "COALESCE(k.klant_type,''), vb.sleutel, COALESCE(k.telefoon,''), COALESCE(k.id::text,''), " & _
        "COALESCE(k.type,''), " & _
        "COALESCE(kwap.dag_klaarmaken, ap.dag_klaarmaken,''), " & _
        "COALESCE(kwap.dag_afhaling, ap.dag_afhaling,''), " & _
        "COALESCE(kwap.id_intern, ap.id_intern, 9999), " & _
        "COALESCE(k.id, 999999) " & _
        "FROM klanten k " & _
        "LEFT JOIN afhaalpunten ap ON ap.id = k.afhaalpunt_id " & _
        "LEFT JOIN klant_afhaalpunt_keuze kw ON kw.klant_id = k.id AND kw.jaar = " & iJaar & " AND kw.week = " & iWeek & " " & _
        "LEFT JOIN afhaalpunten kwap ON kwap.id = kw.afhaalpunt_id " & _
        "INNER JOIN vb_week vb ON (vb.klant_id = k.id OR (vb.klant_id IS NULL AND vb.email_l = LOWER(k.email1))) " & _
        "WHERE k.status = 'actief' " & _
        " AND NOT EXISTS (SELECT 1 FROM abonnementen a3 WHERE a3.klant_id = k.id " & _
        "   AND a3.status = 'actief' AND a3.ritme IN (" & sParRitmes & ") " & _
        "   AND (a3.pauze_vanaf_week IS NULL OR (a3.pauze_vanaf_jaar * 100 + a3.pauze_vanaf_week) > " & iWeekNum & ") " & _
        "   AND (a3.eind_jaar IS NULL OR (a3.eind_jaar * 100 + a3.eind_week) > " & iWeekNum & ") " & _
        "   AND (a3.start_jaar IS NULL OR (a3.start_jaar * 100 + a3.start_week) <= " & iWeekNum & ")) " & _
        " AND NOT EXISTS (SELECT 1 FROM bestellingen bx " & _
        "   WHERE bx.weeknummer = " & iWeek & " AND bx.jaar = " & iJaar & _
        "     AND (bx.klant_id = k.id OR (bx.klant_id IS NULL AND LOWER(bx.klant_email) = LOWER(k.email1)))) " & _
        " AND NOT EXISTS (SELECT 1 FROM annulaties a " & _
        "   WHERE a.jaar = " & iJaar & " AND a.week_annulatie = " & iWeek & _
        "     AND (a.klant_id = k.id OR (a.klant_id IS NULL AND LOWER(a.klant_email) = LOWER(k.email1)))) " & _
        " AND vb.sleutel IS NOT NULL " & _
        " ORDER BY leverdag ASC, id_intern_sort ASC, klant_id_sort ASC, familienaam ASC, voornaam ASC")

    ' Bestellingen in arrays
    Dim bId(500)      As Long
    Dim bVoor(500)    As String
    Dim bFam(500)     As String
    Dim bEmail(500)   As String
    Dim bAfh(500)     As String
    Dim bDag(500)     As String
    Dim bPakket(500)  As String
    Dim bInhoud(500)  As String
    Dim bWijzig(500)  As String
    Dim bOpm(500)     As String
    Dim bType(500)    As String
    Dim bFormaat(500) As String
    Dim bTel(500)     As String
    Dim bTyp(500)     As String
    Dim bKlaarDag(500) As String
    Dim bAfhDag(500)  As String
    Dim bSamenv(500)  As String
    Dim bKlantId(500) As String
    Dim nBest As Integer
    nBest = 0

    Do While oRS.next()
        bId(nBest)      = CLng(oRS.getString(1))
        bVoor(nBest)    = oRS.getString(2)
        bFam(nBest)     = oRS.getString(3)
        bEmail(nBest)   = oRS.getString(4)
        bAfh(nBest)     = oRS.getString(5)
        bDag(nBest)     = oRS.getString(6)
        bPakket(nBest)  = oRS.getString(7)
        bInhoud(nBest)  = oRS.getString(8)
        bWijzig(nBest)  = oRS.getString(9)
        bOpm(nBest)     = oRS.getString(10)
        bType(nBest)    = oRS.getString(11)
        bFormaat(nBest) = oRS.getString(12)
        bTel(nBest)     = oRS.getString(13)
        bTyp(nBest)      = oRS.getString(15)
        bKlaarDag(nBest) = oRS.getString(16)
        bAfhDag(nBest)   = oRS.getString(17)   ' dag_afhaling (kan afwijken van klaarmaken, bv. 't Voldersveld)
        bKlantId(nBest)  = oRS.getString(14)
        nBest = nBest + 1
    Loop
    oRS.close() : oStmt.close()

    ' --- Stap 3b: DB-correcties t.o.v. de bestelling (URL) ---
    ' Een klant bestelt via een gepersonaliseerde URL (afhaalpunt erin verwerkt).
    ' Wijzigt het afhaalpunt/leverdag/naam daarna in de database (klanten_beheer),
    ' dan is de database leidend: het weekbestand hierboven volgt nu kap.* (DB)
    ' i.p.v. b.* (URL). Deze lijst toont wat daardoor afwijkt van wat de klant
    ' oorspronkelijk doorgaf, zodat het zichtbaar is in de eindpopup.
    ' Vergelijkt met het THUISafhaalpunt (kap). Klanten die deze week een
    ' tijdelijke weekkeuze hebben (klant_afhaalpunt_keuze) worden hier volledig
    ' uitgesloten — hun afhaalpunt-verschil is bedoeld en staat in het
    ' wisselrapport (3c). Zo blijven de DB-correcties enkel échte admin-
    ' wijzigingen (naam/thuisafhaalpunt) tonen, zonder dubbele vermelding.
    Dim sDbCorr As String : sDbCorr = ""
    oStmt = oConn.createStatement()
    oRS = oStmt.executeQuery( _
        "SELECT b.voornaam, b.familienaam, " & _
        "b.afhaalpunt, COALESCE(kap.naam,''), " & _
        "b.leverdag, COALESCE(kap.dag_afhaling,''), " & _
        "k.voornaam, k.familienaam " & _
        "FROM bestellingen b " & _
        "JOIN klanten k ON (k.id = b.klant_id OR (b.klant_id IS NULL AND k.email1 = b.klant_email)) " & _
        "LEFT JOIN afhaalpunten kap ON kap.id = k.afhaalpunt_id " & _
        "WHERE b.weeknummer = " & iWeek & " AND b.jaar = " & iJaar & _
        " AND b.klant_email NOT IN (" & _
        "SELECT klant_email FROM annulaties WHERE jaar = " & iJaar & " AND week_annulatie = " & iWeek & ") " & _
        " AND NOT EXISTS (SELECT 1 FROM klant_afhaalpunt_keuze kw " & _
        "   WHERE kw.klant_id = k.id AND kw.jaar = " & iJaar & " AND kw.week = " & iWeek & ") " & _
        " AND ( (kap.naam IS NOT NULL AND kap.naam <> b.afhaalpunt) " & _
        "    OR (kap.dag_afhaling IS NOT NULL AND kap.dag_afhaling <> b.leverdag) " & _
        "    OR (COALESCE(k.voornaam,'')    <> COALESCE(b.voornaam,'')) " & _
        "    OR (COALESCE(k.familienaam,'') <> COALESCE(b.familienaam,'')) ) " & _
        "ORDER BY k.familienaam, k.voornaam")
    Do While oRS.next()
        Dim sBestelNaam As String, sDbNaam As String, sRegel As String
        sBestelNaam = Trim(oRS.getString(1) & " " & oRS.getString(2))
        sDbNaam     = Trim(oRS.getString(7) & " " & oRS.getString(8))
        sRegel = "• " & sDbNaam
        If oRS.getString(4) <> "" And oRS.getString(4) <> oRS.getString(3) Then
            sRegel = sRegel & Chr(10) & "    afhaalpunt: " & oRS.getString(3) & " -> " & oRS.getString(4)
        End If
        If oRS.getString(6) <> "" And oRS.getString(6) <> oRS.getString(5) Then
            sRegel = sRegel & Chr(10) & "    leverdag: " & oRS.getString(5) & " -> " & oRS.getString(6)
        End If
        If sDbNaam <> "" And sDbNaam <> sBestelNaam Then
            sRegel = sRegel & Chr(10) & "    naam volgens bestelling: " & sBestelNaam
        End If
        sDbCorr = sDbCorr & sRegel & Chr(10)
    Loop
    oRS.close() : oStmt.close()

    ' --- Stap 3c: wie deze week tijdelijk een ander afhaalpunt koos (backlog #27) ---
    ' klant_afhaalpunt_keuze bevat elke live wissel via het bestelformulier voor
    ' deze (jaar,week). Enkel tonen als de keuze écht afwijkt van het
    ' thuisafhaalpunt — dat is wie de praktische info (adres/uren) nodig heeft.
    ' Naast de popup-tekst bouwen we een lookup klant_id -> thuisafhaalpunt-naam,
    ' zodat de rij-schrijflus verderop de wissel per klant in vragen_opmerkingen
    ' kan markeren (blijvend in het weekbestand, i.t.t. de vluchtige popup).
    Dim sWisselRapport As String : sWisselRapport = ""
    Dim nWissel As Integer : nWissel = 0
    Dim wisselKId(500)   As Long
    Dim wisselThuis(500) As String
    oStmt = oConn.createStatement()
    oRS = oStmt.executeQuery( _
        "SELECT k.voornaam, k.familienaam, " & _
        "COALESCE(hap.naam_publiek, hap.naam, '(geen thuisafhaalpunt)'), " & _
        "COALESCE(gap.naam_publiek, gap.naam), kw.klant_id " & _
        "FROM klant_afhaalpunt_keuze kw " & _
        "JOIN klanten k ON k.id = kw.klant_id " & _
        "JOIN afhaalpunten gap ON gap.id = kw.afhaalpunt_id " & _
        "LEFT JOIN afhaalpunten hap ON hap.id = k.afhaalpunt_id " & _
        "WHERE kw.jaar = " & iJaar & " AND kw.week = " & iWeek & _
        " AND (k.afhaalpunt_id IS NULL OR kw.afhaalpunt_id <> k.afhaalpunt_id) " & _
        "ORDER BY k.familienaam, k.voornaam")
    Do While oRS.next()
        sWisselRapport = sWisselRapport & "• " & Trim(oRS.getString(1) & " " & oRS.getString(2)) & _
                         ": " & oRS.getString(3) & " -> " & oRS.getString(4) & Chr(10)
        If nWissel <= 500 Then
            wisselKId(nWissel)   = oRS.getLong(5)
            wisselThuis(nWissel) = oRS.getString(3)
        End If
        nWissel = nWissel + 1
    Loop
    oRS.close() : oStmt.close()

    ' --- Stap 3d: wie deze week nog op een gesloten afhaalpunt staat (backlog #27) ---
    ' Klanten wiens geschreven afhaalpunt deze week in een lopende sluiting valt,
    ' maar die zelf niet wisselden (geen klant_afhaalpunt_keuze-rij, dus niet in
    ' het wisselrapport hierboven) — ze staan dus nog stil op het gesloten punt.
    ' Lijst met gesloten-punt-namen + hun alternatieven wordt hier opgehaald;
    ' de eigenlijke toets (elke geschreven rij tegen deze namenlijst) gebeurt
    ' verderop in de rij-schrijflus, waar het geschreven afhaalpunt bekend is.
    Dim nGesloten As Integer : nGesloten = 0
    Dim gAfhNaam(50) As String
    Dim gAfhAlt(50)  As String
    Dim iVenster As Long : iVenster = iJaar * 100 + iWeek
    oStmt = oConn.createStatement()
    oRS = oStmt.executeQuery( _
        "SELECT ap.naam, " & _
        "(SELECT string_agg(COALESCE(alt.naam_publiek, alt.naam), ', ' ORDER BY COALESCE(alt.naam_publiek, alt.naam)) " & _
        " FROM afhaalpunten alt WHERE alt.id = ANY(s.alternatieven)) " & _
        "FROM afhaalpunt_sluitingen s " & _
        "JOIN afhaalpunten ap ON ap.id = s.afhaalpunt_id " & _
        "WHERE (s.vanaf_jaar * 100 + s.vanaf_week) <= " & iVenster & _
        " AND " & iVenster & " < (s.tot_jaar * 100 + s.tot_week)")
    Do While oRS.next()
        If nGesloten <= 50 Then
            gAfhNaam(nGesloten) = oRS.getString(1)
            gAfhAlt(nGesloten)  = oRS.getString(2)
        End If
        nGesloten = nGesloten + 1
    Loop
    oRS.close() : oStmt.close()
    Dim sNogGeslotenRapport As String : sNogGeslotenRapport = ""
    Dim nNogGesloten As Integer : nNogGesloten = 0

    ' --- Stap 3e: slapende klanten die deze week terugkwamen ---
    ' Een on_hold-klant krijgt geen wekelijkse aanbodmail (alle on_hold-klanten
    ' hebben type = 'on_hold', en de mailmerge-lus in Module2 slaat elk
    ' niet-herkend type over). Zijn enige bestellink is die uit de eenmalige
    ' reddingsmail (BereidHeractivatieMailmergeVoor, Module4). Bestelt hij toch,
    ' dan zet postgres-proxy.php hem terug op actief + weekperweek en stempelt
    ' gereactiveerd_jaar/week. Dat hier melden, want verder is er niets aan te
    ' zien: de klantenrij lijkt onaangeroerd (gewijzigd_op blijft staan) en de
    ' reddingsmail zelf laat geen DB-spoor na.
    Dim sReactRapport As String : sReactRapport = ""
    Dim nReact As Integer : nReact = 0
    oStmt = oConn.createStatement()
    oRS = oStmt.executeQuery( _
        "SELECT k.voornaam, k.familienaam, " & _
        "COALESCE(rap.naam_publiek, rap.naam, '(geen afhaalpunt)'), " & _
        "COALESCE(rap.dag_klaarmaken, ''), COALESCE(rap.dag_afhaling, '') " & _
        "FROM klanten k " & _
        "LEFT JOIN afhaalpunten rap ON rap.id = k.afhaalpunt_id " & _
        "WHERE k.gereactiveerd_jaar = " & iJaar & _
        " AND k.gereactiveerd_week = " & iWeek & " " & _
        "ORDER BY k.familienaam, k.voornaam")
    Do While oRS.next()
        Dim sReactDagen As String
        sReactDagen = ""
        If oRS.getString(4) <> "" Then
            sReactDagen = " (klaarmaken " & oRS.getString(4)
            If oRS.getString(5) <> "" Then
                sReactDagen = sReactDagen & ", afhaling " & oRS.getString(5)
            End If
            sReactDagen = sReactDagen & ")"
        End If
        sReactRapport = sReactRapport & "• " & _
                        Trim(oRS.getString(1) & " " & oRS.getString(2)) & _
                        " — " & oRS.getString(3) & sReactDagen & Chr(10)
        nReact = nReact + 1
    Loop
    oRS.close() : oStmt.close()

    ' --- Stap 4: vooruitbestellingen voor stop/annulatie/start-kolommen ---
    oStmt = oConn.createStatement()
    oRS = oStmt.executeQuery( _
        "SELECT klant_email, week_bestelling, week_start_abonnement, COALESCE(klant_id::text,'') " & _
        "FROM vooruitbestellingen " & _
        "WHERE jaar = " & iJaar & " AND week_bestelling >= " & iWeek)
    Dim vbEmail(200) As String
    Dim vbWeek(200)  As Integer
    Dim vbStart(200) As Integer
    Dim vbKlant(200) As String
    Dim nVB As Integer
    nVB = 0
    Do While oRS.next()
        vbEmail(nVB) = oRS.getString(1)
        vbWeek(nVB)  = CInt(oRS.getString(2))
        vbKlant(nVB) = oRS.getString(4)
        Dim sStart As String
        sStart = oRS.getString(3)
        If oRS.wasNull() Or sStart = "" Then
            vbStart(nVB) = 0
        Else
            vbStart(nVB) = CInt(sStart)
        End If
        nVB = nVB + 1
    Loop
    oRS.close() : oStmt.close()

    ' Annulaties
    oStmt = oConn.createStatement()
    oRS = oStmt.executeQuery( _
        "SELECT klant_email, week_annulatie, week_stopzetten_abonnement, COALESCE(klant_id::text,'') " & _
        "FROM annulaties " & _
        "WHERE jaar = " & iJaar & " AND week_annulatie >= " & iWeek)
    Dim annEmail(200)  As String
    Dim annWeek(200)   As Integer
    Dim annStop(200)   As Integer
    Dim annKlant(200)  As String
    Dim nAnn As Integer
    nAnn = 0
    Do While oRS.next()
        annEmail(nAnn) = oRS.getString(1)
        annWeek(nAnn)  = CInt(oRS.getString(2))
        annKlant(nAnn) = oRS.getString(4)
        Dim sStop As String
        sStop = oRS.getString(3)
        If oRS.wasNull() Or sStop = "" Then
            annStop(nAnn) = 0
        Else
            annStop(nAnn) = CInt(sStop)
        End If
        nAnn = nAnn + 1
    Loop
    oRS.close() : oStmt.close()

    ' --- Stap 5: hoeveelheden losse groenten per bestelling ---
    Dim bGroent(500, 50) As Double
    Dim b As Integer, g As Integer
    For b = 0 To nBest - 1
        For g = 0 To nGroenten - 1
            bGroent(b, g) = 0
        Next g
    Next b

    ' Hulp-variabelen voor stap 5 + 6: vooraf declareren zodat ze ook
    ' beschikbaar zijn als de eerste loop geen rijen heeft (anders crasht
    ' stap 6 met "Er is geen variabele gedefinieerd" op lBId).
    Dim lBId  As Long
    Dim sGr   As String
    Dim dAant As Double

    oStmt = oConn.createStatement()
    oRS = oStmt.executeQuery( _
        "SELECT br.bestelling_id, br.groente_naam, br.aantal " & _
        "FROM bestelregels br " & _
        "INNER JOIN bestellingen bst ON bst.id = br.bestelling_id " & _
        "WHERE bst.weeknummer = " & iWeek & " AND bst.jaar = " & iJaar)
    Do While oRS.next()
        lBId = CLng(oRS.getString(1))
        sGr = oRS.getString(2)
        dAant = CDbl(Replace(oRS.getString(3), ".", ","))
        For b = 0 To nBest - 1
            If bId(b) = lBId Then
                For g = 0 To nGroenten - 1
                    If groentNaam(g) = sGr Then
                        bGroent(b, g) = dAant
                        Exit For
                    End If
                Next g
                Exit For
            End If
        Next b
    Loop
    oRS.close() : oStmt.close()

    ' --- Stap 6: weglatingen per bestelling ---
    ' 2e dimensie = wegNaam-slots: alle pakketgroenten (max 12/week), niet enkel
    ' de effectief weggelaten; 20 voor dezelfde marge als wegNaam.
    Dim bWeg(500, 20) As Boolean
    oStmt = oConn.createStatement()
    oRS = oStmt.executeQuery( _
        "SELECT bw.bestelling_id, bw.groente_naam " & _
        "FROM bestelling_weglatingen bw " & _
        "INNER JOIN bestellingen bst ON bst.id = bw.bestelling_id " & _
        "WHERE bst.weeknummer = " & iWeek & " AND bst.jaar = " & iJaar)
    Dim w As Integer
    Do While oRS.next()
        lBId = CLng(oRS.getString(1))
        sGr  = oRS.getString(2)
        For b = 0 To nBest - 1
            If bId(b) = lBId Then
                For w = 0 To nWeg - 1
                    If wegNaam(w) = sGr Then
                        bWeg(b, w) = True
                        Exit For
                    End If
                Next w
                Exit For
            End If
        Next b
    Loop
    oRS.close() : oStmt.close()

    ' --- Stap 7: week-notities met bestemming 'orderpicking' ---
    ' Deze komen in het Opmerkingen-blok bovenaan het weekblad (rij 7) en
    ' verschijnen zo op élk losse_groenten_per_klant-printdocument, zowel
    ' donderdag als vrijdag (zie MaakOverzichten in Module3). Momentopname:
    ' notities die je ná het aanmaken nog in de cockpit tikt, typ je zelf
    ' bij in het blok.
    Dim aOpmAlg(49) As String
    Dim nOpmAlg     As Integer
    nOpmAlg = 0
    oStmt = oConn.createStatement()
    oRS = oStmt.executeQuery( _
        "SELECT tekst FROM week_notitie " & _
        "WHERE jaar = " & iJaar & " AND weeknummer = " & iWeek & _
        " AND voor_orderpicking AND btrim(tekst) <> '' " & _
        "ORDER BY volgorde, id")
    Do While oRS.next()
        If nOpmAlg <= UBound(aOpmAlg) Then
            aOpmAlg(nOpmAlg) = oRS.getString(1)
            nOpmAlg = nOpmAlg + 1
        End If
    Loop
    oRS.close() : oStmt.close()
    oConn.close()

    ' =============================================
    ' BESTAND AANMAKEN EN WERKBLAD OPBOUWEN
    ' =============================================

    Dim oDesktop  As Object
    Dim oNieuwDoc As Object
    Dim oSheet    As Object
    Dim bAutoCalc As Boolean    ' stond automatische herberekening aan?
    Dim bLocked   As Boolean    ' zijn de controllers van het nieuwe doc vergrendeld?
    bAutoCalc = True : bLocked = False

    oDesktop = CreateUnoService("com.sun.star.frame.Desktop")
    Dim aLaadProps(0) As New com.sun.star.beans.PropertyValue
    aLaadProps(0).Name  = "Hidden"
    aLaadProps(0).Value = False
    oNieuwDoc = oDesktop.loadComponentFromURL("private:factory/scalc", "_blank", 0, aLaadProps())
    oSheet = oNieuwDoc.Sheets.getByIndex(0)
    oSheet.Name = "Week " & iWeek & " - " & iJaar

    ' Snelheid: schermopbouw en automatische herberekening uit tijdens het opbouwen
    ' van het weekbestand (honderden cel- en formuleschrijfacties — anders hertekent
    ' en herberekent LO bij élke schrijfactie). Vanaf hier ALTIJD via OpkuisWB
    ' afronden, zodat de vergrendeling ook bij een fout halverwege hersteld wordt
    ' (geen bevroren venster).
    On Error GoTo OpkuisWB
    bAutoCalc = oNieuwDoc.isAutomaticCalculationEnabled()
    oNieuwDoc.lockControllers()
    bLocked = True
    oNieuwDoc.enableAutomaticCalculation(False)

    ' Kolomindices (0-based)
    Const cNaam     = 0   ' voornaam + familienaam
    Const cAfh      = 1   ' afhaalpunt
    Const cKlaarDag = 2   ' dag klaarmaken (afhaalpunt)
    Const cTyp      = 3   ' type (klant)
    Const cFormaat  = 4   ' formaat
    Const cOpm      = 5   ' vragen_opmerkingen
    Const cEmail    = 6   ' email
    Const cTel      = 7   ' telefoon
    Const cVoor     = 8   ' voornaam
    Const cType     = 9   ' klant_type
    Const cDag      = 10  ' leverdag (verborgen)
    Const cWijzig   = 11  ' abonnement_wijziging
    Const cStop     = 12  ' week_stopzetten_abonnement
    Const cAnn      = 13  ' dag afhaling (afhaaldag klant; kan afwijken van klaarmaakdag)
    Const cStart    = 14  ' week_start_abonnement
    Const cWBest    = 15  ' klant_id (kolom P)
    Const cDatum    = 16  ' datum (YYMMDD)
    Const cKG       = 17  ' Klein pakket
    Const cGG       = 18  ' Groot pakket
    Const cEGG      = 19  ' Extra groot pakket
    Const cMINI     = 20  ' Mini pakket
    Const cExtra       = 21             ' extra spacer-kolom (kolom V) — vrij voor manuele info
    Const cSamenv      = 22             ' samenvatting (kolom W)
    Const cWaarde      = 23             ' € losse groenten (kolom X) — formule per klant
    Const nGroentSlots = 24             ' altijd 24 groente-kolommen reserveren
    Dim   cGroent0 As Integer
    cGroent0 = 24                       ' eerste groente-kolom (Y)
    Dim   cAnder  As Integer
    cAnder  = cGroent0 + nGroentSlots  ' "ander" kolom (AW)
    Dim   cAangep As Integer
    cAangep = cAnder  + 1              ' (leeg — vrij voor andere info)
    Dim   cGeen   As Integer
    cGeen   = cAangep + 1              ' synthese weglatingen (AU = 46)
    Dim   cWeg0   As Integer
    cWeg0   = cGeen   + 1              ' eerste weglating-kolom (AV = 47)

    ' Helper: cel ophalen
    ' (LibreOffice Basic heeft geen inline functies, werken met oSheet direct)

    ' --- RIJ 0: metadata ---
    oSheet.getCellByPosition(0, 0).setString(sMaand)
    oSheet.getCellByPosition(1, 0).setString("Week " & iWeek)
    oSheet.getCellByPosition(2, 0).setString(sDatumKort)
    oSheet.getCellByPosition(3, 0).setString(sPareWeek)

    ' --- RIJ 1: kolomhoofden ---
    Dim r As Integer
    r = 1
    oSheet.getCellByPosition(cNaam,    r).setString("voornaam + familienaam")
    oSheet.getCellByPosition(cAfh,     r).setString("afhaalpunt")
    oSheet.getCellByPosition(cKlaarDag,r).setString("dag klaarmaken")
    oSheet.getCellByPosition(cDag,     r).setString("leverdag")
    oSheet.getCellByPosition(cTyp,     r).setString("type")
    oSheet.getCellByPosition(cFormaat,r).setString("formaat")
    oSheet.getCellByPosition(cVoor,   r).setString("voornaam")
    oSheet.getCellByPosition(cTel,    r).setString("telefoon")
    oSheet.getCellByPosition(cEmail,  r).setString("email")
    oSheet.getCellByPosition(cOpm,    r).setString("vragen_opmerkingen")
    oSheet.getCellByPosition(cWijzig, r).setString("abonnement_wijziging")
    oSheet.getCellByPosition(cStop,   r).setString("week_stopzetten_abonnement")
    oSheet.getCellByPosition(cAnn,    r).setString("dag afhaling")
    oSheet.getCellByPosition(cStart,  r).setString("week_start_abonnement")
    oSheet.getCellByPosition(cWBest,  r).setString("klant_id")
    oSheet.getCellByPosition(cDatum,  r).setString(sDatumKort)
    oSheet.getCellByPosition(cKG,     r).setString("KG")
    oSheet.getCellByPosition(cGG,     r).setString("GG")
    oSheet.getCellByPosition(cEGG,    r).setString("EGG")
    oSheet.getCellByPosition(cMINI,   r).setString("MINI")
    oSheet.getCellByPosition(cSamenv, r).setString("samenvatting")
    oSheet.getCellByPosition(cWaarde, r).setString("Losse groenten (waarde)")
    For g = 0 To nGroenten - 1
        oSheet.getCellByPosition(cGroent0 + g, r).setString(groentNaam(g))
    Next g
    oSheet.getCellByPosition(cAnder,  r).setString("ander")
    oSheet.getCellByPosition(cAangep, r).setString("")
    oSheet.getCellByPosition(cGeen,   r).setString("geen (synthese)")
    ' Kolomlabel "geen" voor alle 12 slots, ook de nog lege (klaar voor manueel)
    For w = 0 To nWegSlots - 1
        oSheet.getCellByPosition(cWeg0 + w, r).setString("geen")
    Next w

    ' --- RIJ 2: eenheden ---
    r = 2
    oSheet.getCellByPosition(cAfh,      r).setString("PAKKETTEN")
    oSheet.getCellByPosition(cKlaarDag, r).setString("LOS")
    oSheet.getCellByPosition(cKG,     r).setString("KG")
    oSheet.getCellByPosition(cGG,     r).setString("GG")
    oSheet.getCellByPosition(cEGG,    r).setString("EGG")
    oSheet.getCellByPosition(cMINI,   r).setString("MINI")
    ' Losse-groentekolommen: prijs als getal, opgemaakt als "€ 5,00 / 300g"
    Dim oFmtsR3 As Object
    oFmtsR3 = oNieuwDoc.getNumberFormats()
    Dim oLocR3 As New com.sun.star.lang.Locale
    oLocR3.Language = "nl" : oLocR3.Country = "BE"
    For g = 0 To nGroenten - 1
        Dim oCelPr As Object
        oCelPr = oSheet.getCellByPosition(cGroent0 + g, r)
        oCelPr.setValue(groentPrijs(g))
        Dim sFmtPr As String, nFmtPr As Long
        sFmtPr = "0,00"" " & Chr(8364) & " / " & groentEenh(g) & """"
        nFmtPr = oFmtsR3.queryKey(sFmtPr, oLocR3, False)
        If nFmtPr = -1 Then nFmtPr = oFmtsR3.addNew(sFmtPr, oLocR3)
        oCelPr.NumberFormat = nFmtPr
    Next g
    For w = 0 To nWeg - 1
        oSheet.getCellByPosition(cWeg0 + w, r).setString(wegNaam(w))
    Next w

    ' Valuta-opmaak voor cWaarde-kolom (€ losse) op de klantrijen.
    ' Wordt eenmalig opgezet zodat de loop hieronder de NumberFormat snel kan toepassen.
    Dim oFmtsW As Object : oFmtsW = oNieuwDoc.getNumberFormats()
    Dim oLocW As New com.sun.star.lang.Locale
    oLocW.Language = "nl" : oLocW.Country = "BE"
    Dim nCurW As Long, sCurW As String
    sCurW = "#.##0,00"" " & Chr(8364) & """"
    nCurW = oFmtsW.queryKey(sCurW, oLocW, False)
    If nCurW = -1 Then nCurW = oFmtsW.addNew(sCurW, oLocW)

    ' Blad2 alvast aanmaken met metadata-zones voor groente-eenheden.
    ' Kolommen A-F (rij 3-48) zijn voor VulWeglatingen / LeesUitSheets.
    ' Kolom I (index 8), rij g (0-indexed) = bestel-eenheid mét "x "-prefix voor
    '   per_stuk-groenten (bv. "x 300g"). Gebruikt door MaakOverzichten en de
    '   samenvattingsformule in kolom W van het hoofdblad (kleine letter "x"
    '   tussen aantal en eenheid, consistent met de afweeglijst).
    ' Rij 99 (index, dus UI rij 100), kolom 0..nGroenten-1 = bestel-eenheid mét
    '   "× "-prefix (Unicode multiplication sign) voor per_stuk-groenten, niets
    '   anders. Horizontaal uitgelijnd op de groente-index. Gebruikt door de
    '   detail-formule in afrekening kolom W, waar we "4 × 300g à 5,00 €" of
    '   "4 kg à 0,50 €" willen tonen. Ver voorbij rij 48 zodat
    '   VulWeglatingen/LeesUitSheets er niet bij komen.
    If Not oNieuwDoc.Sheets.hasByName("Blad2") Then
        oNieuwDoc.Sheets.insertNewByName("Blad2", 1)
    End If
    Dim oBlad2Meta As Object
    oBlad2Meta = oNieuwDoc.Sheets.getByName("Blad2")
    For g = 0 To nGroenten - 1
        oBlad2Meta.getCellByPosition(8, g).setString( _
            IIf(groentPerStuk(g), "x ", "") & groentEenh(g))
        oBlad2Meta.getCellByPosition(g, 99).setString( _
            IIf(groentPerStuk(g), Chr(215) & " ", "") & groentEenh(g))
    Next g

    ' --- Helper functie: pakket tellen ---
    ' Tel aantallen per pakkettype voor een reeks bestellingen (van index iVan tot iTot-1)
    ' Geeft terug in array: (0)=KG (1)=GG (2)=EGG (3)=MINI

    ' --- OPMERKINGEN-BLOK (rij 7 e.v.): algemene notities zonder klant ---
    ' Aanwijzingen voor de medewerkers of voor jezelf, los van een bestelling.
    ' Ze verschijnen bovenaan élk losse_groenten_per_klant-printdocument, zowel
    ' donderdag als vrijdag (zie MaakOverzichten in Module3).
    '
    ' Vorm — bewust identiek aan een afhaalpunt-blok, zodat álle bestaande
    ' rij-scans (overzichten, etiketten, afrekening, weglatingen, mailselectie)
    ' het blok overslaan zonder één extra guard:
    '   koprij      : A = "Opmerkingen", B = "afhaalpunt/dag"  → koprij-guard
    '   notitierijen: A leeg, tekst in kolom AW (cAnder)       → lege-naam-guard
    ' Onder de opgehaalde notities staan lege rijen klaar om doorheen de week
    ' zelf in te typen; MaakOverzichten leest alles tot de eerste rij met een
    ' ingevulde kolom A (= de eerste afhaalpunt-koprij).
    Const nOpmVrij = 6                      ' lege notitierijen om zelf in te vullen
    r = 6
    oSheet.getCellByPosition(cNaam, r).setString("Opmerkingen")
    oSheet.getCellByPosition(cAfh,  r).setString("afhaalpunt/dag")
    r = r + 1
    Dim iOpm As Integer
    For iOpm = 0 To nOpmAlg - 1
        oSheet.getCellByPosition(cAnder, r).setString(aOpmAlg(iOpm))
        r = r + 1
    Next iOpm
    r = r + nOpmVrij                        ' lege invulrijen
    r = r + 1                               ' witregel vóór het eerste afhaalpunt

    ' Eerste klantrij onthouden: de opmaak-pas verderop loopt dezelfde
    ' rij-rekenkunde nog eens over en moet op dezelfde rij starten.
    Dim rKlantStart As Integer
    rKlantStart = r

    ' --- KLANTDATA: gegroepeerd per leverdag > afhaalpunt ---
    Dim sHuidigAfh  As String
    Dim sHuidigDag  As String
    Dim iAfhStart   As Integer  ' eerste rij van huidig afhaalpunt (voor subtotaal)
    sHuidigAfh = ""
    sHuidigDag = ""

    ' Subtotaal-tellers voor huidig afhaalpunt
    Dim afKG As Integer, afGG As Integer, afEGG As Integer, afMINI As Integer
    Dim afGroent(50) As Double

    For b = 0 To nBest - 1

        ' Nieuwe leverdag of nieuw afhaalpunt: eerst subtotaalrij vorige groep schrijven
        If sHuidigAfh <> "" And (bAfh(b) <> sHuidigAfh Or bDag(b) <> sHuidigDag) Then
            ' Witregel tussen groepen
            r = r + 1
            ' Reset tellers
            afKG = 0 : afGG = 0 : afEGG = 0 : afMINI = 0
            For g = 0 To nGroenten - 1 : afGroent(g) = 0 : Next g
        End If

        ' Nieuwe koprijlijn als afhaalpunt of dag verandert
        If bAfh(b) <> sHuidigAfh Or bDag(b) <> sHuidigDag Then
            oSheet.getCellByPosition(cNaam,  r).setString(bAfh(b))
            oSheet.getCellByPosition(cAfh,   r).setString("afhaalpunt/dag")
            oSheet.getCellByPosition(cDatum, r).setFormula("=A" & (r + 1))
            r = r + 1
            sHuidigAfh = bAfh(b)
            sHuidigDag = bDag(b)
            afKG = 0 : afGG = 0 : afEGG = 0 : afMINI = 0
            For g = 0 To nGroenten - 1 : afGroent(g) = 0 : Next g
        End If

        ' Klantdata schrijven
        oSheet.getCellByPosition(cDatum,  r).setFormula("=A" & (r + 1))
        oSheet.getCellByPosition(cNaam,    r).setString(bVoor(b) & " " & bFam(b))
        oSheet.getCellByPosition(cAfh,     r).setString(bAfh(b))
        oSheet.getCellByPosition(cKlaarDag,r).setString(bKlaarDag(b))
        oSheet.getCellByPosition(cDag,     r).setString(bDag(b))
        oSheet.getCellByPosition(cAnn,     r).setString(bAfhDag(b))
        oSheet.getCellByPosition(cTyp,     r).setString(bTyp(b))
        oSheet.getCellByPosition(cFormaat,r).setString(bFormaat(b))
        oSheet.getCellByPosition(cType,   r).setString(bType(b))
        oSheet.getCellByPosition(cVoor,   r).setString(bVoor(b))
        oSheet.getCellByPosition(cTel,    r).setString(bTel(b))
        oSheet.getCellByPosition(cEmail,  r).setString(bEmail(b))
        ' Afhaalpunt-wissel deze week (backlog #27): aan de opmerking toevoegen
        ' zodat het blijvend in het weekbestand staat (niet enkel in de popup)
        ' — en meteen mee naar kolom AW (cAnder), want dat is wat op de
        ' afgedrukte stapellijsten verschijnt (zie MaakOverzichten).
        Dim sOpmFinaal As String : sOpmFinaal = bOpm(b)
        If Trim(bKlantId(b)) <> "" Then
            Dim lRijKId As Long : lRijKId = CLng(Val(bKlantId(b)))
            Dim iWm As Integer
            Dim fWisselFound As Boolean : fWisselFound = False
            For iWm = 0 To nWissel - 1
                If wisselKId(iWm) = lRijKId Then
                    Dim sWisselMark As String : sWisselMark = "alternatief voor " & wisselThuis(iWm)
                    sOpmFinaal = IIf(Trim(sOpmFinaal) <> "", sOpmFinaal & " / " & sWisselMark, sWisselMark)
                    fWisselFound = True
                    Exit For
                End If
            Next iWm
            ' Niet gewisseld, maar het geschreven afhaalpunt is deze week wél
            ' gesloten (backlog #27, Stap 3d) — klant staat nog op het gesloten punt.
            If Not fWisselFound Then
                Dim iG As Integer
                For iG = 0 To nGesloten - 1
                    If gAfhNaam(iG) = bAfh(b) Then
                        Dim sGeslotenMark As String : sGeslotenMark = "nog op gesloten afhaalpunt"
                        If Trim(gAfhAlt(iG)) <> "" Then
                            sGeslotenMark = sGeslotenMark & " (alternatieven: " & gAfhAlt(iG) & ")"
                        End If
                        sOpmFinaal = IIf(Trim(sOpmFinaal) <> "", sOpmFinaal & " / " & sGeslotenMark, sGeslotenMark)
                        sNogGeslotenRapport = sNogGeslotenRapport & "• " & bVoor(b) & " " & bFam(b) & _
                            ": " & bAfh(b) & Chr(10)
                        nNogGesloten = nNogGesloten + 1
                        Exit For
                    End If
                Next iG
            End If
        End If
        oSheet.getCellByPosition(cOpm, r).setString(sOpmFinaal)
        If Trim(sOpmFinaal) <> "" Then
            oSheet.getCellByPosition(cAnder, r).setString(sOpmFinaal)
        End If

        ' klant_id (kolom P) — vaste kolom net voor de centrale datumkolom
        If Trim(bKlantId(b)) <> "" Then
            oSheet.getCellByPosition(cWBest, r).setValue(Val(bKlantId(b)))
        End If

        ' abonnement_wijziging alleen als relevant
        If Trim(bWijzig(b)) <> "" Then
            oSheet.getCellByPosition(cWijzig, r).setString(bWijzig(b))
        End If

        ' Vooruitbestellingen: week_start — match op klant_id (leidend), met
        ' e-mail enkel als terugval voor klantloze (weekperweek-)bestellingen.
        Dim vi As Integer
        Dim bVbMatch As Boolean
        For vi = 0 To nVB - 1
            If Trim(bKlantId(b)) <> "" And vbKlant(vi) <> "" Then
                bVbMatch = (vbKlant(vi) = bKlantId(b))
            Else
                bVbMatch = (LCase(vbEmail(vi)) = LCase(bEmail(b)))
            End If
            If bVbMatch And vbStart(vi) > 0 Then
                oSheet.getCellByPosition(cStart, r).setValue(vbStart(vi))
            End If
        Next vi

        ' Annulaties: week_stop — zelfde klant_id-eerst logica.
        Dim ai As Integer
        Dim bAnnMatch As Boolean
        For ai = 0 To nAnn - 1
            If Trim(bKlantId(b)) <> "" And annKlant(ai) <> "" Then
                bAnnMatch = (annKlant(ai) = bKlantId(b))
            Else
                bAnnMatch = (LCase(annEmail(ai)) = LCase(bEmail(b)))
            End If
            If bAnnMatch And annStop(ai) > 0 Then
                oSheet.getCellByPosition(cStop, r).setValue(annStop(ai))
            End If
        Next ai

        ' Pakket tellen (voor subtotaal afhaalpunt)
        Select Case LCase(bPakket(b))
            Case "klein pakket"
                oSheet.getCellByPosition(cKG, r).setValue(1)
                afKG = afKG + 1
            Case "groot pakket"
                oSheet.getCellByPosition(cGG, r).setValue(1)
                afGG = afGG + 1
            Case "extra groot pakket"
                oSheet.getCellByPosition(cEGG, r).setValue(1)
                afEGG = afEGG + 1
            Case "mini pakket"
                oSheet.getCellByPosition(cMINI, r).setValue(1)
                afMINI = afMINI + 1
        End Select

        ' Losse groenten
        For g = 0 To nGroenten - 1
            If bGroent(b, g) > 0 Then
                oSheet.getCellByPosition(cGroent0 + g, r).setValue(bGroent(b, g))
                afGroent(g) = afGroent(g) + bGroent(b, g)
            End If
        Next g

        ' Weglatingen
        For w = 0 To nWeg - 1
            If bWeg(b, w) Then
                oSheet.getCellByPosition(cWeg0 + w, r).setString(wegNaam(w))
            End If
        Next w

        ' Synthese weglatingen (kolom AY) als levende formule over alle 12
        ' weglating-slots: per slot met een ingevulde cel "Geen: <naam>" (naam
        ' uit koprij 3), samengevoegd met TEXTJOIN (lege slots vallen weg, geen
        ' beginnende witregel). Zo wordt een handmatige weglating ná aanmaak —
        ' ook in een tot nog toe leeg slot — meteen bijgewerkt, net als kolom W.
        Dim oCelGeen As Object
        oCelGeen = oSheet.getCellByPosition(cGeen, r)
        oSheet.getCellRangeByName(KolomLetter(cGeen) & (r + 1)).setArrayFormula( _
            "=TEXTJOIN(CHAR(10);1;IF(" & KolomLetter(cWeg0) & (r + 1) & ":" & _
            KolomLetter(cWeg0 + nWegSlots - 1) & (r + 1) & "="""";"""";""Geen: ""&" & _
            KolomLetter(cWeg0) & "$3:" & KolomLetter(cWeg0 + nWegSlots - 1) & "$3))")
        oCelGeen.IsTextWrapped = True

        ' Samenvatting als levende formule (kolom V): trekt naam+afhaalpunt+
        ' pakketformaat live uit dezelfde rij, per groente met aantal>0 een
        ' regel "naam: aantal eenheid" (groentenaam uit $2, eenheid uit Blad2.I
        ' met "x "-prefix voor per_stuk), per actieve weglating "Geen: <naam>"
        ' (naam uit $3 van de wegCol). Hierdoor lopen wijzigingen aan
        ' hoeveelheden of weglatingen meteen mee.
        Dim iSamRij As Integer
        iSamRij = r + 1
        Dim sFmlSv As String
        sFmlSv = "=A" & iSamRij & "&"" (""&B" & iSamRij & "&""): ""&" & _
            "IF(" & KolomLetter(cKG) & iSamRij & ">0;""klein"";" & _
            "IF(" & KolomLetter(cGG) & iSamRij & ">0;""groot"";" & _
            "IF(" & KolomLetter(cEGG) & iSamRij & ">0;""extra groot"";" & _
            "IF(" & KolomLetter(cMINI) & iSamRij & ">0;""mini"";""geen pakket""))))"
        Dim sgCol As String
        ' Alle 24 slots (Y..AV), niet enkel de DB-groenten: zo verschijnt een
        ' handmatig toegevoegde losse groente ook in de samenvatting-kolom W.
        ' Een leeg slot levert "" en voegt niets toe tot het ingevuld wordt.
        For g = 0 To nGroentSlots - 1
            sgCol = KolomLetter(cGroent0 + g)
            sFmlSv = sFmlSv & "&IF(" & sgCol & iSamRij & "="""";"""";CHAR(10)&" & _
                sgCol & "$2&"": ""&" & sgCol & iSamRij & "&"" ""&Blad2.I" & (g + 1) & ")"
        Next g
        ' "ander"-kolom (AW) als losse regel "ander/opmerking: <inhoud>",
        ' onder de groenten en vóór de weglatingen. Enkel als AW gevuld is.
        sFmlSv = sFmlSv & "&IF(" & KolomLetter(cAnder) & iSamRij & "="""";"""";CHAR(10)&" & _
            """ander/opmerking: ""&" & KolomLetter(cAnder) & iSamRij & ")"
        Dim swCol As String
        For w = 0 To nWegSlots - 1
            swCol = KolomLetter(cWeg0 + w)
            sFmlSv = sFmlSv & "&IF(" & swCol & iSamRij & "="""";"""";CHAR(10)&""Geen: ""&" & swCol & "$3)"
        Next w
        Dim oCelSamenv As Object
        oCelSamenv = oSheet.getCellByPosition(cSamenv, r)
        oCelSamenv.setFormula(sFmlSv)
        oCelSamenv.IsTextWrapped = True
        bSamenv(b) = ""

        ' € losse: formule naar afrekening.C<rij> (totaal losse groenten per klant)
        Dim oCelWa As Object
        oCelWa = oSheet.getCellByPosition(cWaarde, r)
        oCelWa.setFormula("=afrekening.C" & (r + 1))
        oCelWa.NumberFormat = nCurW

        r = r + 1
    Next b

    ' Witregel na laatste groep
    If sHuidigAfh <> "" Then r = r + 1

    ' --- SAMENVATTINGSRIJEN (formules in rijen 4-6, geschreven na de loop zodat het rijbereik bekend is) ---
    Dim iLaatste As Integer
    iLaatste = r  ' = 1-indexed spreadsheet rij van laatste datarij

    Dim sDatDo As String
    Dim sDatVr As String
    sDatDo = "Donderdag " & Day(dDonderdag) & " " & saMaanden(Month(dDonderdag))
    sDatVr = "Vrijdag "   & Day(dVrijdag)   & " " & saMaanden(Month(dVrijdag))

    Dim ic As Integer
    Dim sK As String

    ' Totaalrij (code rij 3 = spreadsheet rij 4)
    oSheet.getCellByPosition(cNaam, 3).setString("Totaal W" & iWeek)
    oSheet.getCellByPosition(cNaam, 4).setString(sDatDo)
    oSheet.getCellByPosition(cNaam, 5).setString(sDatVr)
    ' Q4/Q5/Q6: som van de pakkettotalen R..U op die rij (gecentreerd).
    oSheet.getCellByPosition(cDatum, 3).setFormula( _
        "=SUM(" & KolomLetter(cKG) & "4:" & KolomLetter(cMINI) & "4)")
    oSheet.getCellByPosition(cDatum, 4).setFormula( _
        "=SUM(" & KolomLetter(cKG) & "5:" & KolomLetter(cMINI) & "5)")
    oSheet.getCellByPosition(cDatum, 5).setFormula( _
        "=SUM(" & KolomLetter(cKG) & "6:" & KolomLetter(cMINI) & "6)")

    ' W4/W5/W6: aantal losse bestellingen (geen pakket, X > 0), opgesplitst per
    ' klaarmaakdag voor rij 5/6. SUMPRODUCT met ='' tests werkt mét echt-lege
    ' cellen — COUNTIFS-criterium '""' deed dat niet en gaf altijd 0.
    Dim sW45Basis As String
    sW45Basis = "(" & KolomLetter(cKG)     & "7:" & KolomLetter(cKG)     & iLaatste & "="""")*" & _
                "(" & KolomLetter(cGG)     & "7:" & KolomLetter(cGG)     & iLaatste & "="""")*" & _
                "(" & KolomLetter(cEGG)    & "7:" & KolomLetter(cEGG)    & iLaatste & "="""")*" & _
                "(" & KolomLetter(cMINI)   & "7:" & KolomLetter(cMINI)   & iLaatste & "="""")*" & _
                "(" & KolomLetter(cWaarde) & "7:" & KolomLetter(cWaarde) & iLaatste & ">0)"
    Dim sDagRange As String
    sDagRange = "$" & KolomLetter(cKlaarDag) & "$7:$" & KolomLetter(cKlaarDag) & "$" & iLaatste
    oSheet.getCellByPosition(cSamenv, 3).setFormula("=SUMPRODUCT(" & sW45Basis & ")")
    oSheet.getCellByPosition(cSamenv, 4).setFormula( _
        "=SUMPRODUCT(" & sW45Basis & "*(" & sDagRange & "=""donderdag""))")
    oSheet.getCellByPosition(cSamenv, 5).setFormula( _
        "=SUMPRODUCT(" & sW45Basis & "*(" & sDagRange & "=""vrijdag""))")

    ' B4-B6 spiegelen Q4-Q6, C4-C6 spiegelen W4-W6 (gewoon doorgeef-formules,
    ' geen aparte opmaak — die volgt de algemene rij 3-5 layout).
    Dim rrSpiegel As Integer
    For rrSpiegel = 3 To 5
        oSheet.getCellByPosition(cAfh,      rrSpiegel).setFormula( _
            "=" & KolomLetter(cDatum)  & (rrSpiegel + 1))
        oSheet.getCellByPosition(cKlaarDag, rrSpiegel).setFormula( _
            "=" & KolomLetter(cSamenv) & (rrSpiegel + 1))
    Next rrSpiegel

    ' Centrering voor Q4-Q6 + W4-W6 (achtergrond komt verderop in de rij 3-5
    ' opmaaksectie, na de clDDDDDD-definitie).
    Dim iQRij As Integer
    For iQRij = 3 To 5
        oSheet.getCellByPosition(cDatum,  iQRij).HoriJustify = com.sun.star.table.CellHoriJustify.CENTER
        oSheet.getCellByPosition(cDatum,  iQRij).VertJustify = com.sun.star.table.CellVertJustify2.CENTER
        oSheet.getCellByPosition(cSamenv, iQRij).HoriJustify = com.sun.star.table.CellHoriJustify.CENTER
        oSheet.getCellByPosition(cSamenv, iQRij).VertJustify = com.sun.star.table.CellVertJustify2.CENTER
    Next iQRij
    For ic = cKG To cMINI
        sK = KolomLetter(ic)
        oSheet.getCellByPosition(ic, 3).setFormula( _
            "=SUM(" & sK & "7:" & sK & iLaatste & ")")
    Next ic
    ' € losse — totaal
    sK = KolomLetter(cWaarde)
    oSheet.getCellByPosition(cWaarde, 3).setFormula( _
        "=SUM(" & sK & "7:" & sK & iLaatste & ")")
    oSheet.getCellByPosition(cWaarde, 3).NumberFormat = nCurW
    For ic = cGroent0 To cGroent0 + nGroentSlots - 1
        sK = KolomLetter(ic)
        oSheet.getCellByPosition(ic, 3).setFormula( _
            "=SUM(" & sK & "7:" & sK & iLaatste & ")")
    Next ic

    ' Q3: totaal aantal pakketten — som van de pakkettotalen (R4:U4) in de
    ' totaalrij, gevolgd door het woord PAKKETTEN.
    oSheet.getCellByPosition(cDatum, 2).setFormula( _
        "=SUM(" & KolomLetter(cKG) & "4:" & KolomLetter(cMINI) & "4)&"" PAKKETTEN""")

    ' W3: "<aantal losse bestellingen> LOSSE BESTELLINGEN" — klanten zonder
    ' pakket (R,S,T,U leeg) maar met een waarde in X (cWaarde > 0). Hergebruikt
    ' W4 (totaalrij) zodat W3 automatisch meeloopt bij wijzigingen.
    oSheet.getCellByPosition(cSamenv, 2).setFormula( _
        "=" & KolomLetter(cSamenv) & "4&"" LOSSE BESTELLINGEN""")

    ' Donderdagrij (code rij 4 = spreadsheet rij 5) — SUMIF op kolom C (dag_klaarmaken)
    For ic = cKG To cMINI
        sK = KolomLetter(ic)
        oSheet.getCellByPosition(ic, 4).setFormula( _
            "=SUMIF($C$7:$C$" & iLaatste & ";""donderdag"";" & sK & "7:" & sK & iLaatste & ")")
    Next ic
    ' € losse — donderdag
    sK = KolomLetter(cWaarde)
    oSheet.getCellByPosition(cWaarde, 4).setFormula( _
        "=SUMIF($C$7:$C$" & iLaatste & ";""donderdag"";" & sK & "7:" & sK & iLaatste & ")")
    oSheet.getCellByPosition(cWaarde, 4).NumberFormat = nCurW
    For ic = cGroent0 To cGroent0 + nGroentSlots - 1
        sK = KolomLetter(ic)
        oSheet.getCellByPosition(ic, 4).setFormula( _
            "=SUMIF($C$7:$C$" & iLaatste & ";""donderdag"";" & sK & "7:" & sK & iLaatste & ")")
    Next ic

    ' Vrijdagrij (code rij 5 = spreadsheet rij 6)
    For ic = cKG To cMINI
        sK = KolomLetter(ic)
        oSheet.getCellByPosition(ic, 5).setFormula( _
            "=SUMIF($C$7:$C$" & iLaatste & ";""vrijdag"";" & sK & "7:" & sK & iLaatste & ")")
    Next ic
    ' € losse — vrijdag
    sK = KolomLetter(cWaarde)
    oSheet.getCellByPosition(cWaarde, 5).setFormula( _
        "=SUMIF($C$7:$C$" & iLaatste & ";""vrijdag"";" & sK & "7:" & sK & iLaatste & ")")
    oSheet.getCellByPosition(cWaarde, 5).NumberFormat = nCurW
    For ic = cGroent0 To cGroent0 + nGroentSlots - 1
        sK = KolomLetter(ic)
        oSheet.getCellByPosition(ic, 5).setFormula( _
            "=SUMIF($C$7:$C$" & iLaatste & ";""vrijdag"";" & sK & "7:" & sK & iLaatste & ")")
    Next ic

    ' Weglatingen (AZ..BK) — aantal keer dat een groente weggelaten wordt, over
    ' ALLE klanten samen (onafhankelijk van pakketformaat), gesplitst per dag
    ' klaarmaken (kolom C) net als de pakket-/lossetotalen hierboven. De
    ' weglatingcellen in de klantrijen bevatten de groentenaam (tekst) als de
    ' groente weggelaten is, dus tellen = niet-lege cellen tellen: SUMPRODUCT op
    ' (<kol>7:<kol>last<>"") i.p.v. SUM. Rij 4 = totaal (do+vr), rij 5 =
    ' donderdag, rij 6 = vrijdag (code-rijen 3/4/5).
    ' IF-guard op de koprij (rij 3): enkel tellen als het slot een groentenaam
    ' heeft. Groente in het pakket maar nergens weggelaten -> 0; ongebruikt slot
    ' (lege koprij) -> leeg (geen 0). De guard past zich ook aan een handmatig
    ' toegevoegde weglating-groente aan.
    Dim sWK     As String
    Dim sWRange As String
    Dim sCDag   As String
    sCDag = "$C$7:$C$" & iLaatste
    For ic = cWeg0 To cWeg0 + nWegSlots - 1
        sWK = KolomLetter(ic)
        sWRange = sWK & "7:" & sWK & iLaatste
        ' Totaal (spreadsheet rij 4)
        oSheet.getCellByPosition(ic, 3).setFormula( _
            "=IF(" & sWK & "$3="""";"""";SUMPRODUCT((" & sWRange & "<>"""")*1))")
        ' Donderdag (spreadsheet rij 5)
        oSheet.getCellByPosition(ic, 4).setFormula( _
            "=IF(" & sWK & "$3="""";"""";SUMPRODUCT((" & sWRange & "<>"""")*(" & sCDag & "=""donderdag"")))")
        ' Vrijdag (spreadsheet rij 6)
        oSheet.getCellByPosition(ic, 5).setFormula( _
            "=IF(" & sWK & "$3="""";"""";SUMPRODUCT((" & sWRange & "<>"""")*(" & sCDag & "=""vrijdag"")))")
    Next ic

    ' =============================================
    ' OPMAAK TOEPASSEN
    ' =============================================

    ' Helper: pas celstijl toe
    ' Kleuren als Long: RGB(r,g,b) of &H00RRGGBB
    Dim nTotRijen As Integer
    nTotRijen = r + 1  ' r is de laatste geschreven rij

    ' --- Kolombreedtes instellen ---
    ' Vaste kolommen (0-23)
    Dim aBreedtes(23) As Long
    aBreedtes(0)  = 4219  ' naam
    aBreedtes(1)  = 2800  ' afhaalpunt
    aBreedtes(2)  = 1800  ' dag klaarmaken
    aBreedtes(3)  = 3250  ' type
    aBreedtes(4)  = 1900  ' formaat
    aBreedtes(5)  = 7500  ' opmerkingen
    aBreedtes(6)  = 5500  ' email
    aBreedtes(7)  = 2500  ' telefoon
    aBreedtes(8)  = 1850  ' voornaam
    aBreedtes(9)  = 2205  ' klant_type
    aBreedtes(10) = 1800  ' leverdag (verborgen)
    aBreedtes(11) = 993   ' abonnement_wijziging
    aBreedtes(12) = 993   ' week_stop
    aBreedtes(13) = 1800  ' dag afhaling
    aBreedtes(14) = 993   ' week_start
    aBreedtes(15) = 1700  ' klant_id
    aBreedtes(16) = 4219  ' datum/totaal kolom
    aBreedtes(17) = 700   ' KG
    aBreedtes(18) = 700   ' GG
    aBreedtes(19) = 700   ' EGG
    aBreedtes(20) = 700   ' MINI
    aBreedtes(21) = 1000  ' extra spacer (kolom V)
    aBreedtes(22) = 10000 ' samenvatting (kolom W)
    aBreedtes(23) = 2000  ' € losse (kolom X)

    Dim ci As Integer
    For ci = 0 To 23
        oSheet.Columns.getByIndex(ci).Width = aBreedtes(ci)
    Next ci
    ' Losse groenten: basisbreedte 2,30 cm per slot, maar breder als de prijsregel
    ' in rij 3 ("<prijs> € / <eenheid>") niet past — anders toont LibreOffice "###".
    ' De kop (rij 2) breekt af (wrap) en is dus niet bepalend; enkel rij 3 telt.
    ' Schatting op tekenlengte: ~190 (1/100 mm) per teken + marge. De vaste tekst
    ' " € / " = 5 tekens; de prijs heeft altijd 2 decimalen (Format "0.00").
    ' 2300 = minimum (normale "… € / kg"-kolommen blijven gelijk), 4200 = plafond.
    Dim nLenR3 As Integer
    Dim nWdtR3 As Long
    For ci = 0 To nGroentSlots - 1
        nWdtR3 = 2300
        If ci < nGroenten Then
            nLenR3 = Len(Format(groentPrijs(ci), "0.00")) + 5 + Len(groentEenh(ci))
            nWdtR3 = 190 * nLenR3 + 200
            If nWdtR3 < 2300 Then nWdtR3 = 2300
            If nWdtR3 > 4200 Then nWdtR3 = 4200
        End If
        oSheet.Columns.getByIndex(cGroent0 + ci).Width = nWdtR3
    Next ci
    ' Invoerhulp op de losse-groente-slots: wijs op de macro VoegLosseGroenteToe
    ZetLosseGroenteTip(oSheet)
    oSheet.Columns.getByIndex(cAnder).Width  = 2300   ' ander
    oSheet.Columns.getByIndex(cAangep).Width = 3344   ' aangepast pakket
    oSheet.Columns.getByIndex(cGeen).Width   = 5000   ' synthese weglatingen
    ' Weglatingen: 2260 elk (alle 12 slots)
    For ci = 0 To nWegSlots - 1
        oSheet.Columns.getByIndex(cWeg0 + ci).Width = 2260
    Next ci

    ' Kolommen I, J en K verbergen
    oSheet.Columns.getByIndex(cVoor).IsVisible    = False
    oSheet.Columns.getByIndex(cType).IsVisible    = False
    oSheet.Columns.getByIndex(cDag).IsVisible     = False

    ' --- Rijhoogtes instellen ---
    oSheet.Rows.getByIndex(0).Height = 960   ' rij 0: metadata
    oSheet.Rows.getByIndex(1).OptimalHeight = False
    oSheet.Rows.getByIndex(1).Height = 1200
    Dim ri As Integer
    oSheet.Rows.getByIndex(2).Height = 1640
    For ri = 3 To 5
        oSheet.Rows.getByIndex(ri).Height = 450
    Next ri
    For ri = 6 To nTotRijen
        oSheet.Rows.getByIndex(ri).OptimalHeight = True
    Next ri

    ' --- Kleuren en lettertype per zone ---
    ' Kleuren als Long (LibreOffice gebruikt BGR intern, maar RGB() werkt correct)
    Dim clCyan     As Long : clCyan     = RGB(153, 255, 255)  ' #99FFFF - metadata rij
    Dim clGrijs    As Long : clGrijs    = RGB(204, 204, 204)  ' #CCCCCC - kolomhoofden
    Dim clGeel     As Long : clGeel     = RGB(255, 255, 153)  ' #FFFF99 - afhaalpunt/groenten
    Dim clDDDDDD   As Long : clDDDDDD   = RGB(221, 221, 221)  ' #DDDDDD - totaalrijen
    Dim clWit      As Long : clWit      = RGB(255, 255, 255)  ' #FFFFFF - klantdata
    Dim clOranje   As Long : clOranje   = RGB(255, 128,   0)  ' #FF8000 - weglatingen
    Dim clGoud     As Long : clGoud     = RGB(204, 153,   0)  ' #CC9900 - datumcel rij1
    Dim clGroenKG  As Long : clGroenKG  = RGB(204, 255, 153)  ' #CCFF99 - KG
    Dim clBlauwGG  As Long : clBlauwGG  = RGB(153, 204, 255)  ' #99CCFF - GG
    Dim clGrijsEGG As Long : clGrijsEGG = RGB(178, 178, 178)  ' #B2B2B2 - EGG
    Dim clRoosM    As Long : clRoosM    = RGB(255, 153, 204)  ' #FF99CC - MINI
    Dim clGrijsTekst As Long : clGrijsTekst = RGB(128, 128, 128)

    ' Hulpfunctie: stijl toepassen op een cel
    ' (inline, LibreOffice Basic heeft geen echte functies met objecten)

    Dim oC As Object
    Dim cIdx As Integer
    Dim rIdx As Integer

    ' --- RIJ 0: metadata (#99FFFF, wit tekst, vet, 16pt, midden/midden) ---
    For cIdx = 0 To cWeg0 + nWegSlots - 1
        oC = oSheet.getCellByPosition(cIdx, 0)
        oC.CellBackColor   = clCyan
        oC.CharWeight      = com.sun.star.awt.FontWeight.BOLD
        oC.CharHeight      = 16
        oC.HoriJustify     = com.sun.star.table.CellHoriJustify.CENTER
        oC.VertJustify     = com.sun.star.table.CellVertJustify2.CENTER
        oC.IsTextWrapped   = True
    Next cIdx
    ' Kolommen 0-3: iets kleiner lettertype
    For cIdx = 0 To 3
        oSheet.getCellByPosition(cIdx, 0).CharHeight = 14
    Next cIdx

    ' --- RIJ 1: kolomhoofden (#CCCCCC, vet, 10pt, links/boven, tekstomloop) ---
    For cIdx = 0 To cWeg0 + nWegSlots - 1
        oC = oSheet.getCellByPosition(cIdx, 1)
        oC.CellBackColor = clGrijs
        oC.CharWeight    = com.sun.star.awt.FontWeight.BOLD
        oC.CharHeight    = 10
        oC.HoriJustify   = com.sun.star.table.CellHoriJustify.LEFT
        oC.VertJustify   = com.sun.star.table.CellVertJustify2.TOP
        oC.IsTextWrapped = True
    Next cIdx
    ' Datumkolom rij1: goud, 16pt, midden
    oC = oSheet.getCellByPosition(cDatum, 1)
    oC.CellBackColor = clGoud
    oC.CharHeight    = 16
    oC.HoriJustify   = com.sun.star.table.CellHoriJustify.CENTER
    oC.VertJustify   = com.sun.star.table.CellVertJustify2.CENTER
    ' KG/GG/EGG/MINI rij1: eigen kleuren, links/boven
    oSheet.getCellByPosition(cKG,   1).CellBackColor = clGroenKG
    oSheet.getCellByPosition(cGG,   1).CellBackColor = clBlauwGG
    oSheet.getCellByPosition(cEGG,  1).CellBackColor = clGrijsEGG
    oSheet.getCellByPosition(cMINI, 1).CellBackColor = clRoosM
    For cIdx = cKG To cMINI
        oSheet.getCellByPosition(cIdx, 1).HoriJustify = com.sun.star.table.CellHoriJustify.LEFT
    Next cIdx
    ' Groenten + ander rij1: #99FFFF, links/boven
    For cIdx = cGroent0 To cAnder
        oC = oSheet.getCellByPosition(cIdx, 1)
        oC.CellBackColor = clCyan
        oC.HoriJustify   = com.sun.star.table.CellHoriJustify.LEFT
    Next cIdx
    ' Synthese weglatingen rij1: oranje
    oSheet.getCellByPosition(cGeen, 1).CellBackColor = clOranje
    ' Weglatingen rij1: oranje
    For cIdx = cWeg0 To cWeg0 + nWegSlots - 1
        oSheet.getCellByPosition(cIdx, 1).CellBackColor = clOranje
    Next cIdx
    ' Samenvatting rij1: grijs kolomhoofd
    Dim oCsamHoofd As Object
    oCsamHoofd = oSheet.getCellByPosition(cSamenv, 1)
    oCsamHoofd.CellBackColor = clGrijs
    oCsamHoofd.CharWeight    = com.sun.star.awt.FontWeight.BOLD
    oCsamHoofd.CharHeight    = 10
    oCsamHoofd.HoriJustify   = com.sun.star.table.CellHoriJustify.LEFT
    oCsamHoofd.VertJustify   = com.sun.star.table.CellVertJustify2.TOP
    oCsamHoofd.IsTextWrapped = True

    ' --- RIJ 2: eenheden (#DDDDDD voor datum/pakket, #99FFFF voor groenten) ---
    For cIdx = 0 To cWeg0 + nWegSlots - 1
        oC = oSheet.getCellByPosition(cIdx, 2)
        oC.CharWeight    = com.sun.star.awt.FontWeight.BOLD
        oC.CharHeight    = 10
        oC.IsTextWrapped = True
        oC.VertJustify   = com.sun.star.table.CellVertJustify2.TOP
    Next cIdx
    oSheet.getCellByPosition(cDatum, 2).CellBackColor = clDDDDDD
    oSheet.getCellByPosition(cKG,    2).CellBackColor = clDDDDDD
    oSheet.getCellByPosition(cGG,    2).CellBackColor = clDDDDDD
    oSheet.getCellByPosition(cEGG,   2).CellBackColor = clDDDDDD
    oSheet.getCellByPosition(cMINI,  2).CellBackColor = clDDDDDD
    For cIdx = cGroent0 To cAnder
        oSheet.getCellByPosition(cIdx, 2).CellBackColor = clCyan
    Next cIdx
    oSheet.getCellByPosition(cGeen, 2).CellBackColor = clOranje

    ' Q3 (totaal pakketten): horizontaal en verticaal centreren
    oSheet.getCellByPosition(cDatum, 2).HoriJustify = com.sun.star.table.CellHoriJustify.CENTER
    oSheet.getCellByPosition(cDatum, 2).VertJustify = com.sun.star.table.CellVertJustify2.CENTER

    ' W3 (losse bestellingen): zelfde opmaak als Q3
    oSheet.getCellByPosition(cSamenv, 2).CellBackColor = clDDDDDD
    oSheet.getCellByPosition(cSamenv, 2).HoriJustify   = com.sun.star.table.CellHoriJustify.CENTER
    oSheet.getCellByPosition(cSamenv, 2).VertJustify   = com.sun.star.table.CellVertJustify2.CENTER

    ' B3/C3 ("PAKKETTEN" / "LOS"): tekst onderaan rij 2 zodat ze visueel vlak
    ' boven B4/C4 staan (override van de algemene rij 2 VertJustify=TOP).
    oSheet.getCellByPosition(cAfh,      2).VertJustify = com.sun.star.table.CellVertJustify2.BOTTOM
    oSheet.getCellByPosition(cKlaarDag, 2).VertJustify = com.sun.star.table.CellVertJustify2.BOTTOM

    ' --- RIJEN 3-5: totaal/donderdag/vrijdag (#DDDDDD, vet) ---
    For rIdx = 3 To 5
        For cIdx = 0 To cWeg0 + nWegSlots - 1
            oC = oSheet.getCellByPosition(cIdx, rIdx)
            oC.CharWeight    = com.sun.star.awt.FontWeight.BOLD
            oC.CharHeight    = 10
            oC.IsTextWrapped = True
        Next cIdx
        oSheet.getCellByPosition(cDatum,  rIdx).CellBackColor = clDDDDDD
        oSheet.getCellByPosition(cKG,     rIdx).CellBackColor = clDDDDDD
        oSheet.getCellByPosition(cGG,     rIdx).CellBackColor = clDDDDDD
        oSheet.getCellByPosition(cEGG,    rIdx).CellBackColor = clDDDDDD
        oSheet.getCellByPosition(cMINI,   rIdx).CellBackColor = clDDDDDD
        oSheet.getCellByPosition(cSamenv, rIdx).CellBackColor = clDDDDDD
        For cIdx = cGroent0 To cAnder
            oSheet.getCellByPosition(cIdx, rIdx).CellBackColor = clGeel
        Next cIdx
        oSheet.getCellByPosition(cGeen, rIdx).CellBackColor = clGeel
        For cIdx = cWeg0 To cWeg0 + nWegSlots - 1
            oSheet.getCellByPosition(cIdx, rIdx).CellBackColor = clGeel
        Next cIdx
    Next rIdx

    ' --- OPMERKINGEN-BLOK: zelfde opmaak als een afhaalpunt-blok ---
    ' Koprij geel/vet, notitierijen wit — inclusief de lege invulrijen, zodat
    ' wat je er doorheen de week bijtypt er meteen bij hoort.
    Dim rOpm As Integer
    PasRijOpmaakToe(oSheet, 6, clGeel, True, _
                    cGroent0, cAangep, cGeen, cWeg0, nWegSlots, clGeel, clGeel)
    For rOpm = 7 To 6 + nOpmAlg + nOpmVrij
        PasRijOpmaakToe(oSheet, rOpm, clWit, False, _
                        cGroent0, cAangep, cGeen, cWeg0, nWegSlots, clCyan, clOranje)
    Next rOpm

    ' --- KLANTDATA RIJEN: opmaak per rij ---
    Dim rStart As Integer
    rStart = rKlantStart
    Dim rLoop As Integer
    rLoop = rStart

    ' Herteken afhaalpunt-koprijlijnen en klantdata
    ' We weten de volgorde: koprijlijn (geel) dan klanten (wit) dan subtotaal (geel)
    ' Herstel door opnieuw te lopen over bDag/bAfh arrays

    Dim sVorigAfh2 As String
    Dim sVorigDag2 As String
    sVorigAfh2 = ""
    sVorigDag2 = ""

    For b = 0 To nBest - 1
        If bAfh(b) <> sVorigAfh2 Or bDag(b) <> sVorigDag2 Then
            ' Dit was een subtotaalrij (als er al een groep was)
            If sVorigAfh2 <> "" Then
                rLoop = rLoop + 1  ' witregel
            End If
            ' Koprijlijn = geel, vet
            PasRijOpmaakToe(oSheet, rLoop, clGeel, True, _
                            cGroent0, cAangep, cGeen, cWeg0, nWegSlots, clGeel, clGeel)
            rLoop = rLoop + 1
            sVorigAfh2 = bAfh(b)
            sVorigDag2 = bDag(b)
        End If
        ' Klantdata rij = wit, normaal
        PasRijOpmaakToe(oSheet, rLoop, clWit, False, _
                        cGroent0, cAangep, cGeen, cWeg0, nWegSlots, clCyan, clOranje)
        rLoop = rLoop + 1
    Next b
    ' Witregel na laatste groep: geen opmaak nodig

    ' --- Celranden instellen ---
    Dim oBL As New com.sun.star.table.BorderLine2
    oBL.LineStyle = com.sun.star.table.BorderLineStyle.SOLID
    oBL.LineWidth = 26
    oBL.Color     = RGB(0, 0, 0)
    Dim oTB As New com.sun.star.table.TableBorder2
    oTB.TopLine            = oBL : oTB.IsTopLineValid        = True
    oTB.BottomLine         = oBL : oTB.IsBottomLineValid     = True
    oTB.LeftLine           = oBL : oTB.IsLeftLineValid       = True
    oTB.RightLine          = oBL : oTB.IsRightLineValid      = True
    oTB.HorizontalLine     = oBL : oTB.IsHorizontalLineValid = True
    oTB.VerticalLine       = oBL : oTB.IsVerticalLineValid   = True
    Dim oRandBereik As Object
    oRandBereik = oSheet.getCellRangeByPosition(0, 0, cWeg0 + nWegSlots - 1, nTotRijen - 1)
    oRandBereik.TableBorder2 = oTB

    ' --- Rijen/kolommen vastzetten bij B7 ---
    oNieuwDoc.getCurrentController().freezeAtPosition(1, 6)

    ' --- Tabblad "pakketwaardes" (bewerkbaar; bron voor weglatingen-verrekening) ---
    ' Eén rij per groente met de in-pakket-waarde per formaat. Initieel gevuld
    ' vanuit pakket_inhoud.waarde (Sheets-sync), maar vrij bewerkbaar: de
    ' afrekening verwijst hiernaar zodat jouw bijsturing meteen doorwerkt.
    ' MOET vóór het afrekeningstabblad worden aangemaakt — de afrekening-formules
    ' verwijzen ernaar, en LibreOffice compileert een verwijzing naar een nog
    ' onbestaand blad meteen tot een fout.
    Dim oPW As Object
    If oNieuwDoc.Sheets.hasByName("pakketwaardes") Then
        oPW = oNieuwDoc.Sheets.getByName("pakketwaardes")
    Else
        oNieuwDoc.Sheets.insertNewByName("pakketwaardes", oNieuwDoc.Sheets.Count)
        oPW = oNieuwDoc.Sheets.getByName("pakketwaardes")
    End If
    Dim oFmtsPW As Object : oFmtsPW = oNieuwDoc.getNumberFormats()
    Dim oLocPW As New com.sun.star.lang.Locale
    oLocPW.Language = "nl" : oLocPW.Country = "BE"
    Dim nCurPW As Long, sCurPW As String
    sCurPW = "#.##0,00"" " & Chr(8364) & """"
    nCurPW = oFmtsPW.queryKey(sCurPW, oLocPW, False)
    If nCurPW = -1 Then nCurPW = oFmtsPW.addNew(sCurPW, oLocPW)
    oPW.getCellByPosition(0, 0).setString("groente")
    oPW.getCellByPosition(1, 0).setString("klein (KG)")
    oPW.getCellByPosition(2, 0).setString("groot (GG)")
    oPW.getCellByPosition(3, 0).setString("extra groot (EGG)")
    oPW.getCellByPosition(4, 0).setString("mini (MINI)")
    Dim iPwRij As Integer
    For iPwRij = 0 To nPW - 1
        oPW.getCellByPosition(0, iPwRij + 1).setString(pwNaam(iPwRij))
        oPW.getCellByPosition(1, iPwRij + 1).setValue(pwKG(iPwRij))
        oPW.getCellByPosition(2, iPwRij + 1).setValue(pwGG(iPwRij))
        oPW.getCellByPosition(3, iPwRij + 1).setValue(pwEGG(iPwRij))
        oPW.getCellByPosition(4, iPwRij + 1).setValue(pwMINI(iPwRij))
    Next iPwRij
    If nPW > 0 Then
        oPW.getCellRangeByName("B2:E" & (nPW + 1)).NumberFormat = nCurPW
    End If
    oPW.getCellRangeByName("A1:E1").CharWeight = com.sun.star.awt.FontWeight.BOLD
    oPW.Columns.getByIndex(0).Width = 5000

    ' --- Tabblad "afrekening" ---
    ' Spiegelt de klantrijen van het datablad met levende formules en
    ' berekent per klant het te betalen bedrag. Manuele correcties van de
    ' geleverde hoeveelheden (kolom W+ op het datablad) rekenen meteen door.
    Dim oAfr As Object
    If oNieuwDoc.Sheets.hasByName("afrekening") Then
        oAfr = oNieuwDoc.Sheets.getByName("afrekening")
    Else
        oNieuwDoc.Sheets.insertNewByName("afrekening", 1)
        oAfr = oNieuwDoc.Sheets.getByName("afrekening")
    End If

    Dim sData As String
    sData = "'Week " & iWeek & " - " & iJaar & "'"   ' bladnaam voor formules

    ' Valuta-opmaak
    Dim oFmtsA As Object : oFmtsA = oNieuwDoc.getNumberFormats()
    Dim oLocA As New com.sun.star.lang.Locale
    oLocA.Language = "nl" : oLocA.Country = "BE"
    Dim nCur As Long, sCurFmt As String
    sCurFmt = "#.##0,00"" " & Chr(8364) & """"
    nCur = oFmtsA.queryKey(sCurFmt, oLocA, False)
    If nCur = -1 Then nCur = oFmtsA.addNew(sCurFmt, oLocA)

    ' Pakketprijzen bovenaan — aanpasbaar
    oAfr.getCellByPosition(0, 0).setString("AFREKENING - Week " & iWeek & " - " & iJaar)
    oAfr.getCellByPosition(0, 1).setString("Klein pakket")
    oAfr.getCellByPosition(0, 2).setString("Groot pakket")
    oAfr.getCellByPosition(0, 3).setString("Extra groot pakket")
    oAfr.getCellByPosition(0, 4).setString("Mini pakket")
    oAfr.getCellByPosition(1, 1).setValue(prijsKlein)
    oAfr.getCellByPosition(1, 2).setValue(prijsGroot)
    oAfr.getCellByPosition(1, 3).setValue(prijsEGroot)
    oAfr.getCellByPosition(1, 4).setValue(prijsMini)
    oAfr.getCellRangeByName("B2:B5").NumberFormat = nCur

    ' --- Samenvatting bovenaan: weekwaarden (kruiscontrole met het maandbestand) ---
    ' Robuust uit de datablad-AGGREGAATrijen (SUMIF; rij 4=totaal, 5=donderdag,
    ' 6=vrijdag), NIET uit de per-klant-cellen: een handmatig verwijderde klantrij
    ' breekt een per-klant-formule (#VERW!) en zou anders elk totaal besmetten.
    ' C2:E5 = pakketwaarde per type (aantal datablad x prijscel B2:B5), do/vr/totaal.
    oAfr.getCellByPosition(2, 0).setString("donderdag")   ' C1
    oAfr.getCellByPosition(3, 0).setString("vrijdag")     ' D1
    oAfr.getCellByPosition(4, 0).setString("totaal")      ' E1
    Dim aPkCol(3) As String
    aPkCol(0) = KolomLetter(cKG)    ' R Klein   -> prijs B2
    aPkCol(1) = KolomLetter(cGG)    ' S Groot   -> B3
    aPkCol(2) = KolomLetter(cEGG)   ' T E.groot -> B4
    aPkCol(3) = KolomLetter(cMINI)  ' U Mini    -> B5
    Dim iPk As Integer, sPrR As String
    For iPk = 0 To 3
        sPrR = CStr(iPk + 2)        ' prijscel B2..B5 = type-rij iPk+2
        oAfr.getCellByPosition(2, iPk + 1).setFormula("=" & sData & "." & aPkCol(iPk) & "5*$B$" & sPrR)  ' do (datablad rij 5)
        oAfr.getCellByPosition(3, iPk + 1).setFormula("=" & sData & "." & aPkCol(iPk) & "6*$B$" & sPrR)  ' vr (rij 6)
        oAfr.getCellByPosition(4, iPk + 1).setFormula("=" & sData & "." & aPkCol(iPk) & "4*$B$" & sPrR)  ' totaal (rij 4)
    Next iPk
    oAfr.getCellRangeByName("C2:E5").NumberFormat = nCur
    oAfr.getCellRangeByName("C1:E1").CharWeight = com.sun.star.awt.FontWeight.BOLD

    ' Zij-strookje G2:H5 — totalen + WEEKTOTAAL (= het getal dat met het maandbestand
    ' moet kloppen). Bijbestellingen uit het datablad-totaal van "€ losse" (kolom X);
    ' weglatingen fouttolerant (AGGREGATE negeert #VERW!-weescellen van verwijderde rijen).
    Dim sXcol As String : sXcol = KolomLetter(cWaarde)   ' X = € losse groenten
    oAfr.getCellByPosition(6, 1).setString("Pakketten")         ' G2
    oAfr.getCellByPosition(6, 2).setString("Bijbestellingen")   ' G3
    oAfr.getCellByPosition(6, 3).setString("Weglatingen (-)")   ' G4
    oAfr.getCellByPosition(6, 4).setString("WEEKTOTAAL")        ' G5
    oAfr.getCellByPosition(7, 1).setFormula("=SUM(E2:E5)")                       ' H2 pakketten totaal
    oAfr.getCellByPosition(7, 2).setFormula("=" & sData & "." & sXcol & "4")     ' H3 bijbestellingen totaal
    oAfr.getCellByPosition(7, 3).setFormula("=AGGREGATE(9;6;D7:D2000)")          ' H4 weglatingen totaal (fouttolerant)
    oAfr.getCellByPosition(7, 4).setFormula("=H2+H3-H4")                         ' H5 WEEKTOTAAL
    oAfr.getCellRangeByName("H2:H5").NumberFormat = nCur
    oAfr.getCellRangeByName("G2:G5").CharWeight = com.sun.star.awt.FontWeight.BOLD
    oAfr.getCellRangeByName("G5:H5").CharWeight = com.sun.star.awt.FontWeight.BOLD

    ' Koprij van de afrekeningstabel
    oAfr.getCellByPosition(0, 5).setString("klant / afhaalpunt")
    oAfr.getCellByPosition(1, 5).setString("pakket")
    oAfr.getCellByPosition(2, 5).setString("losse groenten")
    oAfr.getCellByPosition(3, 5).setString("weglatingen (-)")
    oAfr.getCellByPosition(4, 5).setString("TOTAAL")
    oAfr.getCellByPosition(5, 5).setString("klant_id")            ' kolom F
    oAfr.getCellByPosition(cGeen, 5).setString("detail weglatingen") ' kolom AY
    oAfr.getCellByPosition(cSamenv, 5).setString("detail losse groenten")
    ' Alle 24 gereserveerde groente-slots (Y..AV) spiegelen, niet enkel de
    ' groenten uit de DB: zo wordt een handmatig in rij 2 van het datablad
    ' toegevoegde losse groente automatisch overgenomen. IF-wrap houdt een nog
    ' lege slot leeg i.p.v. een storende "0" in de koprij.
    For g = 0 To nGroentSlots - 1
        oAfr.getCellByPosition(cGroent0 + g, 5).setFormula( _
            "=IF(" & sData & "." & KolomLetter(cGroent0 + g) & "2="""";"""";" & _
            sData & "." & KolomLetter(cGroent0 + g) & "2)")
    Next g

    ' Weglatings-DETAILkolommen (vanaf AZ, uitgelijnd op het datablad): per
    ' weglatingsgroente de waarde die de klant in mindering krijgt. Er staan nu
    ' vast nWegSlots (>=12) kolommen klaar, ook lege, zodat een handmatig
    ' toegevoegde weglating meteen meeloopt. Het vaste TOTAAL staat in kolom D —
    ' daar naar verwijzen voor maandoverzichten, niet naar deze detailkolommen.
    ' De waarde wordt opgezocht in 'pakketwaardes' o.b.v. (formaat, groentenaam).
    ' Weglating-koprij (rij 6): spiegel de groentenaam uit rij 3 van het
    ' datablad voor alle nWegSlots kolommen. Zo verschijnt een handmatig
    ' toegevoegde weglating-groente automatisch, en blijft een lege slot leeg.
    Dim wHdr As Integer
    For wHdr = 0 To nWegSlots - 1
        oAfr.getCellByPosition(cWeg0 + wHdr, 5).setFormula( _
            "=IF(" & sData & "." & KolomLetter(cWeg0 + wHdr) & "3="""";"""";" & _
            sData & "." & KolomLetter(cWeg0 + wHdr) & "3)")
    Next wHdr

    ' Spiegel: één rij per datablad-rij. De formules lopen op ELKE rij mee —
    ' ook op witregels, afhaalpunt-koprijen en de extra lege rijen onderaan — en
    ' geven "" als de bron leeg is of het een afhaalpunt-/witregel is, zodat er
    ' nergens een storende 0 verschijnt. Onderaan staan standaard nExtra lege
    ' rijen mét formules klaar zodat een handmatig toegevoegde klant meteen telt.
    Dim sLG As String : sLG = KolomLetter(cGroent0 + nGroentSlots - 1)  ' laatste groente-slot (AV)
    Dim sFG As String : sFG = KolomLetter(cGroent0)                     ' eerste groente-slot (Y)
    Dim sEenRng As String
    sEenRng = "Blad2.A$100:" & KolomLetter(nGroentSlots - 1) & "$100"
    Dim sWegF As String, sWegL As String, sPwVal As String, sPwKey As String
    Dim nPwRijen As Integer : nPwRijen = nPW : If nPwRijen < 1 Then nPwRijen = 1
    sWegF  = KolomLetter(cWeg0)
    sWegL  = KolomLetter(cWeg0 + nWegSlots - 1)
    sPwVal = "pakketwaardes.$B$2:$E$" & (nPwRijen + 1)
    sPwKey = "pakketwaardes.$A$2:$A$" & (nPwRijen + 1)

    Const nExtra = 10                       ' extra lege rijen met formules klaar
    Dim nLaatsteForm As Integer
    nLaatsteForm = iLaatste + nExtra        ' laatste rij (1-based) met formules

    Dim ar As Integer, asr As Integer
    Dim sGuard As String, sCol As String, sFmtCol As String
    Dim wAfr As Integer, sWegColA As String
    For ar = 6 To nLaatsteForm - 1
        asr = ar + 1
        ' Echte klantrij = naam-bron niet leeg én geen afhaalpunt-koprij. Anders
        ' (witregel, afhaalpunt-rij, extra lege rij) geven de bedrag-kolommen "".
        sGuard = "OR(" & sData & ".A" & asr & "="""";" & _
                 sData & "." & KolomLetter(cAfh) & asr & "=""afhaalpunt/dag"")"

        ' A: naam/afhaalpunt spiegelen (leeg → leeg, niet 0)
        oAfr.getCellByPosition(cNaam, ar).setFormula( _
            "=IF(" & sData & ".A" & asr & "="""";"""";" & sData & ".A" & asr & ")")
        ' F: klant_id uit kolom P; lege bron → leeg (matcht in maandbestand)
        oAfr.getCellByPosition(5, ar).setFormula( _
            "=IF(" & sData & "." & KolomLetter(cWBest) & asr & "="""";"""";" & _
            sData & "." & KolomLetter(cWBest) & asr & ")")
        ' B: pakket-bedrag = pakkettype x pakketprijs-cel bovenaan
        oAfr.getCellByPosition(1, ar).setFormula( _
            "=IF(" & sGuard & ";"""";" & _
            sData & "." & KolomLetter(cKG)   & asr & "*$B$2+" & _
            sData & "." & KolomLetter(cGG)   & asr & "*$B$3+" & _
            sData & "." & KolomLetter(cEGG)  & asr & "*$B$4+" & _
            sData & "." & KolomLetter(cMINI) & asr & "*$B$5)")
        ' per groente Y..AV: geleverde hoeveelheid x prijs/eenheid (rij 3); leeg -> ""
        For g = 0 To nGroentSlots - 1
            sCol = KolomLetter(cGroent0 + g)
            oAfr.getCellByPosition(cGroent0 + g, ar).setFormula( _
                "=IF(" & sData & "." & sCol & asr & "="""";"""";" & _
                sData & "." & sCol & asr & "*" & sData & "." & sCol & "$3)")
        Next g
        ' C: losse-groenten-totaal
        oAfr.getCellByPosition(2, ar).setFormula( _
            "=IF(" & sGuard & ";"""";SUM(" & sFG & asr & ":" & sLG & asr & "))")
        ' W: detail losse groenten (levende formule), per groente
        '   "<naam>: <aantal> <eenheid> a <prijs> EUR = <totaal> EUR"
        ' De "x "-prefix voor per_stuk zit al in de Blad2-cel; a via Chr(224),
        ' EUR via Chr(8364) tegen UTF-8 -> Latin-1 mojibake.
        oAfr.getCellRangeByName(KolomLetter(cSamenv) & asr).setArrayFormula( _
            "=TEXTJOIN(CHAR(10);1;IF(" & sData & "." & sFG & asr & ":" & sLG & asr & "="""";"""";" & _
            sData & "." & sFG & "$2:" & sLG & "$2&"": ""&" & sData & "." & sFG & asr & ":" & sLG & asr & _
            "&"" ""&" & sEenRng & "&"" " & Chr(224) & " ""&" & _
            "TEXT(" & sData & "." & sFG & "$3:" & sLG & "$3;""0,00"")&"" " & Chr(8364) & " = ""&" & _
            "TEXT(" & sData & "." & sFG & asr & ":" & sLG & asr & "*" & sData & "." & sFG & "$3:" & sLG & "$3;""0,00"")&"" " & Chr(8364) & """))")
        ' Weglating-detailkolommen (AZ+): per groente de in-pakket-waarde, maar enkel
        ' als de klant ze weglaat. Opzoeken in 'pakketwaardes' o.b.v. (formaat
        ' 1=KG..4=MINI, naam). Niet-gevonden/"geen pakket" -> 0 (IFERROR). 12 slots.
        sFmtCol = "IF(" & sData & "." & KolomLetter(cKG)   & asr & ">0;1;" & _
                  "IF(" & sData & "." & KolomLetter(cGG)   & asr & ">0;2;" & _
                  "IF(" & sData & "." & KolomLetter(cEGG)  & asr & ">0;3;" & _
                  "IF(" & sData & "." & KolomLetter(cMINI) & asr & ">0;4;0))))"
        For wAfr = 0 To nWegSlots - 1
            sWegColA = KolomLetter(cWeg0 + wAfr)
            oAfr.getCellByPosition(cWeg0 + wAfr, ar).setFormula( _
                "=IF(" & sData & "." & sWegColA & asr & "="""";"""";" & _
                "IFERROR(INDEX(" & sPwVal & ";MATCH(" & sData & "." & sWegColA & "$3;" & sPwKey & ";0);" & _
                sFmtCol & ");0))")
        Next wAfr
        ' D: vast weglatingen-totaal = som van de detailkolommen
        oAfr.getCellByPosition(3, ar).setFormula( _
            "=IF(" & sGuard & ";"""";SUM(" & sWegF & asr & ":" & sWegL & asr & "))")
        ' AY: detail weglatingen als tekst, pendant van W. Per actieve weglating
        '   "Geen <naam>: -<waarde> EUR"  (naam uit koprij 6, waarde uit AZ+).
        oAfr.getCellRangeByName(KolomLetter(cGeen) & asr).setArrayFormula( _
            "=TEXTJOIN(CHAR(10);1;IF(" & sData & "." & sWegF & asr & ":" & sWegL & asr & "="""";"""";" & _
            """Geen ""&LOWER(" & sWegF & "$6:" & sWegL & "$6)&"": -""&" & _
            "TEXT(" & sWegF & asr & ":" & sWegL & asr & ";""0,00"")&"" " & Chr(8364) & """))")
        ' E: TOTAAL (vaste kolom E) = pakket + losse - weglatingen
        oAfr.getCellByPosition(4, ar).setFormula( _
            "=IF(" & sGuard & ";"""";B" & asr & "+C" & asr & "-D" & asr & ")")
    Next ar

    ' (Geen ALGEMEEN TOTAAL meer onderaan: de weektotalen staan nu robuust bovenaan
    '  in de samenvatting C1:E5 + G2:H5; een onderste SUM brak op een #VERW!-weescel.)

    ' Opmaak afrekeningstabblad
    oAfr.getCellRangeByName("B7:E" & nLaatsteForm).NumberFormat = nCur
    oAfr.getCellRangeByName(KolomLetter(cGroent0) & "7:" & sLG & nLaatsteForm).NumberFormat = nCur
    oAfr.getCellRangeByName(KolomLetter(cWeg0) & "7:" & KolomLetter(cWeg0 + nWegSlots - 1) & nLaatsteForm).NumberFormat = nCur
    oAfr.getCellRangeByName(KolomLetter(cWeg0) & "6:" & KolomLetter(cWeg0 + nWegSlots - 1) & "6").CharWeight = com.sun.star.awt.FontWeight.BOLD
    oAfr.getCellRangeByName("A6:" & sLG & "6").CharWeight = com.sun.star.awt.FontWeight.BOLD
    oAfr.getCellByPosition(cGeen, 5).CharWeight = com.sun.star.awt.FontWeight.BOLD
    oAfr.getCellByPosition(0, 0).CharWeight = com.sun.star.awt.FontWeight.BOLD
    oAfr.Columns.getByIndex(0).Width = 5000
    oAfr.Columns.getByIndex(1).Width = 2000
    oAfr.Columns.getByIndex(2).Width = 2600
    oAfr.Columns.getByIndex(3).Width = 2600
    oAfr.Columns.getByIndex(4).Width = 2400
    oAfr.Columns.getByIndex(6).Width = 3800   ' G samenvatting-labels
    oAfr.Columns.getByIndex(7).Width = 2600   ' H samenvatting-waarden
    oAfr.Columns.getByIndex(cSamenv).Width = 9000
    oAfr.getCellRangeByName(KolomLetter(cSamenv) & "7:" & KolomLetter(cSamenv) & nLaatsteForm).IsTextWrapped = True
    oAfr.Columns.getByIndex(cGeen).Width = 9000
    oAfr.getCellRangeByName(KolomLetter(cGeen) & "7:" & KolomLetter(cGeen) & nLaatsteForm).IsTextWrapped = True

    ' Eénmalig herberekenen en schermopbouw terug aanzetten vóór opslaan/tonen
    oNieuwDoc.calculateAll()
    oNieuwDoc.enableAutomaticCalculation(bAutoCalc)
    If bLocked Then
        oNieuwDoc.unlockControllers()
        bLocked = False
    End If

    oNieuwDoc.getCurrentController().setActiveSheet(oNieuwDoc.Sheets.getByIndex(0))

    ' --- Opslaan ---
    Dim sUrl As String
    sUrl = ConvertToURL(sBestand)

    ' Sluit bestaand bestand als het al open staat — maar NIET het aanroepende document
    If FileExists(sBestand) Then
        Dim oComp As Object
        Dim oEnum As Object
        oEnum = StarDesktop.Components.createEnumeration()
        Do While oEnum.hasMoreElements()
            oComp = oEnum.nextElement()
            If HasUnoInterfaces(oComp, "com.sun.star.lang.XServiceInfo") Then
                If oComp.supportsService("com.sun.star.sheet.SpreadsheetDocument") Then
                    If ConvertToURL(sBestand) = oComp.getURL() Then
                        If Not (oComp Is oCallerDoc) Then
                            oComp.close(True)
                        End If
                    End If
                End If
            End If
        Loop
    End If

    Dim aOpslaanProps(0) As New com.sun.star.beans.PropertyValue
    aOpslaanProps(0).Name  = "FilterName"
    aOpslaanProps(0).Value = "calc8"
    oNieuwDoc.storeToURL(sUrl, aOpslaanProps())
    oNieuwDoc.close(True)

    Dim bVanuitWeekbestand As Boolean
    bVanuitWeekbestand = (ConvertToURL(sBestand) = oCallerDoc.getURL())

    Dim sCorrSuffix As String : sCorrSuffix = ""
    If sDbCorr <> "" Then
        sCorrSuffix = Chr(10) & Chr(10) & _
            "Database-correcties t.o.v. de bestelling (URL):" & Chr(10) & sDbCorr
    End If
    If sWisselRapport <> "" Then
        sCorrSuffix = sCorrSuffix & Chr(10) & Chr(10) & _
            nWissel & " klant(en) met een tijdelijk ander afhaalpunt deze week " & _
            "(praktische info nodig):" & Chr(10) & sWisselRapport
    End If
    If sNogGeslotenRapport <> "" Then
        sCorrSuffix = sCorrSuffix & Chr(10) & Chr(10) & _
            nNogGesloten & " klant(en) staan deze week nog op een GESLOTEN afhaalpunt " & _
            "(nog niet gewisseld):" & Chr(10) & sNogGeslotenRapport
    End If
    If sWisselRapport <> "" Or sNogGeslotenRapport <> "" Then
        sCorrSuffix = sCorrSuffix & Chr(10) & _
            "Check ook kolom F (vragen_opmerkingen) / AW (ander, op de stapellijsten) " & _
            "in het weekbestand."
    End If
    ' Vangnet stap 1b: bestelde groenten die niet meer in het aanbod stonden.
    ' Altijd melden — zonder deze regels ziet niemand dat er iets afweek.
    If sHernoemRapport <> "" Then
        sCorrSuffix = sCorrSuffix & Chr(10) & Chr(10) & _
            nHernoem & " bestelde losse groente(n) stonden niet meer in het aanbod van " & _
            "deze week (hernoemd of geschrapt in de cockpit NA de eerste bestellingen). " & _
            "Ze zijn als EXTRA kolom opgenomen i.p.v. stil weggelaten:" & Chr(10) & _
            sHernoemRapport & _
            "Bij een hernoeming staat dezelfde groente nu in twee kolommen: tel ze samen " & _
            "in de nieuwe kolom en wis de oude. Was ze bewust geschrapt (niet oogstbaar), " & _
            "wis dan de kolom en verwittig die klanten."
    End If

    If bVanuitWeekbestand Then
        ' Kan het aanroepende document niet sluiten vanuit de lopende macro.
        ' Gebruiker sluit dit venster zelf; het bestand op schijf is al vervangen.
        MsgBox "Weekbestand aangemaakt:" & Chr(10) & sBestand & sCorrSuffix & Chr(10) & Chr(10) & _
               "Sluit dit venster zelf en open het bestand opnieuw.", 64, "Klaar"
    Else
        Dim aOpenProps(0) As New com.sun.star.beans.PropertyValue
        aOpenProps(0).Name  = "MacroExecutionMode"
        aOpenProps(0).Value = 4
        oDesktop.loadComponentFromURL(sUrl, "_blank", 0, aOpenProps())
        MsgBox "Weekbestand aangemaakt:" & Chr(10) & sBestand & sCorrSuffix, 64, "Klaar"
    End If
    SluitSSHTunnels()
    Exit Sub

OpkuisWB:
    ' Fout tijdens de opbouw van het weekbestand: schermopbouw/herberekening van
    ' het nieuwe document ALTIJD herstellen (anders blijft een bevroren venster
    ' achter), tunnels sluiten en de fout tonen.
    Dim sFoutWB As String
    sFoutWB = "Fout " & Err & " op regel " & Erl & ": " & Error
