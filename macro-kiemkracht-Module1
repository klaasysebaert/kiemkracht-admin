    ' Kiemkracht - Klantwijzigingen terugschrijven
    ' Vergelijkt klanten_beheer (kol C=id, F-Z=data, AC-AF=opt-outs) met
    ' klanten-tabblad. Stuurt alleen UPDATE voor rijen die werkelijk gewijzigd zijn.
    ' =============================================

    ' DB-verbinding: zie MaakDBVerbinding()

    ' Actief kiemkracht-data-bestand bepalen (prod of dev volgt dit bestand)
    Dim oDoc As Object
    oDoc = HuidigDataDocument()
    If IsNull(oDoc) Then
        MsgBox "Geen kiemkracht-data-bestand actief. Open kiemkracht-data.ods " & _
               "of kiemkracht-data-dev.ods en start de macro vanuit dat venster.", 16, "Fout"
