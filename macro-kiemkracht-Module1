           "opmerkingen, opmerkingen_volgend, opmerking_status, voornaam2, familienaam2) " & _
           "VALUES (" & _
           SqlStr(sVoornaam)      & ", " & SqlStr(sFamilienaam)  & ", " & SqlStr(sAanspreking) & ", " & _
           SqlStr(sKlantType)     & ", " & SqlStr(sBedrijfsnaam) & ", " & SqlStr(sBtwNummer)   & ", " & _
           SqlStr(sFactAdres)     & ", " & SqlStr(sEmail1)       & ", " & SqlStr(sEmail2)       & ", " & _
           SqlStr(sEmail3)        & ", " & SqlStr(sEmail4)       & ", " & SqlStr(sTelefoon)     & ", " & _
           SqlStr(sType)          & ", " & SqlStr(sFormaat)      & ", " & _
           sAfhaalpuntSql         & ", " & SqlStr(sNooitGroenten) & ", " & _
           sKlantSindsSql         & ", " & sLaatsteBestSql        & ", " & _
           SqlStr(sOpmerkingen)   & ", " & SqlStr(sOpmerkVolg)   & ", " & SqlStr(sOpmerkStat)  & ", " & _
