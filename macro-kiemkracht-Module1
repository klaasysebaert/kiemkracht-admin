Option Explicit

' =============================================
' OMGEVING & DATABASEVERBINDING — gedeelde helpers
' Eén centrale plek voor alle DB-macro's: bepaalt prod vs dev op
' basis van het open kiemkracht-data-bestand en geeft de juiste
' JDBC-verbinding terug.
' =============================================

' Module-level vlaggen: tunnel al gestart tijdens deze LO-sessie?
' Voorkomt dat een macro die meerdere DB-verbindingen nodig heeft
' (bv. KoffieWeekbestand: groenten + koffie) telkens een nieuwe
' ssh-tunnel opent in een extra cmd-venster.
Private mTunnelProdActief As Boolean
Private mTunnelDevActief  As Boolean

' Geeft het ACTIEVE document terug als het een kiemkracht-data-bestand is,
' anders Null. ThisComponent = het venster waarin de macro gestart is — zo
' werkt alles op het bestand waarin je de macro oproept, ook met
' kiemkracht-data.ods en kiemkracht-data-dev.ods tegelijk open.
Function HuidigDataDocument() As Object
    Dim oDoc As Object
    oDoc = ThisComponent
    If IsNull(oDoc) Then Exit Function
    If Not HasUnoInterfaces(oDoc, "com.sun.star.lang.XServiceInfo") Then Exit Function
    If oDoc.supportsService("com.sun.star.sheet.SpreadsheetDocument") Then
        If InStr(LCase(oDoc.getURL()), "kiemkracht-data") > 0 Then
            HuidigDataDocument = oDoc
        End If
    End If
End Function

' Geeft "dev" als het actieve bestand op "-dev.ods" eindigt, anders "prod".
' Geen kiemkracht-data-bestand actief -> "dev" (veilig: raakt nooit prod).
Function BepaalOmgeving() As String
    Dim oDoc As Object
    BepaalOmgeving = "dev"
    oDoc = HuidigDataDocument()
    If Not IsNull(oDoc) Then
        If InStr(LCase(oDoc.getURL()), "-dev.ods") = 0 Then
            BepaalOmgeving = "prod"
        End If
    End If
End Function

' Start de juiste SSH-tunnel en geeft een JDBC-verbinding terug.
' prod -> tunnel 5433, productiedatabase
' dev  -> tunnel 5434, staging-database (geanonimiseerde kopie van prod)
' Default-database = "postgres" (groenten). Voor andere DB's op dezelfde
' Postgres-instance (bv. "koffie"): MaakDBVerbindingNaar("koffie").
Function MaakDBVerbinding() As Object
    MaakDBVerbinding = MaakDBVerbindingNaar("postgres")
End Function

Function MaakDBVerbindingNaar(sDbNaam As String) As Object
    Dim sJdbcUrl     As String
    Dim sUser        As String
    Dim sPass        As String
    Dim bNetGestart  As Boolean
    bNetGestart = False

    If BepaalOmgeving() = "dev" Then
        ' Staging-DB op het Coolify bridge-netwerk (IP kan wijzigen bij Coolify-reset)
        If Not mTunnelDevActief Then
            Shell "cmd.exe /c start /min ssh -N -L 5434:10.0.1.9:5432 root@91.98.140.165 -i %USERPROFILE%\.ssh\id_ed25519"
            mTunnelDevActief = True
            bNetGestart = True
        End If
        sJdbcUrl = "jdbc:postgresql://localhost:5434/" & sDbNaam
        sUser    = "postgres"
        sPass    = "iKbZmOneZCodIWPqJLkqxv9c0hGhcMhCgmFPrSBppMYK1V3rSdm5AGAveApY4Eo2"
    Else
        If Not mTunnelProdActief Then
            Shell "cmd.exe /c start /min ssh -N -L 5433:localhost:5432 root@91.98.140.165"
            mTunnelProdActief = True
            bNetGestart = True
        End If
        sJdbcUrl = "jdbc:postgresql://localhost:5433/" & sDbNaam
        sUser    = "postgres"
        sPass    = "nAchtbr1l?0chtendst0ND4*0verjAs&"
    End If
    ' Enkel wachten als we net een nieuwe tunnel openden.
    If bNetGestart Then Wait 3000

    Dim aProps(2) As New com.sun.star.beans.PropertyValue
    aProps(0).Name  = "user"            : aProps(0).Value = sUser
    aProps(1).Name  = "password"        : aProps(1).Value = sPass
    aProps(2).Name  = "JavaDriverClass" : aProps(2).Value = "org.postgresql.Driver"

    Dim oManager As Object
    oManager = CreateUnoService("com.sun.star.sdbc.DriverManager")
    MaakDBVerbindingNaar = oManager.getConnectionWithInfo(sJdbcUrl, aProps())
End Function

' Sluit alle openstaande ssh-tunnels (cmd-vensters) en reset de
' module-level vlaggen. Alle DB-macro's roepen dit op het einde aan.
Sub SluitSSHTunnels()
    Shell "cmd.exe /c taskkill /F /IM ssh.exe"
    mTunnelProdActief = False
    mTunnelDevActief  = False
End Sub

Sub LaadAlleTabellen()

    ' =============================================
    ' Kiemkracht - Data loader
    ' Uitvoeren terwijl kiemkracht-data.ods open is
    ' Vereist: SSH-tunnel actief op poort 5433
    ' =============================================
    
    ' DB-verbinding en SSH-tunnel: zie MaakDBVerbinding()

    Dim oDoc         As Object
    Dim oSheets      As Object
    Dim oConn        As Object
    Dim oStmt        As Object
    Dim oRS          As Object
    Dim oSheet       As Object
    Dim oMeta        As Object
    Dim oIndicator   As Object
    Dim i            As Integer
    Dim col          As Integer
    Dim row          As Integer

    ' Tabellen om in te laden
    Dim tabellen(11)  As String
    tabellen(0)  = "afhaalpunten"
    tabellen(1)  = "annulaties"
    tabellen(2)  = "bestelling_weglatingen"
    tabellen(3)  = "bestellingen"
    tabellen(4)  = "bestelregels"
    tabellen(5)  = "groenten"
    tabellen(6)  = "klanten"
    tabellen(7)  = "pakket_inhoud"
    tabellen(8)  = "pakketten"
    tabellen(9)  = "vooruitbestellingen"
    tabellen(10) = "bestelling_overzicht"
    tabellen(11) = "verzonden_mails"

    ' Actief kiemkracht-data-bestand bepalen (prod of dev volgt dit bestand)
    oDoc = HuidigDataDocument()
    If IsNull(oDoc) Then
        MsgBox "Geen kiemkracht-data-bestand actief. Open kiemkracht-data.ods " & _
               "of kiemkracht-data-dev.ods en start de macro vanuit dat venster.", 16, "Fout"
        Exit Sub
    End If
    oSheets = oDoc.Sheets

    ' Startmelding
    MsgBox "Alle tabellen worden geladen." & Chr(10) & _
           "In de statusbalk links onderaan kan je de voortgang volgen.", 64, "LaadAlleTabellen"

    ' Voortgangsbalk in de statusbalk (onderaan het venster)
    oIndicator = oDoc.getCurrentController().getFrame().createStatusIndicator()
    oIndicator.start("Kiemkracht - tabellen laden", 100)
    oIndicator.setText("Verbinden met de database...")

    ' JDBC-verbinding openen (juiste omgeving via MaakDBVerbinding)
    On Error GoTo VerbindingsFout
    oConn = MaakDBVerbinding()
    On Error GoTo 0

    ' Loop over elke tabel
    Dim nTabellen As Integer : nTabellen = UBound(tabellen) + 1
    For i = 0 To UBound(tabellen)
        Dim sNaam As String
        sNaam = tabellen(i)

        oIndicator.setValue((i + 1) * 80 \ nTabellen)
        oIndicator.setText("Laden: " & sNaam & " (" & (i + 1) & "/" & nTabellen & ")")

        ' Tabblad aanmaken of leegmaken
        If oSheets.hasByName(sNaam) Then
            oSheet = oSheets.getByName(sNaam)
            oSheet.clearContents(7)
        Else
            oSheets.insertNewByName(sNaam, oSheets.Count)
            oSheet = oSheets.getByName(sNaam)
        End If

        ' Query uitvoeren
        oStmt = oConn.createStatement()
        oRS   = oStmt.executeQuery("SELECT * FROM " & sNaam)
        oMeta = oRS.getMetaData()

        Dim nKolommen As Integer
        nKolommen = oMeta.getColumnCount()

        ' Kolomhoofden schrijven (rij 0)
        For col = 1 To nKolommen
            oSheet.getCellByPosition(col - 1, 0).setString(oMeta.getColumnName(col))
        Next col

        ' Data schrijven
        row = 1
        Do While oRS.next()
            If (row Mod 200) = 0 Then
                oIndicator.setText("Laden: " & sNaam & " - " & row & " rijen")
            End If
            For col = 1 To nKolommen
                Dim sVal As String
                sVal = oRS.getString(col)
                If oRS.wasNull() Then
                    oSheet.getCellByPosition(col - 1, row).setString("")
                Else
                    Dim nType As Integer
                    nType = oMeta.getColumnType(col)
                    If (nType >= 2 And nType <= 8) Then
                        On Error Resume Next
                        Dim dVal As Double
                        dVal = CDbl(Replace(sVal, ".", ","))
                        If Err = 0 Then
                            oSheet.getCellByPosition(col - 1, row).setValue(dVal)
                        Else
                            oSheet.getCellByPosition(col - 1, row).setString(sVal)
                        End If
                        On Error GoTo 0
                    Else
                        oSheet.getCellByPosition(col - 1, row).setString(sVal)
                    End If
                End If
            Next col
            row = row + 1
        Loop

        oRS.close()
        oStmt.close()

    Next i

    ' Aantal klanten ophalen voor een vloeiende voortgangsbalk in de
    ' klanten_beheer-fase (anders staat de balk lang stil op 80%).
    Dim nKlanten As Integer
    nKlanten = 0
    oStmt = oConn.createStatement()
    oRS = oStmt.executeQuery("SELECT COUNT(*) FROM klanten")
    If oRS.next() Then nKlanten = oRS.getInt(1)
    oRS.close()
    oStmt.close()
    If nKlanten < 1 Then nKlanten = 1

    oIndicator.setValue(80)
    oIndicator.setText("Laden: klanten_beheer (12/12)")

    ' --- klanten_beheer: geselecteerde kolommen schrijven vanaf kolom F (index 5) ---
    Dim oKB As Object
    If oSheets.hasByName("klanten_beheer") Then
        oKB = oSheets.getByName("klanten_beheer")
    Else
        oSheets.insertNewByName("klanten_beheer", oSheets.Count)
        oKB = oSheets.getByName("klanten_beheer")
    End If

    Dim kbKol(15) As String
    kbKol(0)  = "voornaam"         : kbKol(1)  = "familienaam"
    kbKol(2)  = "voornaam2"        : kbKol(3)  = "familienaam2"
    kbKol(4)  = "afhaalpunt_id"    : kbKol(5)  = "type"
    kbKol(6)  = "formaat"          : kbKol(7)  = "email1"
    kbKol(8)  = "email2"           : kbKol(9)  = "email3"
    kbKol(10) = "email4"           : kbKol(11) = "telefoon"
    kbKol(12) = "opmerkingen"      : kbKol(13) = "opmerkingen_volgend"
    kbKol(14) = "opmerking_status" : kbKol(15) = "nooit_groenten"
    Dim nKBKol As Integer : nKBKol = 16

    ' Kolommen F-J (5-9) en L-V (11-21) wissen; K (10) bevat gebruikersformules
    oKB.getCellRangeByPosition(5,  0, 9,  10000).clearContents(7)
    oKB.getCellRangeByPosition(11, 0, 21, 10000).clearContents(7)

    ' Kolomhoofden schrijven in rij 0
    Dim kbIdx As Integer
    For kbIdx = 0 To nKBKol - 1
        oKB.getCellByPosition(KBKolom(kbIdx), 0).setString(kbKol(kbIdx))
    Next kbIdx

    ' Data schrijven (zelfde volgorde als klanten-tabblad, geen ORDER BY)
    oStmt = oConn.createStatement()
    oRS = oStmt.executeQuery( _
        "SELECT voornaam, familienaam, voornaam2, familienaam2, afhaalpunt_id, " & _
        "type, formaat, email1, email2, email3, email4, telefoon, " & _
        "opmerkingen, opmerkingen_volgend, opmerking_status, nooit_groenten " & _
        "FROM klanten")
    Dim kbRow As Integer
    kbRow = 1
    ' Statusbalk actief houden tijdens het schrijven van klanten_beheer,
    ' anders valt hij terug op de standaardweergave ("Blad x van y").
    oIndicator.setText("Laden: klanten_beheer...")
    Do While oRS.next()
        If (kbRow Mod 50) = 0 Then
            oIndicator.setValue(80 + Int(kbRow / nKlanten * 18))
            oIndicator.setText("Laden: klanten_beheer - " & kbRow & " rijen")
        End If
        For kbIdx = 1 To nKBKol
            Dim kbVal As String
            kbVal = oRS.getString(kbIdx)
            If oRS.wasNull() Then
                oKB.getCellByPosition(KBKolom(kbIdx - 1), kbRow).setString("")
            Else
                oKB.getCellByPosition(KBKolom(kbIdx - 1), kbRow).setString(kbVal)
            End If
        Next kbIdx
        kbRow = kbRow + 1
    Loop
    oRS.close()
    oStmt.close()

    oConn.close()
    oIndicator.setValue(100)
    oIndicator.setText("Bijna klaar...")
    MsgBox "Alle tabellen geladen!", 64, "Klaar"
    oIndicator.end()
    SluitSSHTunnels()
    Exit Sub

VerbindingsFout:
    If Not IsNull(oIndicator) Then oIndicator.end()
    MsgBox "Verbindingsfout: " & Err & " - " & Error & Chr(10) & _
           "Controleer of de SSH-tunnel actief is (poort 5433).", 16, "Fout"

End Sub

Sub MaakWeekbestand()

    ' =============================================
    ' Kiemkracht - Weekbestand aanmaken
    ' =============================================

    ' Actief kiemkracht-data-bestand vastleggen vóór aanmaak nieuw document
    ' (ThisComponent wijzigt daarna). Prod of dev volgt dit bestand.
    Dim oCallerDoc As Object
    oCallerDoc = HuidigDataDocument()
    If IsNull(oCallerDoc) Then
        MsgBox "Geen kiemkracht-data-bestand actief. Open kiemkracht-data.ods " & _
               "of kiemkracht-data-dev.ods en start de macro vanuit dat venster.", 16, "Fout"
        Exit Sub
    End If

    ' DB-verbinding en SSH-tunnel: zie MaakDBVerbinding()
    ' Bestandslocatie: zie JaarMap() — week-submappen zitten per jaar gegroepeerd.

    ' Weeknummer en datums: vanaf zaterdag → komende week, anders huidige week
    Dim dVandaag   As Date
    Dim iWeekdag   As Integer
    Dim dMaandag   As Date
    Dim dDonderdag As Date
    Dim dVrijdag   As Date
    Dim iWeek      As Integer
    Dim iJaar      As Integer

    dVandaag = Now()
    iWeekdag = Weekday(dVandaag, 1)  ' 1=zo, 2=ma, ..., 6=vr, 7=za

    If iWeekdag = 7 Then
        dMaandag = dVandaag + 2   ' za → ma volgende week
    ElseIf iWeekdag = 1 Then
        dMaandag = dVandaag + 1   ' zo → ma volgende week
    Else
        dMaandag = dVandaag - (Weekday(dVandaag, 2) - 1)  ' ma t/m vr: huidige week
    End If

    dDonderdag = dMaandag + 3
    dVrijdag   = dMaandag + 4
    iWeek = DatePart("ww", dDonderdag, 2, 2)
    iJaar = Year(dDonderdag)

    ' Dev-only: optioneel een andere (komende) week genereren om te testen,
    ' bv. een onpare week terwijl het een pare week is. Op prod ongewijzigd.
    ' ENTER (= de voorgevulde week) of Annuleren laat de berekende week staan.
    ' WeekNaarDonderdag zoekt vooruit, dus kies een week >= de huidige.
    If BepaalOmgeving() = "dev" Then
        Dim sWeekIn As String
        sWeekIn = InputBox("Weeknummer voor het weekbestand (ENTER = " & iWeek & "):" & Chr(10) & _
                           "Enkel om te testen op dev — kies een komende week.", _
                           "MaakWeekbestand (dev)", CStr(iWeek))
        If IsNumeric(sWeekIn) Then
            Dim iWeekIn As Integer : iWeekIn = CInt(sWeekIn)
            If iWeekIn >= 1 And iWeekIn <= 53 And iWeekIn <> iWeek Then
                Dim dDoOverride As Date : dDoOverride = WeekNaarDonderdag(iWeekIn)
                If dDoOverride > 0 Then
                    dDonderdag = dDoOverride
                    dMaandag   = dDonderdag - 3
                    dVrijdag   = dDonderdag + 1
                    iWeek      = iWeekIn
                    iJaar      = Year(dDonderdag)
                End If
            End If
        End If
    End If

    ' Pare of onpare week
    Dim sPareWeek As String
    If (iWeek Mod 2) = 0 Then
        sPareWeek = "pare week"
    Else
        sPareWeek = "onpare week"
    End If

    ' Maandnaam
    Dim saMaanden(12) As String
    saMaanden(1)  = "januari"  : saMaanden(2)  = "februari"
    saMaanden(3)  = "maart"    : saMaanden(4)  = "april"
    saMaanden(5)  = "mei"      : saMaanden(6)  = "juni"
    saMaanden(7)  = "juli"     : saMaanden(8)  = "augustus"
    saMaanden(9)  = "september": saMaanden(10) = "oktober"
    saMaanden(11) = "november" : saMaanden(12) = "december"
    Dim sMaand As String
    sMaand = saMaanden(Month(dDonderdag))

    ' Datum in formaat YYMMDD
    Dim sDatumKort As String
    sDatumKort = Right(CStr(iJaar), 2) & _
                 Right("0" & Month(dDonderdag), 2) & _
                 Right("0" & Day(dDonderdag), 2)

    ' Weekbestand-naam: de dev-omgeving krijgt een -dev-achtervoegsel zodat
    ' een dev-weekbestand niet botst met (of overschreven wordt door) het
    ' prod-weekbestand met dezelfde week.
    Dim sBestand   As String
    Dim sOmgSuffix As String
    If BepaalOmgeving() = "dev" Then sOmgSuffix = "-dev" Else sOmgSuffix = ""

    Dim sWeekMap As String
    sWeekMap = JaarMap(iJaar) & iJaar & "_week_" & iWeek & "\"
    If Not FileExists(sWeekMap) Then MkDir(sWeekMap)

    sBestand = sWeekMap & "week_" & iWeek & "_" & iJaar & sOmgSuffix & ".ods"

    ' JDBC-verbinding (juiste omgeving via MaakDBVerbinding)
    On Error GoTo VerbindingsFout
    Dim oConn As Object
    oConn = MaakDBVerbinding()
    On Error GoTo 0

    Dim oStmt As Object
    Dim oRS   As Object

    ' --- Stap 0: afhaalpunten volgorde (donderdag voor vrijdag, dan id) ---
    oStmt = oConn.createStatement()
    oRS = oStmt.executeQuery( _
        "SELECT naam, dag_klaarmaken FROM afhaalpunten " & _
        "ORDER BY dag_klaarmaken ASC, id_intern ASC")
    Dim afhNaam(20) As String
    Dim afhDag(20)  As String
    Dim nAfh As Integer
    nAfh = 0
    Do While oRS.next()
        afhNaam(nAfh) = oRS.getString(1)
        afhDag(nAfh)  = oRS.getString(2)
        nAfh = nAfh + 1
    Loop
    oRS.close() : oStmt.close()

    ' --- Stap 1: unieke groenten deze week (kolomhoofden) ---
    oStmt = oConn.createStatement()
    oRS = oStmt.executeQuery( _
        "SELECT naam, eenheid, BOOL_OR(per_stuk), MIN(prijs) FROM groenten " & _
        "WHERE weeknummer = " & iWeek & " AND jaar = " & iJaar & _
        " GROUP BY naam, eenheid" & _
        " ORDER BY MIN(volgorde), MIN(id)")
    Dim groentNaam(50) As String
    Dim groentEenh(50) As String
    Dim groentPerStuk(50) As Boolean   ' "x "-notatie nodig (Sheets-vinkje → groenten.per_stuk)
    Dim groentPrijs(50) As Double      ' prijs per eenheid (voor rij 3 + afrekening)
    Dim nGroenten As Integer
    nGroenten = 0
    Do While oRS.next()
        groentNaam(nGroenten)    = oRS.getString(1)
        groentEenh(nGroenten)    = oRS.getString(2)
        groentPerStuk(nGroenten) = oRS.getBoolean(3)
        groentPrijs(nGroenten)   = oRS.getDouble(4)
        nGroenten = nGroenten + 1
    Loop
    oRS.close() : oStmt.close()

    ' --- Pakketprijzen (voor het afrekeningstabblad) ---
    Dim prijsKlein As Double, prijsGroot As Double
    Dim prijsEGroot As Double, prijsMini As Double
    oStmt = oConn.createStatement()
    oRS = oStmt.executeQuery("SELECT sleutel, prijs FROM pakketten")
    Do While oRS.next()
        Select Case oRS.getString(1)
            Case "klein"       : prijsKlein  = oRS.getDouble(2)
            Case "groot"       : prijsGroot  = oRS.getDouble(2)
            Case "extra-groot" : prijsEGroot = oRS.getDouble(2)
            Case "mini"        : prijsMini   = oRS.getDouble(2)
        End Select
    Loop
    oRS.close() : oStmt.close()

    ' --- Pakketwaardes per (formaat, groente) — bron voor weglatingen-verrekening ---
    ' Komt uit pakket_inhoud.waarde (gesynct vanuit Sheets "€ in pakket").
    ' Belandt in een bewerkbaar tabblad "pakketwaardes"; de afrekening verwijst
    ' ernaar zodat manuele bijsturing in het weekbestand meteen doorwerkt.
    ' ORDER BY pi.id (= invoeg-/Sheets-volgorde) i.p.v. alfabetisch: de groenten
    ' verschijnen in de volgorde van de Google Sheet (eerste voorkomen wint bij
    ' de dedup hieronder). Deze volgorde stuurt zowel het pakketwaardes-tabblad
    ' als de koprij van de weglating-kolommen aan.
    Dim pwNaam(200) As String
    Dim pwKG(200)   As Double, pwGG(200) As Double
    Dim pwEGG(200)  As Double, pwMINI(200) As Double
    Dim nPW         As Integer
    Dim sPwSleutel  As String, sPwNaam As String
    Dim dPwWaarde   As Double
    Dim iPwIdx      As Integer, iPw As Integer
    nPW = 0
    oStmt = oConn.createStatement()
    oRS = oStmt.executeQuery( _
        "SELECT p.sleutel, pi.groente_naam, pi.waarde " & _
        "FROM pakket_inhoud pi JOIN pakketten p ON p.id = pi.pakket_id " & _
        "WHERE pi.weeknummer = " & iWeek & " AND pi.jaar = " & iJaar & _
        " ORDER BY pi.id")
    Do While oRS.next()
        sPwSleutel = oRS.getString(1)
        sPwNaam    = oRS.getString(2)
        dPwWaarde  = oRS.getDouble(3)
        iPwIdx = -1
        For iPw = 0 To nPW - 1
            If pwNaam(iPw) = sPwNaam Then
                iPwIdx = iPw
                Exit For
            End If
        Next iPw
        If iPwIdx = -1 Then
            iPwIdx = nPW
            pwNaam(nPW) = sPwNaam
            pwKG(nPW) = 0 : pwGG(nPW) = 0 : pwEGG(nPW) = 0 : pwMINI(nPW) = 0
            nPW = nPW + 1
        End If
        Select Case sPwSleutel
            Case "klein"       : pwKG(iPwIdx)   = dPwWaarde
            Case "groot"       : pwGG(iPwIdx)   = dPwWaarde
            Case "extra-groot" : pwEGG(iPwIdx)  = dPwWaarde
            Case "mini"        : pwMINI(iPwIdx) = dPwWaarde
        End Select
    Loop
    oRS.close() : oStmt.close()

    ' --- Stap 2: weglating-slots = alle potentieel weg te laten groenten ---
    ' De koprij (rij 3) van de weglating-kolommen (AZ+) krijgt ALLE groenten die
    ' deze week in een pakket (kunnen) zitten — bron 'pakketwaardes' (pwNaam), in
    ' DB-/Sheets-volgorde — ook als geen enkele klant ze weglaat. Zo staan de
    ' juiste namen meteen klaar voor (handmatige) markering. De markeringen per
    ' klant (bWeg) komen nog steeds uit bestelling_weglatingen, op naam gematcht.
    ' Bovengrens: max. 12 verschillende pakketgroenten per week (= 12 weglating-
    ' kolommen); 20 geeft wat marge voor het vangnet hieronder.
    Dim wegNaam(20) As String
    Dim nWeg As Integer
    Dim iWg As Integer
    nWeg = 0
    For iWg = 0 To nPW - 1
        wegNaam(nWeg) = pwNaam(iWg)
        nWeg = nWeg + 1
    Next iWg
    ' Vangnet: een effectief weggelaten groente die (door een data-afwijking) niet
    ' in pakketwaardes zit, achteraan toevoegen zodat ze niet wegvalt.
    oStmt = oConn.createStatement()
    oRS = oStmt.executeQuery( _
        "SELECT DISTINCT bw.groente_naam FROM bestelling_weglatingen bw " & _
        "INNER JOIN bestellingen b ON b.id = bw.bestelling_id " & _
        "WHERE b.weeknummer = " & iWeek & " AND b.jaar = " & iJaar & _
        " ORDER BY bw.groente_naam")
    Dim sWgChk As String
    Dim bWgIn  As Boolean
    Do While oRS.next()
        sWgChk = oRS.getString(1)
        bWgIn = False
        For iWg = 0 To nWeg - 1
            If wegNaam(iWg) = sWgChk Then bWgIn = True : Exit For
        Next iWg
        If Not bWgIn And nWeg < 20 Then
            wegNaam(nWeg) = sWgChk
            nWeg = nWeg + 1
        End If
    Loop
    oRS.close() : oStmt.close()

    ' Aantal weglating-slots: altijd minstens 12 kolommen klaar (zoals de 24
    ' groente-slots), zodat een handmatig toegevoegde weglating-groente meteen
    ' meeloopt. nWeg blijft het aantal ECHTE weglatingen (namen + markeringen).
    Dim nWegSlots As Integer
    nWegSlots = nWeg
    If nWegSlots < 12 Then nWegSlots = 12

    ' --- Stap 3: bestellingen + abonnees zonder bestelling deze week ---
    ' Ritme-set die in DEZE week (pariteit) een pakket oplevert. Een abonnement
    ' met ritme 'wekelijks' telt altijd mee; 'pare-week'/'onpare-week' enkel in de
    ' overeenkomstige pariteit. Vervangt de oude type-gebaseerde sPareFilter/
    ' sTak3Types: het ritme zit nu in abonnementen.ritme, de relatie-status in
    ' klanten.status (weekperweek = status 'actief' zonder actieve abonnement-rij).
    ' TAK 2 = abonnees met een ritme dat deze week matcht; TAK 3 = actieve klanten
    ' met een vooruitbestelling die NIET door TAK 2 gedekt worden (weekperweek,
    ' off-pariteit-abonnees, toekomst-abonnees).
    Dim sParRitmes As String
    If (iWeek Mod 2) = 0 Then
        sParRitmes = "'wekelijks','pare-week'"
    Else
        sParRitmes = "'wekelijks','onpare-week'"
    End If
    ' Weeknummer (jaar*100+week) voor de pauze-conditie: een abonnement levert
    ' deze week zolang het niet gepauzeerd is vanaf een week <= deze.
    Dim iWeekNum As Long : iWeekNum = CLng(iJaar) * 100 + iWeek
    Dim sNietGepauzeerd As String
    sNietGepauzeerd = " AND (a.pauze_vanaf_week IS NULL OR " & _
                      "(a.pauze_vanaf_jaar * 100 + a.pauze_vanaf_week) > " & iWeekNum & ") "
    oStmt = oConn.createStatement()
    ' CTE vb_week: vooruitbestellingen voor deze week met naam→sleutel-mapping
    ' van het formaat-veld (DB slaat de pakketnaam op, bv. 'Groot pakket').
    ' Wordt in TAK 2 gebruikt als formaat-override op klant.formaat, en in
    ' TAK 3 (NIEUW) om weekperweek-/toekomst-klanten met een vooruitbestelling
    ' voor deze week alsnog op te nemen in het weekbestand zonder dat de
    ' klant via de bevestigingsmail expliciet hoeft te klikken.
    oRS = oStmt.executeQuery( _
        "WITH vb_week AS (" & _
        "  SELECT klant_id, LOWER(klant_email) AS email_l, " & _
        "    CASE LOWER(TRIM(REPLACE(formaat, ' pakket', ''))) " & _
        "      WHEN 'klein'       THEN 'klein' " & _
        "      WHEN 'groot'       THEN 'groot' " & _
        "      WHEN 'extra groot' THEN 'extra-groot' " & _
        "      WHEN 'extra-groot' THEN 'extra-groot' " & _
        "      WHEN 'mini'        THEN 'mini' " & _
        "    END AS sleutel " & _
        "  FROM vooruitbestellingen " & _
        "  WHERE jaar = " & iJaar & " AND week_bestelling = " & iWeek & _
        "    AND formaat IS NOT NULL" & _
        ") " & _
        "SELECT b.id, " & _
        "COALESCE(NULLIF(k.voornaam,''), b.voornaam) AS voornaam, " & _
        "COALESCE(NULLIF(k.familienaam,''), b.familienaam) AS familienaam, " & _
        "b.klant_email, " & _
        "COALESCE(kap.naam, b.afhaalpunt) AS afhaalpunt, " & _
        "COALESCE(kap.dag_klaarmaken, b.leverdag) AS leverdag, " & _
        "b.pakket, b.pakket_inhoud, " & _
        "b.abonnement_wijziging, b.vragen_opmerkingen, " & _
        "COALESCE(k.klant_type,'') AS klant_type, " & _
        "COALESCE(k.formaat,'') AS formaat, " & _
        "COALESCE(k.telefoon,'') AS telefoon, " & _
        "COALESCE(k.id::text,'') AS klant_id, " & _
        "COALESCE(k.type,'') AS type, " & _
        "COALESCE(kap.dag_klaarmaken, bap.dag_klaarmaken,'') AS dag_klaarmaken, " & _
        "COALESCE(kap.id_intern, bap.id_intern, 9999) AS id_intern_sort, " & _
        "COALESCE(k.id, 999999) AS klant_id_sort " & _
        "FROM bestellingen b " & _
        "LEFT JOIN klanten k ON (k.id = b.klant_id OR (b.klant_id IS NULL AND k.email1 = b.klant_email)) " & _
        "LEFT JOIN afhaalpunten kap ON kap.id = k.afhaalpunt_id " & _
        "LEFT JOIN afhaalpunten bap ON bap.naam = b.afhaalpunt " & _
        "WHERE b.weeknummer = " & iWeek & " AND b.jaar = " & iJaar & _
        " AND NOT EXISTS (SELECT 1 FROM annulaties a " & _
        "   WHERE a.jaar = " & iJaar & " AND a.week_annulatie = " & iWeek & _
        "     AND (a.klant_id = b.klant_id OR (b.klant_id IS NULL AND LOWER(a.klant_email) = LOWER(b.klant_email)))) " & _
        " UNION ALL " & _
        "SELECT 0, k.voornaam, k.familienaam, k.email1, " & _
        "COALESCE(ap.naam,''), COALESCE(ap.dag_klaarmaken,''), " & _
        "CASE COALESCE(vb.sleutel, a.formaat) " & _
        "  WHEN 'klein'       THEN 'klein pakket' " & _
        "  WHEN 'groot'       THEN 'groot pakket' " & _
        "  WHEN 'extra-groot' THEN 'extra groot pakket' " & _
        "  WHEN 'mini'        THEN 'mini pakket' ELSE '' END, " & _
        "'', '', '', " & _
        "COALESCE(k.klant_type,''), COALESCE(vb.sleutel, a.formaat), COALESCE(k.telefoon,''), COALESCE(k.id::text,''), " & _
        "COALESCE(k.type,''), " & _
        "COALESCE(ap.dag_klaarmaken,''), " & _
        "COALESCE(ap.id_intern, 9999), " & _
        "COALESCE(k.id, 999999) " & _
        "FROM abonnementen a JOIN klanten k ON k.id = a.klant_id " & _
        "LEFT JOIN afhaalpunten ap ON ap.id = k.afhaalpunt_id " & _
        "LEFT JOIN vb_week vb ON (vb.klant_id = k.id OR (vb.klant_id IS NULL AND vb.email_l = LOWER(k.email1))) " & _
        "WHERE a.status = 'actief' AND a.ritme IN (" & sParRitmes & ") " & _
        sNietGepauzeerd & _
        " AND NOT EXISTS (SELECT 1 FROM bestellingen bx " & _
        "   WHERE bx.weeknummer = " & iWeek & " AND bx.jaar = " & iJaar & _
        "     AND (bx.klant_id = k.id OR (bx.klant_id IS NULL AND LOWER(bx.klant_email) = LOWER(k.email1)))) " & _
        " AND NOT EXISTS (SELECT 1 FROM annulaties a " & _
        "   WHERE a.jaar = " & iJaar & " AND a.week_annulatie = " & iWeek & _
        "     AND (a.klant_id = k.id OR (a.klant_id IS NULL AND LOWER(a.klant_email) = LOWER(k.email1)))) " & _
        " AND NOT EXISTS (SELECT 1 FROM annulaties ann " & _
        "   WHERE ann.jaar = " & iJaar & _
        "     AND ann.week_stopzetten_abonnement > 0 AND ann.week_stopzetten_abonnement <= " & iWeek & _
        "     AND (ann.klant_id = k.id OR (ann.klant_id IS NULL AND LOWER(ann.klant_email) = LOWER(k.email1)))) " & _
        " UNION ALL " & _
        "SELECT 0, k.voornaam, k.familienaam, k.email1, " & _
        "COALESCE(ap.naam,''), COALESCE(ap.dag_klaarmaken,''), " & _
        "CASE vb.sleutel " & _
        "  WHEN 'klein'       THEN 'klein pakket' " & _
        "  WHEN 'groot'       THEN 'groot pakket' " & _
        "  WHEN 'extra-groot' THEN 'extra groot pakket' " & _
        "  WHEN 'mini'        THEN 'mini pakket' ELSE '' END, " & _
        "'', '', '', " & _
        "COALESCE(k.klant_type,''), vb.sleutel, COALESCE(k.telefoon,''), COALESCE(k.id::text,''), " & _
        "COALESCE(k.type,''), " & _
        "COALESCE(ap.dag_klaarmaken,''), " & _
        "COALESCE(ap.id_intern, 9999), " & _
        "COALESCE(k.id, 999999) " & _
        "FROM klanten k " & _
        "LEFT JOIN afhaalpunten ap ON ap.id = k.afhaalpunt_id " & _
        "INNER JOIN vb_week vb ON (vb.klant_id = k.id OR (vb.klant_id IS NULL AND vb.email_l = LOWER(k.email1))) " & _
        "WHERE k.status = 'actief' " & _
        " AND NOT EXISTS (SELECT 1 FROM abonnementen a3 WHERE a3.klant_id = k.id " & _
        "   AND a3.status = 'actief' AND a3.ritme IN (" & sParRitmes & ") " & _
        "   AND (a3.pauze_vanaf_week IS NULL OR (a3.pauze_vanaf_jaar * 100 + a3.pauze_vanaf_week) > " & iWeekNum & ")) " & _
        " AND NOT EXISTS (SELECT 1 FROM bestellingen bx " & _
        "   WHERE bx.weeknummer = " & iWeek & " AND bx.jaar = " & iJaar & _
        "     AND (bx.klant_id = k.id OR (bx.klant_id IS NULL AND LOWER(bx.klant_email) = LOWER(k.email1)))) " & _
        " AND NOT EXISTS (SELECT 1 FROM annulaties a " & _
        "   WHERE a.jaar = " & iJaar & " AND a.week_annulatie = " & iWeek & _
        "     AND (a.klant_id = k.id OR (a.klant_id IS NULL AND LOWER(a.klant_email) = LOWER(k.email1)))) " & _
        " AND vb.sleutel IS NOT NULL " & _
        " ORDER BY leverdag ASC, id_intern_sort ASC, klant_id_sort ASC, familienaam ASC, voornaam ASC")

    ' Bestellingen in arrays
    Dim bId(500)      As Long
    Dim bVoor(500)    As String
    Dim bFam(500)     As String
    Dim bEmail(500)   As String
    Dim bAfh(500)     As String
    Dim bDag(500)     As String
    Dim bPakket(500)  As String
    Dim bInhoud(500)  As String
    Dim bWijzig(500)  As String
    Dim bOpm(500)     As String
    Dim bType(500)    As String
    Dim bFormaat(500) As String
    Dim bTel(500)     As String
    Dim bTyp(500)     As String
    Dim bKlaarDag(500) As String
    Dim bSamenv(500)  As String
    Dim bKlantId(500) As String
    Dim nBest As Integer
    nBest = 0

    Do While oRS.next()
        bId(nBest)      = CLng(oRS.getString(1))
        bVoor(nBest)    = oRS.getString(2)
        bFam(nBest)     = oRS.getString(3)
        bEmail(nBest)   = oRS.getString(4)
        bAfh(nBest)     = oRS.getString(5)
        bDag(nBest)     = oRS.getString(6)
        bPakket(nBest)  = oRS.getString(7)
        bInhoud(nBest)  = oRS.getString(8)
        bWijzig(nBest)  = oRS.getString(9)
        bOpm(nBest)     = oRS.getString(10)
        bType(nBest)    = oRS.getString(11)
        bFormaat(nBest) = oRS.getString(12)
        bTel(nBest)     = oRS.getString(13)
        bTyp(nBest)      = oRS.getString(15)
        bKlaarDag(nBest) = oRS.getString(16)
        bKlantId(nBest)  = oRS.getString(14)
        nBest = nBest + 1
    Loop
    oRS.close() : oStmt.close()

    ' --- Stap 3b: DB-correcties t.o.v. de bestelling (URL) ---
    ' Een klant bestelt via een gepersonaliseerde URL (afhaalpunt erin verwerkt).
    ' Wijzigt het afhaalpunt/leverdag/naam daarna in de database (klanten_beheer),
    ' dan is de database leidend: het weekbestand hierboven volgt nu kap.* (DB)
    ' i.p.v. b.* (URL). Deze lijst toont wat daardoor afwijkt van wat de klant
    ' oorspronkelijk doorgaf, zodat het zichtbaar is in de eindpopup.
    Dim sDbCorr As String : sDbCorr = ""
    oStmt = oConn.createStatement()
    oRS = oStmt.executeQuery( _
        "SELECT b.voornaam, b.familienaam, " & _
        "b.afhaalpunt, COALESCE(kap.naam,''), " & _
        "b.leverdag, COALESCE(kap.dag_afhaling,''), " & _
        "k.voornaam, k.familienaam " & _
        "FROM bestellingen b " & _
        "JOIN klanten k ON (k.id = b.klant_id OR (b.klant_id IS NULL AND k.email1 = b.klant_email)) " & _
        "LEFT JOIN afhaalpunten kap ON kap.id = k.afhaalpunt_id " & _
        "WHERE b.weeknummer = " & iWeek & " AND b.jaar = " & iJaar & _
        " AND b.klant_email NOT IN (" & _
        "SELECT klant_email FROM annulaties WHERE jaar = " & iJaar & " AND week_annulatie = " & iWeek & ") " & _
        " AND ( (kap.naam IS NOT NULL AND kap.naam <> b.afhaalpunt) " & _
        "    OR (kap.dag_afhaling IS NOT NULL AND kap.dag_afhaling <> b.leverdag) " & _
        "    OR (COALESCE(k.voornaam,'')    <> COALESCE(b.voornaam,'')) " & _
        "    OR (COALESCE(k.familienaam,'') <> COALESCE(b.familienaam,'')) ) " & _
        "ORDER BY k.familienaam, k.voornaam")
    Do While oRS.next()
        Dim sBestelNaam As String, sDbNaam As String, sRegel As String
        sBestelNaam = Trim(oRS.getString(1) & " " & oRS.getString(2))
        sDbNaam     = Trim(oRS.getString(7) & " " & oRS.getString(8))
        sRegel = "• " & sDbNaam
        If oRS.getString(4) <> "" And oRS.getString(4) <> oRS.getString(3) Then
            sRegel = sRegel & Chr(10) & "    afhaalpunt: " & oRS.getString(3) & " -> " & oRS.getString(4)
        End If
        If oRS.getString(6) <> "" And oRS.getString(6) <> oRS.getString(5) Then
            sRegel = sRegel & Chr(10) & "    leverdag: " & oRS.getString(5) & " -> " & oRS.getString(6)
        End If
        If sDbNaam <> "" And sDbNaam <> sBestelNaam Then
            sRegel = sRegel & Chr(10) & "    naam volgens bestelling: " & sBestelNaam
        End If
        sDbCorr = sDbCorr & sRegel & Chr(10)
    Loop
    oRS.close() : oStmt.close()

    ' --- Stap 4: vooruitbestellingen voor stop/annulatie/start-kolommen ---
    oStmt = oConn.createStatement()
    oRS = oStmt.executeQuery( _
        "SELECT klant_email, week_bestelling, week_start_abonnement, COALESCE(klant_id::text,'') " & _
        "FROM vooruitbestellingen " & _
        "WHERE jaar = " & iJaar & " AND week_bestelling >= " & iWeek)
    Dim vbEmail(200) As String
    Dim vbWeek(200)  As Integer
    Dim vbStart(200) As Integer
    Dim vbKlant(200) As String
    Dim nVB As Integer
    nVB = 0
    Do While oRS.next()
        vbEmail(nVB) = oRS.getString(1)
        vbWeek(nVB)  = CInt(oRS.getString(2))
        vbKlant(nVB) = oRS.getString(4)
        Dim sStart As String
        sStart = oRS.getString(3)
        If oRS.wasNull() Or sStart = "" Then
            vbStart(nVB) = 0
        Else
            vbStart(nVB) = CInt(sStart)
        End If
        nVB = nVB + 1
    Loop
    oRS.close() : oStmt.close()

    ' Annulaties
    oStmt = oConn.createStatement()
    oRS = oStmt.executeQuery( _
        "SELECT klant_email, week_annulatie, week_stopzetten_abonnement, COALESCE(klant_id::text,'') " & _
        "FROM annulaties " & _
        "WHERE jaar = " & iJaar & " AND week_annulatie >= " & iWeek)
    Dim annEmail(200)  As String
    Dim annWeek(200)   As Integer
    Dim annStop(200)   As Integer
    Dim annKlant(200)  As String
    Dim nAnn As Integer
    nAnn = 0
    Do While oRS.next()
        annEmail(nAnn) = oRS.getString(1)
        annWeek(nAnn)  = CInt(oRS.getString(2))
        annKlant(nAnn) = oRS.getString(4)
        Dim sStop As String
        sStop = oRS.getString(3)
        If oRS.wasNull() Or sStop = "" Then
            annStop(nAnn) = 0
        Else
            annStop(nAnn) = CInt(sStop)
        End If
        nAnn = nAnn + 1
    Loop
    oRS.close() : oStmt.close()

    ' --- Stap 5: hoeveelheden losse groenten per bestelling ---
    Dim bGroent(500, 50) As Double
    Dim b As Integer, g As Integer
    For b = 0 To nBest - 1
        For g = 0 To nGroenten - 1
            bGroent(b, g) = 0
        Next g
    Next b

    ' Hulp-variabelen voor stap 5 + 6: vooraf declareren zodat ze ook
    ' beschikbaar zijn als de eerste loop geen rijen heeft (anders crasht
    ' stap 6 met "Er is geen variabele gedefinieerd" op lBId).
    Dim lBId  As Long
    Dim sGr   As String
    Dim dAant As Double

    oStmt = oConn.createStatement()
    oRS = oStmt.executeQuery( _
        "SELECT br.bestelling_id, br.groente_naam, br.aantal " & _
        "FROM bestelregels br " & _
        "INNER JOIN bestellingen bst ON bst.id = br.bestelling_id " & _
        "WHERE bst.weeknummer = " & iWeek & " AND bst.jaar = " & iJaar)
    Do While oRS.next()
        lBId = CLng(oRS.getString(1))
        sGr = oRS.getString(2)
        dAant = CDbl(Replace(oRS.getString(3), ".", ","))
        For b = 0 To nBest - 1
            If bId(b) = lBId Then
                For g = 0 To nGroenten - 1
                    If groentNaam(g) = sGr Then
                        bGroent(b, g) = dAant
                        Exit For
                    End If
                Next g
                Exit For
            End If
        Next b
    Loop
    oRS.close() : oStmt.close()

    ' --- Stap 6: weglatingen per bestelling ---
    ' 2e dimensie = wegNaam-slots: alle pakketgroenten (max 12/week), niet enkel
    ' de effectief weggelaten; 20 voor dezelfde marge als wegNaam.
    Dim bWeg(500, 20) As Boolean
    oStmt = oConn.createStatement()
    oRS = oStmt.executeQuery( _
        "SELECT bw.bestelling_id, bw.groente_naam " & _
        "FROM bestelling_weglatingen bw " & _
        "INNER JOIN bestellingen bst ON bst.id = bw.bestelling_id " & _
        "WHERE bst.weeknummer = " & iWeek & " AND bst.jaar = " & iJaar)
    Dim w As Integer
    Do While oRS.next()
        lBId = CLng(oRS.getString(1))
        sGr  = oRS.getString(2)
        For b = 0 To nBest - 1
            If bId(b) = lBId Then
                For w = 0 To nWeg - 1
                    If wegNaam(w) = sGr Then
                        bWeg(b, w) = True
                        Exit For
                    End If
                Next w
                Exit For
            End If
        Next b
    Loop
    oRS.close() : oStmt.close()
    oConn.close()

    ' =============================================
    ' BESTAND AANMAKEN EN WERKBLAD OPBOUWEN
    ' =============================================

    Dim oDesktop  As Object
    Dim oNieuwDoc As Object
    Dim oSheet    As Object

    oDesktop = CreateUnoService("com.sun.star.frame.Desktop")
    Dim aLaadProps(0) As New com.sun.star.beans.PropertyValue
    aLaadProps(0).Name  = "Hidden"
    aLaadProps(0).Value = False
    oNieuwDoc = oDesktop.loadComponentFromURL("private:factory/scalc", "_blank", 0, aLaadProps())
    oSheet = oNieuwDoc.Sheets.getByIndex(0)
    oSheet.Name = "Week " & iWeek & " - " & iJaar

    ' Kolomindices (0-based)
    Const cNaam     = 0   ' voornaam + familienaam
    Const cAfh      = 1   ' afhaalpunt
    Const cKlaarDag = 2   ' dag klaarmaken (afhaalpunt)
    Const cTyp      = 3   ' type (klant)
    Const cFormaat  = 4   ' formaat
    Const cOpm      = 5   ' vragen_opmerkingen
    Const cEmail    = 6   ' email
    Const cTel      = 7   ' telefoon
    Const cVoor     = 8   ' voornaam
    Const cType     = 9   ' klant_type
    Const cDag      = 10  ' leverdag (verborgen)
    Const cWijzig   = 11  ' abonnement_wijziging
    Const cStop     = 12  ' week_stopzetten_abonnement
    Const cAnn      = 13  ' (leeg — vrij voor andere info)
    Const cStart    = 14  ' week_start_abonnement
    Const cWBest    = 15  ' klant_id (kolom P)
    Const cDatum    = 16  ' datum (YYMMDD)
    Const cKG       = 17  ' Klein pakket
    Const cGG       = 18  ' Groot pakket
    Const cEGG      = 19  ' Extra groot pakket
    Const cMINI     = 20  ' Mini pakket
    Const cExtra       = 21             ' extra spacer-kolom (kolom V) — vrij voor manuele info
    Const cSamenv      = 22             ' samenvatting (kolom W)
    Const cWaarde      = 23             ' € losse groenten (kolom X) — formule per klant
    Const nGroentSlots = 24             ' altijd 24 groente-kolommen reserveren
    Dim   cGroent0 As Integer
    cGroent0 = 24                       ' eerste groente-kolom (Y)
    Dim   cAnder  As Integer
    cAnder  = cGroent0 + nGroentSlots  ' "ander" kolom (AW)
    Dim   cAangep As Integer
    cAangep = cAnder  + 1              ' (leeg — vrij voor andere info)
    Dim   cGeen   As Integer
    cGeen   = cAangep + 1              ' synthese weglatingen (AU = 46)
    Dim   cWeg0   As Integer
    cWeg0   = cGeen   + 1              ' eerste weglating-kolom (AV = 47)

    ' Helper: cel ophalen
    ' (LibreOffice Basic heeft geen inline functies, werken met oSheet direct)

    ' --- RIJ 0: metadata ---
    oSheet.getCellByPosition(0, 0).setString(sMaand)
    oSheet.getCellByPosition(1, 0).setString("Week " & iWeek)
    oSheet.getCellByPosition(2, 0).setString(sDatumKort)
    oSheet.getCellByPosition(3, 0).setString(sPareWeek)

    ' --- RIJ 1: kolomhoofden ---
    Dim r As Integer
    r = 1
    oSheet.getCellByPosition(cNaam,    r).setString("voornaam + familienaam")
    oSheet.getCellByPosition(cAfh,     r).setString("afhaalpunt")
    oSheet.getCellByPosition(cKlaarDag,r).setString("dag klaarmaken")
    oSheet.getCellByPosition(cDag,     r).setString("leverdag")
    oSheet.getCellByPosition(cTyp,     r).setString("type")
    oSheet.getCellByPosition(cFormaat,r).setString("formaat")
    oSheet.getCellByPosition(cVoor,   r).setString("voornaam")
    oSheet.getCellByPosition(cTel,    r).setString("telefoon")
    oSheet.getCellByPosition(cEmail,  r).setString("email")
    oSheet.getCellByPosition(cOpm,    r).setString("vragen_opmerkingen")
    oSheet.getCellByPosition(cWijzig, r).setString("abonnement_wijziging")
    oSheet.getCellByPosition(cStop,   r).setString("week_stopzetten_abonnement")
    oSheet.getCellByPosition(cAnn,    r).setString("")
    oSheet.getCellByPosition(cStart,  r).setString("week_start_abonnement")
    oSheet.getCellByPosition(cWBest,  r).setString("klant_id")
    oSheet.getCellByPosition(cDatum,  r).setString(sDatumKort)
    oSheet.getCellByPosition(cKG,     r).setString("KG")
    oSheet.getCellByPosition(cGG,     r).setString("GG")
    oSheet.getCellByPosition(cEGG,    r).setString("EGG")
    oSheet.getCellByPosition(cMINI,   r).setString("MINI")
    oSheet.getCellByPosition(cSamenv, r).setString("samenvatting")
    oSheet.getCellByPosition(cWaarde, r).setString("Losse groenten (waarde)")
    For g = 0 To nGroenten - 1
        oSheet.getCellByPosition(cGroent0 + g, r).setString(groentNaam(g))
    Next g
    oSheet.getCellByPosition(cAnder,  r).setString("ander")
    oSheet.getCellByPosition(cAangep, r).setString("")
    oSheet.getCellByPosition(cGeen,   r).setString("geen (synthese)")
    ' Kolomlabel "geen" voor alle 12 slots, ook de nog lege (klaar voor manueel)
    For w = 0 To nWegSlots - 1
        oSheet.getCellByPosition(cWeg0 + w, r).setString("geen")
    Next w

    ' --- RIJ 2: eenheden ---
    r = 2
    oSheet.getCellByPosition(cAfh,      r).setString("PAKKETTEN")
    oSheet.getCellByPosition(cKlaarDag, r).setString("LOS")
    oSheet.getCellByPosition(cKG,     r).setString("KG")
    oSheet.getCellByPosition(cGG,     r).setString("GG")
    oSheet.getCellByPosition(cEGG,    r).setString("EGG")
    oSheet.getCellByPosition(cMINI,   r).setString("MINI")
    ' Losse-groentekolommen: prijs als getal, opgemaakt als "€ 5,00 / 300g"
    Dim oFmtsR3 As Object
    oFmtsR3 = oNieuwDoc.getNumberFormats()
    Dim oLocR3 As New com.sun.star.lang.Locale
    oLocR3.Language = "nl" : oLocR3.Country = "BE"
    For g = 0 To nGroenten - 1
        Dim oCelPr As Object
        oCelPr = oSheet.getCellByPosition(cGroent0 + g, r)
        oCelPr.setValue(groentPrijs(g))
        Dim sFmtPr As String, nFmtPr As Long
        sFmtPr = "0,00"" " & Chr(8364) & " / " & groentEenh(g) & """"
        nFmtPr = oFmtsR3.queryKey(sFmtPr, oLocR3, False)
        If nFmtPr = -1 Then nFmtPr = oFmtsR3.addNew(sFmtPr, oLocR3)
        oCelPr.NumberFormat = nFmtPr
    Next g
    For w = 0 To nWeg - 1
        oSheet.getCellByPosition(cWeg0 + w, r).setString(wegNaam(w))
    Next w

    ' Valuta-opmaak voor cWaarde-kolom (€ losse) op de klantrijen.
    ' Wordt eenmalig opgezet zodat de loop hieronder de NumberFormat snel kan toepassen.
    Dim oFmtsW As Object : oFmtsW = oNieuwDoc.getNumberFormats()
    Dim oLocW As New com.sun.star.lang.Locale
    oLocW.Language = "nl" : oLocW.Country = "BE"
    Dim nCurW As Long, sCurW As String
    sCurW = "#.##0,00"" " & Chr(8364) & """"
    nCurW = oFmtsW.queryKey(sCurW, oLocW, False)
    If nCurW = -1 Then nCurW = oFmtsW.addNew(sCurW, oLocW)

    ' Blad2 alvast aanmaken met metadata-zones voor groente-eenheden.
    ' Kolommen A-F (rij 3-48) zijn voor VulWeglatingen / LeesUitSheets.
    ' Kolom I (index 8), rij g (0-indexed) = bestel-eenheid mét "x "-prefix voor
    '   per_stuk-groenten (bv. "x 300g"). Gebruikt door MaakOverzichten en de
    '   samenvattingsformule in kolom W van het hoofdblad (kleine letter "x"
    '   tussen aantal en eenheid, consistent met de afweeglijst).
    ' Rij 99 (index, dus UI rij 100), kolom 0..nGroenten-1 = bestel-eenheid mét
    '   "× "-prefix (Unicode multiplication sign) voor per_stuk-groenten, niets
    '   anders. Horizontaal uitgelijnd op de groente-index. Gebruikt door de
    '   detail-formule in afrekening kolom W, waar we "4 × 300g à 5,00 €" of
    '   "4 kg à 0,50 €" willen tonen. Ver voorbij rij 48 zodat
    '   VulWeglatingen/LeesUitSheets er niet bij komen.
    If Not oNieuwDoc.Sheets.hasByName("Blad2") Then
        oNieuwDoc.Sheets.insertNewByName("Blad2", 1)
    End If
    Dim oBlad2Meta As Object
    oBlad2Meta = oNieuwDoc.Sheets.getByName("Blad2")
    For g = 0 To nGroenten - 1
        oBlad2Meta.getCellByPosition(8, g).setString( _
            IIf(groentPerStuk(g), "x ", "") & groentEenh(g))
        oBlad2Meta.getCellByPosition(g, 99).setString( _
            IIf(groentPerStuk(g), Chr(215) & " ", "") & groentEenh(g))
    Next g

    ' --- Helper functie: pakket tellen ---
    ' Tel aantallen per pakkettype voor een reeks bestellingen (van index iVan tot iTot-1)
    ' Geeft terug in array: (0)=KG (1)=GG (2)=EGG (3)=MINI

    ' --- KLANTDATA: gegroepeerd per leverdag > afhaalpunt ---
    r = 6
    Dim sHuidigAfh  As String
    Dim sHuidigDag  As String
    Dim iAfhStart   As Integer  ' eerste rij van huidig afhaalpunt (voor subtotaal)
    sHuidigAfh = ""
    sHuidigDag = ""

    ' Subtotaal-tellers voor huidig afhaalpunt
    Dim afKG As Integer, afGG As Integer, afEGG As Integer, afMINI As Integer
    Dim afGroent(50) As Double

    For b = 0 To nBest - 1

        ' Nieuwe leverdag of nieuw afhaalpunt: eerst subtotaalrij vorige groep schrijven
        If sHuidigAfh <> "" And (bAfh(b) <> sHuidigAfh Or bDag(b) <> sHuidigDag) Then
            ' Witregel tussen groepen
            r = r + 1
            ' Reset tellers
            afKG = 0 : afGG = 0 : afEGG = 0 : afMINI = 0
            For g = 0 To nGroenten - 1 : afGroent(g) = 0 : Next g
        End If

        ' Nieuwe koprijlijn als afhaalpunt of dag verandert
        If bAfh(b) <> sHuidigAfh Or bDag(b) <> sHuidigDag Then
            oSheet.getCellByPosition(cNaam,  r).setString(bAfh(b))
            oSheet.getCellByPosition(cAfh,   r).setString("afhaalpunt/dag")
            oSheet.getCellByPosition(cDatum, r).setFormula("=A" & (r + 1))
            r = r + 1
            sHuidigAfh = bAfh(b)
            sHuidigDag = bDag(b)
            afKG = 0 : afGG = 0 : afEGG = 0 : afMINI = 0
            For g = 0 To nGroenten - 1 : afGroent(g) = 0 : Next g
        End If

        ' Klantdata schrijven
        oSheet.getCellByPosition(cDatum,  r).setFormula("=A" & (r + 1))
        oSheet.getCellByPosition(cNaam,    r).setString(bVoor(b) & " " & bFam(b))
        oSheet.getCellByPosition(cAfh,     r).setString(bAfh(b))
        oSheet.getCellByPosition(cKlaarDag,r).setString(bKlaarDag(b))
        oSheet.getCellByPosition(cDag,     r).setString(bDag(b))
        oSheet.getCellByPosition(cTyp,     r).setString(bTyp(b))
        oSheet.getCellByPosition(cFormaat,r).setString(bFormaat(b))
        oSheet.getCellByPosition(cType,   r).setString(bType(b))
        oSheet.getCellByPosition(cVoor,   r).setString(bVoor(b))
        oSheet.getCellByPosition(cTel,    r).setString(bTel(b))
        oSheet.getCellByPosition(cEmail,  r).setString(bEmail(b))
        oSheet.getCellByPosition(cOpm,    r).setString(bOpm(b))
        If Trim(bOpm(b)) <> "" Then
            oSheet.getCellByPosition(cAnder, r).setString(bOpm(b))
        End If

        ' klant_id (kolom P) — vaste kolom net voor de centrale datumkolom
        If Trim(bKlantId(b)) <> "" Then
            oSheet.getCellByPosition(cWBest, r).setValue(Val(bKlantId(b)))
        End If

        ' abonnement_wijziging alleen als relevant
        If Trim(bWijzig(b)) <> "" Then
            oSheet.getCellByPosition(cWijzig, r).setString(bWijzig(b))
        End If

        ' Vooruitbestellingen: week_start — match op klant_id (leidend), met
        ' e-mail enkel als terugval voor klantloze (weekperweek-)bestellingen.
        Dim vi As Integer
        Dim bVbMatch As Boolean
        For vi = 0 To nVB - 1
            If Trim(bKlantId(b)) <> "" And vbKlant(vi) <> "" Then
                bVbMatch = (vbKlant(vi) = bKlantId(b))
            Else
                bVbMatch = (LCase(vbEmail(vi)) = LCase(bEmail(b)))
            End If
            If bVbMatch And vbStart(vi) > 0 Then
                oSheet.getCellByPosition(cStart, r).setValue(vbStart(vi))
            End If
        Next vi

        ' Annulaties: week_stop — zelfde klant_id-eerst logica.
        Dim ai As Integer
        Dim bAnnMatch As Boolean
        For ai = 0 To nAnn - 1
            If Trim(bKlantId(b)) <> "" And annKlant(ai) <> "" Then
                bAnnMatch = (annKlant(ai) = bKlantId(b))
            Else
                bAnnMatch = (LCase(annEmail(ai)) = LCase(bEmail(b)))
            End If
            If bAnnMatch And annStop(ai) > 0 Then
                oSheet.getCellByPosition(cStop, r).setValue(annStop(ai))
            End If
        Next ai

        ' Pakket tellen (voor subtotaal afhaalpunt)
        Select Case LCase(bPakket(b))
            Case "klein pakket"
                oSheet.getCellByPosition(cKG, r).setValue(1)
                afKG = afKG + 1
            Case "groot pakket"
                oSheet.getCellByPosition(cGG, r).setValue(1)
                afGG = afGG + 1
            Case "extra groot pakket"
                oSheet.getCellByPosition(cEGG, r).setValue(1)
                afEGG = afEGG + 1
            Case "mini pakket"
                oSheet.getCellByPosition(cMINI, r).setValue(1)
                afMINI = afMINI + 1
        End Select

        ' Losse groenten
        For g = 0 To nGroenten - 1
            If bGroent(b, g) > 0 Then
                oSheet.getCellByPosition(cGroent0 + g, r).setValue(bGroent(b, g))
                afGroent(g) = afGroent(g) + bGroent(b, g)
            End If
        Next g

        ' Weglatingen
        For w = 0 To nWeg - 1
            If bWeg(b, w) Then
                oSheet.getCellByPosition(cWeg0 + w, r).setString(wegNaam(w))
            End If
        Next w

        ' Synthese weglatingen (kolom AY) als levende formule over alle 12
        ' weglating-slots: per slot met een ingevulde cel "Geen: <naam>" (naam
        ' uit koprij 3), samengevoegd met TEXTJOIN (lege slots vallen weg, geen
        ' beginnende witregel). Zo wordt een handmatige weglating ná aanmaak —
        ' ook in een tot nog toe leeg slot — meteen bijgewerkt, net als kolom W.
        Dim oCelGeen As Object
        oCelGeen = oSheet.getCellByPosition(cGeen, r)
        oSheet.getCellRangeByName(KolomLetter(cGeen) & (r + 1)).setArrayFormula( _
            "=TEXTJOIN(CHAR(10);1;IF(" & KolomLetter(cWeg0) & (r + 1) & ":" & _
            KolomLetter(cWeg0 + nWegSlots - 1) & (r + 1) & "="""";"""";""Geen: ""&" & _
            KolomLetter(cWeg0) & "$3:" & KolomLetter(cWeg0 + nWegSlots - 1) & "$3))")
        oCelGeen.IsTextWrapped = True

        ' Samenvatting als levende formule (kolom V): trekt naam+afhaalpunt+
        ' pakketformaat live uit dezelfde rij, per groente met aantal>0 een
        ' regel "naam: aantal eenheid" (groentenaam uit $2, eenheid uit Blad2.I
        ' met "x "-prefix voor per_stuk), per actieve weglating "Geen: <naam>"
        ' (naam uit $3 van de wegCol). Hierdoor lopen wijzigingen aan
        ' hoeveelheden of weglatingen meteen mee.
        Dim iSamRij As Integer
        iSamRij = r + 1
        Dim sFmlSv As String
        sFmlSv = "=A" & iSamRij & "&"" (""&B" & iSamRij & "&""): ""&" & _
            "IF(" & KolomLetter(cKG) & iSamRij & ">0;""klein"";" & _
            "IF(" & KolomLetter(cGG) & iSamRij & ">0;""groot"";" & _
            "IF(" & KolomLetter(cEGG) & iSamRij & ">0;""extra groot"";" & _
            "IF(" & KolomLetter(cMINI) & iSamRij & ">0;""mini"";""geen pakket""))))"
        Dim sgCol As String
        ' Alle 24 slots (Y..AV), niet enkel de DB-groenten: zo verschijnt een
        ' handmatig toegevoegde losse groente ook in de samenvatting-kolom W.
        ' Een leeg slot levert "" en voegt niets toe tot het ingevuld wordt.
        For g = 0 To nGroentSlots - 1
            sgCol = KolomLetter(cGroent0 + g)
            sFmlSv = sFmlSv & "&IF(" & sgCol & iSamRij & "="""";"""";CHAR(10)&" & _
                sgCol & "$2&"": ""&" & sgCol & iSamRij & "&"" ""&Blad2.I" & (g + 1) & ")"
        Next g
        ' "ander"-kolom (AW) als losse regel "ander/opmerking: <inhoud>",
        ' onder de groenten en vóór de weglatingen. Enkel als AW gevuld is.
        sFmlSv = sFmlSv & "&IF(" & KolomLetter(cAnder) & iSamRij & "="""";"""";CHAR(10)&" & _
            """ander/opmerking: ""&" & KolomLetter(cAnder) & iSamRij & ")"
        Dim swCol As String
        For w = 0 To nWegSlots - 1
            swCol = KolomLetter(cWeg0 + w)
            sFmlSv = sFmlSv & "&IF(" & swCol & iSamRij & "="""";"""";CHAR(10)&""Geen: ""&" & swCol & "$3)"
        Next w
        Dim oCelSamenv As Object
        oCelSamenv = oSheet.getCellByPosition(cSamenv, r)
        oCelSamenv.setFormula(sFmlSv)
        oCelSamenv.IsTextWrapped = True
        bSamenv(b) = ""

        ' € losse: formule naar afrekening.C<rij> (totaal losse groenten per klant)
        Dim oCelWa As Object
        oCelWa = oSheet.getCellByPosition(cWaarde, r)
        oCelWa.setFormula("=afrekening.C" & (r + 1))
        oCelWa.NumberFormat = nCurW

        r = r + 1
    Next b

    ' Witregel na laatste groep
    If sHuidigAfh <> "" Then r = r + 1

    ' --- SAMENVATTINGSRIJEN (formules in rijen 4-6, geschreven na de loop zodat het rijbereik bekend is) ---
    Dim iLaatste As Integer
    iLaatste = r  ' = 1-indexed spreadsheet rij van laatste datarij

    Dim sDatDo As String
    Dim sDatVr As String
    sDatDo = "Donderdag " & Day(dDonderdag) & " " & saMaanden(Month(dDonderdag))
    sDatVr = "Vrijdag "   & Day(dVrijdag)   & " " & saMaanden(Month(dVrijdag))

    Dim ic As Integer
    Dim sK As String

    ' Totaalrij (code rij 3 = spreadsheet rij 4)
    oSheet.getCellByPosition(cNaam, 3).setString("Totaal W" & iWeek)
    oSheet.getCellByPosition(cNaam, 4).setString(sDatDo)
    oSheet.getCellByPosition(cNaam, 5).setString(sDatVr)
    ' Q4/Q5/Q6: som van de pakkettotalen R..U op die rij (gecentreerd).
    oSheet.getCellByPosition(cDatum, 3).setFormula( _
        "=SUM(" & KolomLetter(cKG) & "4:" & KolomLetter(cMINI) & "4)")
    oSheet.getCellByPosition(cDatum, 4).setFormula( _
        "=SUM(" & KolomLetter(cKG) & "5:" & KolomLetter(cMINI) & "5)")
    oSheet.getCellByPosition(cDatum, 5).setFormula( _
        "=SUM(" & KolomLetter(cKG) & "6:" & KolomLetter(cMINI) & "6)")

    ' W4/W5/W6: aantal losse bestellingen (geen pakket, X > 0), opgesplitst per
    ' klaarmaakdag voor rij 5/6. SUMPRODUCT met ='' tests werkt mét echt-lege
    ' cellen — COUNTIFS-criterium '""' deed dat niet en gaf altijd 0.
    Dim sW45Basis As String
    sW45Basis = "(" & KolomLetter(cKG)     & "7:" & KolomLetter(cKG)     & iLaatste & "="""")*" & _
                "(" & KolomLetter(cGG)     & "7:" & KolomLetter(cGG)     & iLaatste & "="""")*" & _
                "(" & KolomLetter(cEGG)    & "7:" & KolomLetter(cEGG)    & iLaatste & "="""")*" & _
                "(" & KolomLetter(cMINI)   & "7:" & KolomLetter(cMINI)   & iLaatste & "="""")*" & _
                "(" & KolomLetter(cWaarde) & "7:" & KolomLetter(cWaarde) & iLaatste & ">0)"
    Dim sDagRange As String
    sDagRange = "$" & KolomLetter(cKlaarDag) & "$7:$" & KolomLetter(cKlaarDag) & "$" & iLaatste
    oSheet.getCellByPosition(cSamenv, 3).setFormula("=SUMPRODUCT(" & sW45Basis & ")")
    oSheet.getCellByPosition(cSamenv, 4).setFormula( _
        "=SUMPRODUCT(" & sW45Basis & "*(" & sDagRange & "=""donderdag""))")
    oSheet.getCellByPosition(cSamenv, 5).setFormula( _
        "=SUMPRODUCT(" & sW45Basis & "*(" & sDagRange & "=""vrijdag""))")

    ' B4-B6 spiegelen Q4-Q6, C4-C6 spiegelen W4-W6 (gewoon doorgeef-formules,
    ' geen aparte opmaak — die volgt de algemene rij 3-5 layout).
    Dim rrSpiegel As Integer
    For rrSpiegel = 3 To 5
        oSheet.getCellByPosition(cAfh,      rrSpiegel).setFormula( _
            "=" & KolomLetter(cDatum)  & (rrSpiegel + 1))
        oSheet.getCellByPosition(cKlaarDag, rrSpiegel).setFormula( _
            "=" & KolomLetter(cSamenv) & (rrSpiegel + 1))
    Next rrSpiegel

    ' Centrering voor Q4-Q6 + W4-W6 (achtergrond komt verderop in de rij 3-5
    ' opmaaksectie, na de clDDDDDD-definitie).
    Dim iQRij As Integer
    For iQRij = 3 To 5
        oSheet.getCellByPosition(cDatum,  iQRij).HoriJustify = com.sun.star.table.CellHoriJustify.CENTER
        oSheet.getCellByPosition(cDatum,  iQRij).VertJustify = com.sun.star.table.CellVertJustify2.CENTER
        oSheet.getCellByPosition(cSamenv, iQRij).HoriJustify = com.sun.star.table.CellHoriJustify.CENTER
        oSheet.getCellByPosition(cSamenv, iQRij).VertJustify = com.sun.star.table.CellVertJustify2.CENTER
    Next iQRij
    For ic = cKG To cMINI
        sK = KolomLetter(ic)
        oSheet.getCellByPosition(ic, 3).setFormula( _
            "=SUM(" & sK & "7:" & sK & iLaatste & ")")
    Next ic
    ' € losse — totaal
    sK = KolomLetter(cWaarde)
    oSheet.getCellByPosition(cWaarde, 3).setFormula( _
        "=SUM(" & sK & "7:" & sK & iLaatste & ")")
    oSheet.getCellByPosition(cWaarde, 3).NumberFormat = nCurW
    For ic = cGroent0 To cGroent0 + nGroentSlots - 1
        sK = KolomLetter(ic)
        oSheet.getCellByPosition(ic, 3).setFormula( _
            "=SUM(" & sK & "7:" & sK & iLaatste & ")")
    Next ic

    ' Q3: totaal aantal pakketten — som van de pakkettotalen (R4:U4) in de
    ' totaalrij, gevolgd door het woord PAKKETTEN.
    oSheet.getCellByPosition(cDatum, 2).setFormula( _
        "=SUM(" & KolomLetter(cKG) & "4:" & KolomLetter(cMINI) & "4)&"" PAKKETTEN""")

    ' W3: "<aantal losse bestellingen> LOSSE BESTELLINGEN" — klanten zonder
    ' pakket (R,S,T,U leeg) maar met een waarde in X (cWaarde > 0). Hergebruikt
    ' W4 (totaalrij) zodat W3 automatisch meeloopt bij wijzigingen.
    oSheet.getCellByPosition(cSamenv, 2).setFormula( _
        "=" & KolomLetter(cSamenv) & "4&"" LOSSE BESTELLINGEN""")

    ' Donderdagrij (code rij 4 = spreadsheet rij 5) — SUMIF op kolom C (dag_klaarmaken)
    For ic = cKG To cMINI
        sK = KolomLetter(ic)
        oSheet.getCellByPosition(ic, 4).setFormula( _
            "=SUMIF($C$7:$C$" & iLaatste & ";""donderdag"";" & sK & "7:" & sK & iLaatste & ")")
    Next ic
    ' € losse — donderdag
    sK = KolomLetter(cWaarde)
    oSheet.getCellByPosition(cWaarde, 4).setFormula( _
        "=SUMIF($C$7:$C$" & iLaatste & ";""donderdag"";" & sK & "7:" & sK & iLaatste & ")")
    oSheet.getCellByPosition(cWaarde, 4).NumberFormat = nCurW
    For ic = cGroent0 To cGroent0 + nGroentSlots - 1
        sK = KolomLetter(ic)
        oSheet.getCellByPosition(ic, 4).setFormula( _
            "=SUMIF($C$7:$C$" & iLaatste & ";""donderdag"";" & sK & "7:" & sK & iLaatste & ")")
    Next ic

    ' Vrijdagrij (code rij 5 = spreadsheet rij 6)
    For ic = cKG To cMINI
        sK = KolomLetter(ic)
        oSheet.getCellByPosition(ic, 5).setFormula( _
            "=SUMIF($C$7:$C$" & iLaatste & ";""vrijdag"";" & sK & "7:" & sK & iLaatste & ")")
    Next ic
    ' € losse — vrijdag
    sK = KolomLetter(cWaarde)
    oSheet.getCellByPosition(cWaarde, 5).setFormula( _
        "=SUMIF($C$7:$C$" & iLaatste & ";""vrijdag"";" & sK & "7:" & sK & iLaatste & ")")
    oSheet.getCellByPosition(cWaarde, 5).NumberFormat = nCurW
    For ic = cGroent0 To cGroent0 + nGroentSlots - 1
        sK = KolomLetter(ic)
        oSheet.getCellByPosition(ic, 5).setFormula( _
            "=SUMIF($C$7:$C$" & iLaatste & ";""vrijdag"";" & sK & "7:" & sK & iLaatste & ")")
    Next ic

    ' =============================================
    ' OPMAAK TOEPASSEN
    ' =============================================

    ' Helper: pas celstijl toe
    ' Kleuren als Long: RGB(r,g,b) of &H00RRGGBB
    Dim nTotRijen As Integer
    nTotRijen = r + 1  ' r is de laatste geschreven rij

    ' --- Kolombreedtes instellen ---
    ' Vaste kolommen (0-23)
    Dim aBreedtes(23) As Long
    aBreedtes(0)  = 4219  ' naam
    aBreedtes(1)  = 2800  ' afhaalpunt
    aBreedtes(2)  = 1800  ' dag klaarmaken
    aBreedtes(3)  = 3250  ' type
    aBreedtes(4)  = 1900  ' formaat
    aBreedtes(5)  = 7500  ' opmerkingen
    aBreedtes(6)  = 5500  ' email
    aBreedtes(7)  = 2500  ' telefoon
    aBreedtes(8)  = 1850  ' voornaam
    aBreedtes(9)  = 2205  ' klant_type
    aBreedtes(10) = 1800  ' leverdag (verborgen)
    aBreedtes(11) = 993   ' abonnement_wijziging
    aBreedtes(12) = 993   ' week_stop
    aBreedtes(13) = 993   ' week_ann
    aBreedtes(14) = 993   ' week_start
    aBreedtes(15) = 1700  ' klant_id
    aBreedtes(16) = 4219  ' datum/totaal kolom
    aBreedtes(17) = 700   ' KG
    aBreedtes(18) = 700   ' GG
    aBreedtes(19) = 700   ' EGG
    aBreedtes(20) = 700   ' MINI
    aBreedtes(21) = 1000  ' extra spacer (kolom V)
    aBreedtes(22) = 10000 ' samenvatting (kolom W)
    aBreedtes(23) = 2000  ' € losse (kolom X)

    Dim ci As Integer
    For ci = 0 To 23
        oSheet.Columns.getByIndex(ci).Width = aBreedtes(ci)
    Next ci
    ' Losse groenten: altijd 24 slots à 2,30 cm elk
    For ci = 0 To nGroentSlots - 1
        oSheet.Columns.getByIndex(cGroent0 + ci).Width = 2300
    Next ci
    ' Invoerhulp op de losse-groente-slots: wijs op de macro VoegLosseGroenteToe
    ZetLosseGroenteTip(oSheet)
    oSheet.Columns.getByIndex(cAnder).Width  = 2300   ' ander
    oSheet.Columns.getByIndex(cAangep).Width = 3344   ' aangepast pakket
    oSheet.Columns.getByIndex(cGeen).Width   = 5000   ' synthese weglatingen
    ' Weglatingen: 2260 elk (alle 12 slots)
    For ci = 0 To nWegSlots - 1
        oSheet.Columns.getByIndex(cWeg0 + ci).Width = 2260
    Next ci

    ' Kolommen I, J en K verbergen
    oSheet.Columns.getByIndex(cVoor).IsVisible    = False
    oSheet.Columns.getByIndex(cType).IsVisible    = False
    oSheet.Columns.getByIndex(cDag).IsVisible     = False

    ' --- Rijhoogtes instellen ---
    oSheet.Rows.getByIndex(0).Height = 960   ' rij 0: metadata
    oSheet.Rows.getByIndex(1).OptimalHeight = False
    oSheet.Rows.getByIndex(1).Height = 1200
    Dim ri As Integer
    oSheet.Rows.getByIndex(2).Height = 1640
    For ri = 3 To 5
        oSheet.Rows.getByIndex(ri).Height = 450
    Next ri
    For ri = 6 To nTotRijen
        oSheet.Rows.getByIndex(ri).OptimalHeight = True
    Next ri

    ' --- Kleuren en lettertype per zone ---
    ' Kleuren als Long (LibreOffice gebruikt BGR intern, maar RGB() werkt correct)
    Dim clCyan     As Long : clCyan     = RGB(153, 255, 255)  ' #99FFFF - metadata rij
    Dim clGrijs    As Long : clGrijs    = RGB(204, 204, 204)  ' #CCCCCC - kolomhoofden
    Dim clGeel     As Long : clGeel     = RGB(255, 255, 153)  ' #FFFF99 - afhaalpunt/groenten
    Dim clDDDDDD   As Long : clDDDDDD   = RGB(221, 221, 221)  ' #DDDDDD - totaalrijen
    Dim clWit      As Long : clWit      = RGB(255, 255, 255)  ' #FFFFFF - klantdata
    Dim clOranje   As Long : clOranje   = RGB(255, 128,   0)  ' #FF8000 - weglatingen
    Dim clGoud     As Long : clGoud     = RGB(204, 153,   0)  ' #CC9900 - datumcel rij1
    Dim clGroenKG  As Long : clGroenKG  = RGB(204, 255, 153)  ' #CCFF99 - KG
    Dim clBlauwGG  As Long : clBlauwGG  = RGB(153, 204, 255)  ' #99CCFF - GG
    Dim clGrijsEGG As Long : clGrijsEGG = RGB(178, 178, 178)  ' #B2B2B2 - EGG
    Dim clRoosM    As Long : clRoosM    = RGB(255, 153, 204)  ' #FF99CC - MINI
    Dim clGrijsTekst As Long : clGrijsTekst = RGB(128, 128, 128)

    ' Hulpfunctie: stijl toepassen op een cel
    ' (inline, LibreOffice Basic heeft geen echte functies met objecten)

    Dim oC As Object
    Dim cIdx As Integer
    Dim rIdx As Integer

    ' --- RIJ 0: metadata (#99FFFF, wit tekst, vet, 16pt, midden/midden) ---
    For cIdx = 0 To cWeg0 + nWegSlots - 1
        oC = oSheet.getCellByPosition(cIdx, 0)
        oC.CellBackColor   = clCyan
        oC.CharWeight      = com.sun.star.awt.FontWeight.BOLD
        oC.CharHeight      = 16
        oC.HoriJustify     = com.sun.star.table.CellHoriJustify.CENTER
        oC.VertJustify     = com.sun.star.table.CellVertJustify2.CENTER
        oC.IsTextWrapped   = True
    Next cIdx
    ' Kolommen 0-3: iets kleiner lettertype
    For cIdx = 0 To 3
        oSheet.getCellByPosition(cIdx, 0).CharHeight = 14
    Next cIdx

    ' --- RIJ 1: kolomhoofden (#CCCCCC, vet, 10pt, links/boven, tekstomloop) ---
    For cIdx = 0 To cWeg0 + nWegSlots - 1
        oC = oSheet.getCellByPosition(cIdx, 1)
        oC.CellBackColor = clGrijs
        oC.CharWeight    = com.sun.star.awt.FontWeight.BOLD
        oC.CharHeight    = 10
        oC.HoriJustify   = com.sun.star.table.CellHoriJustify.LEFT
        oC.VertJustify   = com.sun.star.table.CellVertJustify2.TOP
        oC.IsTextWrapped = True
    Next cIdx
    ' Datumkolom rij1: goud, 16pt, midden
    oC = oSheet.getCellByPosition(cDatum, 1)
    oC.CellBackColor = clGoud
    oC.CharHeight    = 16
    oC.HoriJustify   = com.sun.star.table.CellHoriJustify.CENTER
    oC.VertJustify   = com.sun.star.table.CellVertJustify2.CENTER
    ' KG/GG/EGG/MINI rij1: eigen kleuren, links/boven
    oSheet.getCellByPosition(cKG,   1).CellBackColor = clGroenKG
    oSheet.getCellByPosition(cGG,   1).CellBackColor = clBlauwGG
    oSheet.getCellByPosition(cEGG,  1).CellBackColor = clGrijsEGG
    oSheet.getCellByPosition(cMINI, 1).CellBackColor = clRoosM
    For cIdx = cKG To cMINI
        oSheet.getCellByPosition(cIdx, 1).HoriJustify = com.sun.star.table.CellHoriJustify.LEFT
    Next cIdx
    ' Groenten + ander rij1: #99FFFF, links/boven
    For cIdx = cGroent0 To cAnder
        oC = oSheet.getCellByPosition(cIdx, 1)
        oC.CellBackColor = clCyan
        oC.HoriJustify   = com.sun.star.table.CellHoriJustify.LEFT
    Next cIdx
    ' Synthese weglatingen rij1: oranje
    oSheet.getCellByPosition(cGeen, 1).CellBackColor = clOranje
    ' Weglatingen rij1: oranje
    For cIdx = cWeg0 To cWeg0 + nWegSlots - 1
        oSheet.getCellByPosition(cIdx, 1).CellBackColor = clOranje
    Next cIdx
    ' Samenvatting rij1: grijs kolomhoofd
    Dim oCsamHoofd As Object
    oCsamHoofd = oSheet.getCellByPosition(cSamenv, 1)
    oCsamHoofd.CellBackColor = clGrijs
    oCsamHoofd.CharWeight    = com.sun.star.awt.FontWeight.BOLD
    oCsamHoofd.CharHeight    = 10
    oCsamHoofd.HoriJustify   = com.sun.star.table.CellHoriJustify.LEFT
    oCsamHoofd.VertJustify   = com.sun.star.table.CellVertJustify2.TOP
    oCsamHoofd.IsTextWrapped = True

    ' --- RIJ 2: eenheden (#DDDDDD voor datum/pakket, #99FFFF voor groenten) ---
    For cIdx = 0 To cWeg0 + nWegSlots - 1
        oC = oSheet.getCellByPosition(cIdx, 2)
        oC.CharWeight    = com.sun.star.awt.FontWeight.BOLD
        oC.CharHeight    = 10
        oC.IsTextWrapped = True
        oC.VertJustify   = com.sun.star.table.CellVertJustify2.TOP
    Next cIdx
    oSheet.getCellByPosition(cDatum, 2).CellBackColor = clDDDDDD
    oSheet.getCellByPosition(cKG,    2).CellBackColor = clDDDDDD
    oSheet.getCellByPosition(cGG,    2).CellBackColor = clDDDDDD
    oSheet.getCellByPosition(cEGG,   2).CellBackColor = clDDDDDD
    oSheet.getCellByPosition(cMINI,  2).CellBackColor = clDDDDDD
    For cIdx = cGroent0 To cAnder
        oSheet.getCellByPosition(cIdx, 2).CellBackColor = clCyan
    Next cIdx
    oSheet.getCellByPosition(cGeen, 2).CellBackColor = clOranje

    ' Q3 (totaal pakketten): horizontaal en verticaal centreren
    oSheet.getCellByPosition(cDatum, 2).HoriJustify = com.sun.star.table.CellHoriJustify.CENTER
    oSheet.getCellByPosition(cDatum, 2).VertJustify = com.sun.star.table.CellVertJustify2.CENTER

    ' W3 (losse bestellingen): zelfde opmaak als Q3
    oSheet.getCellByPosition(cSamenv, 2).CellBackColor = clDDDDDD
    oSheet.getCellByPosition(cSamenv, 2).HoriJustify   = com.sun.star.table.CellHoriJustify.CENTER
    oSheet.getCellByPosition(cSamenv, 2).VertJustify   = com.sun.star.table.CellVertJustify2.CENTER

    ' B3/C3 ("PAKKETTEN" / "LOS"): tekst onderaan rij 2 zodat ze visueel vlak
    ' boven B4/C4 staan (override van de algemene rij 2 VertJustify=TOP).
    oSheet.getCellByPosition(cAfh,      2).VertJustify = com.sun.star.table.CellVertJustify2.BOTTOM
    oSheet.getCellByPosition(cKlaarDag, 2).VertJustify = com.sun.star.table.CellVertJustify2.BOTTOM

    ' --- RIJEN 3-5: totaal/donderdag/vrijdag (#DDDDDD, vet) ---
    For rIdx = 3 To 5
        For cIdx = 0 To cWeg0 + nWegSlots - 1
            oC = oSheet.getCellByPosition(cIdx, rIdx)
            oC.CharWeight    = com.sun.star.awt.FontWeight.BOLD
            oC.CharHeight    = 10
            oC.IsTextWrapped = True
        Next cIdx
        oSheet.getCellByPosition(cDatum,  rIdx).CellBackColor = clDDDDDD
        oSheet.getCellByPosition(cKG,     rIdx).CellBackColor = clDDDDDD
        oSheet.getCellByPosition(cGG,     rIdx).CellBackColor = clDDDDDD
        oSheet.getCellByPosition(cEGG,    rIdx).CellBackColor = clDDDDDD
        oSheet.getCellByPosition(cMINI,   rIdx).CellBackColor = clDDDDDD
        oSheet.getCellByPosition(cSamenv, rIdx).CellBackColor = clDDDDDD
        For cIdx = cGroent0 To cAnder
            oSheet.getCellByPosition(cIdx, rIdx).CellBackColor = clGeel
        Next cIdx
        oSheet.getCellByPosition(cGeen, rIdx).CellBackColor = clGeel
        For cIdx = cWeg0 To cWeg0 + nWegSlots - 1
            oSheet.getCellByPosition(cIdx, rIdx).CellBackColor = clGeel
        Next cIdx
    Next rIdx

    ' --- KLANTDATA RIJEN (vanaf rij 6): opmaak per rij ---
    Dim rStart As Integer
    rStart = 6
    Dim rLoop As Integer
    rLoop = rStart

    ' Herteken afhaalpunt-koprijlijnen en klantdata
    ' We weten de volgorde: koprijlijn (geel) dan klanten (wit) dan subtotaal (geel)
    ' Herstel door opnieuw te lopen over bDag/bAfh arrays

    Dim sVorigAfh2 As String
    Dim sVorigDag2 As String
    sVorigAfh2 = ""
    sVorigDag2 = ""

    For b = 0 To nBest - 1
        If bAfh(b) <> sVorigAfh2 Or bDag(b) <> sVorigDag2 Then
            ' Dit was een subtotaalrij (als er al een groep was)
            If sVorigAfh2 <> "" Then
                rLoop = rLoop + 1  ' witregel
            End If
            ' Koprijlijn = geel, vet
            PasRijOpmaakToe(oSheet, rLoop, clGeel, True, _
                            cGroent0, cAangep, cGeen, cWeg0, nWegSlots, clGeel, clGeel)
            rLoop = rLoop + 1
            sVorigAfh2 = bAfh(b)
            sVorigDag2 = bDag(b)
        End If
        ' Klantdata rij = wit, normaal
        PasRijOpmaakToe(oSheet, rLoop, clWit, False, _
                        cGroent0, cAangep, cGeen, cWeg0, nWegSlots, clCyan, clOranje)
        rLoop = rLoop + 1
    Next b
    ' Witregel na laatste groep: geen opmaak nodig

    ' --- Celranden instellen ---
    Dim oBL As New com.sun.star.table.BorderLine2
    oBL.LineStyle = com.sun.star.table.BorderLineStyle.SOLID
    oBL.LineWidth = 26
    oBL.Color     = RGB(0, 0, 0)
    Dim oTB As New com.sun.star.table.TableBorder2
    oTB.TopLine            = oBL : oTB.IsTopLineValid        = True
    oTB.BottomLine         = oBL : oTB.IsBottomLineValid     = True
    oTB.LeftLine           = oBL : oTB.IsLeftLineValid       = True
    oTB.RightLine          = oBL : oTB.IsRightLineValid      = True
    oTB.HorizontalLine     = oBL : oTB.IsHorizontalLineValid = True
    oTB.VerticalLine       = oBL : oTB.IsVerticalLineValid   = True
    Dim oRandBereik As Object
    oRandBereik = oSheet.getCellRangeByPosition(0, 0, cWeg0 + nWegSlots - 1, nTotRijen - 1)
    oRandBereik.TableBorder2 = oTB

    ' --- Rijen/kolommen vastzetten bij B7 ---
    oNieuwDoc.getCurrentController().freezeAtPosition(1, 6)

    ' --- Tabblad "pakketwaardes" (bewerkbaar; bron voor weglatingen-verrekening) ---
    ' Eén rij per groente met de in-pakket-waarde per formaat. Initieel gevuld
    ' vanuit pakket_inhoud.waarde (Sheets-sync), maar vrij bewerkbaar: de
    ' afrekening verwijst hiernaar zodat jouw bijsturing meteen doorwerkt.
    ' MOET vóór het afrekeningstabblad worden aangemaakt — de afrekening-formules
    ' verwijzen ernaar, en LibreOffice compileert een verwijzing naar een nog
    ' onbestaand blad meteen tot een fout.
    Dim oPW As Object
    If oNieuwDoc.Sheets.hasByName("pakketwaardes") Then
        oPW = oNieuwDoc.Sheets.getByName("pakketwaardes")
    Else
        oNieuwDoc.Sheets.insertNewByName("pakketwaardes", oNieuwDoc.Sheets.Count)
        oPW = oNieuwDoc.Sheets.getByName("pakketwaardes")
    End If
    Dim oFmtsPW As Object : oFmtsPW = oNieuwDoc.getNumberFormats()
    Dim oLocPW As New com.sun.star.lang.Locale
    oLocPW.Language = "nl" : oLocPW.Country = "BE"
    Dim nCurPW As Long, sCurPW As String
    sCurPW = "#.##0,00"" " & Chr(8364) & """"
    nCurPW = oFmtsPW.queryKey(sCurPW, oLocPW, False)
    If nCurPW = -1 Then nCurPW = oFmtsPW.addNew(sCurPW, oLocPW)
    oPW.getCellByPosition(0, 0).setString("groente")
    oPW.getCellByPosition(1, 0).setString("klein (KG)")
    oPW.getCellByPosition(2, 0).setString("groot (GG)")
    oPW.getCellByPosition(3, 0).setString("extra groot (EGG)")
    oPW.getCellByPosition(4, 0).setString("mini (MINI)")
    Dim iPwRij As Integer
    For iPwRij = 0 To nPW - 1
        oPW.getCellByPosition(0, iPwRij + 1).setString(pwNaam(iPwRij))
        oPW.getCellByPosition(1, iPwRij + 1).setValue(pwKG(iPwRij))
        oPW.getCellByPosition(2, iPwRij + 1).setValue(pwGG(iPwRij))
        oPW.getCellByPosition(3, iPwRij + 1).setValue(pwEGG(iPwRij))
        oPW.getCellByPosition(4, iPwRij + 1).setValue(pwMINI(iPwRij))
    Next iPwRij
    If nPW > 0 Then
        oPW.getCellRangeByName("B2:E" & (nPW + 1)).NumberFormat = nCurPW
    End If
    oPW.getCellRangeByName("A1:E1").CharWeight = com.sun.star.awt.FontWeight.BOLD
    oPW.Columns.getByIndex(0).Width = 5000

    ' --- Tabblad "afrekening" ---
    ' Spiegelt de klantrijen van het datablad met levende formules en
    ' berekent per klant het te betalen bedrag. Manuele correcties van de
    ' geleverde hoeveelheden (kolom W+ op het datablad) rekenen meteen door.
    Dim oAfr As Object
    If oNieuwDoc.Sheets.hasByName("afrekening") Then
        oAfr = oNieuwDoc.Sheets.getByName("afrekening")
    Else
        oNieuwDoc.Sheets.insertNewByName("afrekening", 1)
        oAfr = oNieuwDoc.Sheets.getByName("afrekening")
    End If

    Dim sData As String
    sData = "'Week " & iWeek & " - " & iJaar & "'"   ' bladnaam voor formules

    ' Valuta-opmaak
    Dim oFmtsA As Object : oFmtsA = oNieuwDoc.getNumberFormats()
    Dim oLocA As New com.sun.star.lang.Locale
    oLocA.Language = "nl" : oLocA.Country = "BE"
    Dim nCur As Long, sCurFmt As String
    sCurFmt = "#.##0,00"" " & Chr(8364) & """"
    nCur = oFmtsA.queryKey(sCurFmt, oLocA, False)
    If nCur = -1 Then nCur = oFmtsA.addNew(sCurFmt, oLocA)

    ' Pakketprijzen bovenaan — aanpasbaar
    oAfr.getCellByPosition(0, 0).setString("AFREKENING - Week " & iWeek & " - " & iJaar)
    oAfr.getCellByPosition(0, 1).setString("Klein pakket")
    oAfr.getCellByPosition(0, 2).setString("Groot pakket")
    oAfr.getCellByPosition(0, 3).setString("Extra groot pakket")
    oAfr.getCellByPosition(0, 4).setString("Mini pakket")
    oAfr.getCellByPosition(1, 1).setValue(prijsKlein)
    oAfr.getCellByPosition(1, 2).setValue(prijsGroot)
    oAfr.getCellByPosition(1, 3).setValue(prijsEGroot)
    oAfr.getCellByPosition(1, 4).setValue(prijsMini)
    oAfr.getCellRangeByName("B2:B5").NumberFormat = nCur

    ' Koprij van de afrekeningstabel
    oAfr.getCellByPosition(0, 5).setString("klant / afhaalpunt")
    oAfr.getCellByPosition(1, 5).setString("pakket")
    oAfr.getCellByPosition(2, 5).setString("losse groenten")
    oAfr.getCellByPosition(3, 5).setString("weglatingen (-)")
    oAfr.getCellByPosition(4, 5).setString("TOTAAL")
    oAfr.getCellByPosition(5, 5).setString("klant_id")            ' kolom F
    oAfr.getCellByPosition(cGeen, 5).setString("detail weglatingen") ' kolom AY
    oAfr.getCellByPosition(cSamenv, 5).setString("detail losse groenten")
    ' Alle 24 gereserveerde groente-slots (Y..AV) spiegelen, niet enkel de
    ' groenten uit de DB: zo wordt een handmatig in rij 2 van het datablad
    ' toegevoegde losse groente automatisch overgenomen. IF-wrap houdt een nog
    ' lege slot leeg i.p.v. een storende "0" in de koprij.
    For g = 0 To nGroentSlots - 1
        oAfr.getCellByPosition(cGroent0 + g, 5).setFormula( _
            "=IF(" & sData & "." & KolomLetter(cGroent0 + g) & "2="""";"""";" & _
            sData & "." & KolomLetter(cGroent0 + g) & "2)")
    Next g

    ' Weglatings-DETAILkolommen (vanaf AZ, uitgelijnd op het datablad): per
    ' weglatingsgroente de waarde die de klant in mindering krijgt. Er staan nu
    ' vast nWegSlots (>=12) kolommen klaar, ook lege, zodat een handmatig
    ' toegevoegde weglating meteen meeloopt. Het vaste TOTAAL staat in kolom D —
    ' daar naar verwijzen voor maandoverzichten, niet naar deze detailkolommen.
    ' De waarde wordt opgezocht in 'pakketwaardes' o.b.v. (formaat, groentenaam).
    ' Weglating-koprij (rij 6): spiegel de groentenaam uit rij 3 van het
    ' datablad voor alle nWegSlots kolommen. Zo verschijnt een handmatig
    ' toegevoegde weglating-groente automatisch, en blijft een lege slot leeg.
    Dim wHdr As Integer
    For wHdr = 0 To nWegSlots - 1
        oAfr.getCellByPosition(cWeg0 + wHdr, 5).setFormula( _
            "=IF(" & sData & "." & KolomLetter(cWeg0 + wHdr) & "3="""";"""";" & _
            sData & "." & KolomLetter(cWeg0 + wHdr) & "3)")
    Next wHdr

    ' Spiegel: één rij per datablad-rij. De formules lopen op ELKE rij mee —
    ' ook op witregels, afhaalpunt-koprijen en de extra lege rijen onderaan — en
    ' geven "" als de bron leeg is of het een afhaalpunt-/witregel is, zodat er
    ' nergens een storende 0 verschijnt. Onderaan staan standaard nExtra lege
    ' rijen mét formules klaar zodat een handmatig toegevoegde klant meteen telt.
    Dim sLG As String : sLG = KolomLetter(cGroent0 + nGroentSlots - 1)  ' laatste groente-slot (AV)
    Dim sFG As String : sFG = KolomLetter(cGroent0)                     ' eerste groente-slot (Y)
    Dim sEenRng As String
    sEenRng = "Blad2.A$100:" & KolomLetter(nGroentSlots - 1) & "$100"
    Dim sWegF As String, sWegL As String, sPwVal As String, sPwKey As String
    Dim nPwRijen As Integer : nPwRijen = nPW : If nPwRijen < 1 Then nPwRijen = 1
    sWegF  = KolomLetter(cWeg0)
    sWegL  = KolomLetter(cWeg0 + nWegSlots - 1)
    sPwVal = "pakketwaardes.$B$2:$E$" & (nPwRijen + 1)
    sPwKey = "pakketwaardes.$A$2:$A$" & (nPwRijen + 1)

    Const nExtra = 10                       ' extra lege rijen met formules klaar
    Dim nLaatsteForm As Integer
    nLaatsteForm = iLaatste + nExtra        ' laatste rij (1-based) met formules

    Dim ar As Integer, asr As Integer
    Dim sGuard As String, sCol As String, sFmtCol As String
    Dim wAfr As Integer, sWegColA As String
    For ar = 6 To nLaatsteForm - 1
        asr = ar + 1
        ' Echte klantrij = naam-bron niet leeg én geen afhaalpunt-koprij. Anders
        ' (witregel, afhaalpunt-rij, extra lege rij) geven de bedrag-kolommen "".
        sGuard = "OR(" & sData & ".A" & asr & "="""";" & _
                 sData & "." & KolomLetter(cAfh) & asr & "=""afhaalpunt/dag"")"

        ' A: naam/afhaalpunt spiegelen (leeg → leeg, niet 0)
        oAfr.getCellByPosition(cNaam, ar).setFormula( _
            "=IF(" & sData & ".A" & asr & "="""";"""";" & sData & ".A" & asr & ")")
        ' F: klant_id uit kolom P; lege bron → leeg (matcht in maandbestand)
        oAfr.getCellByPosition(5, ar).setFormula( _
            "=IF(" & sData & "." & KolomLetter(cWBest) & asr & "="""";"""";" & _
            sData & "." & KolomLetter(cWBest) & asr & ")")
        ' B: pakket-bedrag = pakkettype x pakketprijs-cel bovenaan
        oAfr.getCellByPosition(1, ar).setFormula( _
            "=IF(" & sGuard & ";"""";" & _
            sData & "." & KolomLetter(cKG)   & asr & "*$B$2+" & _
            sData & "." & KolomLetter(cGG)   & asr & "*$B$3+" & _
            sData & "." & KolomLetter(cEGG)  & asr & "*$B$4+" & _
            sData & "." & KolomLetter(cMINI) & asr & "*$B$5)")
        ' per groente Y..AV: geleverde hoeveelheid x prijs/eenheid (rij 3); leeg -> ""
        For g = 0 To nGroentSlots - 1
            sCol = KolomLetter(cGroent0 + g)
            oAfr.getCellByPosition(cGroent0 + g, ar).setFormula( _
                "=IF(" & sData & "." & sCol & asr & "="""";"""";" & _
                sData & "." & sCol & asr & "*" & sData & "." & sCol & "$3)")
        Next g
        ' C: losse-groenten-totaal
        oAfr.getCellByPosition(2, ar).setFormula( _
            "=IF(" & sGuard & ";"""";SUM(" & sFG & asr & ":" & sLG & asr & "))")
        ' W: detail losse groenten (levende formule), per groente
        '   "<naam>: <aantal> <eenheid> a <prijs> EUR = <totaal> EUR"
        ' De "x "-prefix voor per_stuk zit al in de Blad2-cel; a via Chr(224),
        ' EUR via Chr(8364) tegen UTF-8 -> Latin-1 mojibake.
        oAfr.getCellRangeByName(KolomLetter(cSamenv) & asr).setArrayFormula( _
            "=TEXTJOIN(CHAR(10);1;IF(" & sData & "." & sFG & asr & ":" & sLG & asr & "="""";"""";" & _
            sData & "." & sFG & "$2:" & sLG & "$2&"": ""&" & sData & "." & sFG & asr & ":" & sLG & asr & _
            "&"" ""&" & sEenRng & "&"" " & Chr(224) & " ""&" & _
            "TEXT(" & sData & "." & sFG & "$3:" & sLG & "$3;""0,00"")&"" " & Chr(8364) & " = ""&" & _
            "TEXT(" & sData & "." & sFG & asr & ":" & sLG & asr & "*" & sData & "." & sFG & "$3:" & sLG & "$3;""0,00"")&"" " & Chr(8364) & """))")
        ' Weglating-detailkolommen (AZ+): per groente de in-pakket-waarde, maar enkel
        ' als de klant ze weglaat. Opzoeken in 'pakketwaardes' o.b.v. (formaat
        ' 1=KG..4=MINI, naam). Niet-gevonden/"geen pakket" -> 0 (IFERROR). 12 slots.
        sFmtCol = "IF(" & sData & "." & KolomLetter(cKG)   & asr & ">0;1;" & _
                  "IF(" & sData & "." & KolomLetter(cGG)   & asr & ">0;2;" & _
                  "IF(" & sData & "." & KolomLetter(cEGG)  & asr & ">0;3;" & _
                  "IF(" & sData & "." & KolomLetter(cMINI) & asr & ">0;4;0))))"
        For wAfr = 0 To nWegSlots - 1
            sWegColA = KolomLetter(cWeg0 + wAfr)
            oAfr.getCellByPosition(cWeg0 + wAfr, ar).setFormula( _
                "=IF(" & sData & "." & sWegColA & asr & "="""";"""";" & _
                "IFERROR(INDEX(" & sPwVal & ";MATCH(" & sData & "." & sWegColA & "$3;" & sPwKey & ";0);" & _
                sFmtCol & ");0))")
        Next wAfr
        ' D: vast weglatingen-totaal = som van de detailkolommen
        oAfr.getCellByPosition(3, ar).setFormula( _
            "=IF(" & sGuard & ";"""";SUM(" & sWegF & asr & ":" & sWegL & asr & "))")
        ' AY: detail weglatingen als tekst, pendant van W. Per actieve weglating
        '   "Geen <naam>: -<waarde> EUR"  (naam uit koprij 6, waarde uit AZ+).
        oAfr.getCellRangeByName(KolomLetter(cGeen) & asr).setArrayFormula( _
            "=TEXTJOIN(CHAR(10);1;IF(" & sData & "." & sWegF & asr & ":" & sWegL & asr & "="""";"""";" & _
            """Geen ""&LOWER(" & sWegF & "$6:" & sWegL & "$6)&"": -""&" & _
            "TEXT(" & sWegF & asr & ":" & sWegL & asr & ";""0,00"")&"" " & Chr(8364) & """))")
        ' E: TOTAAL (vaste kolom E) = pakket + losse - weglatingen
        oAfr.getCellByPosition(4, ar).setFormula( _
            "=IF(" & sGuard & ";"""";B" & asr & "+C" & asr & "-D" & asr & ")")
    Next ar

    ' Algemeen totaal onderaan (na de extra lege formule-rijen)
    Dim arTot As Integer
    arTot = nLaatsteForm + 1
    oAfr.getCellByPosition(0, arTot).setString("ALGEMEEN TOTAAL")
    oAfr.getCellByPosition(1, arTot).setFormula("=SUM(B7:B" & nLaatsteForm & ")")
    oAfr.getCellByPosition(2, arTot).setFormula("=SUM(C7:C" & nLaatsteForm & ")")
    oAfr.getCellByPosition(3, arTot).setFormula("=SUM(D7:D" & nLaatsteForm & ")")
    oAfr.getCellByPosition(4, arTot).setFormula("=SUM(E7:E" & nLaatsteForm & ")")

    ' Opmaak afrekeningstabblad
    oAfr.getCellRangeByName("B7:E" & (arTot + 1)).NumberFormat = nCur
    oAfr.getCellRangeByName(KolomLetter(cGroent0) & "7:" & sLG & nLaatsteForm).NumberFormat = nCur
    oAfr.getCellRangeByName(KolomLetter(cWeg0) & "7:" & KolomLetter(cWeg0 + nWegSlots - 1) & nLaatsteForm).NumberFormat = nCur
    oAfr.getCellRangeByName(KolomLetter(cWeg0) & "6:" & KolomLetter(cWeg0 + nWegSlots - 1) & "6").CharWeight = com.sun.star.awt.FontWeight.BOLD
    oAfr.getCellRangeByName("A6:" & sLG & "6").CharWeight = com.sun.star.awt.FontWeight.BOLD
    oAfr.getCellByPosition(cGeen, 5).CharWeight = com.sun.star.awt.FontWeight.BOLD
    oAfr.getCellByPosition(0, 0).CharWeight = com.sun.star.awt.FontWeight.BOLD
    oAfr.getCellRangeByName("A" & (arTot + 1) & ":E" & (arTot + 1)).CharWeight = com.sun.star.awt.FontWeight.BOLD
    oAfr.Columns.getByIndex(0).Width = 5000
    oAfr.Columns.getByIndex(1).Width = 2000
    oAfr.Columns.getByIndex(2).Width = 2600
    oAfr.Columns.getByIndex(3).Width = 2600
    oAfr.Columns.getByIndex(4).Width = 2400
    oAfr.Columns.getByIndex(cSamenv).Width = 9000
    oAfr.getCellRangeByName(KolomLetter(cSamenv) & "7:" & KolomLetter(cSamenv) & nLaatsteForm).IsTextWrapped = True
    oAfr.Columns.getByIndex(cGeen).Width = 9000
    oAfr.getCellRangeByName(KolomLetter(cGeen) & "7:" & KolomLetter(cGeen) & nLaatsteForm).IsTextWrapped = True

    oNieuwDoc.getCurrentController().setActiveSheet(oNieuwDoc.Sheets.getByIndex(0))

    ' --- Opslaan ---
    Dim sUrl As String
    sUrl = ConvertToURL(sBestand)

    ' Sluit bestaand bestand als het al open staat — maar NIET het aanroepende document
    If FileExists(sBestand) Then
        Dim oComp As Object
        Dim oEnum As Object
        oEnum = StarDesktop.Components.createEnumeration()
        Do While oEnum.hasMoreElements()
            oComp = oEnum.nextElement()
            If HasUnoInterfaces(oComp, "com.sun.star.lang.XServiceInfo") Then
                If oComp.supportsService("com.sun.star.sheet.SpreadsheetDocument") Then
                    If ConvertToURL(sBestand) = oComp.getURL() Then
                        If Not (oComp Is oCallerDoc) Then
                            oComp.close(True)
                        End If
                    End If
                End If
            End If
        Loop
    End If

    Dim aOpslaanProps(0) As New com.sun.star.beans.PropertyValue
    aOpslaanProps(0).Name  = "FilterName"
    aOpslaanProps(0).Value = "calc8"
    oNieuwDoc.storeToURL(sUrl, aOpslaanProps())
    oNieuwDoc.close(True)

    Dim bVanuitWeekbestand As Boolean
    bVanuitWeekbestand = (ConvertToURL(sBestand) = oCallerDoc.getURL())

    Dim sCorrSuffix As String : sCorrSuffix = ""
    If sDbCorr <> "" Then
        sCorrSuffix = Chr(10) & Chr(10) & _
            "Database-correcties t.o.v. de bestelling (URL):" & Chr(10) & sDbCorr
    End If

    If bVanuitWeekbestand Then
        ' Kan het aanroepende document niet sluiten vanuit de lopende macro.
        ' Gebruiker sluit dit venster zelf; het bestand op schijf is al vervangen.
        MsgBox "Weekbestand aangemaakt:" & Chr(10) & sBestand & sCorrSuffix & Chr(10) & Chr(10) & _
               "Sluit dit venster zelf en open het bestand opnieuw.", 64, "Klaar"
    Else
        Dim aOpenProps(0) As New com.sun.star.beans.PropertyValue
        aOpenProps(0).Name  = "MacroExecutionMode"
        aOpenProps(0).Value = 4
        oDesktop.loadComponentFromURL(sUrl, "_blank", 0, aOpenProps())
        MsgBox "Weekbestand aangemaakt:" & Chr(10) & sBestand & sCorrSuffix, 64, "Klaar"
    End If
    SluitSSHTunnels()
    Exit Sub

VerbindingsFout:
    MsgBox "Verbindingsfout: " & Err & " - " & Error & Chr(10) & _
           "Controleer of de SSH-tunnel actief is (poort 5433).", 16, "Fout"

End Sub

' =============================================
' Kiemkracht - Losse groente handmatig toevoegen
' Uitvoeren terwijl een weekbestand open is (eerste tabblad = datablad).
' Vult het eerste vrije groente-slot (Y..AV) met:
'   - naam in rij 2
'   - prijs in rij 3, opgemaakt als "0,00 EUR / <eenheid>"
'   - eenheid-metadata in Blad2 (kolom I + rij 100), identiek aan
'     MaakWeekbestand, met "x "/"Chr(215) "-prefix voor per-stuk-groenten.
' Daardoor lopen afrekening, samenvatting-kolom en overzichten meteen mee.
' Werkt op weekbestanden gemaakt met de 24-slot-versie van MaakWeekbestand;
' oudere bestanden worden gedetecteerd en gemeld.
' =============================================
Sub VoegLosseGroenteToe()
    On Error GoTo Fout

    Const cGroent0     = 24   ' eerste groente-kolom (Y)
    Const nGroentSlots = 24   ' slots Y..AV

    ' --- Actief weekbestand ophalen + controleren ---
    Dim oDoc As Object, oWk As Object
    oDoc = ThisComponent
    If IsNull(oDoc) Then Exit Sub
    If Not HasUnoInterfaces(oDoc, "com.sun.star.lang.XServiceInfo") Then
        MsgBox "Geen rekenblad actief.", 16, "Losse groente toevoegen"
        Exit Sub
    End If
    If Not oDoc.supportsService("com.sun.star.sheet.SpreadsheetDocument") Then
        MsgBox "Geen rekenblad actief.", 16, "Losse groente toevoegen"
        Exit Sub
    End If
    If Not oDoc.Sheets.hasByName("Blad2") Then
        MsgBox "Dit lijkt geen weekbestand (geen Blad2-tabblad). Open het " & _
               "weekbestand en start de macro vanuit dat venster.", 16, "Losse groente toevoegen"
        Exit Sub
    End If
    oWk = oDoc.Sheets.getByIndex(0)

    ' --- Eerste vrij groente-slot zoeken in rij 2 (index 1) ---
    Dim iSlot As Integer, iVrij As Integer
    iVrij = -1
    For iSlot = 0 To nGroentSlots - 1
        If Trim(oWk.getCellByPosition(cGroent0 + iSlot, 1).getString()) = "" Then
            iVrij = iSlot
            Exit For
        End If
    Next iSlot
    If iVrij = -1 Then
        MsgBox "Alle 24 groente-slots (Y t/m AV) zijn al gevuld; geen plaats " & _
               "voor een extra losse groente.", 16, "Losse groente toevoegen"
        Exit Sub
    End If

    ' --- Oude-structuur-controle: heeft de afrekening al een formule voor dit slot? ---
    Dim bOud As Boolean : bOud = False
    If oDoc.Sheets.hasByName("afrekening") Then
        If oDoc.Sheets.getByName("afrekening").getCellByPosition(cGroent0 + iVrij, 5).getFormula() = "" Then
            bOud = True
        End If
    End If
    If bOud Then
        If MsgBox("Dit weekbestand is met een oudere versie gemaakt: de afrekening " & _
            "en samenvatting dekken dit slot niet automatisch." & Chr(10) & _
            "Genereer het weekbestand opnieuw voor volledige ondersteuning." & Chr(10) & Chr(10) & _
            "Toch naam en prijs invullen?", 4 + 48, "Losse groente toevoegen") <> 6 Then
            Exit Sub
        End If
    End If

    ' --- Invoer ---
    Dim sNaam As String, sEenheid As String, sPrijsRuw As String
    sNaam = Trim(InputBox("Naam van de losse groente:", "Losse groente toevoegen"))
    If sNaam = "" Then Exit Sub

    ' Dubbele naam? (al aanwezig in een ander slot)
    For iSlot = 0 To nGroentSlots - 1
        If LCase(Trim(oWk.getCellByPosition(cGroent0 + iSlot, 1).getString())) = LCase(sNaam) Then
            If MsgBox("'" & sNaam & "' staat al in kolom " & KolomLetter(cGroent0 + iSlot) & _
                ". Toch een tweede kolom toevoegen?", 4 + 48, "Losse groente toevoegen") <> 6 Then
                Exit Sub
            End If
            Exit For
        End If
    Next iSlot

    sEenheid = Trim(InputBox("Eenheid (bv. kg, 300g, bussel) - mag leeg:", "Losse groente toevoegen"))

    sPrijsRuw = Trim(InputBox("Prijs per eenheid (bv. 5,00):", "Losse groente toevoegen"))
    If sPrijsRuw = "" Then Exit Sub
    Dim dPrijs As Double, bPrijsOk As Boolean
    dPrijs = 0
    On Error Resume Next
    dPrijs = CDbl(Replace(sPrijsRuw, ".", ","))
    bPrijsOk = (Err = 0)
    On Error GoTo Fout
    If Not bPrijsOk Then
        MsgBox "Ongeldige prijs: " & sPrijsRuw, 16, "Losse groente toevoegen"
        Exit Sub
    End If

    Dim bPerStuk As Boolean : bPerStuk = False
    If sEenheid <> "" Then
        bPerStuk = (MsgBox("Wordt deze groente per stuk verkocht?" & Chr(10) & _
            "(Ja = per stuk, bv. 'x " & sEenheid & "';  Nee = per " & sEenheid & ")", _
            4 + 32, "Losse groente toevoegen") = 6)
    End If

    ' --- Wegschrijven ---
    ' Naam in rij 2 (index 1)
    oWk.getCellByPosition(cGroent0 + iVrij, 1).setString(sNaam)

    ' Prijs in rij 3 (index 2), opgemaakt als "0,00 EUR / <eenheid>"
    Dim oCel As Object : oCel = oWk.getCellByPosition(cGroent0 + iVrij, 2)
    oCel.setValue(dPrijs)
    Dim oFmts As Object, nFmt As Long, sFmt As String
    Dim oLoc As New com.sun.star.lang.Locale
    oLoc.Language = "nl" : oLoc.Country = "BE"
    oFmts = oDoc.getNumberFormats()
    If sEenheid = "" Then
        sFmt = "0,00"" " & Chr(8364) & """"
    Else
        sFmt = "0,00"" " & Chr(8364) & " / " & sEenheid & """"
    End If
    nFmt = oFmts.queryKey(sFmt, oLoc, False)
    If nFmt = -1 Then nFmt = oFmts.addNew(sFmt, oLoc)
    oCel.NumberFormat = nFmt

    ' Eenheid-metadata in Blad2 (identiek aan MaakWeekbestand):
    '   kolom I (index 8), rij = slot   -> "x "-prefix     (samenvatting, maandafrekening, overzichten)
    '   rij 100 (index 99), kolom = slot -> Chr(215)-prefix (afrekening-detail)
    Dim oBlad2 As Object : oBlad2 = oDoc.Sheets.getByName("Blad2")
    oBlad2.getCellByPosition(8, iVrij).setString(IIf(bPerStuk, "x ", "") & sEenheid)
    oBlad2.getCellByPosition(iVrij, 99).setString(IIf(bPerStuk, Chr(215) & " ", "") & sEenheid)

    oDoc.calculateAll()

    MsgBox "Losse groente toegevoegd in kolom " & KolomLetter(cGroent0 + iVrij) & ":" & Chr(10) & _
           "   " & sNaam & " - " & oCel.getString() & Chr(10) & Chr(10) & _
           "Vul nu bij de klanten de hoeveelheden in; afrekening en samenvatting lopen mee.", _
           64, "Losse groente toevoegen"
    Exit Sub

Fout:
    MsgBox "Fout: " & Err & " - " & Error, 16, "Losse groente toevoegen"
End Sub

' =============================================
' Zet per losse-groente-slot (Y..AV, rij 2-3) een invoerhulp-tooltip die de
' gebruiker wijst op de macro VoegLosseGroenteToe. Beperkt de invoer niet.
' De tooltip staat ENKEL op lege slots (naamcel rij 2 leeg); gevulde slots
' krijgen geen hint. Roep opnieuw aan na het vullen om te verversen.
' Wordt aangeroepen door MaakWeekbestand zodat elk nieuw weekbestand de hint
' heeft (handmatig instellen verdwijnt bij hergenereren).
' =============================================
Sub ZetLosseGroenteTip(oWk As Object)
    Const cGroent0     = 24   ' eerste groente-kolom (Y)
    Const nGroentSlots = 24   ' slots Y..AV
    Dim iSlot As Integer, oCells As Object, oVal As Object, bLeeg As Boolean
    For iSlot = 0 To nGroentSlots - 1
        ' sub-bereik = naam (rij 2) + prijs (rij 3) van dit slot
        oCells = oWk.getCellRangeByPosition(cGroent0 + iSlot, 1, cGroent0 + iSlot, 2)
        bLeeg  = (Trim(oWk.getCellByPosition(cGroent0 + iSlot, 1).getString()) = "")
        oVal = oCells.Validation
        oVal.Type = com.sun.star.sheet.ValidationType.ANY   ' geen invoerbeperking, enkel hint
        If bLeeg Then
            oVal.ShowInputMessage = True
            oVal.InputTitle   = "Gebruik de macro"
            oVal.InputMessage = "Typ losse groenten hier niet handmatig in." & Chr(10) & _
                "Start de macro VoegLosseGroenteToe: die zet ook de prijsopmaak, " & _
                "de eenheid-metadata in Blad2 en laat de afrekening/samenvatting meelopen."
        Else
            oVal.ShowInputMessage = False
        End If
        oCells.Validation = oVal      ' terugzetten = verplicht, anders geen effect
    Next iSlot
End Sub

Sub PasRijOpmaakToe(oSheet As Object, rIdx As Integer, _
                    clBG As Long, bVet As Boolean, _
                    cGroent0 As Integer, cAangep As Integer, _
                    cGeen As Integer, cWeg0 As Integer, nWeg As Integer, _
                    clGroentBG As Long, clWegBG As Long)

    Dim cIdx As Integer
    Dim oC As Object
    Dim nTotKol As Integer
    nTotKol = cWeg0 + nWeg

    For cIdx = 0 To nTotKol - 1
        oC = oSheet.getCellByPosition(cIdx, rIdx)
        oC.CharHeight    = 10
        oC.IsTextWrapped = True
        oC.VertJustify   = com.sun.star.table.CellVertJustify2.TOP
        oC.HoriJustify   = com.sun.star.table.CellHoriJustify.LEFT
        If bVet Then
            oC.CharWeight = com.sun.star.awt.FontWeight.BOLD
        Else
            oC.CharWeight = com.sun.star.awt.FontWeight.NORMAL
        End If
        ' Achtergrond: weg/synthese=clWegBG, groente+ander=clGroentBG, overig=clBG
        If cIdx >= cWeg0 Or cIdx = cGeen Then
            oC.CellBackColor = clWegBG
        ElseIf cIdx >= cGroent0 And cIdx < cAangep Then
            oC.CellBackColor = clGroentBG
        Else
            oC.CellBackColor = clBG
        End If
    Next cIdx
End Sub

' =============================================
' 0-indexed kolomnummer → spreadsheet kolomletter (A, B, ..., Z, AA, ...)
' =============================================
Function KolomLetter(iCol As Integer) As String
    Dim iH As Integer, iL As Integer
    iL = iCol Mod 26
    iH = iCol \ 26
    If iH = 0 Then
        KolomLetter = Chr(65 + iL)
    Else
        KolomLetter = Chr(64 + iH) & Chr(65 + iL)
    End If
End Function

' Basismap voor een gegeven jaar: <SAVE_MAP>\Samenstelling en bestellingen <jaar>\
' Sinds 2026 worden week-submappen en maandafrekeningen per jaar gegroepeerd.
' Maakt de jaarmap aan als ze nog niet bestaat (MkDir doet maar één niveau,
' dus dit moet gebeuren vóór het aanmaken van <jaar>_week_<wk>-submappen erin).
Function JaarMap(iJaar As Integer) As String
    Const SAVE_MAP As String = "C:\Users\klaas\Documents\Zaak\Afzet\Samenstelling en bestellingen\"
    Dim sMap As String
    sMap = SAVE_MAP & "Samenstelling en bestellingen " & iJaar & "\"
    If Not FileExists(sMap) Then MkDir(sMap)
    JaarMap = sMap
End Function

' =============================================
' Kolomindex in klanten_beheer voor veldindex vi (0-15).
' Kolom K (index 10) is gereserveerd voor gebruikersformules.
'   vi 0-4  → col 5-9  (F t/m J)
'   vi 5-15 → col 11-21 (L t/m V)
' =============================================
Function KBKolom(vi As Integer) As Integer
    If vi < 5 Then
        KBKolom = 5 + vi
    Else
        KBKolom = 6 + vi
    End If
End Function

' =============================================
' Helper: SQL-veilige string (single-quotes escapen; leeg → NULL)
' =============================================
Function SqlStr(s As String) As String
    If s = "" Then
        SqlStr = "NULL"
    Else
        SqlStr = "'" & Replace(s, "'", "''") & "'"
    End If
End Function

Sub SchrijfWijzigingenTerug()

    ' =============================================
    ' Kiemkracht - Klantwijzigingen terugschrijven
    ' Vergelijkt klanten_beheer (kol C=id, F-U=data) met klanten-tabblad.
    ' Stuurt alleen UPDATE voor rijen die werkelijk gewijzigd zijn.
    ' =============================================

    ' DB-verbinding: zie MaakDBVerbinding()

    ' Actief kiemkracht-data-bestand bepalen (prod of dev volgt dit bestand)
    Dim oDoc As Object
    oDoc = HuidigDataDocument()
    If IsNull(oDoc) Then
        MsgBox "Geen kiemkracht-data-bestand actief. Open kiemkracht-data.ods " & _
               "of kiemkracht-data-dev.ods en start de macro vanuit dat venster.", 16, "Fout"
        Exit Sub
    End If

    If Not oDoc.Sheets.hasByName("klanten_beheer") Then
        MsgBox "Tabblad 'klanten_beheer' niet gevonden.", 16, "Fout"
        Exit Sub
    End If
    If Not oDoc.Sheets.hasByName("klanten") Then
        MsgBox "Tabblad 'klanten' niet gevonden. Voer eerst LaadAlleTabellen uit.", 16, "Fout"
        Exit Sub
    End If

    Dim oKB      As Object : oKB      = oDoc.Sheets.getByName("klanten_beheer")
    Dim oKlanten As Object : oKlanten = oDoc.Sheets.getByName("klanten")

    ' === Popup 1 ===
    Dim nAntw As Integer
    nAntw = MsgBox( _
        "Opgelet: deze actie overschrijft de klantgegevens in de database." & Chr(10) & Chr(10) & _
        "Heb je recent alle tabellen geladen zodat er geen onbedoelde wijzigingen gebeuren?", _
        1, "SchrijfWijzigingenTerug")
    If nAntw <> 1 Then Exit Sub

    ' === Stap 1: klanten-tabblad header → kolom-indices (geen SSH nodig) ===
    Dim veldNamen(15) As String
    veldNamen(0)  = "voornaam"         : veldNamen(1)  = "familienaam"
    veldNamen(2)  = "voornaam2"        : veldNamen(3)  = "familienaam2"
    veldNamen(4)  = "afhaalpunt_id"    : veldNamen(5)  = "type"
    veldNamen(6)  = "formaat"          : veldNamen(7)  = "email1"
    veldNamen(8)  = "email2"           : veldNamen(9)  = "email3"
    veldNamen(10) = "email4"           : veldNamen(11) = "telefoon"
    veldNamen(12) = "opmerkingen"      : veldNamen(13) = "opmerkingen_volgend"
    veldNamen(14) = "opmerking_status" : veldNamen(15) = "nooit_groenten"

    Dim klantenIdCol As Integer : klantenIdCol = -1
    Dim kVeldCol(15) As Integer
    Dim vi As Integer
    For vi = 0 To 15 : kVeldCol(vi) = -1 : Next vi

    Dim hIdx As Integer : hIdx = 0
    Do While oKlanten.getCellByPosition(hIdx, 0).getString() <> ""
        Dim hNaam As String : hNaam = oKlanten.getCellByPosition(hIdx, 0).getString()
        If hNaam = "id" Then klantenIdCol = hIdx
        For vi = 0 To 15
            If hNaam = veldNamen(vi) Then kVeldCol(vi) = hIdx
        Next vi
        hIdx = hIdx + 1
    Loop

    If klantenIdCol = -1 Then
        MsgBox "Kolom 'id' niet gevonden in tabblad klanten." & Chr(10) & _
               "Voer eerst LaadAlleTabellen uit.", 16, "Fout"
        Exit Sub
    End If

    ' === Stap 2: klanten-tabblad in arrays laden ===
    Dim kID(2000)       As Long
    Dim kVals(2000, 15) As String
    Dim nKlanten As Integer : nKlanten = 0
    Dim kr As Integer : kr = 1
    Do While oKlanten.getCellByPosition(klantenIdCol, kr).getString() <> ""
        kID(nKlanten) = CLng(oKlanten.getCellByPosition(klantenIdCol, kr).getValue())
        For vi = 0 To 15
            If kVeldCol(vi) >= 0 Then
                If vi = 4 Then
                    If oKlanten.getCellByPosition(kVeldCol(vi), kr).getString() = "" Then
                        kVals(nKlanten, vi) = ""
                    Else
                        Dim dAfhaal As Double
                        dAfhaal = oKlanten.getCellByPosition(kVeldCol(vi), kr).getValue()
                        kVals(nKlanten, vi) = CStr(CLng(dAfhaal))
                    End If
                Else
                    kVals(nKlanten, vi) = Trim(oKlanten.getCellByPosition(kVeldCol(vi), kr).getString())
                End If
            End If
        Next vi
        nKlanten = nKlanten + 1
        kr = kr + 1
    Loop

    ' === Stap 3: pre-pass — vergelijken zonder DB, resultaat opslaan ===
    Dim bGewijzigd(2000) As Boolean
    Dim aKIdx(2000)      As Integer
    Dim nGewijzigd As Integer : nGewijzigd = 0
    Dim nTotaal    As Integer : nTotaal    = 0
    Dim sProblemen As String  : sProblemen = ""
    Dim nProblemen As Integer : nProblemen = 0
    Dim r As Integer : r = 1

    Do While oKB.getCellByPosition(2, r).getValue() <> 0
        Dim nID As Long : nID = CLng(oKB.getCellByPosition(2, r).getValue())

        Dim kIdx As Integer : kIdx = -1
        Dim ki As Integer
        For ki = 0 To nKlanten - 1
            If kID(ki) = nID Then kIdx = ki : Exit For
        Next ki

        Dim bWijz As Boolean : bWijz = (kIdx = -1)
        If Not bWijz Then
            For vi = 0 To 15
                If kVals(kIdx, vi) <> Trim(oKB.getCellByPosition(KBKolom(vi), r).getString()) Then
                    bWijz = True : Exit For
                End If
            Next vi
        End If

        bGewijzigd(r) = bWijz
        aKIdx(r)      = kIdx
        If bWijz Then nGewijzigd = nGewijzigd + 1
        nTotaal = nTotaal + 1

        ' Validatie: een gewijzigde abonnee mag geen leeg formaat hebben — anders
        ' krijgt de klant in het weekbestand geen pakket en toont de landings-
        ' pagina-melding 'klein' bij gebrek aan beter. Liever menselijk laten
        ' kiezen dan stilletjes default zetten.
        If bWijz Then
            Dim sValType_p As String : sValType_p = LCase(Trim(oKB.getCellByPosition(KBKolom(5), r).getString()))
            Dim sValFmt_p  As String : sValFmt_p  = Trim(oKB.getCellByPosition(KBKolom(6), r).getString())
            If (sValType_p = "abonnee" Or Left(sValType_p, 8) = "abonnee-") And sValFmt_p = "" Then
                Dim sValNm_p As String
                sValNm_p = Trim(oKB.getCellByPosition(KBKolom(0), r).getString()) & " " & _
                           Trim(oKB.getCellByPosition(KBKolom(1), r).getString())
                sProblemen = sProblemen & Chr(10) & "  rij " & (r + 1) & ": " & sValNm_p & _
                             " (id " & nID & ", type " & sValType_p & ")"
                nProblemen = nProblemen + 1
            End If
        End If

        r = r + 1
    Loop

    ' Blokkeer als er gewijzigde abonnees zijn zonder formaat
    If nProblemen > 0 Then
        MsgBox nProblemen & " gewijzigde abonnee(s) zonder formaat:" & Chr(10) & sProblemen & Chr(10) & Chr(10) & _
               "Vul de kolom 'formaat' aan met 'klein', 'groot', 'extra-groot' of 'mini' en start de macro opnieuw.", _
               16, "Validatiefout"
        Exit Sub
    End If

    ' === Popup 2: exacte wijzigingstelling ===
    nAntw = MsgBox( _
        "Deze actie zal de gegevens wijzigen van " & nGewijzigd & " klant(en)" & Chr(10) & _
        "(van " & nTotaal & " vergeleken met het klanten-tabblad)." & Chr(10) & Chr(10) & _
        "Akkoord?", _
        1, "SchrijfWijzigingenTerug")
    If nAntw <> 1 Then Exit Sub

    If nGewijzigd = 0 Then
        MsgBox "Geen wijzigingen gevonden. Niets verstuurd.", 64, "SchrijfWijzigingenTerug"
        Exit Sub
    End If

    ' === Pas na bevestiging: DB-verbinding (juiste omgeving) ===
    On Error GoTo VerbindingsFout2
    Dim oConn As Object
    oConn = MaakDBVerbinding()
    On Error GoTo 0

    ' === Stap 4: UPDATE enkel gewijzigde rijen ===
    Dim oStmt As Object : oStmt = oConn.createStatement()
    Dim nUpdates As Integer : nUpdates = 0
    r = 1
    Do While r <= nTotaal
        If bGewijzigd(r) Then
            nID = CLng(oKB.getCellByPosition(2, r).getValue())

            Dim sVoornaam     As String : sVoornaam     = oKB.getCellByPosition(KBKolom(0),  r).getString()
            Dim sFamilienaam  As String : sFamilienaam  = oKB.getCellByPosition(KBKolom(1),  r).getString()
            Dim sVoornaam2    As String : sVoornaam2    = oKB.getCellByPosition(KBKolom(2),  r).getString()
            Dim sFamilienaam2 As String : sFamilienaam2 = oKB.getCellByPosition(KBKolom(3),  r).getString()
            Dim sAfhaalId     As String : sAfhaalId     = Trim(oKB.getCellByPosition(KBKolom(4),  r).getString())
            Dim sType         As String : sType         = oKB.getCellByPosition(KBKolom(5),  r).getString()
            Dim sFormaat      As String : sFormaat      = oKB.getCellByPosition(KBKolom(6),  r).getString()
            Dim sEmail1       As String : sEmail1       = oKB.getCellByPosition(KBKolom(7),  r).getString()
            Dim sEmail2       As String : sEmail2       = oKB.getCellByPosition(KBKolom(8),  r).getString()
            Dim sEmail3       As String : sEmail3       = oKB.getCellByPosition(KBKolom(9),  r).getString()
            Dim sEmail4       As String : sEmail4       = oKB.getCellByPosition(KBKolom(10), r).getString()
            Dim sTelefoon     As String : sTelefoon     = oKB.getCellByPosition(KBKolom(11), r).getString()
            Dim sOpmerk       As String : sOpmerk       = oKB.getCellByPosition(KBKolom(12), r).getString()
            Dim sOpmerkVolg   As String : sOpmerkVolg   = oKB.getCellByPosition(KBKolom(13), r).getString()
            Dim sOpmerkStat   As String : sOpmerkStat   = oKB.getCellByPosition(KBKolom(14), r).getString()
            Dim sNooit        As String : sNooit        = Trim(oKB.getCellByPosition(KBKolom(15), r).getString())

            Dim sAfhaalSql As String
            If sAfhaalId = "" Or Not IsNumeric(sAfhaalId) Then
                sAfhaalSql = "NULL"
            Else
                sAfhaalSql = CStr(CLng(sAfhaalId))
            End If

            Dim sNooitSql As String
            Select Case LCase(sNooit)
                Case "t", "true", "1", "ja"   : sNooitSql = "TRUE"
                Case "f", "false", "0", "nee" : sNooitSql = "FALSE"
                Case Else                      : sNooitSql = "NULL"
            End Select

            ' Relatie-status (klant-niveau) afleiden uit het bewerkte type.
            Dim sStatusKlant As String
            Select Case sType
                Case "stop-tijdelijk"  : sStatusKlant = "gepauzeerd"
                Case "stop-definitief" : sStatusKlant = "gestopt"
                Case "on_hold"         : sStatusKlant = "on_hold"
                Case Else              : sStatusKlant = "actief"   ' abonnee* / weekperweek*
            End Select

            Dim sSQL As String
            sSQL = "UPDATE klanten SET " & _
                   "voornaam = "             & SqlStr(sVoornaam)     & ", " & _
                   "familienaam = "          & SqlStr(sFamilienaam)  & ", " & _
                   "voornaam2 = "            & SqlStr(sVoornaam2)    & ", " & _
                   "familienaam2 = "         & SqlStr(sFamilienaam2) & ", " & _
                   "afhaalpunt_id = "        & sAfhaalSql            & ", " & _
                   "type = "                 & SqlStr(sType)         & ", " & _
                   "formaat = "              & SqlStr(sFormaat)      & ", " & _
                   "status = '"              & sStatusKlant & "', "          & _
                   "email1 = "               & SqlStr(sEmail1)       & ", " & _
                   "email2 = "               & SqlStr(sEmail2)       & ", " & _
                   "email3 = "               & SqlStr(sEmail3)       & ", " & _
                   "email4 = "               & SqlStr(sEmail4)       & ", " & _
                   "telefoon = "             & SqlStr(sTelefoon)     & ", " & _
                   "opmerkingen = "          & SqlStr(sOpmerk)       & ", " & _
                   "opmerkingen_volgend = "  & SqlStr(sOpmerkVolg)   & ", " & _
                   "opmerking_status = "     & SqlStr(sOpmerkStat)   & ", " & _
                   "nooit_groenten = "       & sNooitSql & _
                   " WHERE id = "            & CStr(nID)

            oStmt.executeUpdate(sSQL)
            nUpdates = nUpdates + 1

            ' Primair abonnement synchroniseren met het bewerkte type/formaat.
            ' Enkel bron='primair' wordt aangeraakt; handmatige combo-'extra'-rijen
            ' blijven ongemoeid (klantenbeheer-tabblad is nog niet combo-bewerkbaar — backlog #22).
            oStmt.executeUpdate("DELETE FROM abonnementen WHERE klant_id = " & CStr(nID) & " AND bron = 'primair'")
            If Left(sType, 7) = "abonnee" And _
               (sFormaat = "klein" Or sFormaat = "groot" Or sFormaat = "extra-groot" Or sFormaat = "mini") Then
                Dim sRitmeBeh As String, sStatusBeh As String
                If InStr(sType, "onpare-week") > 0 Then
                    sRitmeBeh = "onpare-week"
                ElseIf InStr(sType, "pare-week") > 0 Then
                    sRitmeBeh = "pare-week"
                Else
                    sRitmeBeh = "wekelijks"
                End If
                If InStr(sType, "-toekomst") > 0 Then sStatusBeh = "toekomst" Else sStatusBeh = "actief"
                oStmt.executeUpdate("INSERT INTO abonnementen " & _
                    "(klant_id, ritme, formaat, status, bron) VALUES (" & _
                    CStr(nID) & ", '" & sRitmeBeh & "', '" & sFormaat & "', '" & sStatusBeh & "', 'primair')")
            End If
        End If
        r = r + 1
    Loop

    oStmt.close()
    oConn.close()

    ' === Stap 5: klanten-sheet bijwerken als nieuwe vergelijkingsbasis ===
    ' Zo herkent de volgende vergelijking een teruggedraaide waarde opnieuw als wijziging.
    Dim rSync As Integer : rSync = 1
    Do While rSync <= nTotaal
        If bGewijzigd(rSync) And aKIdx(rSync) >= 0 Then
            Dim kRow As Integer : kRow = aKIdx(rSync) + 1
            Dim viS As Integer
            For viS = 0 To 15
                If kVeldCol(viS) >= 0 Then
                    If viS = 4 Then
                        Dim sAfhSync As String
                        sAfhSync = Trim(oKB.getCellByPosition(KBKolom(4), rSync).getString())
                        If sAfhSync = "" Or Not IsNumeric(sAfhSync) Then
                            oKlanten.getCellByPosition(kVeldCol(viS), kRow).setString("")
                        Else
                            oKlanten.getCellByPosition(kVeldCol(viS), kRow).setValue(CLng(sAfhSync))
                        End If
                    Else
                        oKlanten.getCellByPosition(kVeldCol(viS), kRow).setString( _
                            oKB.getCellByPosition(KBKolom(viS), rSync).getString())
                    End If
                End If
            Next viS
        End If
        rSync = rSync + 1
    Loop

    MsgBox nUpdates & " klant(en) bijgewerkt in postgres.", 64, "Klaar"
    SluitSSHTunnels()
    Exit Sub

VerbindingsFout2:
    MsgBox "Verbindingsfout: " & Err & " - " & Error & Chr(10) & _
           "Controleer of de SSH-tunnel actief is (poort 5433).", 16, "Fout"
    SluitSSHTunnels()
End Sub

' =============================================
' Helper: LibreOffice datumcel → SQL-string 'YYYY-MM-DD' of NULL
' =============================================
Function SqlDateCell(oCell As Object) As String
    If oCell.getType() = 0 Then
        SqlDateCell = "NULL"
    ElseIf oCell.getType() = 1 Then
        Dim dBase As Date : dBase = CDate("1899-12-30")
        Dim dResult As Date : dResult = dBase + CLng(oCell.getValue())
        SqlDateCell = "'" & Format(dResult, "YYYY-MM-DD") & "'"
    Else
        Dim s As String : s = Trim(oCell.getString())
        If s = "" Then
            SqlDateCell = "NULL"
        Else
            SqlDateCell = "'" & Replace(s, "'", "''") & "'"
        End If
    End If
End Function

' =============================================
' Kiemkracht - Nieuwe klant toevoegen
' Leest gegevens uit tabblad "klant_nieuw" G7:G32
' en voegt een rij in in de postgres-tabel klanten.
' =============================================
Sub VoegNieuweKlantToe()

    Dim oDoc As Object
    oDoc = HuidigDataDocument()
    If IsNull(oDoc) Then
        MsgBox "Geen kiemkracht-data-bestand actief. Open kiemkracht-data.ods " & _
               "of kiemkracht-data-dev.ods en start de macro vanuit dat venster.", 16, "Fout"
        Exit Sub
    End If
    If Not oDoc.Sheets.hasByName("klant_nieuw") Then
        MsgBox "Tabblad 'klant_nieuw' niet gevonden.", 16, "Fout"
        Exit Sub
    End If
    Dim oSheet As Object : oSheet = oDoc.Sheets.getByName("klant_nieuw")

    Const COL_G = 6  ' kolom G = index 6

    ' Rij 7 (index 6) = id → overgeslagen (auto-increment)
    Dim sVoornaam      As String : sVoornaam      = Trim(oSheet.getCellByPosition(COL_G,  7).getString())
    Dim sFamilienaam   As String : sFamilienaam   = Trim(oSheet.getCellByPosition(COL_G,  8).getString())
    Dim sAanspreking   As String : sAanspreking   = Trim(oSheet.getCellByPosition(COL_G,  9).getString())
    Dim sKlantType     As String : sKlantType     = Trim(oSheet.getCellByPosition(COL_G, 10).getString())
    Dim sBedrijfsnaam  As String : sBedrijfsnaam  = Trim(oSheet.getCellByPosition(COL_G, 11).getString())
    Dim sBtwNummer     As String : sBtwNummer     = Trim(oSheet.getCellByPosition(COL_G, 12).getString())
    Dim sFactAdres     As String : sFactAdres     = Trim(oSheet.getCellByPosition(COL_G, 13).getString())
    Dim sEmail1        As String : sEmail1        = Trim(oSheet.getCellByPosition(COL_G, 14).getString())
    Dim sEmail2        As String : sEmail2        = Trim(oSheet.getCellByPosition(COL_G, 15).getString())
    Dim sEmail3        As String : sEmail3        = Trim(oSheet.getCellByPosition(COL_G, 16).getString())
    Dim sEmail4        As String : sEmail4        = Trim(oSheet.getCellByPosition(COL_G, 17).getString())
    Dim sTelefoon      As String : sTelefoon      = Trim(oSheet.getCellByPosition(COL_G, 18).getString())
    Dim sType          As String : sType          = Trim(oSheet.getCellByPosition(COL_G, 19).getString())
    Dim sFormaat       As String : sFormaat       = Trim(oSheet.getCellByPosition(COL_G, 20).getString())
    Dim sAfhaalpuntId  As String : sAfhaalpuntId  = Trim(oSheet.getCellByPosition(COL_G, 21).getString())
    Dim sNooitGroenten As String : sNooitGroenten = Trim(oSheet.getCellByPosition(COL_G, 22).getString())
    ' Rij 24-25 = datumvelden (type VALUE als celdatum, TEXT als tekst)
    Dim sKlantSindsSql  As String : sKlantSindsSql  = SqlDateCell(oSheet.getCellByPosition(COL_G, 23))
    ' Klant_sinds leeg gelaten? Vul automatisch met vandaag (formaat YYYY-MM-DD).
    If sKlantSindsSql = "NULL" Then
        sKlantSindsSql = "'" & Format(Now(), "YYYY-MM-DD") & "'"
    End If
    Dim sLaatsteBestSql As String : sLaatsteBestSql = SqlDateCell(oSheet.getCellByPosition(COL_G, 24))
    Dim sOpmerkingen   As String : sOpmerkingen   = Trim(oSheet.getCellByPosition(COL_G, 25).getString())
    Dim sOpmerkVolg    As String : sOpmerkVolg    = Trim(oSheet.getCellByPosition(COL_G, 26).getString())
    Dim sOpmerkStat    As String : sOpmerkStat    = Trim(oSheet.getCellByPosition(COL_G, 27).getString())
    ' Rij 29-30 (index 28-29) = aangemaakt_op / gewijzigd_op → overgeslagen (DEFAULT now())
    Dim sVoornaam2     As String : sVoornaam2     = Trim(oSheet.getCellByPosition(COL_G, 30).getString())
    Dim sFamilienaam2  As String : sFamilienaam2  = Trim(oSheet.getCellByPosition(COL_G, 31).getString())

    ' Verplichte velden
    If sVoornaam = "" Then
        MsgBox "Voornaam is verplicht (G8).", 16, "Validatiefout"
        Exit Sub
    End If
    If sType = "" Then
        MsgBox "Type is verplicht (G20): bv. 'abonnee', 'weekperweek', 'stop-definitief'.", 16, "Validatiefout"
        Exit Sub
    End If
    ' Formaat verplicht voor abonnees: anders krijgt de klant in het weekbestand
    ' geen pakket toegewezen ('CASE k.formaat WHEN ... ELSE ""' in MaakWeekbestand)
    ' en toont haar landingspagina-melding 'klein' bij gebrek aan beter (fallback
    ' op de frontend). Liever menselijk laten kiezen dan stilletjes default zetten.
    Dim sTypeLC As String : sTypeLC = LCase(sType)
    Dim bIsAbonnee As Boolean
    bIsAbonnee = (sTypeLC = "abonnee" Or Left(sTypeLC, 8) = "abonnee-")
    If bIsAbonnee And sFormaat = "" Then
        MsgBox "Formaat is verplicht voor een abonnee (G21):" & Chr(10) & _
               "kies 'klein', 'groot', 'extra-groot' of 'mini'.", 16, "Validatiefout"
        Exit Sub
    End If
    If sAanspreking = "" Then sAanspreking = "jouw"
    If sKlantType   = "" Then sKlantType   = "particulier"

    ' Relatie-status (klant-niveau) afleiden uit het type.
    Dim sStatusKlant As String
    Select Case sTypeLC
        Case "stop-tijdelijk"  : sStatusKlant = "gepauzeerd"
        Case "stop-definitief" : sStatusKlant = "gestopt"
        Case "on_hold"         : sStatusKlant = "on_hold"
        Case Else              : sStatusKlant = "actief"   ' abonnee* / weekperweek*
    End Select

    ' afhaalpunt_id: integer of NULL
    Dim sAfhaalpuntSql As String
    If sAfhaalpuntId = "" Then
        sAfhaalpuntSql = "NULL"
    Else
        On Error GoTo AfhaalpuntFout
        sAfhaalpuntSql = CStr(CLng(sAfhaalpuntId))
        On Error GoTo 0
    End If

    ' Bevestiging
    Dim sInfo As String
    sInfo = "Naam:   " & sVoornaam & " " & sFamilienaam & Chr(10) & _
            "Email:  " & sEmail1 & Chr(10) & _
            "Type:   " & sType & " / " & sKlantType
    If MsgBox("Nieuwe klant toevoegen?" & Chr(10) & Chr(10) & sInfo, 33, "Bevestig") <> 1 Then
        Exit Sub
    End If

    On Error GoTo VerbindingsFout3
    Dim oConn As Object
    oConn = MaakDBVerbinding()
    Dim oStmt As Object : oStmt = oConn.createStatement()

    Dim sSQL As String
    sSQL = "INSERT INTO klanten " & _
           "(voornaam, familienaam, aanspreking, klant_type, bedrijfsnaam, btw_nummer, " & _
           "facturatie_adres, email1, email2, email3, email4, telefoon, type, formaat, status, " & _
           "afhaalpunt_id, nooit_groenten, klant_sinds, laatste_bestelling, " & _
           "opmerkingen, opmerkingen_volgend, opmerking_status, voornaam2, familienaam2) " & _
           "VALUES (" & _
           SqlStr(sVoornaam)      & ", " & SqlStr(sFamilienaam)  & ", " & SqlStr(sAanspreking) & ", " & _
           SqlStr(sKlantType)     & ", " & SqlStr(sBedrijfsnaam) & ", " & SqlStr(sBtwNummer)   & ", " & _
           SqlStr(sFactAdres)     & ", " & SqlStr(sEmail1)       & ", " & SqlStr(sEmail2)       & ", " & _
           SqlStr(sEmail3)        & ", " & SqlStr(sEmail4)       & ", " & SqlStr(sTelefoon)     & ", " & _
           SqlStr(sType)          & ", " & SqlStr(sFormaat)      & ", '" & sStatusKlant & "', " & _
           sAfhaalpuntSql         & ", " & SqlStr(sNooitGroenten) & ", " & _
           sKlantSindsSql         & ", " & sLaatsteBestSql        & ", " & _
           SqlStr(sOpmerkingen)   & ", " & SqlStr(sOpmerkVolg)   & ", " & SqlStr(sOpmerkStat)  & ", " & _
           SqlStr(sVoornaam2)     & ", " & SqlStr(sFamilienaam2) & _
           ") RETURNING id"

    ' RETURNING id zodat we meteen het primaire abonnement kunnen aanmaken.
    Dim oRSNew As Object : oRSNew = oStmt.executeQuery(sSQL)
    Dim nNewId As Long : nNewId = 0
    If oRSNew.next() Then nNewId = CLng(oRSNew.getString(1))
    oRSNew.close()

    ' Primair abonnement voor een nieuwe abonnee (formaat is hierboven verplicht gesteld).
    If bIsAbonnee And nNewId > 0 And _
       (sFormaat = "klein" Or sFormaat = "groot" Or sFormaat = "extra-groot" Or sFormaat = "mini") Then
        Dim sRitmeNw As String, sStatusNw As String
        If InStr(sTypeLC, "onpare-week") > 0 Then
            sRitmeNw = "onpare-week"
        ElseIf InStr(sTypeLC, "pare-week") > 0 Then
            sRitmeNw = "pare-week"
        Else
            sRitmeNw = "wekelijks"
        End If
        If InStr(sTypeLC, "-toekomst") > 0 Then sStatusNw = "toekomst" Else sStatusNw = "actief"
        oStmt.executeUpdate("INSERT INTO abonnementen " & _
            "(klant_id, ritme, formaat, status, bron) VALUES (" & _
            CStr(nNewId) & ", '" & sRitmeNw & "', '" & sFormaat & "', '" & sStatusNw & "', 'primair')")
    End If

    oStmt.close()
    oConn.close()
    SluitSSHTunnels()

    MsgBox "Klant '" & sVoornaam & " " & sFamilienaam & "' succesvol toegevoegd.", 64, "Klaar"

    ' Invoervelden leegmaken
    Dim iRij As Integer
    For iRij = 7 To 31
        oSheet.getCellByPosition(COL_G, iRij).setString("")
    Next iRij

    Exit Sub

AfhaalpuntFout:
    MsgBox "Afhaalpunt_id (G22) moet een geheel getal zijn of leeg.", 16, "Validatiefout"
    Exit Sub

VerbindingsFout3:
    MsgBox "Databasefout: " & Err & " - " & Error, 16, "Fout"
    SluitSSHTunnels()

End Sub

' =============================================
' Helper: ISO-weeknummer (1-53) van een datum.
' =============================================
Function ISOWeek(d As Date) As Integer
    ' Donderdag van de week waarin d valt (WeekDay type 2: ma=1 .. zo=7)
    Dim dThu As Date : dThu = d - (WeekDay(d, 2) - 1) + 3
    Dim dJan1 As Date : dJan1 = DateSerial(Year(dThu), 1, 1)
    ' Dagen van 1 januari tot de eerste donderdag van dat jaar
    Dim iOffset As Integer : iOffset = (4 - WeekDay(dJan1, 2) + 7) Mod 7
    Dim dEersteDo As Date : dEersteDo = dJan1 + iOffset
    ISOWeek = (dThu - dEersteDo) \ 7 + 1
End Function

' =============================================
' Helper: donderdag-datum van het eerstvolgende voorkomen
' van ISO-weeknummer iWeek, gerekend vanaf vandaag.
' Geeft 0 als het weeknummer niet gevonden wordt.
' =============================================
Function WeekNaarDonderdag(iWeek As Integer) As Date
    Dim dToday As Date : dToday = Date
    Dim dThuNu As Date : dThuNu = dToday - (WeekDay(dToday, 2) - 1) + 3
    Dim n As Integer
    For n = 0 To 60
        Dim dCand As Date : dCand = dThuNu + 7 * n
        If ISOWeek(dCand) = iWeek Then
            WeekNaarDonderdag = dCand
            Exit Function
        End If
    Next n
    WeekNaarDonderdag = 0
End Function

' =============================================
' Helper: parseert weekinvoer "W22-W24, W26" naar een
' CSV-string van weeknummers "22,23,24,26".
'   bEnkel = True  -> slechts één week toegelaten (stop/start)
' Lege invoer -> "". Bij een fout -> "" en sFout ingevuld.
' =============================================
' Parseert week-met-optioneel-formaat invoer voor vooruitbestellingen.
' Syntax: "W22-W24:groot, W26:klein, W28" (W is optioneel, hoofdletter
' ongevoelig, spaties genegeerd). Formaat per week optioneel — zonder
' ":formaat" blijft de overeenkomstige slot in sFormatenCsv leeg, waarna
' de caller terugvalt op klant.formaat.
'
' ByRef-resultaten zijn parallelle CSV's:
'   sWekenCsv     = "22,23,24,26,28"
'   sFormatenCsv  = "groot,groot,groot,klein,"        (leeg = default)
'
' Returnt True bij succes, False bij fout (sFout krijgt dan een
' leesbare boodschap).
Function ParseerWekenMetFormaat(sInvoer As String, _
                                 ByRef sWekenCsv As String, _
                                 ByRef sFormatenCsv As String, _
                                 ByRef sFout As String) As Boolean
    sFout = ""
    sWekenCsv = ""
    sFormatenCsv = ""
    Dim s As String : s = Trim(sInvoer)
    If s = "" Then
        ParseerWekenMetFormaat = True
        Exit Function
    End If
    s = Replace(s, " ", "")

    Dim aDelen() As String : aDelen = Split(s, ",")
    Dim i As Integer
    For i = 0 To UBound(aDelen)
        Dim sDeel As String : sDeel = aDelen(i)
        If sDeel <> "" Then
            ' Splits op ":" — formaat optioneel
            Dim sWeekDeel As String, sFormaat As String
            Dim iColon As Integer : iColon = InStr(sDeel, ":")
            If iColon > 0 Then
                sWeekDeel = Left(sDeel, iColon - 1)
                sFormaat  = LCase(Mid(sDeel, iColon + 1))
                If sFormaat <> "klein" And sFormaat <> "groot" _
                   And sFormaat <> "extra-groot" And sFormaat <> "mini" Then
                    sFout = "ongeldig formaat '" & sFormaat & _
                            "' (klein/groot/extra-groot/mini)"
                    ParseerWekenMetFormaat = False : Exit Function
                End If
            Else
                sWeekDeel = sDeel
                sFormaat  = ""
            End If

            sWeekDeel = Replace(sWeekDeel, "W", "")
            sWeekDeel = Replace(sWeekDeel, "w", "")

            If InStr(sWeekDeel, "-") > 0 Then
                Dim aR() As String : aR = Split(sWeekDeel, "-")
                If UBound(aR) <> 1 Or Not IsNumeric(aR(0)) Or Not IsNumeric(aR(1)) Then
                    sFout = "ongeldig bereik '" & sWeekDeel & "'"
                    ParseerWekenMetFormaat = False : Exit Function
                End If
                Dim wVan As Integer : wVan = CInt(aR(0))
                Dim wTot As Integer : wTot = CInt(aR(1))
                If wVan < 1 Or wVan > 53 Or wTot < 1 Or wTot > 53 Then
                    sFout = "weeknummer buiten 1-53 in '" & sWeekDeel & "'"
                    ParseerWekenMetFormaat = False : Exit Function
                End If
                If wTot < wVan Then
                    sFout = "bereik '" & sWeekDeel & "' loopt over een jaargrens — splits het op"
                    ParseerWekenMetFormaat = False : Exit Function
                End If
                Dim w As Integer
                For w = wVan To wTot
                    If sWekenCsv <> "" Then
                        sWekenCsv    = sWekenCsv    & ","
                        sFormatenCsv = sFormatenCsv & ","
                    End If
                    sWekenCsv    = sWekenCsv    & CStr(w)
                    sFormatenCsv = sFormatenCsv & sFormaat
                Next w
            Else
                If Not IsNumeric(sWeekDeel) Then
                    sFout = "ongeldig weeknummer '" & sWeekDeel & "'"
                    ParseerWekenMetFormaat = False : Exit Function
                End If
                Dim wE As Integer : wE = CInt(sWeekDeel)
                If wE < 1 Or wE > 53 Then
                    sFout = "weeknummer buiten 1-53: '" & sWeekDeel & "'"
                    ParseerWekenMetFormaat = False : Exit Function
                End If
                If sWekenCsv <> "" Then
                    sWekenCsv    = sWekenCsv    & ","
                    sFormatenCsv = sFormatenCsv & ","
                End If
                sWekenCsv    = sWekenCsv    & CStr(wE)
                sFormatenCsv = sFormatenCsv & sFormaat
            End If
        End If
    Next i

    ParseerWekenMetFormaat = True
End Function

Function ParseerWeken(sInvoer As String, bEnkel As Boolean, ByRef sFout As String) As String
    sFout = ""
    Dim s As String : s = Trim(sInvoer)
    If s = "" Then
        ParseerWeken = ""
        Exit Function
    End If
    s = Replace(s, "W", "")
    s = Replace(s, "w", "")
    s = Replace(s, " ", "")

    Dim aDelen() As String : aDelen = Split(s, ",")
    If bEnkel And UBound(aDelen) > 0 Then
        sFout = "hier mag maar één week staan"
        ParseerWeken = ""
        Exit Function
    End If

    Dim sResult As String : sResult = ""
    Dim i As Integer
    For i = 0 To UBound(aDelen)
        Dim sDeel As String : sDeel = aDelen(i)
        If sDeel = "" Then
            ' lege sectie (dubbele komma) negeren
        ElseIf InStr(sDeel, "-") > 0 Then
            If bEnkel Then
                sFout = "hier mag geen bereik staan"
                ParseerWeken = "" : Exit Function
            End If
            Dim aR() As String : aR = Split(sDeel, "-")
            If UBound(aR) <> 1 Or Not IsNumeric(aR(0)) Or Not IsNumeric(aR(1)) Then
                sFout = "ongeldig bereik '" & sDeel & "'"
                ParseerWeken = "" : Exit Function
            End If
            Dim wVan As Integer : wVan = CInt(aR(0))
            Dim wTot As Integer : wTot = CInt(aR(1))
            If wVan < 1 Or wVan > 53 Or wTot < 1 Or wTot > 53 Then
                sFout = "weeknummer buiten 1-53 in '" & sDeel & "'"
                ParseerWeken = "" : Exit Function
            End If
            If wTot < wVan Then
                sFout = "bereik '" & sDeel & "' loopt over een jaargrens — splits het op"
                ParseerWeken = "" : Exit Function
            End If
            Dim w As Integer
            For w = wVan To wTot
                If sResult <> "" Then sResult = sResult & ","
                sResult = sResult & CStr(w)
            Next w
        Else
            If Not IsNumeric(sDeel) Then
                sFout = "ongeldig weeknummer '" & sDeel & "'"
                ParseerWeken = "" : Exit Function
            End If
            Dim wE As Integer : wE = CInt(sDeel)
            If wE < 1 Or wE > 53 Then
                sFout = "weeknummer buiten 1-53: '" & sDeel & "'"
                ParseerWeken = "" : Exit Function
            End If
            If sResult <> "" Then sResult = sResult & ","
            sResult = sResult & CStr(wE)
        End If
    Next i
    ParseerWeken = sResult
End Function

' =============================================
' Kiemkracht - Annulaties / stopzetting / vooruitbestellingen
'               / abonnementstart verwerken
' Tabblad "klanten_stop_start":
'   - kolommen A-P : formules met klantgegevens, één rij per klant
'                    (rij 1 = weeklegende, rij 2 = kolomhoofden, data vanaf rij 7)
'   - één kolom in A-P heeft de kop "klant_id"
'   - kolom Q = annulaties           (tekst, bv. "W22-W24, W26")
'   - kolom R = stopzetting          (één week,  bv. "W30")
'   - kolom S = vooruitbestellingen  (tekst, bv. "W22-W24:groot, W26:klein, W28")
'               Formaat per week optioneel (na ":"); zonder formaat valt
'               het terug op klant.formaat. Geldige formaten: klein /
'               groot / extra-groot / mini.
'   - kolom T = start abonnement     (één week,  bv. "W38")
'   - kolom U = abonnementstype      (verplicht bij een start: abonnee /
'               abonnee-pare-week / abonnee-onpare-week)
'   - kolom V = formaat              (verplicht bij een start: klein /
'               groot / extra-groot / mini)
' INSERT't in postgres-tabellen annulaties / vooruitbestellingen.
' Bij een start zet de macro de klant bovendien op een toekomst-
' abonneetype (klanten.type = '<U>-toekomst', formaat = '<V>'); een
' VPS-cron schakelt dat op de startweek om naar het echte type.
' Bestaande (klant_id, jaar, week) worden overgeslagen; de verwerkte
' cellen Q-V worden daarna leeggemaakt.
' =============================================
Sub VerwerkStopStart()

    Const COL_ANN   = 16   ' Q
    Const COL_STOP  = 17   ' R
    Const COL_VB    = 18   ' S
    Const COL_START = 19   ' T
    Const COL_TYPE  = 20   ' U
    Const COL_FORMAAT = 21 ' V
    Const DATA_RIJ0 = 6    ' rij 7 = eerste datarij
    Const MAX_RIJ   = 1000
    Const MAX_ITEM  = 12000

    Dim oDoc As Object
    oDoc = HuidigDataDocument()
    If IsNull(oDoc) Then
        MsgBox "Geen kiemkracht-data-bestand actief. Open kiemkracht-data.ods " & _
               "of kiemkracht-data-dev.ods en start de macro vanuit dat venster.", 16, "Fout"
        Exit Sub
    End If
    If Not oDoc.Sheets.hasByName("klanten_stop_start") Then
        MsgBox "Tabblad 'klanten_stop_start' niet gevonden.", 16, "Fout"
        Exit Sub
    End If
    Dim oSheet As Object : oSheet = oDoc.Sheets.getByName("klanten_stop_start")

    ' --- klant_id-kolom zoeken in de kophoek (rij 1 of 2, kolom A-P) ---
    Dim iIdCol As Integer : iIdCol = -1
    Dim hr As Integer, hc As Integer
    For hr = 0 To 1
        For hc = 0 To 15
            If LCase(Trim(oSheet.getCellByPosition(hc, hr).getString())) = "klant_id" Then
                iIdCol = hc
            End If
        Next hc
    Next hr
    If iIdCol = -1 Then
        MsgBox "Geen kolom met de kop 'klant_id' gevonden in A-P (rij 1 of 2)." & Chr(10) & _
               "Geef één van je formulekolommen die kop.", 16, "Fout"
        Exit Sub
    End If

    ' === Fase 1: invoerrijen verzamelen en parseren ===
    Dim riRij(MAX_RIJ)   As Integer
    Dim riKlant(MAX_RIJ) As Long
    Dim riAnn(MAX_RIJ)   As String
    Dim riStop(MAX_RIJ)  As Integer
    Dim riVb(MAX_RIJ)    As String      ' CSV met weken (bv. "22,23,24,26")
    Dim riVbFmt(MAX_RIJ) As String      ' CSV met formaten parallel aan riVb (lege slot = klant.formaat)
    Dim riStart(MAX_RIJ) As Integer
    Dim riType(MAX_RIJ)  As String
    Dim riFmt(MAX_RIJ)   As String
    Dim nRij As Integer : nRij = 0

    Dim r As Integer
    For r = DATA_RIJ0 To DATA_RIJ0 + MAX_RIJ - 1
        Dim sAnn   As String : sAnn   = Trim(oSheet.getCellByPosition(COL_ANN,   r).getString())
        Dim sStop  As String : sStop  = Trim(oSheet.getCellByPosition(COL_STOP,  r).getString())
        Dim sVb    As String : sVb    = Trim(oSheet.getCellByPosition(COL_VB,    r).getString())
        Dim sStart As String : sStart = Trim(oSheet.getCellByPosition(COL_START, r).getString())

        If sAnn <> "" Or sStop <> "" Or sVb <> "" Or sStart <> "" Then
            Dim dKlant As Double : dKlant = oSheet.getCellByPosition(iIdCol, r).getValue()
            If dKlant < 1 Then
                MsgBox "Rij " & (r + 1) & ": er staat invoer in Q-T maar geen geldig klant_id." & Chr(10) & _
                       "Controleer of je in de juiste rij staat.", 16, "Fout"
                Exit Sub
            End If

            Dim sFout As String
            Dim sAnnCsv   As String : sAnnCsv   = ParseerWeken(sAnn, False, sFout)
            If sFout <> "" Then
                MsgBox "Rij " & (r + 1) & ", kolom Q (annulaties): " & sFout, 16, "Fout"
                Exit Sub
            End If
            Dim sVbCsv As String, sVbFmtCsv As String
            If Not ParseerWekenMetFormaat(sVb, sVbCsv, sVbFmtCsv, sFout) Then
                MsgBox "Rij " & (r + 1) & ", kolom S (vooruitbestellingen): " & sFout, 16, "Fout"
                Exit Sub
            End If
            Dim sStopCsv  As String : sStopCsv  = ParseerWeken(sStop, True, sFout)
            If sFout <> "" Then
                MsgBox "Rij " & (r + 1) & ", kolom R (stopzetting): " & sFout, 16, "Fout"
                Exit Sub
            End If
            Dim sStartCsv As String : sStartCsv = ParseerWeken(sStart, True, sFout)
            If sFout <> "" Then
                MsgBox "Rij " & (r + 1) & ", kolom T (start abonnement): " & sFout, 16, "Fout"
                Exit Sub
            End If

            ' Kolom U (abonnementstype) en V (formaat): verplicht bij een start
            Dim sTypeIn As String : sTypeIn = Trim(oSheet.getCellByPosition(COL_TYPE,    r).getString())
            Dim sFmtIn  As String : sFmtIn  = Trim(oSheet.getCellByPosition(COL_FORMAAT, r).getString())
            If sStart <> "" Then
                If sTypeIn <> "abonnee" And sTypeIn <> "abonnee-pare-week" _
                   And sTypeIn <> "abonnee-onpare-week" Then
                    MsgBox "Rij " & (r + 1) & ", kolom U: een startweek vereist een geldig " & _
                           "abonnementstype:" & Chr(10) & _
                           "abonnee / abonnee-pare-week / abonnee-onpare-week.", 16, "Fout"
                    Exit Sub
                End If
                If sFmtIn <> "klein" And sFmtIn <> "groot" _
                   And sFmtIn <> "extra-groot" And sFmtIn <> "mini" Then
                    MsgBox "Rij " & (r + 1) & ", kolom V: een startweek vereist een geldig " & _
                           "formaat:" & Chr(10) & "klein / groot / extra-groot / mini.", 16, "Fout"
                    Exit Sub
                End If
            ElseIf sTypeIn <> "" Or sFmtIn <> "" Then
                MsgBox "Rij " & (r + 1) & ": type/formaat (kolom U/V) horen bij een " & _
                       "startweek in kolom T. Vul de startweek aan of maak U/V leeg.", 16, "Fout"
                Exit Sub
            End If

            riRij(nRij)   = r
            riKlant(nRij) = CLng(dKlant)
            riAnn(nRij)   = sAnnCsv
            riVb(nRij)    = sVbCsv
            riVbFmt(nRij) = sVbFmtCsv
            riType(nRij)  = sTypeIn
            riFmt(nRij)   = sFmtIn
            If sStopCsv  = "" Then riStop(nRij)  = 0 Else riStop(nRij)  = CInt(sStopCsv)
            If sStartCsv = "" Then riStart(nRij) = 0 Else riStart(nRij) = CInt(sStartCsv)
            nRij = nRij + 1
        End If
    Next r

    If nRij = 0 Then
        MsgBox "Geen invoer gevonden in de kolommen Q-T.", 64, "VerwerkStopStart"
        Exit Sub
    End If

    ' === Fase 2: DB-verbinding + klantgegevens + bestaande records ===
    On Error GoTo VerbindingsFoutSS
    Dim oConn As Object
    oConn = MaakDBVerbinding()
    On Error GoTo 0

    Dim oStmt As Object, oRS As Object

    Dim klId(5000)      As Long
    Dim klVn(5000)      As String
    Dim klVn2(5000)     As String
    Dim klFn(5000)      As String
    Dim klMail(5000)    As String
    Dim klFormaat(5000) As String
    Dim nKl As Integer : nKl = 0
    oStmt = oConn.createStatement()
    oRS = oStmt.executeQuery("SELECT id, voornaam, familienaam, email1, formaat, COALESCE(voornaam2,'') FROM klanten")
    Do While oRS.next()
        klId(nKl)      = CLng(oRS.getString(1))
        klVn(nKl)      = oRS.getString(2)
        klFn(nKl)      = oRS.getString(3)
        klMail(nKl)    = oRS.getString(4)
        klFormaat(nKl) = oRS.getString(5)
        klVn2(nKl)     = oRS.getString(6)
        nKl = nKl + 1
    Loop
    oRS.close() : oStmt.close()

    ' Bestaande (klant_id, jaar, week) als doorzoekbare sleutelreeksen
    Dim sBestAnn As String : sBestAnn = "|"
    oStmt = oConn.createStatement()
    oRS = oStmt.executeQuery("SELECT klant_id, jaar, week_annulatie FROM annulaties " & _
                             "WHERE klant_id IS NOT NULL AND week_annulatie IS NOT NULL")
    Do While oRS.next()
        sBestAnn = sBestAnn & oRS.getString(1) & "#" & oRS.getString(2) & "#" & oRS.getString(3) & "|"
    Loop
    oRS.close() : oStmt.close()

    Dim sBestVb As String : sBestVb = "|"
    oStmt = oConn.createStatement()
    oRS = oStmt.executeQuery("SELECT klant_id, jaar, week_bestelling FROM vooruitbestellingen " & _
                             "WHERE klant_id IS NOT NULL AND week_bestelling IS NOT NULL")
    Do While oRS.next()
        sBestVb = sBestVb & oRS.getString(1) & "#" & oRS.getString(2) & "#" & oRS.getString(3) & "|"
    Loop
    oRS.close() : oStmt.close()

    ' === Fase 3: INSERT-opdrachten opbouwen (jaar/datum berekenen, dubbels filteren) ===
    Dim aSql(MAX_ITEM) As String
    Dim nItem As Integer : nItem = 0
    Dim nAnn As Integer, nStopz As Integer, nVb As Integer, nStart As Integer, nDup As Integer

    ' Mail-eligible records: parallel aan de INSERTs voor Q/R/S/T-kolommen.
    ' Worden later (optioneel, na bevestigingsdialoog) als HTTP-POST verstuurd.
    Dim mEmail(MAX_ITEM)    As String
    Dim mVoor(MAX_ITEM)     As String
    Dim mVoor2(MAX_ITEM)    As String
    Dim mKlantId(MAX_ITEM)  As Long
    Dim mWeek(MAX_ITEM)     As Integer
    Dim mType(MAX_ITEM)     As String    ' "annulatie" / "stopzetting" / "vooruitbestelling" / "abonnementsstart"
    Dim mFormaat(MAX_ITEM)  As String    ' enkel relevant voor vooruitbestelling/abonnementsstart
    Dim mDatum(MAX_ITEM)    As String    ' YYYY-MM-DD
    Dim mJaar(MAX_ITEM)     As Integer
    Dim nMail As Integer : nMail = 0

    Dim i As Integer, k As Integer, kIdx As Integer
    Dim aW() As String, wi As Integer, w As Integer
    Dim dDo As Date, iJaar As Integer
    Dim sSleutel As String, sDatum As String
    Dim sVnQ As String, sFnQ As String, sMailQ As String, sFmtQ As String, sKid As String

    For i = 0 To nRij - 1
        kIdx = -1
        For k = 0 To nKl - 1
            If klId(k) = riKlant(i) Then kIdx = k : Exit For
        Next k
        If kIdx = -1 Then
            oConn.close()
            SluitSSHTunnels()
            MsgBox "Rij " & (riRij(i) + 1) & ": klant_id " & riKlant(i) & _
                   " bestaat niet in de klanten-tabel.", 16, "Fout"
            Exit Sub
        End If

        sVnQ   = SqlStr(klVn(kIdx))
        sFnQ   = SqlStr(klFn(kIdx))
        sMailQ = SqlStr(klMail(kIdx))
        sFmtQ  = SqlStr(klFormaat(kIdx))
        sKid   = CStr(riKlant(i))

        ' --- annulaties (kolom Q) ---
        If riAnn(i) <> "" Then
            aW = Split(riAnn(i), ",")
            For wi = 0 To UBound(aW)
                w = CInt(aW(wi))
                dDo = WeekNaarDonderdag(w)
                iJaar = Year(dDo)
                sDatum = Format(dDo, "YYYY-MM-DD")
                sSleutel = sKid & "#" & iJaar & "#" & w
                If InStr(sBestAnn, "|" & sSleutel & "|") > 0 Then
                    nDup = nDup + 1
                Else
                    aSql(nItem) = "INSERT INTO annulaties " & _
                        "(voornaam, familienaam, klant_email, klant_id, datum, " & _
                        "week_annulatie, week_stopzetten_abonnement, jaar) VALUES (" & _
                        sVnQ & ", " & sFnQ & ", " & sMailQ & ", " & sKid & ", '" & sDatum & "', " & _
                        w & ", NULL, " & iJaar & ")"
                    nItem = nItem + 1
                    sBestAnn = sBestAnn & sSleutel & "|"
                    nAnn = nAnn + 1

                    ' Mail-eligible (alleen als klant een email1 heeft)
                    If klMail(kIdx) <> "" Then
                        mEmail(nMail)    = klMail(kIdx)
                        mVoor(nMail)     = klVn(kIdx)
                        mVoor2(nMail)    = klVn2(kIdx)
                        mKlantId(nMail)  = riKlant(i)
                        mWeek(nMail)     = w
                        mType(nMail)     = "annulatie"
                        mFormaat(nMail)  = ""
                        mDatum(nMail)    = sDatum
                        mJaar(nMail)     = iJaar
                        nMail = nMail + 1
                    End If
                End If
            Next wi
        End If

        ' --- stopzetting (kolom R) ---
        If riStop(i) > 0 Then
            w = riStop(i)
            dDo = WeekNaarDonderdag(w)
            iJaar = Year(dDo)
            sDatum = Format(dDo, "YYYY-MM-DD")
            sSleutel = sKid & "#" & iJaar & "#" & w
            If InStr(sBestAnn, "|" & sSleutel & "|") > 0 Then
                nDup = nDup + 1
            Else
                aSql(nItem) = "INSERT INTO annulaties " & _
                    "(voornaam, familienaam, klant_email, klant_id, datum, " & _
                    "week_annulatie, week_stopzetten_abonnement, jaar) VALUES (" & _
                    sVnQ & ", " & sFnQ & ", " & sMailQ & ", " & sKid & ", '" & sDatum & "', " & _
                    w & ", " & w & ", " & iJaar & ")"
                nItem = nItem + 1
                sBestAnn = sBestAnn & sSleutel & "|"
                nStopz = nStopz + 1

                ' Mail-eligible (alleen als klant een email1 heeft)
                If klMail(kIdx) <> "" Then
                    mEmail(nMail)    = klMail(kIdx)
                    mVoor(nMail)     = klVn(kIdx)
                    mVoor2(nMail)    = klVn2(kIdx)
                    mKlantId(nMail)  = riKlant(i)
                    mWeek(nMail)     = w
                    mType(nMail)     = "stopzetting"
                    mFormaat(nMail)  = ""
                    mDatum(nMail)    = sDatum
                    mJaar(nMail)     = iJaar
                    nMail = nMail + 1
                End If
            End If
        End If

        ' --- vooruitbestellingen (kolom S) ---
        If riVb(i) <> "" Then
            aW = Split(riVb(i), ",")
            Dim aWFmt() As String : aWFmt = Split(riVbFmt(i), ",")
            For wi = 0 To UBound(aW)
                w = CInt(aW(wi))
                dDo = WeekNaarDonderdag(w)
                iJaar = Year(dDo)
                sDatum = Format(dDo, "YYYY-MM-DD")
                sSleutel = sKid & "#" & iJaar & "#" & w
                If InStr(sBestVb, "|" & sSleutel & "|") > 0 Then
                    nDup = nDup + 1
                Else
                    ' Formaat: per-week-keuze (kolom S na ":") of klant.formaat als fallback
                    Dim sFmtVoorWeek As String
                    sFmtVoorWeek = ""
                    If wi <= UBound(aWFmt) Then sFmtVoorWeek = aWFmt(wi)
                    If sFmtVoorWeek = "" Then sFmtVoorWeek = klFormaat(kIdx)
                    Dim sFmtVoorWeekQ As String : sFmtVoorWeekQ = SqlStr(sFmtVoorWeek)

                    aSql(nItem) = "INSERT INTO vooruitbestellingen " & _
                        "(voornaam, familienaam, klant_email, klant_id, formaat, datum, " & _
                        "week_bestelling, week_start_abonnement, jaar) VALUES (" & _
                        sVnQ & ", " & sFnQ & ", " & sMailQ & ", " & sKid & ", " & sFmtVoorWeekQ & ", '" & _
                        sDatum & "', " & w & ", NULL, " & iJaar & ")"
                    nItem = nItem + 1
                    sBestVb = sBestVb & sSleutel & "|"
                    nVb = nVb + 1

                    ' Mail-eligible (alleen als klant een email1 heeft)
                    If klMail(kIdx) <> "" Then
                        mEmail(nMail)    = klMail(kIdx)
                        mVoor(nMail)     = klVn(kIdx)
                        mVoor2(nMail)    = klVn2(kIdx)
                        mKlantId(nMail)  = riKlant(i)
                        mWeek(nMail)     = w
                        mType(nMail)     = "vooruitbestelling"
                        mFormaat(nMail)  = sFmtVoorWeek
                        mDatum(nMail)    = sDatum
                        mJaar(nMail)     = iJaar
                        nMail = nMail + 1
                    End If
                End If
            Next wi
        End If

        ' --- start abonnement (kolom T) ---
        If riStart(i) > 0 Then
            w = riStart(i)
            dDo = WeekNaarDonderdag(w)
            iJaar = Year(dDo)
            sDatum = Format(dDo, "YYYY-MM-DD")
            sSleutel = sKid & "#" & iJaar & "#" & w
            If InStr(sBestVb, "|" & sSleutel & "|") > 0 Then
                nDup = nDup + 1
            Else
                aSql(nItem) = "INSERT INTO vooruitbestellingen " & _
                    "(voornaam, familienaam, klant_email, klant_id, formaat, datum, " & _
                    "week_bestelling, week_start_abonnement, jaar) VALUES (" & _
                    sVnQ & ", " & sFnQ & ", " & sMailQ & ", " & sKid & ", '" & riFmt(i) & "', '" & _
                    sDatum & "', " & w & ", " & w & ", " & iJaar & ")"
                nItem = nItem + 1
                ' Klant in toekomst-toestand zetten; de VPS-cron schakelt om op de startweek
                ' (legacy klanten.type blijft transitie-mirror tot Fase F).
                aSql(nItem) = "UPDATE klanten SET type = '" & riType(i) & "-toekomst', " & _
                    "formaat = '" & riFmt(i) & "' WHERE id = " & sKid
                nItem = nItem + 1
                ' Nieuw model: primair abonnement als toekomst-rij. Combo-'extra'-rijen
                ' blijven ongemoeid (DELETE enkel bron='primair'). De flip-cron zet
                ' status 'toekomst'->'actief' zodra (start_jaar,start_week) bereikt is.
                Dim sRitmeStart As String
                Select Case riType(i)
                    Case "abonnee-pare-week"   : sRitmeStart = "pare-week"
                    Case "abonnee-onpare-week" : sRitmeStart = "onpare-week"
                    Case Else                  : sRitmeStart = "wekelijks"
                End Select
                aSql(nItem) = "DELETE FROM abonnementen WHERE klant_id = " & sKid & " AND bron = 'primair'"
                nItem = nItem + 1
                aSql(nItem) = "INSERT INTO abonnementen " & _
                    "(klant_id, ritme, formaat, status, bron, start_jaar, start_week) VALUES (" & _
                    sKid & ", '" & sRitmeStart & "', '" & riFmt(i) & "', 'toekomst', 'primair', " & _
                    iJaar & ", " & w & ")"
                nItem = nItem + 1
                sBestVb = sBestVb & sSleutel & "|"
                nStart = nStart + 1

                ' Mail-eligible (alleen als klant een email1 heeft)
                If klMail(kIdx) <> "" Then
                    mEmail(nMail)    = klMail(kIdx)
                    mVoor(nMail)     = klVn(kIdx)
                    mVoor2(nMail)    = klVn2(kIdx)
                    mKlantId(nMail)  = riKlant(i)
                    mWeek(nMail)     = w
                    mType(nMail)     = "abonnementsstart"
                    mFormaat(nMail)  = riFmt(i)
                    mDatum(nMail)    = sDatum
                    mJaar(nMail)     = iJaar
                    nMail = nMail + 1
                End If
            End If
        End If
    Next i

    ' === Fase 4: bevestiging (of melding dat alles al bestond) ===
    If nItem = 0 Then
        oConn.close()
        For i = 0 To nRij - 1
            oSheet.getCellByPosition(COL_ANN,   riRij(i)).setString("")
            oSheet.getCellByPosition(COL_STOP,  riRij(i)).setString("")
            oSheet.getCellByPosition(COL_VB,    riRij(i)).setString("")
            oSheet.getCellByPosition(COL_START, riRij(i)).setString("")
        Next i
        SluitSSHTunnels()
        MsgBox "Alle " & nDup & " ingevoerde week(en) stonden al in de database." & Chr(10) & _
               "De invoercellen zijn leeggemaakt.", 64, "VerwerkStopStart"
        Exit Sub
    End If

    Dim sVraag As String
    sVraag = "Te verwerken in de database:" & Chr(10) & Chr(10) & _
             "  Annulaties:           " & nAnn   & Chr(10) & _
             "  Stopzettingen:        " & nStopz & Chr(10) & _
             "  Vooruitbestellingen:  " & nVb    & Chr(10) & _
             "  Abonnementstarts:     " & nStart & Chr(10) & Chr(10)
    If nDup > 0 Then
        sVraag = sVraag & nDup & " week(en) worden overgeslagen (staan al in de DB)." & Chr(10) & Chr(10)
    End If
    If nStart > 0 Then
        sVraag = sVraag & "Elke start zet de klant ook op een toekomst-abonneetype." & Chr(10) & Chr(10)
    End If
    sVraag = sVraag & "Akkoord?"
    If MsgBox(sVraag, 33, "VerwerkStopStart") <> 1 Then
        oConn.close()
        SluitSSHTunnels()
        Exit Sub
    End If

    ' Tweede vraag: bevestigingsmails versturen? Enkel als er kandidaten zijn.
    Dim bStuurMails As Boolean : bStuurMails = False
    If nMail > 0 Then
        Dim sUrl As String
        If BepaalOmgeving() = "dev" Then
            sUrl = "https://bestel.dev.kiemkracht.be"
        Else
            sUrl = "https://bestel.kiemkracht.be"
        End If
        Dim sMailVraag As String
        Dim sMailWoord As String
        If nMail = 1 Then sMailWoord = "1 bevestigingsmail" Else sMailWoord = nMail & " bevestigingsmails"
        sMailVraag = "Wil je ook " & sMailWoord & " versturen?" & Chr(10) & _
                     "(annulaties + stopzettingen + vooruitbestellingen + abonnementsstarts — klanten zonder email1 zijn overgeslagen)" & Chr(10) & Chr(10) & _
                     "Doelomgeving: " & sUrl & Chr(10) & Chr(10) & _
                     "Ja = inserts + mails" & Chr(10) & _
                     "Nee = enkel inserts, geen mails"
        If MsgBox(sMailVraag, 36, "VerwerkStopStart") = 6 Then bStuurMails = True
    End If

    ' === Fase 5: uitvoeren ===
    On Error GoTo UitvoerFout
    oStmt = oConn.createStatement()
    Dim it As Integer
    For it = 0 To nItem - 1
        oStmt.executeUpdate(aSql(it))
    Next it
    oStmt.close()
    oConn.close()
    On Error GoTo 0

    ' === Fase 5b: mails versturen (na succesvolle inserts) ===
    Dim nMailOk As Integer : nMailOk = 0
    Dim nMailFout As Integer : nMailFout = 0
    If bStuurMails Then
        Dim m As Integer
        For m = 0 To nMail - 1
            Dim bOk As Boolean : bOk = False
            Select Case mType(m)
                Case "annulatie", "stopzetting"
                    Dim iWeekStop As Integer
                    If mType(m) = "stopzetting" Then iWeekStop = mWeek(m) Else iWeekStop = 0
                    bOk = VerstuurAnnulatieMail(mEmail(m), mVoor(m), mVoor2(m), mWeek(m), mJaar(m), _
                                                mDatum(m), iWeekStop, mKlantId(m))
                Case "vooruitbestelling", "abonnementsstart"
                    Dim iWeekStart As Integer
                    If mType(m) = "abonnementsstart" Then iWeekStart = mWeek(m) Else iWeekStart = 0
                    bOk = VerstuurVooruitbestellingMail(mEmail(m), mVoor(m), mVoor2(m), mWeek(m), mJaar(m), _
                                                        mDatum(m), iWeekStart, mKlantId(m), mFormaat(m))
            End Select
            If bOk Then nMailOk = nMailOk + 1 Else nMailFout = nMailFout + 1
        Next m
    End If

    ' Verwerkte invoercellen leegmaken
    For i = 0 To nRij - 1
        oSheet.getCellByPosition(COL_ANN,     riRij(i)).setString("")
        oSheet.getCellByPosition(COL_STOP,    riRij(i)).setString("")
        oSheet.getCellByPosition(COL_VB,      riRij(i)).setString("")
        oSheet.getCellByPosition(COL_START,   riRij(i)).setString("")
        oSheet.getCellByPosition(COL_TYPE,    riRij(i)).setString("")
        oSheet.getCellByPosition(COL_FORMAAT, riRij(i)).setString("")
    Next i

    SluitSSHTunnels()
    Dim sKlaar As String
    sKlaar = "Verwerkt: " & nAnn & " annulaties, " & nStopz & " stopzettingen, " & _
             nVb & " vooruitbestellingen, " & nStart & " abonnementstarts."
    If nStart > 0 Then
        sKlaar = sKlaar & Chr(10) & nStart & " klant(en) op een toekomst-abonneetype gezet."
    End If
    If bStuurMails Then
        sKlaar = sKlaar & Chr(10) & Chr(10) & "Bevestigingsmails: " & nMailOk & " ok, " & nMailFout & " fout."
    End If
    MsgBox sKlaar, 64, "Klaar"
    Exit Sub

UitvoerFout:
    MsgBox "Databasefout tijdens het wegschrijven: " & Err & " - " & Error & Chr(10) & Chr(10) & _
           "Niet alle records zijn verwerkt. De invoer is bewaard — draai de macro " & _
           "opnieuw; reeds verwerkte weken worden automatisch overgeslagen.", 16, "Fout"
    SluitSSHTunnels()
    Exit Sub

VerbindingsFoutSS:
    MsgBox "Verbindingsfout: " & Err & " - " & Error, 16, "Fout"
    SluitSSHTunnels()

End Sub

' =============================================
' Verstuur bevestigingsmail voor een annulatie of stopzetting via de
' postgres-proxy. Sync HTTP-POST naar /actie=annulatie_bevestiging_mail.
' Returnt True bij HTTP 200, anders False.
' iWeekStop = 0  -> gewone annulatie
' iWeekStop > 0  -> stopzetting (proxy kiest dan stopzet-template)
' =============================================
Function VerstuurAnnulatieMail(sEmail As String, sVoornaam As String, sVoornaam2 As String, _
                                iWeek As Integer, iJaar As Integer, _
                                sDatum As String, iWeekStop As Integer, _
                                iKlantId As Long) As Boolean
    Dim sUrl As String
    If BepaalOmgeving() = "dev" Then
        sUrl = "https://bestel.dev.kiemkracht.be/postgres-proxy.php?actie=annulatie_bevestiging_mail"
    Else
        sUrl = "https://bestel.kiemkracht.be/postgres-proxy.php?actie=annulatie_bevestiging_mail"
    End If

    Dim sJson As String
    sJson = "{""Sleutel"":""Kiemkracht2026BestelFormulierSleutel""," & _
            """KlantEmail"":""" & JsonEsc(sEmail) & """," & _
            """Voornaam"":""" & JsonEsc(sVoornaam) & """," & _
            """Voornaam2"":""" & JsonEsc(sVoornaam2) & """," & _
            """KlantID"":" & iKlantId & "," & _
            """WeekAnnulatie"":" & iWeek & "," & _
            """Datum"":""" & sDatum & """," & _
            """Jaar"":" & iJaar
    If iWeekStop > 0 Then
        sJson = sJson & ",""WeekStopzettenAbonnement"":" & iWeekStop
    End If
    sJson = sJson & "}"

    On Error GoTo HttpFout
    Dim http As Object
    http = createObject("MSXML2.ServerXMLHTTP.6.0")
    http.open("POST", sUrl, False)
    http.setRequestHeader("Content-Type", "application/json")
    http.send(sJson)
    VerstuurAnnulatieMail = (http.status = 200)
    Exit Function
HttpFout:
    VerstuurAnnulatieMail = False
End Function

