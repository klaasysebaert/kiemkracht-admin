    sInput = "Henk"  ' Begin heel klein
    
    Dim sResultaat As String
    sResultaat = Base64Encode(sInput)
    
    MsgBox "Input: " & sInput & Chr(10) & _
           "Base64: " & sResultaat & Chr(10) & Chr(10) & _
           "Verwacht: SGVuaw=="
End Sub

