Sub BereidMailmergeVoor()

    ' =============================================
    ' Kiemkracht - Mailmerge voorbereiden
    '
    ' Doet TWEE dingen tegelijk (transitie-modus):
    '   (a) Vult sheet "Mailmerge" in kiemkracht-data.ods met
    '       1 rij per klant per geldige mail — bron voor de
    '       bestaande Thunderbird-mailmerge (backup-pad).
    '   (b) Maakt een 'concept'-run aan in mailmerge_runs +
    '       recipients in mailmerge_recipients (klantspecifieke
    '       base64-URL vooraf berekend). Bron voor de nieuwe
    '       geautomatiseerde flow via admin-mailmerge.php +
    '       mailmerge-runner.php.
    '
    ' Logica per klanttype:
    '   abonnee              -> altijd uitgenodigd
    '   abonnee-pare         -> enkel in pare weken
    '   abonnee-onpare       -> enkel in onpare weken
    '   weekperweek          -> altijd uitgenodigd (vrijblijvend)
    '   weekperweek + vooruit-> altijd uitgenodigd (bevestiging)
    '   abonnee-*-toekomst   -> behandeld als weekperweek
    '   stop-tijdelijk       -> niet uitgenodigd
    '   stop-definitief      -> niet uitgenodigd
    '
    ' Mailtype:
    '   abonnee zonder annulatie         -> 'uitnodiging'
    '   abonnee met annulatie deze week  -> 'annulatie-bevestiging'
    '   weekperweek zonder vooruit       -> 'uitnodiging-los'
    '   weekperweek met vooruit          -> 'bevestiging'
    '   abonnee in off-pariteit met vooruit -> 'bevestiging'
    '
    ' Voor DB-recipients: 1 rij per geldig e-mailadres (email1
    ' + optioneel email2/3/4). Voor de Mailmerge-sheet blijft de
    ' oude indeling: 1 rij per klant met extra emails in
    ' kolommen N/Q/T.
    ' =============================================

    ' Diagnose: vang elke onverwachte fout en toon het regelnummer (Erl).
    On Error GoTo FoutAlgemeen

    ' Webshop- en admin-URL volgen de omgeving
    Dim BESTEL_URL As String
    Dim ADMIN_URL  As String
    If BepaalOmgeving() = "dev" Then
        BESTEL_URL = "https://bestel.dev.kiemkracht.be/"
        ADMIN_URL  = "https://bestel.dev.kiemkracht.be/admin-mailmerge.php"
    Else
        BESTEL_URL = "https://bestel.kiemkracht.be/"
        ADMIN_URL  = "https://bestel.kiemkracht.be/admin-mailmerge.php"
    End If

    ' --- Weeknummer: komende donderdag ---
    Dim dVandaag   As Date
    Dim dDonderdag As Date
    Dim iWeekdag   As Integer
    dVandaag = Now()
    iWeekdag = Weekday(dVandaag, 1)  ' 1=zo, ..., 5=do, 6=vr, 7=za
    Dim iDagenTot As Integer
    If iWeekdag <= 5 Then
        iDagenTot = 5 - iWeekdag
    Else
        iDagenTot = 5 - iWeekdag + 7
    End If
    If iWeekdag = 5 Then iDagenTot = 7  ' op donderdag: volgende week
    dDonderdag = dVandaag + iDagenTot

    Dim iWeek As Integer
    Dim iJaar As Integer
    iWeek = DatePart("ww", dDonderdag, 2, 2)
    iJaar = Year(dDonderdag)

    Dim sPareOnpare As String
    If (iWeek Mod 2) = 0 Then sPareOnpare = "pare" Else sPareOnpare = "onpare"
    ' Ritme dat deze week (pariteit) matcht — gebruikt om bij een combo-klant
    ' (meerdere abonnementen) de juiste abonnement-lijn voor de URL te kiezen.
    Dim sParRitme As String
    If sPareOnpare = "pare" Then sParRitme = "pare-week" Else sParRitme = "onpare-week"
    ' Weeknummer voor de pauze-conditie (een gepauzeerd abonnement telt deze week niet mee).
    Dim iWeekNumMM As Long : iWeekNumMM = CLng(iJaar) * 100 + iWeek

    ' Default planned_at: eerstvolgende maandag 13u
    Dim sDefault As String
    sDefault = Format(VolgendeMaandag13u(), "YYYY-MM-DD HH:MM")

    ' Bevestiging
    Dim sAntwoord As Integer
    sAntwoord = MsgBox( _
        "Mailmerge voorbereiden voor:" & Chr(10) & _
        "Week " & iWeek & " / " & iJaar & " (" & sPareOnpare & " week)" & Chr(10) & _
        "Komende donderdag: " & Format(dDonderdag, "DD/MM/YYYY") & Chr(10) & Chr(10) & _
        "Vult zowel het tabblad 'Mailmerge' (Thunderbird-backup) als" & Chr(10) & _
        "de DB-queue (nieuwe geautomatiseerde flow via " & ADMIN_URL & ")." & Chr(10) & Chr(10) & _
        "Doorgaan?", _
        36, "BereidMailmergeVoor")
    If sAntwoord <> 6 Then  ' 6 = Ja
        SluitSSHTunnels()
        Exit Sub
    End If

    Dim sGepland As String
    sGepland = InputBox( _
        "Wanneer mag de bulk-mail vroegst verstuurd worden?" & Chr(10) & _
        "Formaat: YYYY-MM-DD HH:MM" & Chr(10) & Chr(10) & _
        "Tot dat moment kan je tekst aanpassen via admin-mailmerge.php" & Chr(10) & _
        "en de testmails bekijken + goedkeuren.", _
        "Plan verzending", sDefault)
    If sGepland = "" Then
        SluitSSHTunnels()
        Exit Sub
    End If

    ' --- Check data-bestand vroeg (we hebben oDoc nodig voor de Mailmerge-sheet) ---
    Dim oDoc As Object
    oDoc = HuidigDataDocument()
    If IsNull(oDoc) Then
        MsgBox "Geen kiemkracht-data-bestand actief. Open kiemkracht-data.ods " & _
               "of kiemkracht-data-dev.ods en start de macro vanuit dat venster.", 16, "Fout"
        SluitSSHTunnels()
        Exit Sub
    End If

    ' --- JDBC-verbinding ---
    On Error GoTo VerbindingsFout
    Dim oConn As Object
    oConn = MaakDBVerbinding()
    On Error GoTo FoutAlgemeen

    Dim oStmt As Object
    Dim oRS   As Object

    ' --- Stap 1: klanten ophalen ---
    oStmt = oConn.createStatement()
    oRS = oStmt.executeQuery( _
        "SELECT k.voornaam, k.familienaam, k.email1, " & _
        "COALESCE(ab.eff_type, k.type) AS type, " & _
        "COALESCE(ab.eff_formaat, k.formaat) AS formaat, " & _
        "COALESCE(a.naam, '') AS afhaalnaam, " & _
        "COALESCE(a.dag_afhaling, '') AS leverdag, " & _
        "k.id, COALESCE(k.email2,''), COALESCE(k.email3,''), COALESCE(k.email4,''), " & _
        "COALESCE(k.voornaam2,''), COALESCE(k.familienaam2,'') " & _
        "FROM klanten k " & _
        "LEFT JOIN afhaalpunten a ON a.id = k.afhaalpunt_id " & _
        "LEFT JOIN LATERAL ( " & _
        "  SELECT 'abonnee' " & _
        "      || CASE x.ritme WHEN 'pare-week' THEN '-pare-week' " & _
        "                      WHEN 'onpare-week' THEN '-onpare-week' ELSE '' END " & _
        "      || CASE WHEN x.status = 'toekomst' THEN '-toekomst' ELSE '' END AS eff_type, " & _
        "    x.formaat AS eff_formaat " & _
        "  FROM abonnementen x " & _
        "  WHERE x.klant_id = k.id AND x.status IN ('actief','toekomst') " & _
        "    AND (x.pauze_vanaf_week IS NULL OR (x.pauze_vanaf_jaar * 100 + x.pauze_vanaf_week) > " & iWeekNumMM & ") " & _
        "    AND (x.eind_jaar IS NULL OR (x.eind_jaar * 100 + x.eind_week) > " & iWeekNumMM & ") " & _
        "    AND (x.start_jaar IS NULL OR (x.start_jaar * 100 + x.start_week) <= " & iWeekNumMM & ") " & _
        "  ORDER BY (CASE WHEN x.ritme = 'wekelijks' OR x.ritme = '" & sParRitme & "' THEN 0 ELSE 1 END), x.id " & _
        "  LIMIT 1 " & _
        ") ab ON true " & _
        "WHERE k.status NOT IN ('gepauzeerd', 'gestopt') " & _
        " AND NOT (k.pauze_vanaf_jaar IS NOT NULL " & _
        "          AND (k.pauze_vanaf_jaar * 100 + k.pauze_vanaf_week) <= " & iWeekNumMM & _
        "          AND (k.pauze_tot_jaar IS NULL OR (k.pauze_tot_jaar * 100 + k.pauze_tot_week) > " & iWeekNumMM & ")) " & _
        " AND NOT EXISTS (SELECT 1 FROM annulaties ann " & _
        "   WHERE ann.jaar = " & iJaar & _
        "     AND ann.week_stopzetten_abonnement > 0 AND ann.week_stopzetten_abonnement <= " & iWeek & _
        "     AND (ann.klant_id = k.id OR (ann.klant_id IS NULL AND LOWER(ann.klant_email) = LOWER(k.email1)))) " & _
        "ORDER BY k.familienaam, k.voornaam")

    Dim kVoor(1000)    As String
    Dim kFam(1000)     As String
    Dim kEmail(1000)   As String
    Dim kType(1000)    As String
    Dim kFormaat(1000) As String
    Dim kAfhaal(1000)  As String
    Dim kLevdag(1000)  As String
    Dim kID(1000)      As String
    Dim kEmail2(1000)  As String
    Dim kEmail3(1000)  As String
    Dim kEmail4(1000)  As String
    Dim kVoor2(1000)   As String
    Dim kFam2(1000)    As String
    Dim nKlanten      As Integer
    nKlanten = 0

    Do While oRS.next()
        kVoor(nKlanten)    = oRS.getString(1)
        kFam(nKlanten)     = oRS.getString(2)
        kEmail(nKlanten)   = oRS.getString(3)
        kType(nKlanten)    = oRS.getString(4)
        kFormaat(nKlanten) = oRS.getString(5)
        kAfhaal(nKlanten)  = oRS.getString(6)
        kLevdag(nKlanten)  = oRS.getString(7)
        kID(nKlanten)      = oRS.getString(8)
        kEmail2(nKlanten)  = oRS.getString(9)
        kEmail3(nKlanten)  = oRS.getString(10)
        kEmail4(nKlanten)  = oRS.getString(11)
        kVoor2(nKlanten)   = oRS.getString(12)
        kFam2(nKlanten)    = oRS.getString(13)
        nKlanten = nKlanten + 1
    Loop
    oRS.close() : oStmt.close()

    ' --- Stap 2: vooruitbestellingen deze week ---
    ' klant_id mee ophalen: bestellingen via een email2/3/4-link dragen
    ' dat adres als klant_email, dus matchen op email1 alleen mist ze.
    oStmt = oConn.createStatement()
    oRS = oStmt.executeQuery( _
        "SELECT klant_email, formaat, COALESCE(klant_id, 0) " & _
        "FROM vooruitbestellingen " & _
        "WHERE jaar = " & iJaar & " AND week_bestelling = " & iWeek)

    Dim vbEmail(1000)   As String
    Dim vbFormaat(1000) As String
    Dim vbKlantId(1000) As String
    Dim nVB As Integer
    nVB = 0
    Do While oRS.next()
        vbEmail(nVB)   = oRS.getString(1)
        vbFormaat(nVB) = oRS.getString(2)
        vbKlantId(nVB) = oRS.getString(3)
        nVB = nVB + 1
    Loop
    oRS.close() : oStmt.close()

    ' --- Stap 2b: annulaties deze week ---
    oStmt = oConn.createStatement()
    oRS = oStmt.executeQuery( _
        "SELECT klant_email, COALESCE(klant_id, 0) " & _
        "FROM annulaties " & _
        "WHERE jaar = " & iJaar & " AND week_annulatie = " & iWeek)

    Dim annEmail(1000)   As String
    Dim annKlantId(1000) As String
    Dim nAnn As Integer
    nAnn = 0
    Do While oRS.next()
        annEmail(nAnn)   = oRS.getString(1)
        annKlantId(nAnn) = oRS.getString(2)
        nAnn = nAnn + 1
    Loop
    oRS.close() : oStmt.close()

    ' --- Stap 3: mailmerge_runs aanmaken, run_id ophalen ---
    Dim sToken As String
    sToken = GenereerToken(32)

    Dim sSqlRun As String
    sSqlRun = "INSERT INTO mailmerge_runs " & _
              "(week, jaar, planned_at, status, goedkeur_token) VALUES (" & _
              iWeek & ", " & iJaar & ", " & _
              SqlStr(sGepland) & "::timestamptz, 'concept', " & _
              SqlStr(sToken) & ") RETURNING id"
    Dim oStmtRun As Object : oStmtRun = oConn.createStatement()
    Dim oRSRun   As Object : oRSRun   = oStmtRun.executeQuery(sSqlRun)
    Dim lRunId As Long : lRunId = 0
    If oRSRun.next() Then lRunId = oRSRun.getLong(1)
    oRSRun.close() : oStmtRun.close()

    If lRunId = 0 Then
        MsgBox "Kon mailmerge_runs niet aanmaken — geen ID ontvangen.", 16, "Fout"
        oConn.close() : SluitSSHTunnels()
        Exit Sub
    End If

    ' --- Stap 4: sheet "Mailmerge" aanmaken of leegmaken ---
    Dim oSheets As Object
    Dim oSheet  As Object
    oSheets = oDoc.Sheets

    If oSheets.hasByName("Mailmerge") Then
        oSheet = oSheets.getByName("Mailmerge")
        oSheet.clearContents(7)
    Else
        oSheets.insertNewByName("Mailmerge", 0)  ' eerste positie
        oSheet = oSheets.getByName("Mailmerge")
    End If

    ' Erfenis van een handmatige AutoFilter opruimen (zie MaakBladFilterVrij)
    MaakBladFilterVrij(oDoc, oSheet)

    ' --- Stap 5: kolomhoofden Mailmerge-sheet ---
    Dim hoofden(19) As String
    hoofden(0)  = "Voornaam"
    hoofden(1)  = "Familienaam"
    hoofden(2)  = "Email"
    hoofden(3)  = "Type"
    hoofden(4)  = "Mailtype"
    hoofden(5)  = "Pakket"
    hoofden(6)  = "Leverdag"
    hoofden(7)  = "Afhaal"
    hoofden(8)  = "Week"
    hoofden(9)  = "BestelURL"
    hoofden(10) = "BestelURL_encoded"
    hoofden(11) = "Voornaam2"
    hoofden(12) = "Familienaam2"
    hoofden(13) = "Email2"
    hoofden(14) = "Voornaam3"
    hoofden(15) = "Familienaam3"
    hoofden(16) = "Email3"
    hoofden(17) = "Voornaam4"
    hoofden(18) = "Familienaam4"
    hoofden(19) = "Email4"

    Dim c As Integer
    For c = 0 To 19
        Dim oCell As Object
        oCell = oSheet.getCellByPosition(c, 0)
        oCell.setString(hoofden(c))
        oCell.CharWeight = com.sun.star.awt.FontWeight.BOLD
        oCell.CellBackColor = RGB(204, 204, 204)
    Next c

    ' --- Stap 6: klanten verwerken — schrijven naar Mailmerge-sheet ÉN DB ---
    Dim oStmtIns As Object : oStmtIns = oConn.createStatement()
    Dim nDbRecipients As Long : nDbRecipients = 0
    Dim r As Integer : r = 1  ' rij 1 = eerste datarij (rij 0 = hoofden)

    ' ALLE per-klant variabelen vooraan declareren. LO Basic struikelt op
    ' `Dim` binnen een loop (vooral fixed-size arrays) — zelfde patroon
    ' als de oude MaakWeekbestand-bug.
    Dim k As Integer
    Dim sType         As String
    Dim sFormaat      As String
    Dim sAfhaal       As String
    Dim sLevdag       As String
    Dim bVooruit      As Boolean
    Dim v             As Integer
    Dim bMail         As Boolean
    Dim sMailtype     As String
    Dim sPakketURL    As String
    Dim bGean         As Boolean
    Dim a             As Integer
    Dim sTypeURL      As String
    Dim sVoornaamURL  As String
    Dim sAfhaalURL    As String
    Dim sURL          As String
    Dim sQuerystring  As String
    Dim sBestelURL    As String
    Dim sEmails(3)    As String
    Dim sVoornamen(3) As String
    Dim sFamnamen(3)  As String
    Dim nE            As Integer
    Dim e             As Integer
    Dim sSqlRcp       As String
    Dim sQsE          As String
    Dim sBestelURLe   As String

    For k = 0 To nKlanten - 1

        sType    = kType(k)
        sFormaat = kFormaat(k)
        sAfhaal  = kAfhaal(k)
        sLevdag  = kLevdag(k)

        ' Vooruitbesteld? Match op klant_id (bestelling kan via een
        ' email2/3/4-link geplaatst zijn); e-mail als terugval voor
        ' oude records zonder klant_id.
        bVooruit = False
        For v = 0 To nVB - 1
            If (vbKlantId(v) <> "0" And vbKlantId(v) = kID(k)) _
                Or (vbKlantId(v) = "0" And LCase(vbEmail(v)) = LCase(kEmail(k))) Then
                bVooruit = True
                If vbFormaat(v) <> "" Then sFormaat = vbFormaat(v)
                Exit For
            End If
        Next v

        ' Mail deze week?
        bMail = False
        If bVooruit Then
            bMail = True
        ElseIf sType = "abonnee" Then
            bMail = True
        ElseIf sType = "abonnee-pare-week" And sPareOnpare = "pare" Then
            bMail = True
        ElseIf sType = "abonnee-onpare-week" And sPareOnpare = "onpare" Then
            bMail = True
        ElseIf sType = "weekperweek" Then
            bMail = True
        ElseIf sType = "weekperweek-pare-week" And sPareOnpare = "pare" Then
            bMail = True
        ElseIf sType = "weekperweek-onpare-week" And sPareOnpare = "onpare" Then
            bMail = True
        ElseIf sType = "abonnee-toekomst" _
            Or sType = "abonnee-pare-week-toekomst" _
            Or sType = "abonnee-onpare-week-toekomst" Then
            bMail = True
        End If
        If Not bMail Then GoTo VolgendeKlant
        If kEmail(k) = "" Then GoTo VolgendeKlant

        ' Mailtype + pakket-in-URL
        If bVooruit Then
            sMailtype  = "bevestiging"
            sPakketURL = sFormaat
        ElseIf sType = "weekperweek" Or sType = "weekperweek-pare-week" Or sType = "weekperweek-onpare-week" _
           Or sType = "abonnee-toekomst" Or sType = "abonnee-pare-week-toekomst" _
           Or sType = "abonnee-onpare-week-toekomst" Then
            sMailtype  = "uitnodiging-los"
            sPakketURL = ""
        Else
            bGean = False
            For a = 0 To nAnn - 1
                If (annKlantId(a) <> "0" And annKlantId(a) = kID(k)) _
                    Or (annKlantId(a) = "0" And LCase(annEmail(a)) = LCase(kEmail(k))) Then
                    bGean = True : Exit For
                End If
            Next a
            If bGean Then
                sMailtype  = "annulatie-bevestiging"
                sPakketURL = ""
            Else
                sMailtype  = "uitnodiging"
                sPakketURL = sFormaat
            End If
        End If

        ' Type voor URL (toekomst -> weekperweek)
        If InStr(sType, "-toekomst") > 0 Then
            sTypeURL = "weekperweek"
        Else
            sTypeURL = sType
        End If

        ' --- Plain URL (oude kolom J) ---
        sVoornaamURL = JoinPlus(kVoor(k))
        sAfhaalURL   = JoinPlus(sAfhaal)

        sURL = BESTEL_URL & _
               "?voornaam="  & sVoornaamURL & _
               "&naam="      & JoinPlus(kFam(k)) & _
               "&email="     & kEmail(k) & _
               "&klant_id="  & kID(k) & _
               "&type="      & sTypeURL & _
               "&leverdag="  & sLevdag & _
               "&afhaalpunt=" & sAfhaalURL
        If sPakketURL <> "" Then sURL = sURL & "&formaat=" & sPakketURL
        If kVoor2(k) <> "" Then sURL = sURL & "&voornaam2=" & JoinPlus(kVoor2(k))

        ' --- Base64-URL (oude kolom K + nieuwe DB) ---
        sQuerystring = "voornaam="    & UrlEncodeValue(kVoor(k))  & _
                       "&naam="       & UrlEncodeValue(kFam(k))   & _
                       "&email="      & UrlEncodeValue(kEmail(k)) & _
                       "&klant_id="   & kID(k)                    & _
                       "&type="       & UrlEncodeValue(sTypeURL)  & _
                       "&leverdag="   & UrlEncodeValue(sLevdag)   & _
                       "&afhaalpunt=" & UrlEncodeValue(sAfhaal)
        If sPakketURL <> "" Then
            sQuerystring = sQuerystring & "&formaat=" & UrlEncodeValue(sPakketURL)
        End If
        If kVoor2(k) <> "" Then
            sQuerystring = sQuerystring & "&voornaam2=" & UrlEncodeValue(kVoor2(k))
        End If
        sBestelURL = BESTEL_URL & "?d=" & Base64UrlEncode(sQuerystring)

        ' === Mailmerge-sheet rij schrijven (oude gedrag) ===
        oSheet.getCellByPosition(0, r).setString(kVoor(k))
        oSheet.getCellByPosition(1, r).setString(kFam(k))
        oSheet.getCellByPosition(2, r).setString(kEmail(k))
        oSheet.getCellByPosition(3, r).setString(sType)
        oSheet.getCellByPosition(4, r).setString(sMailtype)
        oSheet.getCellByPosition(5, r).setString(sPakketURL)
        oSheet.getCellByPosition(6, r).setString(sLevdag)
        oSheet.getCellByPosition(7, r).setString(sAfhaal)
        oSheet.getCellByPosition(8, r).setValue(iWeek)
        oSheet.getCellByPosition(9, r).setString(sURL)
        oSheet.getCellByPosition(10, r).setString(sBestelURL)

        If kVoor2(k)  <> "" Then oSheet.getCellByPosition(11, r).setString(kVoor2(k))
        If kFam2(k)   <> "" Then oSheet.getCellByPosition(12, r).setString(kFam2(k))
        If kEmail2(k) <> "" Then oSheet.getCellByPosition(13, r).setString(kEmail2(k))
        If kEmail3(k) <> "" Then oSheet.getCellByPosition(16, r).setString(kEmail3(k))
        If kEmail4(k) <> "" Then oSheet.getCellByPosition(19, r).setString(kEmail4(k))

        r = r + 1

        ' === DB-recipients schrijven (nieuw gedrag): 1 rij per uniek email ===
        ' Arrays expliciet leegmaken — Dim staat vooraan, dus de waarden
        ' van de vorige iteratie zitten er nog in.
        sEmails(0) = "" : sEmails(1) = "" : sEmails(2) = "" : sEmails(3) = ""
        sVoornamen(0) = "" : sVoornamen(1) = "" : sVoornamen(2) = "" : sVoornamen(3) = ""
        sFamnamen(0) = "" : sFamnamen(1) = "" : sFamnamen(2) = "" : sFamnamen(3) = ""
        nE = 0
        sEmails(0)    = kEmail(k)
        sVoornamen(0) = kVoor(k)
        sFamnamen(0)  = kFam(k)
        nE = 1

        If kEmail2(k) <> "" And LCase(kEmail2(k)) <> LCase(kEmail(k)) Then
            sEmails(nE) = kEmail2(k)
            If kVoor2(k) <> "" Then sVoornamen(nE) = kVoor2(k) Else sVoornamen(nE) = kVoor(k)
            If kFam2(k)  <> "" Then sFamnamen(nE)  = kFam2(k)  Else sFamnamen(nE)  = kFam(k)
            nE = nE + 1
        End If
        If kEmail3(k) <> "" And LCase(kEmail3(k)) <> LCase(kEmail(k)) _
                            And LCase(kEmail3(k)) <> LCase(kEmail2(k)) Then
            sEmails(nE) = kEmail3(k)
            sVoornamen(nE) = kVoor(k)
            sFamnamen(nE)  = kFam(k)
            nE = nE + 1
        End If
        ' email4 krijgt BEWUST GEEN wekelijkse aanbodsmail (beslissing 2026-07-13):
        ' enkel email1, email2 en email3 zijn mailing-adressen. email4 blijft wel
        ' bewaard als contactadres (en staat nog in de Mailmerge-sheet-kolom), maar
        ' wordt hier niet als recipient in mailmerge_recipients gezet.

        ' INSERT per email — elk adres krijgt een EIGEN bestel-URL met
        ' zichzelf als email-parameter. Het bestelformulier vult dat adres
        ' in en de bevestigingsmail volgt het formulier-adres; met een
        ' gedeelde email1-URL kwam de bevestiging van een bestelling via
        ' de email2-mail op email1 terecht (casus Dekyvere 2026-07-06).
        ' Naam/voornaam blijven klant-niveau (bestelling blijft op het
        ' huishouden staan); enkel het e-mailadres varieert.
        For e = 0 To nE - 1
            sQsE = "voornaam="    & UrlEncodeValue(kVoor(k))   & _
                   "&naam="       & UrlEncodeValue(kFam(k))    & _
                   "&email="      & UrlEncodeValue(sEmails(e)) & _
                   "&klant_id="   & kID(k)                     & _
                   "&type="       & UrlEncodeValue(sTypeURL)   & _
                   "&leverdag="   & UrlEncodeValue(sLevdag)    & _
                   "&afhaalpunt=" & UrlEncodeValue(sAfhaal)
            If sPakketURL <> "" Then
                sQsE = sQsE & "&formaat=" & UrlEncodeValue(sPakketURL)
            End If
            If kVoor2(k) <> "" Then
                sQsE = sQsE & "&voornaam2=" & UrlEncodeValue(kVoor2(k))
            End If
            sBestelURLe = BESTEL_URL & "?d=" & Base64UrlEncode(sQsE)

            sSqlRcp = "INSERT INTO mailmerge_recipients " & _
                      "(run_id, klant_id, naar_email, voornaam, familienaam, " & _
                      " klant_type, mailtype, bestel_url, pakket, leverdag, afhaalpunt) " & _
                      "VALUES (" & lRunId & ", " & kID(k) & ", " & _
                      SqlStr(sEmails(e))    & ", " & _
                      SqlStr(sVoornamen(e)) & ", " & _
                      SqlStr(sFamnamen(e))  & ", " & _
                      SqlStr(sType)         & ", " & _
                      SqlStr(sMailtype)     & ", " & _
                      SqlStr(sBestelURLe)   & ", " & _
                      SqlStr(sPakketURL)    & ", " & _
                      SqlStr(sLevdag)       & ", " & _
                      SqlStr(sAfhaal)       & ")"
            oStmtIns.executeUpdate(sSqlRcp)
            nDbRecipients = nDbRecipients + 1
        Next e

        VolgendeKlant:
    Next k
    oStmtIns.close()

    ' --- Stap 7: totaal_recipients bijwerken in DB ---
    Dim oStmtUpd As Object : oStmtUpd = oConn.createStatement()
    oStmtUpd.executeUpdate("UPDATE mailmerge_runs SET totaal_recipients = " & _
                            nDbRecipients & " WHERE id = " & lRunId)
    oStmtUpd.close()

    oConn.close()

    ' --- Stap 8: kolombreedte Mailmerge-sheet ---
    Dim oKolommen As Object
    oKolommen = oSheet.getColumns()
    Dim cIdx As Integer
    For cIdx = 0 To 19
        oKolommen.getByIndex(cIdx).OptimalWidth = True
    Next cIdx
    oKolommen.getByIndex(9).Width  = 12000  ' ~12 cm
    oKolommen.getByIndex(10).Width = 12000

    SluitSSHTunnels()

    ' --- Klaar ---
    Dim nSheetRijen As Integer
    nSheetRijen = r - 1
    MsgBox "Mailmerge klaar!" & Chr(10) & Chr(10) & _
           "Week " & iWeek & " / " & iJaar & " (" & sPareOnpare & " week)" & Chr(10) & Chr(10) & _
           "Tabblad 'Mailmerge': " & nSheetRijen & " klanten (Thunderbird-backup-pad)" & Chr(10) & _
           "DB-run #" & lRunId & ": " & nDbRecipients & " ontvangers (incl. extra e-mailadressen)" & Chr(10) & _
           "Geplande verzending: " & sGepland & Chr(10) & Chr(10) & _
           "Schrijf de mail-tekst en stuur testmails via:" & Chr(10) & _
           ADMIN_URL & "?run_id=" & lRunId, _
           64, "BereidMailmergeVoor"

    Exit Sub

FoutAlgemeen:
    MsgBox "Onverwachte fout " & Err & ": " & Error & Chr(10) & _
           "Module2, regel " & Erl, 16, "BereidMailmergeVoor"
    SluitSSHTunnels()
    Exit Sub

VerbindingsFout:
    MsgBox "Verbindingsfout: " & Err & " - " & Error & Chr(10) & _
           "Controleer of de SSH-tunnel actief is (poort 5433/5434).", 16, "Fout"
    SluitSSHTunnels()

End Sub

' =============================================
' Hulpfunctie: eerstvolgende maandag 13u na NOW
' =============================================
Function VolgendeMaandag13u() As Date
    Dim dNu As Date : dNu = Now()
    Dim iDow As Integer : iDow = Weekday(dNu, 2)  ' 1=ma, ..., 7=zo
    Dim iDagen As Integer
    If iDow = 1 Then
        If Hour(dNu) < 13 Then iDagen = 0 Else iDagen = 7
    Else
        iDagen = 8 - iDow
    End If
    ' Int(dNu) trunceert naar datum-only; daarna iDagen optellen en
    ' 13:00 toevoegen. Vermijdt DateSerial-overflow-bug bij dagen > 31.
    VolgendeMaandag13u = Int(dNu) + iDagen + TimeSerial(13, 0, 0)
End Function

' =============================================
' Hulpfunctie: random hex-token (Rnd is geen crypto-RNG, maar
' voldoende om de goedkeur-URL niet te kunnen raden voor
' iemand die het token niet uit de testmail haalt).
' =============================================
Function GenereerToken(iLen As Integer) As String
    Const HEX As String = "0123456789abcdef"
    Randomize()
    Dim sR As String : sR = ""
    Dim i As Integer
    For i = 1 To iLen
        sR = sR & Mid(HEX, Int(Rnd() * 16) + 1, 1)
    Next i
    GenereerToken = sR
End Function

' =============================================
' Hulproutine: een hergebruikt mailmerge-tabblad filtervrij maken.
'
' De mailmerge-Subs hergebruiken hun tabblad en maken het leeg met
' clearContents(7) — dat wist enkel celINHOUD. Een AutoFilter die ooit
' met de hand op dat blad werd gezet (bv. om even enkel de abonnees te
' bekijken) overleeft dat: de verbergvlaggen kleven aan het RIJNUMMER,
' terwijl de volgende run daar andere klanten in schrijft. Je houdt dan
' een willekeurige restselectie verborgen over.
'
' Vastgesteld 17/08/2026 op Koffiemailmerge: 128 verborgen rijen die
' niet meer met het filter zelf overeenkwamen (61 weekperweek, 35
' on_hold, 22 abonnee, ...). Dat is geen schoonheidsfoutje — rijen die
' door een filter verborgen zijn, komen bij kopiëren niet mee naar het
' verzendbestand, dus die klanten krijgen stilzwijgend geen mail.
'
' Daarom bij elke run: alle rijen zichtbaar zetten en de filterknopjes
' weghalen. Stap 1 is het essentiële deel en heeft een terugvalpad;
' stap 2 is opkuis en mag stilletjes mislukken (dan staan de knopjes er
' nog, maar verbergt er niets meer).
' =============================================
Sub MaakBladFilterVrij(oDoc As Object, oSheet As Object)
    Dim oRijen    As Object
    Dim oNaamloos As Object
    Dim oBereik   As Object
    Dim oCursor   As Object
    Dim nBlad     As Integer
    Dim nLaatste  As Long
    Dim iRij      As Long
    Dim bGelukt   As Boolean

    If IsNull(oSheet) Then Exit Sub
    oRijen = oSheet.getRows()

    ' 1. Alle rijen weer zichtbaar. De collectie-eigenschap zet ze in één
    '    keer; lukt dat niet, dan rij per rij over het gebruikte gebied.
    bGelukt = True
    On Error Resume Next
    oRijen.IsVisible = True
    If Err <> 0 Then bGelukt = False
    On Error GoTo 0

    If Not bGelukt Then
        ' Rij per rij. Niet op het gebruikte gebied vertrouwen: clearContents
        ' is hier al gepasseerd, dus dat kan ingekrompen zijn terwijl de
        ' verbergvlaggen lager op het blad blijven staan. Vandaar een
        ' ondergrens die ruim boven elke mailmerge-lijst ligt.
        oCursor = oSheet.createCursor()
        oCursor.gotoEndOfUsedArea(True)
        nLaatste = oCursor.getRangeAddress().EndRow
        If nLaatste < 2000 Then nLaatste = 2000
        For iRij = 0 To nLaatste
            oRijen.getByIndex(iRij).IsVisible = True
        Next iRij
    End If

    ' 2. De AutoFilter zelf weg (de naamloze database-range van dit blad),
    '    anders staan de knopjes er nog en volstaat één klik om opnieuw
    '    rijen te verbergen.
    On Error Resume Next
    nBlad = oSheet.RangeAddress.Sheet
    oNaamloos = oDoc.UnnamedDatabaseRanges
    If Not IsNull(oNaamloos) Then
        If oNaamloos.hasByTable(nBlad) Then
            oBereik = oNaamloos.getByTable(nBlad)
            oBereik.AutoFilter = False
        End If
    End If
    On Error GoTo 0
End Sub

Sub BereidKoffieMailmergeVoor()

    ' =============================================
    ' Kiemkracht - Koffie-mailmerge voorbereiden
    ' Maakt sheet "Koffiemailmerge" klaar in kiemkracht-data.ods
    ' met gepersonaliseerde koffie-URL per klant.
    '
    ' Doelgroep: IEDEREEN met koffie_opt_out = false, zonder week-filter
    '            — pare-week-klanten krijgen ook een uitnodiging in
    '            onpare weken en omgekeerd. Klanten zonder email1 worden
    '            overgeslagen.
    '
    ' Bewust GEEN filter op klanten.type (2026-07-28): koffie is een
    ' aparte mailstroom met een eigen opt-out-kolom. Vroeger sloot
    ' "type NOT IN ('stop-tijdelijk','stop-definitief')" iedereen uit die
    ' met groenten stopte — ook wie de koffie- en honingmail uitdrukkelijk
    ' wél wilde blijven krijgen. Dat filter dubbelde koffie_opt_out en
    ' won er stilzwijgend van. Nu is koffie_opt_out de ENIGE poort, zodat
    ' groenten (status-gestuurd) en koffie (opt-out-gestuurd) los van
    ' elkaar staan. Zelfde predicaat geldt als beschermingsregel bij een
    ' toekomstige opkuis/anonimisering: wie hier nog in zit, niet wissen.
    '
    ' Doel-URL: koffie.kiemkracht.be (prod) of koffie.dev.kiemkracht.be (dev).
    ' Payload: voornaam, naam, email, klant_id, afhaalpunt — base64 in ?d=.
    ' =============================================

    ' Doel-URL volgt de omgeving (dev-bestand -> dev-formulier)
    Dim KOFFIE_URL As String
    Dim BESTEL_URL As String   ' voor de uitschrijflink (uitschrijven.php leeft op de bestel-app)
    If BepaalOmgeving() = "dev" Then
        KOFFIE_URL = "https://koffie.dev.kiemkracht.be/"
        BESTEL_URL = "https://bestel.dev.kiemkracht.be/"
    Else
        KOFFIE_URL = "https://koffie.kiemkracht.be/"
        BESTEL_URL = "https://bestel.kiemkracht.be/"
    End If

    ' Bevestiging aan gebruiker
    Dim sAntwoord As Integer
    sAntwoord = MsgBox( _
        "Koffie-mailmerge voorbereiden voor IEDEREEN die de koffiemail" & Chr(10) & _
        "niet heeft afgezegd (koffie_opt_out = nee)." & Chr(10) & _
        "(inclusief pare-week klanten in onpare weken en omgekeerd, en" & Chr(10) & _
        "inclusief wie met groenten gestopt is maar koffie wil houden)" & Chr(10) & Chr(10) & _
        "Doelomgeving: " & KOFFIE_URL & Chr(10) & Chr(10) & _
        "Doorgaan?", _
        36, "BereidKoffieMailmergeVoor")
    If sAntwoord <> 6 Then  ' 6 = Ja
        SluitSSHTunnels()
        Exit Sub
    End If

    ' --- JDBC-verbinding (juiste omgeving via MaakDBVerbinding) ---
    On Error GoTo VerbindingsFout
    Dim oConn As Object
    oConn = MaakDBVerbinding()
    On Error GoTo 0

    Dim oStmt As Object
    Dim oRS   As Object

    ' --- Stap 1: alle koffie-geadresseerden + afhaalpunt ---
    oStmt = oConn.createStatement()
    oRS = oStmt.executeQuery( _
        "SELECT k.voornaam, k.familienaam, k.email1, k.type, " & _
        "COALESCE(a.naam, '') AS afhaalnaam, " & _
        "k.id, COALESCE(k.email2,''), COALESCE(k.email3,''), COALESCE(k.email4,''), " & _
        "COALESCE(k.voornaam2,''), COALESCE(k.familienaam2,''), " & _
        "COALESCE(k.unsub_token,'') " & _
        "FROM klanten k " & _
        "LEFT JOIN afhaalpunten a ON a.id = k.afhaalpunt_id " & _
        "WHERE COALESCE(k.koffie_opt_out, false) = false " & _
        "AND COALESCE(k.email1, '') <> '' " & _
        "ORDER BY k.familienaam, k.voornaam")

    Dim kVoor(1000)   As String
    Dim kFam(1000)    As String
    Dim kEmail(1000)  As String
    Dim kType(1000)   As String
    Dim kAfhaal(1000) As String
    Dim kID(1000)     As String
    Dim kEmail2(1000) As String
    Dim kEmail3(1000) As String
    Dim kEmail4(1000) As String
    Dim kVoor2(1000)  As String
    Dim kFam2(1000)   As String
    Dim kUnsub(1000)  As String
    Dim nKlanten      As Integer
    nKlanten = 0

    Do While oRS.next()
        kVoor(nKlanten)   = oRS.getString(1)
        kFam(nKlanten)    = oRS.getString(2)
        kEmail(nKlanten)  = oRS.getString(3)
        kType(nKlanten)   = oRS.getString(4)
        kAfhaal(nKlanten) = oRS.getString(5)
        kID(nKlanten)     = oRS.getString(6)
        kEmail2(nKlanten) = oRS.getString(7)
        kEmail3(nKlanten) = oRS.getString(8)
        kEmail4(nKlanten) = oRS.getString(9)
        kVoor2(nKlanten)  = oRS.getString(10)
        kFam2(nKlanten)   = oRS.getString(11)
        kUnsub(nKlanten)  = oRS.getString(12)
        nKlanten = nKlanten + 1
    Loop
    oRS.close() : oStmt.close()
    oConn.close()

    ' --- Stap 2: sheet "Koffiemailmerge" aanmaken of leegmaken ---
    Dim oDoc    As Object
    Dim oSheets As Object
    Dim oSheet  As Object
    oDoc = HuidigDataDocument()
    If IsNull(oDoc) Then
        MsgBox "Geen kiemkracht-data-bestand actief. Open kiemkracht-data.ods " & _
               "of kiemkracht-data-dev.ods en start de macro vanuit dat venster.", 16, "Fout"
        SluitSSHTunnels()
        Exit Sub
    End If
    oSheets = oDoc.Sheets

    If oSheets.hasByName("Koffiemailmerge") Then
        oSheet = oSheets.getByName("Koffiemailmerge")
        oSheet.clearContents(7)
    Else
        oSheets.insertNewByName("Koffiemailmerge", 0)  ' eerste positie
        oSheet = oSheets.getByName("Koffiemailmerge")
    End If

    ' Erfenis van een handmatige AutoFilter opruimen (zie MaakBladFilterVrij)
    MaakBladFilterVrij(oDoc, oSheet)

    ' --- Stap 3: kolomhoofden schrijven ---
    Dim hoofden(15) As String
    hoofden(0)  = "Voornaam"
    hoofden(1)  = "Familienaam"
    hoofden(2)  = "Email"
    hoofden(3)  = "Type"
    hoofden(4)  = "Afhaal"
    hoofden(5)  = "KoffieURL_encoded"
    hoofden(6)  = "Voornaam2"
    hoofden(7)  = "Familienaam2"
    hoofden(8)  = "Email2"
    hoofden(9)  = "Voornaam3"
    hoofden(10) = "Familienaam3"
    hoofden(11) = "Email3"
    hoofden(12) = "Voornaam4"
    hoofden(13) = "Familienaam4"
    hoofden(14) = "Email4"
    hoofden(15) = "UitschrijfURL"

    Dim c As Integer
    For c = 0 To 15
        Dim oCell As Object
        oCell = oSheet.getCellByPosition(c, 0)
        oCell.setString(hoofden(c))
        oCell.CharWeight = com.sun.star.awt.FontWeight.BOLD
        oCell.CellBackColor = RGB(204, 204, 204)
    Next c

    ' --- Stap 4: klanten verwerken en rijen schrijven ---
    Dim r As Integer
    r = 1  ' rij 1 = eerste datarij (rij 0 = hoofden)

    Dim k As Integer
    For k = 0 To nKlanten - 1

        ' Querystring bouwen — zelfde formaat als koffie-form verwacht (?d=)
        Dim sQuerystring As String
        sQuerystring = "voornaam="    & UrlEncodeValue(kVoor(k))   & _
                       "&naam="       & UrlEncodeValue(kFam(k))    & _
                       "&email="      & UrlEncodeValue(kEmail(k))  & _
                       "&klant_id="   & kID(k)                     & _
                       "&afhaalpunt=" & UrlEncodeValue(kAfhaal(k))

        Dim sURLEncoded As String
        sURLEncoded = KOFFIE_URL & "?d=" & Base64UrlEncode(sQuerystring)

        oSheet.getCellByPosition(0, r).setString(kVoor(k))
        oSheet.getCellByPosition(1, r).setString(kFam(k))
        oSheet.getCellByPosition(2, r).setString(kEmail(k))
        oSheet.getCellByPosition(3, r).setString(kType(k))
        oSheet.getCellByPosition(4, r).setString(kAfhaal(k))
        oSheet.getCellByPosition(5, r).setString(sURLEncoded)

        ' Partner-naam (kolommen G, H) + extra e-mailadressen (kolommen I, L, O — zelfde patroon als Mailmerge)
        If kVoor2(k)  <> "" Then oSheet.getCellByPosition(6, r).setString(kVoor2(k))
        If kFam2(k)   <> "" Then oSheet.getCellByPosition(7, r).setString(kFam2(k))
        If kEmail2(k) <> "" Then oSheet.getCellByPosition(8, r).setString(kEmail2(k))
        If kEmail3(k) <> "" Then oSheet.getCellByPosition(11, r).setString(kEmail3(k))
        If kEmail4(k) <> "" Then oSheet.getCellByPosition(14, r).setString(kEmail4(k))

        ' Uitschrijflink (koffie-stream) — wijst naar de bestel-app; leeg als de
        ' klant nog geen token heeft (tokens-vullen.php vult die server-side).
        If kUnsub(k) <> "" Then _
            oSheet.getCellByPosition(15, r).setString( _
                BESTEL_URL & "uitschrijven.php?u=" & kID(k) & "." & kUnsub(k) & "&type=koffie")

        r = r + 1
    Next k

    ' --- Stap 5: kolombreedte automatisch aanpassen ---
    Dim oKolommen As Object
    oKolommen = oSheet.getColumns()
    Dim cIdx As Integer
    For cIdx = 0 To 15
        oKolommen.getByIndex(cIdx).OptimalWidth = True
    Next cIdx
    oKolommen.getByIndex(5).Width = 12000  ' ~12 cm voor URL-kolom
    oKolommen.getByIndex(15).Width = 9000  ' uitschrijflink

    ' --- Klaar ---
    Dim nRijen As Integer
    nRijen = r - 1
    MsgBox "Koffie-mailmerge klaar!" & Chr(10) & Chr(10) & _
           nRijen & " klanten opgenomen in sheet 'Koffiemailmerge'." & Chr(10) & _
           "Doelomgeving: " & KOFFIE_URL, _
           64, "BereidKoffieMailmergeVoor"

    SluitSSHTunnels()
    Exit Sub

VerbindingsFout:
    MsgBox "Verbindingsfout: " & Err & " - " & Error & Chr(10) & _
           "Controleer of de SSH-tunnel actief is.", 16, "Fout"
    SluitSSHTunnels()

End Sub

Sub BereidCombiMailmergeVoor()

    ' =============================================
    ' Kiemkracht - Combi-mailmerge voorbereiden (groente + koffie)
    '
    ' Zelfde klantselectie als BereidMailmergeVoor (wie krijgt deze week
    ' een aanbodsmail: pare/onpare-ritme, vooruitbestellingen, annulaties),
    ' maar:
    '   - Vult ENKEL het tabblad "Mailmerge" — GEEN DB-run en GEEN
    '     mailmerge_recipients. Bedoeld voor de Thunderbird-mailmerge.
    '   - Voegt naast de groente-bestel-URL (kolom J/K) een extra kolom toe
    '     (KoffieURL_encoded) met de gepersonaliseerde koffie-bestel-URL
    '     (zoals BereidKoffieMailmergeVoor), zodat de aanbodsmail beide
    '     links kan bevatten.
    '
    ' Draai deze i.p.v. BereidMailmergeVoor in een week waarin je de
    ' koffie-link wil meesturen. Verzenden gebeurt via Thunderbird vanaf
    ' het tabblad 'Mailmerge'.
    ' =============================================

    ' Webshop- en koffie-URL volgen de omgeving
    Dim BESTEL_URL As String
    Dim KOFFIE_URL As String
    If BepaalOmgeving() = "dev" Then
        BESTEL_URL = "https://bestel.dev.kiemkracht.be/"
        KOFFIE_URL = "https://koffie.dev.kiemkracht.be/"
    Else
        BESTEL_URL = "https://bestel.kiemkracht.be/"
        KOFFIE_URL = "https://koffie.kiemkracht.be/"
    End If

    ' --- Weeknummer: komende donderdag ---
    Dim dVandaag   As Date
    Dim dDonderdag As Date
    Dim iWeekdag   As Integer
    dVandaag = Now()
    iWeekdag = Weekday(dVandaag, 1)  ' 1=zo, ..., 5=do, 6=vr, 7=za
    Dim iDagenTot As Integer
    If iWeekdag <= 5 Then
        iDagenTot = 5 - iWeekdag
    Else
        iDagenTot = 5 - iWeekdag + 7
    End If
    If iWeekdag = 5 Then iDagenTot = 7  ' op donderdag: volgende week
    dDonderdag = dVandaag + iDagenTot

    Dim iWeek As Integer
    Dim iJaar As Integer
    iWeek = DatePart("ww", dDonderdag, 2, 2)
    iJaar = Year(dDonderdag)

    Dim sPareOnpare As String
    If (iWeek Mod 2) = 0 Then sPareOnpare = "pare" Else sPareOnpare = "onpare"
    ' Ritme dat deze week (pariteit) matcht — gebruikt om bij een combo-klant
    ' (meerdere abonnementen) de juiste abonnement-lijn voor de URL te kiezen.
    Dim sParRitme As String
    If sPareOnpare = "pare" Then sParRitme = "pare-week" Else sParRitme = "onpare-week"
    ' Weeknummer voor de pauze-conditie (een gepauzeerd abonnement telt deze week niet mee).
    Dim iWeekNumMM As Long : iWeekNumMM = CLng(iJaar) * 100 + iWeek

    ' Bevestiging
    Dim sAntwoord As Integer
    sAntwoord = MsgBox( _
        "Combi-mailmerge (groente + koffie) voorbereiden voor:" & Chr(10) & _
        "Week " & iWeek & " / " & iJaar & " (" & sPareOnpare & " week)" & Chr(10) & _
        "Komende donderdag: " & Format(dDonderdag, "DD/MM/YYYY") & Chr(10) & Chr(10) & _
        "Vult ENKEL het tabblad 'Mailmerge' (Thunderbird-pad) met de" & Chr(10) & _
        "groente-bestel-URL plus een extra kolom koffie-bestel-URL." & Chr(10) & _
        "Er wordt GEEN DB-run aangemaakt." & Chr(10) & Chr(10) & _
        "Doorgaan?", _
        36, "BereidCombiMailmergeVoor")
    If sAntwoord <> 6 Then  ' 6 = Ja
        SluitSSHTunnels()
        Exit Sub
    End If

    ' --- Check data-bestand vroeg (we hebben oDoc nodig voor de Mailmerge-sheet) ---
    Dim oDoc As Object
    oDoc = HuidigDataDocument()
    If IsNull(oDoc) Then
        MsgBox "Geen kiemkracht-data-bestand actief. Open kiemkracht-data.ods " & _
               "of kiemkracht-data-dev.ods en start de macro vanuit dat venster.", 16, "Fout"
        SluitSSHTunnels()
        Exit Sub
    End If

    ' --- JDBC-verbinding ---
    On Error GoTo VerbindingsFout
    Dim oConn As Object
    oConn = MaakDBVerbinding()
    On Error GoTo 0

    Dim oStmt As Object
    Dim oRS   As Object

    ' --- Stap 1: klanten ophalen (identiek aan BereidMailmergeVoor) ---
    oStmt = oConn.createStatement()
    oRS = oStmt.executeQuery( _
        "SELECT k.voornaam, k.familienaam, k.email1, " & _
        "COALESCE(ab.eff_type, k.type) AS type, " & _
        "COALESCE(ab.eff_formaat, k.formaat) AS formaat, " & _
        "COALESCE(a.naam, '') AS afhaalnaam, " & _
        "COALESCE(a.dag_afhaling, '') AS leverdag, " & _
        "k.id, COALESCE(k.email2,''), COALESCE(k.email3,''), COALESCE(k.email4,''), " & _
        "COALESCE(k.voornaam2,''), COALESCE(k.familienaam2,'') " & _
        "FROM klanten k " & _
        "LEFT JOIN afhaalpunten a ON a.id = k.afhaalpunt_id " & _
        "LEFT JOIN LATERAL ( " & _
        "  SELECT 'abonnee' " & _
        "      || CASE x.ritme WHEN 'pare-week' THEN '-pare-week' " & _
        "                      WHEN 'onpare-week' THEN '-onpare-week' ELSE '' END " & _
        "      || CASE WHEN x.status = 'toekomst' THEN '-toekomst' ELSE '' END AS eff_type, " & _
        "    x.formaat AS eff_formaat " & _
        "  FROM abonnementen x " & _
        "  WHERE x.klant_id = k.id AND x.status IN ('actief','toekomst') " & _
        "    AND (x.pauze_vanaf_week IS NULL OR (x.pauze_vanaf_jaar * 100 + x.pauze_vanaf_week) > " & iWeekNumMM & ") " & _
        "    AND (x.eind_jaar IS NULL OR (x.eind_jaar * 100 + x.eind_week) > " & iWeekNumMM & ") " & _
        "    AND (x.start_jaar IS NULL OR (x.start_jaar * 100 + x.start_week) <= " & iWeekNumMM & ") " & _
        "  ORDER BY (CASE WHEN x.ritme = 'wekelijks' OR x.ritme = '" & sParRitme & "' THEN 0 ELSE 1 END), x.id " & _
        "  LIMIT 1 " & _
        ") ab ON true " & _
        "WHERE k.status NOT IN ('gepauzeerd', 'gestopt') " & _
        " AND NOT (k.pauze_vanaf_jaar IS NOT NULL " & _
        "          AND (k.pauze_vanaf_jaar * 100 + k.pauze_vanaf_week) <= " & iWeekNumMM & _
        "          AND (k.pauze_tot_jaar IS NULL OR (k.pauze_tot_jaar * 100 + k.pauze_tot_week) > " & iWeekNumMM & ")) " & _
        " AND NOT EXISTS (SELECT 1 FROM annulaties ann " & _
        "   WHERE ann.jaar = " & iJaar & _
        "     AND ann.week_stopzetten_abonnement > 0 AND ann.week_stopzetten_abonnement <= " & iWeek & _
        "     AND (ann.klant_id = k.id OR (ann.klant_id IS NULL AND LOWER(ann.klant_email) = LOWER(k.email1)))) " & _
        "ORDER BY k.familienaam, k.voornaam")

    Dim kVoor(1000)    As String
    Dim kFam(1000)     As String
    Dim kEmail(1000)   As String
    Dim kType(1000)    As String
    Dim kFormaat(1000) As String
    Dim kAfhaal(1000)  As String
    Dim kLevdag(1000)  As String
    Dim kID(1000)      As String
    Dim kEmail2(1000)  As String
    Dim kEmail3(1000)  As String
    Dim kEmail4(1000)  As String
    Dim kVoor2(1000)   As String
    Dim kFam2(1000)    As String
    Dim nKlanten      As Integer
    nKlanten = 0

    Do While oRS.next()
        kVoor(nKlanten)    = oRS.getString(1)
        kFam(nKlanten)     = oRS.getString(2)
        kEmail(nKlanten)   = oRS.getString(3)
        kType(nKlanten)    = oRS.getString(4)
        kFormaat(nKlanten) = oRS.getString(5)
        kAfhaal(nKlanten)  = oRS.getString(6)
        kLevdag(nKlanten)  = oRS.getString(7)
        kID(nKlanten)      = oRS.getString(8)
        kEmail2(nKlanten)  = oRS.getString(9)
        kEmail3(nKlanten)  = oRS.getString(10)
        kEmail4(nKlanten)  = oRS.getString(11)
        kVoor2(nKlanten)   = oRS.getString(12)
        kFam2(nKlanten)    = oRS.getString(13)
        nKlanten = nKlanten + 1
    Loop
    oRS.close() : oStmt.close()

    ' --- Stap 2: vooruitbestellingen deze week ---
    ' klant_id mee ophalen: bestellingen via een email2/3/4-link dragen
    ' dat adres als klant_email, dus matchen op email1 alleen mist ze.
    oStmt = oConn.createStatement()
    oRS = oStmt.executeQuery( _
        "SELECT klant_email, formaat, COALESCE(klant_id, 0) " & _
        "FROM vooruitbestellingen " & _
        "WHERE jaar = " & iJaar & " AND week_bestelling = " & iWeek)

    Dim vbEmail(1000)   As String
    Dim vbFormaat(1000) As String
    Dim vbKlantId(1000) As String
    Dim nVB As Integer
    nVB = 0
    Do While oRS.next()
        vbEmail(nVB)   = oRS.getString(1)
        vbFormaat(nVB) = oRS.getString(2)
        vbKlantId(nVB) = oRS.getString(3)
        nVB = nVB + 1
    Loop
    oRS.close() : oStmt.close()

    ' --- Stap 2b: annulaties deze week ---
    oStmt = oConn.createStatement()
    oRS = oStmt.executeQuery( _
        "SELECT klant_email, COALESCE(klant_id, 0) " & _
        "FROM annulaties " & _
        "WHERE jaar = " & iJaar & " AND week_annulatie = " & iWeek)

    Dim annEmail(1000)   As String
    Dim annKlantId(1000) As String
    Dim nAnn As Integer
    nAnn = 0
    Do While oRS.next()
        annEmail(nAnn)   = oRS.getString(1)
        annKlantId(nAnn) = oRS.getString(2)
        nAnn = nAnn + 1
    Loop
    oRS.close() : oStmt.close()

    ' Geen DB-writes meer nodig — verbinding mag dicht.
    oConn.close()

    ' --- Stap 3: sheet "Mailmerge" aanmaken of leegmaken ---
    Dim oSheets As Object
    Dim oSheet  As Object
    oSheets = oDoc.Sheets

    If oSheets.hasByName("Mailmerge") Then
        oSheet = oSheets.getByName("Mailmerge")
        oSheet.clearContents(7)
    Else
        oSheets.insertNewByName("Mailmerge", 0)  ' eerste positie
        oSheet = oSheets.getByName("Mailmerge")
    End If

    ' Erfenis van een handmatige AutoFilter opruimen (zie MaakBladFilterVrij)
    MaakBladFilterVrij(oDoc, oSheet)

    ' --- Stap 4: kolomhoofden (0-19 identiek aan BereidMailmergeVoor, 20 = koffie) ---
    Dim hoofden(20) As String
    hoofden(0)  = "Voornaam"
    hoofden(1)  = "Familienaam"
    hoofden(2)  = "Email"
    hoofden(3)  = "Type"
    hoofden(4)  = "Mailtype"
    hoofden(5)  = "Pakket"
    hoofden(6)  = "Leverdag"
    hoofden(7)  = "Afhaal"
    hoofden(8)  = "Week"
    hoofden(9)  = "BestelURL"
    hoofden(10) = "BestelURL_encoded"
    hoofden(11) = "Voornaam2"
    hoofden(12) = "Familienaam2"
    hoofden(13) = "Email2"
    hoofden(14) = "Voornaam3"
    hoofden(15) = "Familienaam3"
    hoofden(16) = "Email3"
    hoofden(17) = "Voornaam4"
    hoofden(18) = "Familienaam4"
    hoofden(19) = "Email4"
    hoofden(20) = "KoffieURL_encoded"

    Dim c As Integer
    For c = 0 To 20
        Dim oCell As Object
        oCell = oSheet.getCellByPosition(c, 0)
        oCell.setString(hoofden(c))
        oCell.CharWeight = com.sun.star.awt.FontWeight.BOLD
        oCell.CellBackColor = RGB(204, 204, 204)
    Next c

    ' --- Stap 5: klanten verwerken — enkel naar Mailmerge-sheet schrijven ---
    Dim r As Integer : r = 1  ' rij 1 = eerste datarij (rij 0 = hoofden)

    ' ALLE per-klant variabelen vooraan declareren (LO Basic struikelt op
    ' Dim binnen een loop).
    Dim k As Integer
    Dim sType         As String
    Dim sFormaat      As String
    Dim sAfhaal       As String
    Dim sLevdag       As String
    Dim bVooruit      As Boolean
    Dim v             As Integer
    Dim bMail         As Boolean
    Dim sMailtype     As String
    Dim sPakketURL    As String
    Dim bGean         As Boolean
    Dim a             As Integer
    Dim sTypeURL      As String
    Dim sVoornaamURL  As String
    Dim sAfhaalURL    As String
    Dim sURL          As String
    Dim sQuerystring  As String
    Dim sBestelURL    As String
    Dim sKoffieQs     As String
    Dim sKoffieURL    As String

    For k = 0 To nKlanten - 1

        sType    = kType(k)
        sFormaat = kFormaat(k)
        sAfhaal  = kAfhaal(k)
        sLevdag  = kLevdag(k)

        ' Vooruitbesteld? Match op klant_id (bestelling kan via een
        ' email2/3/4-link geplaatst zijn); e-mail als terugval voor
        ' oude records zonder klant_id.
        bVooruit = False
        For v = 0 To nVB - 1
            If (vbKlantId(v) <> "0" And vbKlantId(v) = kID(k)) _
                Or (vbKlantId(v) = "0" And LCase(vbEmail(v)) = LCase(kEmail(k))) Then
                bVooruit = True
                If vbFormaat(v) <> "" Then sFormaat = vbFormaat(v)
                Exit For
            End If
        Next v

        ' Mail deze week?
        bMail = False
        If bVooruit Then
            bMail = True
        ElseIf sType = "abonnee" Then
            bMail = True
        ElseIf sType = "abonnee-pare-week" And sPareOnpare = "pare" Then
            bMail = True
        ElseIf sType = "abonnee-onpare-week" And sPareOnpare = "onpare" Then
            bMail = True
        ElseIf sType = "weekperweek" Then
            bMail = True
        ElseIf sType = "weekperweek-pare-week" And sPareOnpare = "pare" Then
            bMail = True
        ElseIf sType = "weekperweek-onpare-week" And sPareOnpare = "onpare" Then
            bMail = True
        ElseIf sType = "abonnee-toekomst" _
            Or sType = "abonnee-pare-week-toekomst" _
            Or sType = "abonnee-onpare-week-toekomst" Then
            bMail = True
        End If
        If Not bMail Then GoTo VolgendeKlant
        If kEmail(k) = "" Then GoTo VolgendeKlant

        ' Mailtype + pakket-in-URL
        If bVooruit Then
            sMailtype  = "bevestiging"
            sPakketURL = sFormaat
        ElseIf sType = "weekperweek" Or sType = "weekperweek-pare-week" Or sType = "weekperweek-onpare-week" _
           Or sType = "abonnee-toekomst" Or sType = "abonnee-pare-week-toekomst" _
           Or sType = "abonnee-onpare-week-toekomst" Then
            sMailtype  = "uitnodiging-los"
            sPakketURL = ""
        Else
            bGean = False
            For a = 0 To nAnn - 1
                If (annKlantId(a) <> "0" And annKlantId(a) = kID(k)) _
                    Or (annKlantId(a) = "0" And LCase(annEmail(a)) = LCase(kEmail(k))) Then
                    bGean = True : Exit For
                End If
            Next a
            If bGean Then
                sMailtype  = "annulatie-bevestiging"
                sPakketURL = ""
            Else
                sMailtype  = "uitnodiging"
                sPakketURL = sFormaat
            End If
        End If

        ' Type voor URL (toekomst -> weekperweek)
        If InStr(sType, "-toekomst") > 0 Then
            sTypeURL = "weekperweek"
        Else
            sTypeURL = sType
        End If

        ' --- Plain groente-URL (kolom J) ---
        sVoornaamURL = JoinPlus(kVoor(k))
        sAfhaalURL   = JoinPlus(sAfhaal)

        sURL = BESTEL_URL & _
               "?voornaam="  & sVoornaamURL & _
               "&naam="      & JoinPlus(kFam(k)) & _
               "&email="     & kEmail(k) & _
               "&klant_id="  & kID(k) & _
               "&type="      & sTypeURL & _
               "&leverdag="  & sLevdag & _
               "&afhaalpunt=" & sAfhaalURL
        If sPakketURL <> "" Then sURL = sURL & "&formaat=" & sPakketURL
        If kVoor2(k) <> "" Then sURL = sURL & "&voornaam2=" & JoinPlus(kVoor2(k))

        ' --- Base64 groente-URL (kolom K) ---
        sQuerystring = "voornaam="    & UrlEncodeValue(kVoor(k))  & _
                       "&naam="       & UrlEncodeValue(kFam(k))   & _
                       "&email="      & UrlEncodeValue(kEmail(k)) & _
                       "&klant_id="   & kID(k)                    & _
                       "&type="       & UrlEncodeValue(sTypeURL)  & _
                       "&leverdag="   & UrlEncodeValue(sLevdag)   & _
                       "&afhaalpunt=" & UrlEncodeValue(sAfhaal)
        If sPakketURL <> "" Then
            sQuerystring = sQuerystring & "&formaat=" & UrlEncodeValue(sPakketURL)
        End If
        If kVoor2(k) <> "" Then
            sQuerystring = sQuerystring & "&voornaam2=" & UrlEncodeValue(kVoor2(k))
        End If
        sBestelURL = BESTEL_URL & "?d=" & Base64UrlEncode(sQuerystring)

        ' --- Base64 koffie-URL (kolom U) — zelfde payload als BereidKoffieMailmergeVoor ---
        sKoffieQs = "voornaam="    & UrlEncodeValue(kVoor(k))   & _
                    "&naam="       & UrlEncodeValue(kFam(k))    & _
                    "&email="      & UrlEncodeValue(kEmail(k))  & _
                    "&klant_id="   & kID(k)                     & _
                    "&afhaalpunt=" & UrlEncodeValue(kAfhaal(k))
        sKoffieURL = KOFFIE_URL & "?d=" & Base64UrlEncode(sKoffieQs)

        ' === Mailmerge-sheet rij schrijven ===
        oSheet.getCellByPosition(0, r).setString(kVoor(k))
        oSheet.getCellByPosition(1, r).setString(kFam(k))
        oSheet.getCellByPosition(2, r).setString(kEmail(k))
        oSheet.getCellByPosition(3, r).setString(sType)
        oSheet.getCellByPosition(4, r).setString(sMailtype)
        oSheet.getCellByPosition(5, r).setString(sPakketURL)
        oSheet.getCellByPosition(6, r).setString(sLevdag)
        oSheet.getCellByPosition(7, r).setString(sAfhaal)
        oSheet.getCellByPosition(8, r).setValue(iWeek)
        oSheet.getCellByPosition(9, r).setString(sURL)
        oSheet.getCellByPosition(10, r).setString(sBestelURL)

        If kVoor2(k)  <> "" Then oSheet.getCellByPosition(11, r).setString(kVoor2(k))
        If kFam2(k)   <> "" Then oSheet.getCellByPosition(12, r).setString(kFam2(k))
        If kEmail2(k) <> "" Then oSheet.getCellByPosition(13, r).setString(kEmail2(k))
        If kEmail3(k) <> "" Then oSheet.getCellByPosition(16, r).setString(kEmail3(k))
        If kEmail4(k) <> "" Then oSheet.getCellByPosition(19, r).setString(kEmail4(k))

        oSheet.getCellByPosition(20, r).setString(sKoffieURL)

        r = r + 1

        VolgendeKlant:
    Next k

    ' --- Stap 6: kolombreedte ---
    Dim oKolommen As Object
    oKolommen = oSheet.getColumns()
    Dim cIdx As Integer
    For cIdx = 0 To 20
        oKolommen.getByIndex(cIdx).OptimalWidth = True
    Next cIdx
    oKolommen.getByIndex(9).Width  = 12000  ' ~12 cm
    oKolommen.getByIndex(10).Width = 12000
    oKolommen.getByIndex(20).Width = 12000  ' koffie-URL

    SluitSSHTunnels()

    ' --- Klaar ---
    Dim nSheetRijen As Integer
    nSheetRijen = r - 1
    MsgBox "Combi-mailmerge klaar!" & Chr(10) & Chr(10) & _
           "Week " & iWeek & " / " & iJaar & " (" & sPareOnpare & " week)" & Chr(10) & Chr(10) & _
           "Tabblad 'Mailmerge': " & nSheetRijen & " klanten" & Chr(10) & _
           "Kolom K = groente-bestel-URL, kolom U = koffie-bestel-URL." & Chr(10) & Chr(10) & _
           "GEEN DB-run aangemaakt — verstuur via Thunderbird-mailmerge" & Chr(10) & _
           "vanaf het tabblad 'Mailmerge'.", _
           64, "BereidCombiMailmergeVoor"

    Exit Sub

VerbindingsFout:
    MsgBox "Verbindingsfout: " & Err & " - " & Error & Chr(10) & _
           "Controleer of de SSH-tunnel actief is (poort 5433/5434).", 16, "Fout"
    SluitSSHTunnels()

End Sub

' =============================================
' Hulpfunctie: vervang spaties door + voor URL
' =============================================
Function JoinPlus(sInput As String) As String
    Dim i As Integer
    Dim sUit As String
    sUit = ""
    For i = 1 To Len(sInput)
        If Mid(sInput, i, 1) = " " Then
            sUit = sUit & "+"
        Else
            sUit = sUit & Mid(sInput, i, 1)
        End If
    Next i
    JoinPlus = sUit
End Function


' =============================================
' URL-encoding van een veldwaarde (query parameter)
' Laat A-Z a-z 0-9 - _ . ~ ongemoeid.
' ASCII speciale tekens (spatie, apostrof, &, =, ...) → %XX
' Latin-1 supplement U+00A0–U+00BF → UTF-8 %C2%XX
' Latin-1 supplement U+00C0–U+00FF → UTF-8 %C3%XX
' =============================================
Function UrlEncodeValue(sInput As String) As String
    Dim i   As Long
    Dim b   As Long
    Dim c   As String
    Dim sUit As String
    sUit = ""
    For i = 1 To Len(sInput)
        c = Mid(sInput, i, 1)
        b = Asc(c) And 255
        If (b >= 65 And b <= 90) Or (b >= 97 And b <= 122) Or _
           (b >= 48 And b <= 57) Or _
           b = 45 Or b = 95 Or b = 46 Or b = 126 Then
            sUit = sUit & c
        ElseIf b >= 192 Then
            ' Windows-1252 0xC0–0xFF = Unicode U+00C0–U+00FF
            ' UTF-8: 0xC3 gevolgd door (b - 0x40)
            sUit = sUit & "%C3%" & UCase(Right("0" & Hex(b - 64), 2))
        ElseIf b >= 160 Then
            ' Windows-1252 0xA0–0xBF = Unicode U+00A0–U+00BF
            ' UTF-8: 0xC2 gevolgd door b
            sUit = sUit & "%C2%" & UCase(Right("0" & Hex(b), 2))
        Else
            ' ASCII 0x00–0x7F en Windows-1252 0x80–0x9F: %XX
            sUit = sUit & "%" & UCase(Right("0" & Hex(b), 2))
        End If
    Next i
    UrlEncodeValue = sUit
End Function

Function Base64Encode(sInput As String) As String
    Const CHARS As String = _
        "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"

    Dim i    As Long
    Dim b0   As Long
    Dim b1   As Long
    Dim b2   As Long
    Dim sOut As String
    Dim nLen As Long
    nLen = Len(sInput)
    sOut = ""
    i = 1

    Do While i <= nLen
        ' Bytes ophalen — And 255 om negatieve waarden te vermijden
        b0 = Asc(Mid(sInput, i, 1)) And 255
        b1 = 0 : b2 = 0
        If i + 1 <= nLen Then b1 = Asc(Mid(sInput, i + 1, 1)) And 255
        If i + 2 <= nLen Then b2 = Asc(Mid(sInput, i + 2, 1)) And 255

        ' 3 bytes → 4 Base64-tekens
        sOut = sOut & Mid(CHARS, (b0 \ 4) + 1, 1)
        sOut = sOut & Mid(CHARS, ((b0 And 3) * 16) + (b1 \ 16) + 1, 1)

        If i + 1 <= nLen Then
            sOut = sOut & Mid(CHARS, ((b1 And 15) * 4) + (b2 \ 64) + 1, 1)
        Else
            sOut = sOut & "="
        End If

        If i + 2 <= nLen Then
            sOut = sOut & Mid(CHARS, (b2 And 63) + 1, 1)
        Else
            sOut = sOut & "="
        End If

        i = i + 3
    Loop

    Base64Encode = sOut
End Function

' =============================================
' URL-safe Base64 (+ → -, / → _, geen padding =)
' Zo vermijd je problemen in query-parameters
' =============================================
Function Base64UrlEncode(sInput As String) As String
    Dim s As String
    s = Base64Encode(sInput)
    ' Vervang tekens die problemen geven in URLs
    Dim i As Integer
    Dim sOut As String
    sOut = ""
    For i = 1 To Len(s)
        Dim c As String
        c = Mid(s, i, 1)
        If c = "+" Then
            sOut = sOut & "-"
        ElseIf c = "/" Then
            sOut = sOut & "_"
        ElseIf c = "=" Then
            ' padding weglaten
        Else
            sOut = sOut & c
        End If
    Next i
    Base64UrlEncode = sOut
End Function

