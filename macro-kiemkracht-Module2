' Kolomindex (0-based) van een kop in rij 0, of -1 als niet gevonden.
' Maakt het inlezen van een vorig bestand robuust tegen kolomverschuivingen.
Function ZoekKolomKop(oSheet As Object, sKop As String) As Integer
    Dim c As Integer
    ZoekKolomKop = -1
    For c = 0 To 60
        If LCase(oSheet.getCellByPosition(c, 0).getString()) = LCase(sKop) Then
            ZoekKolomKop = c
            Exit Function
        End If
    Next c
End Function

' Reeds-open spreadsheetdocument met deze URL teruggeven, anders Null.
Function VindOpenDocument(sUrl As String) As Object
    Dim oEnum As Object, oComp As Object
    oEnum = StarDesktop.Components.createEnumeration()
    Do While oEnum.hasMoreElements()
        oComp = oEnum.nextElement()
        If HasUnoInterfaces(oComp, "com.sun.star.lang.XServiceInfo") Then
            If oComp.supportsService("com.sun.star.sheet.SpreadsheetDocument") Then
                If oComp.getURL() = sUrl Then
                    VindOpenDocument = oComp
                    Exit Function
                End If
            End If
        End If
    Loop
End Function

' Bedrag als string met 2 decimalen en komma, bv. 51.3 -> "51,30".
' Locale-onafhankelijk opgebouwd (geen Format), want Format hangt af van
' de systeemtaal en gaf eerder mojibake/punt-komma-verwarring.
Function FmtNum2(dValue As Double) As String
    Dim dAbs As Double, lCents As Long, lWhole As Long, iFrac As Integer, sOut As String
    dAbs   = Abs(dValue)
    lCents = Int(dAbs * 100 + 0.5)
    lWhole = lCents \ 100
    iFrac  = lCents Mod 100
    sOut   = CStr(lWhole) & "," & Right("0" & CStr(iFrac), 2)
    If dValue < 0 Then sOut = "-" & sOut
    FmtNum2 = sOut
End Function

' Als FmtNum2, maar ronde bedragen zonder ",00": 7 -> "7", 2,25 -> "2,25".
Function FmtNumTrim(dValue As Double) As String
    Dim s As String
    s = FmtNum2(dValue)
    If Right(s, 3) = ",00" Then s = Left(s, Len(s) - 3)
    FmtNumTrim = s
End Function

' Zoekt het canonieke, GEFINALISEERDE weekbestand voor (wk, jaar, omgeving):
' uitsluitend het exacte "week_<wk>_<jaar><omg>_definitief.ods" in sMap
' (omg = "" prod, "-dev" dev). Bewust GEEN fuzzy match: working copies
' ("week_<wk>_<jaar>.ods") en label-exports ("_etiketten"/"_bijbestelling")
' mogen NOOIT als databron dienen — die bevatten niet de gefinaliseerde
' bijbestellingen. Niet gevonden -> "" (week wordt overgeslagen + gemeld in de
' eindpopup). Vroegere bug (2026-06-27): de eerste Dir()-treffer koos soms de
' working copy zonder de ingevoerde bijbestellingen -> saldo te laag.
Function ZoekWeekbestand(sMap As String, iWk As Integer, iJr As Integer, sOmg As String) As String
    Dim sNaam As String
    sNaam = "week_" & iWk & "_" & iJr & sOmg & "_definitief.ods"
    If FileExists(sMap & sNaam) Then
        ZoekWeekbestand = sMap & sNaam
    Else
        ZoekWeekbestand = ""
    End If
End Function

' Eerste letter naar hoofdletter ("donderdag" -> "Donderdag").
Function KapWoord(s As String) As String
    If Len(s) = 0 Then
        KapWoord = ""
    Else
        KapWoord = UCase(Left(s, 1)) & Mid(s, 2)
    End If
End Function
