' =============================================
' Kiemkracht - Maandafrekening voorbereiden
'
' Bouwt EEN maandbestand (mailmerge-bron) door per klant de gegevens
' te plukken uit de weekbestanden van een maand. Werkt zelfstandig op
' de reeds afgewerkte weekbestanden (met jouw manuele correcties) —
' geen database, en de weekbestanden hoeven NIET hergenereerd te worden.
'
' Welke weekbestanden? Alle ISO-weken waarvan de donderdag in de
' doelmaand valt (zelfde logica als MaakWeekbestand: de week "hoort"
' bij de maand van zijn donderdag). Zoekt in <jaarmap>\<jaar>_week_<wk>\
' het eerste .ods dat begint met "week_<wk>_<jaar>" (extra suffixen zoals
' _definitief worden transparant herkend via ZoekWeekbestand).
'
' Per klant (gesleuteld op klant_id, anders e-mail, anders naam):
'   - Saldo   = som van afrekening!E (TOTAAL) over de weken
'   - per leverweek n: "Pakket n als" + "Bijb n als"
'       Pakket n als : "<leverdatum>: 1 x <Pakket>, <bedrag> €"
'       Bijb n als   : "<leverdatum>: <losse groenten> & <weglatingen>"
'   Losse groenten en weglatingen worden in TWEE varianten geschreven:
'       "Bijb n als"               -> items met " & " (Thunderbird-mailmerge,
'                                     waar echte regeleindes lastig zijn)
'       "Bijb n als (regeleindes)" -> items met echte regeleindes (CHAR 10),
'                                     voor de PHP/ZeptoMail-flow
'   Weglatingen worden per groente getoond ("geen rabarber: -3,00 €"),
'   met de waarde uit de afrekening-detailkolommen (AZ+).
'
' Output: <jaarmap>\afrekening_<maand>_<jaar>[-dev].ods, 1 rij per klant,
' kolomhoofden = de mailmerge-placeholders ({{Voornaam}}, {{Saldo}}, ...).
' =============================================
Sub MaakMaandbestand()

    ' Bestandslocatie: zie JaarMap() — weken én maandafrekening per jaar gegroepeerd.
    ' Databstblad-kolommen (0-based), exact zoals MaakWeekbestand ze schrijft
    Const cdNaam    = 0    ' voornaam + familienaam
    Const cdEmail   = 6
    Const cdVoor    = 8
    Const cdDag     = 10   ' leverdag = klaarmaakdag (donderdag/vrijdag) — fallback
    Const cdAfhDag  = 13   ' dag afhaling (afhaaldag klant; voorkeur boven cdDag)
    Const cdKlantId = 15   ' kolom P
    Const cdKG      = 17
    Const cdGG      = 18
    Const cdEGG     = 19
    Const cdMINI    = 20
    Const cdGroent0 = 24   ' eerste losse-groentekolom (Y); naam in rij 2, prijs in rij 3
    ' Afrekening-tabblad
    Const caBedrag  = 1    ' B = pakket-bedrag
    Const caTotaal  = 4    ' E = TOTAAL
    Const caWeg0    = 51   ' AZ = eerste weglating-detailkolom (vast: 24+24+3)
    Const NWEKEN    = 5    ' vaste leverweek-slots (max donderdagen in een maand)

    Dim saMaanden(12) As String
    saMaanden(1)="januari"  : saMaanden(2)="februari" : saMaanden(3)="maart"
    saMaanden(4)="april"    : saMaanden(5)="mei"      : saMaanden(6)="juni"
    saMaanden(7)="juli"     : saMaanden(8)="augustus" : saMaanden(9)="september"
    saMaanden(10)="oktober" : saMaanden(11)="november": saMaanden(12)="december"

    ' --- doelmaand (default = vorige maand) ---
    Dim dNu As Date, iTM As Integer, iJaar As Integer
    dNu = Now()
    iTM = Month(dNu) - 1 : iJaar = Year(dNu)
    If iTM < 1 Then iTM = 12 : iJaar = iJaar - 1
    Dim sIn As String
    sIn = InputBox("Voor welke maand een afrekening maken?" & Chr(10) & _
                   "Formaat: MM JJJJ (bv. 05 2026)", "Maandafrekening", _
                   Right("0" & iTM, 2) & " " & iJaar)
    If Trim(sIn) = "" Then Exit Sub
    sIn = Trim(sIn)
    Dim iSp As Integer : iSp = InStr(sIn, " ")
    If iSp = 0 Then MsgBox "Ongeldige invoer. Gebruik 'MM JJJJ'.", 16, "Maandafrekening" : Exit Sub
    iTM   = CInt(Left(sIn, iSp - 1))
    iJaar = CInt(Trim(Mid(sIn, iSp + 1)))
    If iTM < 1 Or iTM > 12 Then MsgBox "Maand moet 1-12 zijn.", 16, "Maandafrekening" : Exit Sub
    Dim sMaandNaam As String : sMaandNaam = saMaanden(iTM)

    ' --- omgeving-suffix: volgt actief data-bestand, standaard prod ---
    Dim sOmg As String : sOmg = ""
    Dim oActief As Object : oActief = HuidigDataDocument()
    If Not IsNull(oActief) Then
        If InStr(LCase(oActief.getURL()), "-dev.ods") > 0 Then sOmg = "-dev"
    End If

    ' --- kandidaat-weken: ISO-weken met donderdag in de doelmaand ---
    Dim dJan4 As Date, dWk1Ma As Date, dThu As Date
    dJan4  = DateSerial(iJaar, 1, 4)
    dWk1Ma = dJan4 - (Weekday(dJan4, 2) - 1)   ' maandag van ISO-week 1
    Dim wkNr(60) As Integer, wkThu(60) As Date, nWk As Integer
    Dim wk As Integer
    nWk = 0
    For wk = 1 To 53
        dThu = dWk1Ma + (wk - 1) * 7 + 3
        If Year(dThu) = iJaar And Month(dThu) = iTM Then
            wkNr(nWk) = wk : wkThu(nWk) = dThu : nWk = nWk + 1
        End If
    Next wk
    If nWk = 0 Then MsgBox "Geen weken gevonden voor die maand.", 16, "Maandafrekening" : Exit Sub

    ' --- klant-aggregatie ---
    Dim mKey(600) As String, mKid(600) As String, mVoor(600) As String
    Dim mNaam(600) As String, mEmail(600) As String, mSaldo(600) As Double
    Dim mPak(600, 8) As String, mBijA(600, 8) As String, mBijN(600, 8) As String
    Dim mVorig(600) As Double, mOntv(600) As Double, mHist(600) As Boolean
    Dim mAfhDag(600) As String
    Dim nKl As Integer : nKl = 0

    Dim oDesktop As Object : oDesktop = createUnoService("com.sun.star.frame.Desktop")
    Dim aHidden(0) As New com.sun.star.beans.PropertyValue
    aHidden(0).Name = "Hidden" : aHidden(0).Value = True

    ' Alle lus-variabelen vooraan (LO Basic struikelt op Dim binnen een lus)
    Dim wi As Integer, sPad As String, sUrlW As String
    Dim oWeek As Object, bSluiten As Boolean
    Dim oData As Object, oAfr As Object, oBlad2 As Object, bBlad2 As Boolean
    Dim nGroenten As Integer, nWeg As Integer
    Dim gName(80) As String, gPrice(80) As Double, gEenh(80) As String
    Dim wName(40) As String
    Dim g As Integer, w As Integer, rr As Integer, blanks As Integer
    Dim sNaam As String, sAfhM As String, sKid As String
    Dim sEmail As String, sVoor As String, sLev As String
    Dim dLever As Date, sDatum As String, sDayWord As String
    Dim sPak As String, dBedrag As Double, q As Double, dVal As Double, dTot As Double, cnt As Double
    Dim sItemsA As String, sItemsN As String, sItem As String
    Dim sKey As String, ki As Integer, kFound As Integer
    Dim nVerwerkt As Integer : nVerwerkt = 0
    Dim sEmailWijzigingen As String : sEmailWijzigingen = ""
    ' Vorige-maand carry-over (Vorig saldo / Ontvangen)
    Dim iVM As Integer, iVJaar As Integer
    Dim sVorigNaam As String, sVorigPad As String, sVorigUrl As String
    Dim oVorig As Object, oVAfr As Object, oVOp As Object
    Dim bVorigSluiten As Boolean, bVorigGevonden As Boolean
    Dim pr As Integer, pBlanks As Integer
    Dim sPKid As String, sPNaam As String, sPEmail As String, sPVoor As String, sPKey As String
    Dim dPSaldo As Double, dPOntv As Double
    ' "Ontvangen"-koppeling uit "opvolgen betalingen" op klant_id (niet op rijnummer)
    Dim cOKid As Integer, cONaam As Integer, cOEmail As Integer, cOTot As Integer
    Dim sOKid As String, sONaam As String, sOEmail As String, sOKey As String
    Dim opKey(800) As String, opOntv(800) As Double, nOp As Integer, oi As Integer
    Dim nOvergedragen As Integer : nOvergedragen = 0
    Dim sGeenKid As String : sGeenKid = ""
    Dim sGeenEmail As String : sGeenEmail = ""

    For wi = 0 To nWk - 1
        ' Bestand zoeken: de exacte naam kan variëren (bv. _definitief-suffix).
        ' Strategie: zoek in de weekmap het eerste .ods-bestand waarvan de naam
        ' begint met "week_<wk>_<jaar>" en de omgevingssuffix bevat.
        Dim sWeekMap As String
        sWeekMap = JaarMap(iJaar) & iJaar & "_week_" & wkNr(wi) & "\"
        sPad = ZoekWeekbestand(sWeekMap, wkNr(wi), iJaar, sOmg)
        If sPad = "" Then GoTo VolgendeWeek
        sUrlW = ConvertToURL(sPad)

        ' Al open (jij bekijkt het bestand)? Hergebruiken, niet sluiten.
        oWeek = VindOpenDocument(sUrlW)
        If IsNull(oWeek) Then
            oWeek = oDesktop.loadComponentFromURL(sUrlW, "_blank", 0, aHidden())
            bSluiten = True
        Else
            bSluiten = False
        End If
        If IsNull(oWeek) Then GoTo VolgendeWeek
        If Not oWeek.Sheets.hasByName("afrekening") Then
            If bSluiten Then oWeek.close(True)
            GoTo VolgendeWeek
        End If

        oWeek.calculateAll()
        oData = oWeek.Sheets.getByIndex(0)
        oAfr  = oWeek.Sheets.getByName("afrekening")
        bBlad2 = oWeek.Sheets.hasByName("Blad2")
        If bBlad2 Then oBlad2 = oWeek.Sheets.getByName("Blad2")

        ' Groente-metadata
        nGroenten = 0
        Do While oData.getCellByPosition(cdGroent0 + nGroenten, 1).getString() <> "" And nGroenten < 80
            nGroenten = nGroenten + 1
        Loop
        For g = 0 To nGroenten - 1
            gName(g)  = oData.getCellByPosition(cdGroent0 + g, 1).getString()
            gPrice(g) = oData.getCellByPosition(cdGroent0 + g, 2).getValue()
            gEenh(g)  = ""
            If bBlad2 Then gEenh(g) = oBlad2.getCellByPosition(8, g).getString()
        Next g

        ' Weglating-namen (koprij afrekening, vanaf AZ)
        ' Scan een vaste reeks (0..39) en onthoud de LAATSTE niet-lege kolom, zodat
        ' een handmatig toegevoegde weglating in een niet-aansluitende kolom (gat
        ' ertussen) toch meetelt. De klantloop hieronder checkt elke cel apart.
        nWeg = 0
        For w = 0 To 39
            wName(w) = oAfr.getCellByPosition(caWeg0 + w, 5).getString()
            If wName(w) <> "" Then nWeg = w + 1
        Next w

        ' Klantrijen (vanaf rij 7 = index 6)
        blanks = 0 : rr = 6
        Do While blanks < 10 And rr < 5000
            sNaam = oData.getCellByPosition(cdNaam, rr).getString()
            If sNaam = "" Then
                blanks = blanks + 1
                GoTo VolgendeRij
            End If
            blanks = 0
            sAfhM = oData.getCellByPosition(1, rr).getString()
            If sAfhM = "afhaalpunt/dag" Then GoTo VolgendeRij   ' koprij afhaalpunt

            sKid   = Trim(oData.getCellByPosition(cdKlantId, rr).getString())
            sEmail = oData.getCellByPosition(cdEmail, rr).getString()
            sVoor  = oData.getCellByPosition(cdVoor, rr).getString()
            sLev   = LCase(Trim(oData.getCellByPosition(cdDag, rr).getString()))

            If sKid <> "" Then
                sKey = "K:" & sKid
            ElseIf sEmail <> "" Then
                sKey = "E:" & LCase(sEmail)
            Else
                sKey = "N:" & LCase(sNaam)
            End If

            ' Leverdatum (donderdag van deze week; vrijdag-afhaalpunt = +1)
            dLever = wkThu(wi)
            If Left(sLev, 2) = "vr" Then dLever = dLever + 1
            sDatum = KapWoord(sLev)
            If sDatum = "" Then sDatum = "Donderdag"
            sDatum = sDatum & " " & Day(dLever) & " " & saMaanden(Month(dLever))

            ' Pakketregel
            sPak = ""
            dBedrag = oAfr.getCellByPosition(caBedrag, rr).getValue()
            cnt = oData.getCellByPosition(cdKG, rr).getValue()
            If cnt > 0 Then sPak = FmtNumTrim(cnt) & " x Klein groentenpakket"
            cnt = oData.getCellByPosition(cdGG, rr).getValue()
            If cnt > 0 Then
                If sPak <> "" Then sPak = sPak & " & "
                sPak = sPak & FmtNumTrim(cnt) & " x Groot groentenpakket"
            End If
            cnt = oData.getCellByPosition(cdEGG, rr).getValue()
            If cnt > 0 Then
                If sPak <> "" Then sPak = sPak & " & "
                sPak = sPak & FmtNumTrim(cnt) & " x Extra groot groentenpakket"
            End If
            cnt = oData.getCellByPosition(cdMINI, rr).getValue()
            If cnt > 0 Then
                If sPak <> "" Then sPak = sPak & " & "
                sPak = sPak & FmtNumTrim(cnt) & " x Mini groentenpakket"
            End If
            If sPak <> "" Then sPak = sDatum & ": " & sPak & ", " & FmtNumTrim(dBedrag) & " " & Chr(8364)

            ' Bijbestelling: losse groenten + weglatingen, twee join-varianten
            sItemsA = "" : sItemsN = ""
            For g = 0 To nGroenten - 1
                q = oData.getCellByPosition(cdGroent0 + g, rr).getValue()
                If q > 0 Then
                    sItem = gName(g) & ": " & FmtNumTrim(q) & " " & gEenh(g) & _
                            " aan " & FmtNumTrim(gPrice(g)) & Chr(8364)
                    If sItemsA <> "" Then sItemsA = sItemsA & " & " : sItemsN = sItemsN & Chr(10)
                    sItemsA = sItemsA & sItem
                    sItemsN = sItemsN & sItem
                End If
            Next g
            For w = 0 To nWeg - 1
                If oAfr.getCellByPosition(caWeg0 + w, rr).getString() <> "" Then
                    dVal = oAfr.getCellByPosition(caWeg0 + w, rr).getValue()
                    If dVal > 0 Then
                        sItem = "geen " & LCase(wName(w)) & ": -" & FmtNum2(dVal) & Chr(8364)
                        If sItemsA <> "" Then sItemsA = sItemsA & " & " : sItemsN = sItemsN & Chr(10)
                        sItemsA = sItemsA & sItem
                        sItemsN = sItemsN & sItem
                    End If
                End If
            Next w

            dTot = oAfr.getCellByPosition(caTotaal, rr).getValue()

            ' Klant opzoeken/aanmaken
            kFound = -1
            For ki = 0 To nKl - 1
                If mKey(ki) = sKey Then kFound = ki : Exit For
            Next ki
            If kFound = -1 Then
                kFound = nKl
                mKey(nKl)   = sKey
                mKid(nKl)   = sKid
                mVoor(nKl)  = sVoor
                mNaam(nKl)  = sNaam
                mEmail(nKl) = sEmail
                mSaldo(nKl) = 0
                nKl = nKl + 1
            Else
                If sEmail <> "" Then
                    If mEmail(kFound) <> "" And LCase(sEmail) <> LCase(mEmail(kFound)) Then
                        sEmailWijzigingen = sEmailWijzigingen & "  " & mNaam(kFound) & ": " & mEmail(kFound) & " -> " & sEmail & Chr(10)
                    End If
                    mEmail(kFound) = sEmail
                End If
                If mVoor(kFound)  = "" Then mVoor(kFound)  = sVoor
            End If
            mSaldo(kFound) = mSaldo(kFound) + dTot
            If sPak <> "" Then mPak(kFound, wi) = sPak
            If sItemsA <> "" Then
                mBijA(kFound, wi) = sDatum & ": " & sItemsA
                mBijN(kFound, wi) = sDatum & ": " & sItemsN
            End If

            VolgendeRij:
            rr = rr + 1
        Loop

        If bSluiten Then oWeek.close(True)
        nVerwerkt = nVerwerkt + 1

        VolgendeWeek:
    Next wi

    If nVerwerkt = 0 Then MsgBox "Geen weekbestanden gevonden voor " & sMaandNaam & " " & iJaar & _
                                 "." & Chr(10) & "Verwacht in: " & JaarMap(iJaar), 48, "Maandafrekening" : Exit Sub

    ' --- vorige maand inlezen: Vorig saldo (G) + Ontvangen (H) per klant ---
    ' Exact bestand: afrekening_<vorige maand>_<jaar><omg>_definitief.ods in de jaarmap
    ' van het VORIGE jaar (klopt automatisch over de jaarwisseling). Niet gevonden ->
    ' melden en doorgaan met lege G/H. Klanten die vorige maand nog openstonden maar
    ' deze maand niets bestelden, worden als losse rij overgedragen (herinnering).
    iVM = iTM - 1 : iVJaar = iJaar
    If iVM < 1 Then iVM = 12 : iVJaar = iVJaar - 1
    sVorigNaam = "afrekening_" & saMaanden(iVM) & "_" & iVJaar & sOmg & "_definitief.ods"
    sVorigPad  = JaarMap(iVJaar) & sVorigNaam
    If FileExists(sVorigPad) Then
        sVorigUrl = ConvertToURL(sVorigPad)
        oVorig = VindOpenDocument(sVorigUrl)          ' hergebruik als al open
        If IsNull(oVorig) Then
            oVorig = oDesktop.loadComponentFromURL(sVorigUrl, "_blank", 0, aHidden())
            bVorigSluiten = True
        Else
            bVorigSluiten = False
        End If
        If Not IsNull(oVorig) Then
            If oVorig.Sheets.hasByName("afrekening") And oVorig.Sheets.hasByName("opvolgen betalingen") Then
                oVorig.calculateAll()
                oVAfr = oVorig.Sheets.getByName("afrekening")
                oVOp  = oVorig.Sheets.getByName("opvolgen betalingen")
                ' Volledig op kop-opzoeking (ZoekKolomKop, hoofdletter-ongevoelig): de
                ' kolomvolgorde van BEIDE tabbladen kan wijzigen. Identiteit + Saldo uit
                ' het afrekening-tab; "Totaal betaald" bestaat enkel in "opvolgen betalingen".
                Dim cVKid As Integer, cVNaam As Integer, cVEmail As Integer
                Dim cVVoor As Integer, cVSaldo As Integer
                cVKid   = ZoekKolomKop(oVAfr, "klant_id")
                cVNaam  = ZoekKolomKop(oVAfr, "Voornaam Familienaam")
                cVEmail = ZoekKolomKop(oVAfr, "Email")
                cVVoor  = ZoekKolomKop(oVAfr, "Voornaam")
                cVSaldo = ZoekKolomKop(oVAfr, "Saldo")
                ' "Ontvangen" (Totaal betaald) komt uit "opvolgen betalingen", maar wordt
                ' op klant_id (anders e-mail, anders naam) gekoppeld i.p.v. op rijnummer.
                ' Bouw daarom eerst een map uit DAT tab zelf. Vroeger las de macro het
                ' bedrag op hetzelfde rijnummer als het afrekening-tab; één ingevoegde/
                ' verwijderde rij in één van beide tabbladen (bv. een witregel) gaf dan
                ' vanaf die rij een verschuiving: elke klant kreeg het Ontvangen-bedrag
                ' van de vorige klant. De koppeling hieronder is daar ongevoelig voor.
                cOKid   = ZoekKolomKop(oVOp, "klant_id")
                cONaam  = ZoekKolomKop(oVOp, "Voornaam Familienaam")
                cOEmail = ZoekKolomKop(oVOp, "Email")
                cOTot   = ZoekKolomKop(oVOp, "Totaal betaald")
                nOp = 0
                If cONaam >= 0 And cOTot >= 0 Then
                    pBlanks = 0 : pr = 1
                    Do While pBlanks < 10 And pr < 5000
                        sONaam = oVOp.getCellByPosition(cONaam, pr).getString()
                        If sONaam = "" Then
                            pBlanks = pBlanks + 1
                            GoTo VolgendeOpRij
                        End If
                        pBlanks = 0
                        sOKid = "" : sOEmail = ""
                        If cOKid   >= 0 Then sOKid   = Trim(oVOp.getCellByPosition(cOKid, pr).getString())
                        If cOEmail >= 0 Then sOEmail = oVOp.getCellByPosition(cOEmail, pr).getString()
                        If sOKid <> "" Then
                            sOKey = "K:" & sOKid
                        ElseIf sOEmail <> "" Then
                            sOKey = "E:" & LCase(sOEmail)
                        Else
                            sOKey = "N:" & LCase(sONaam)
                        End If
                        If nOp <= UBound(opKey) Then
                            opKey(nOp)  = sOKey
                            opOntv(nOp) = oVOp.getCellByPosition(cOTot, pr).getValue()
                            nOp = nOp + 1
                        End If
                        VolgendeOpRij:
                        pr = pr + 1
                    Loop
                End If
                If cVNaam >= 0 And cVSaldo >= 0 And cOTot >= 0 Then bVorigGevonden = True
                If bVorigGevonden Then pBlanks = 0 Else pBlanks = 10   ' koppen niet herkend -> loop overslaan
                pr = 1
                Do While pBlanks < 10 And pr < 5000
                    sPNaam = oVAfr.getCellByPosition(cVNaam, pr).getString()
                    If sPNaam = "" Then
                        pBlanks = pBlanks + 1
                        GoTo VolgendeVorigeRij
                    End If
                    pBlanks = 0
                    sPKid = "" : sPEmail = "" : sPVoor = ""
                    If cVKid   >= 0 Then sPKid   = Trim(oVAfr.getCellByPosition(cVKid, pr).getString())
                    If cVEmail >= 0 Then sPEmail = oVAfr.getCellByPosition(cVEmail, pr).getString()
                    If cVVoor  >= 0 Then sPVoor  = oVAfr.getCellByPosition(cVVoor, pr).getString()
                    dPSaldo = oVAfr.getCellByPosition(cVSaldo, pr).getValue()  ' Saldo -> Vorig saldo
                    ' Sleutel identiek aan de maand-aggregatie (klant_id, anders e-mail, anders naam)
                    If sPKid <> "" Then
                        sPKey = "K:" & sPKid
                    ElseIf sPEmail <> "" Then
                        sPKey = "E:" & LCase(sPEmail)
                    Else
                        sPKey = "N:" & LCase(sPNaam)
                    End If
                    ' Ontvangen (Totaal betaald) op klant_id koppelen met "opvolgen
                    ' betalingen" -> robuust tegen rij-verschuiving tussen de tabbladen.
                    dPOntv = 0
                    For oi = 0 To nOp - 1
                        If opKey(oi) = sPKey Then dPOntv = opOntv(oi) : Exit For
                    Next oi
                    kFound = -1
                    For ki = 0 To nKl - 1
                        If mKey(ki) = sPKey Then kFound = ki : Exit For
                    Next ki
                    If kFound >= 0 Then
                        mVorig(kFound) = dPSaldo : mOntv(kFound) = dPOntv : mHist(kFound) = True
                    ElseIf Abs(dPSaldo - dPOntv) >= 0.005 Then
                        ' Deze maand niets besteld, maar nog openstaand -> overdragen als herinnering
                        mKey(nKl)   = sPKey  : mKid(nKl)   = sPKid
                        mVoor(nKl)  = sPVoor : mNaam(nKl)  = sPNaam : mEmail(nKl) = sPEmail
                        mSaldo(nKl) = 0
                        mVorig(nKl) = dPSaldo : mOntv(nKl) = dPOntv : mHist(nKl) = True
                        nKl = nKl + 1 : nOvergedragen = nOvergedragen + 1
                    End If
                    VolgendeVorigeRij:
                    pr = pr + 1
                Loop
            End If
            If bVorigSluiten Then oVorig.close(True)
        End If
    End If

    ' --- maandbestand opbouwen ---
    Dim oOut As Object, oS As Object
    Dim aOut(0) As New com.sun.star.beans.PropertyValue
    aOut(0).Name = "Hidden" : aOut(0).Value = True
    oOut = oDesktop.loadComponentFromURL("private:factory/scalc", "_blank", 0, aOut())
    oS = oOut.Sheets.getByIndex(0)
    oS.Name = "afrekening"

    oS.getCellByPosition(0, 0).setString("Voornaam Familienaam")
    oS.getCellByPosition(1, 0).setString("klant_id")
    oS.getCellByPosition(2, 0).setString("Voornaam2 Familienaam2")
    oS.getCellByPosition(3, 0).setString("Email")
    oS.getCellByPosition(4, 0).setString("Voornaam")
    oS.getCellByPosition(5, 0).setString("Maand")
    oS.getCellByPosition(6, 0).setString("Saldo")
    oS.getCellByPosition(7, 0).setString("Vorig saldo")
    oS.getCellByPosition(8, 0).setString("Ontvangen")
    oS.getCellByPosition(9, 0).setString("Verschil")    ' J = Vorig saldo - Ontvangen
    ' Saldo=G, Vorig saldo=H, Ontvangen=I, Verschil=J (=H-I), Besteld=K.
    ' Per week 2 ruwe kolommen (L..) + 2 mailmerge-kolommen (V..). Weekkolommen starten op L.
    oS.getCellByPosition(10, 0).setString("Besteld in maand")
    Dim n As Integer
    For wi = 0 To NWEKEN - 1
        n = wi + 1
        oS.getCellByPosition(11 + wi * 2,      0).setString("Pakket week " & n)
        oS.getCellByPosition(11 + wi * 2 + 1,  0).setString("Bijbestellingen week " & n)
        oS.getCellByPosition(21 + wi * 2,      0).setString("Pakket " & n & " als")
        oS.getCellByPosition(21 + wi * 2 + 1,  0).setString("Bijb " & n & " als")
    Next wi
    Dim nKol As Integer : nKol = 11 + NWEKEN * 4

    ' Sorteren op naam (insertion sort op index-array)
    Dim ord(600) As Integer, i2 As Integer, j2 As Integer, tmp As Integer
    For i2 = 0 To nKl - 1 : ord(i2) = i2 : Next i2
    For i2 = 1 To nKl - 1
        tmp = ord(i2) : j2 = i2 - 1
        Do While j2 >= 0
            If LCase(mNaam(ord(j2))) > LCase(mNaam(tmp)) Then
                ord(j2 + 1) = ord(j2) : j2 = j2 - 1
            Else
                Exit Do
            End If
        Loop
        ord(j2 + 1) = tmp
    Next i2

    ' Rijen schrijven (enkel klanten met een saldo)
    ' Rijen 1-5 (index 1-5) leeg laten; data start op index 6 (rij 7 in het blad).
    Dim ro As Integer : ro = 6
    Dim idx As Integer, sSaldoRaw As String
    For i2 = 0 To nKl - 1
        idx = ord(i2)
        ' Tonen zodra het totaal (deze maand + overgedragen saldo) niet ~0 is
        If Abs(mSaldo(idx) + mVorig(idx) - mOntv(idx)) < 0.005 Then GoTo VolgendeUit
        oS.getCellByPosition(0, ro).setString(mNaam(idx))   ' Voornaam Familienaam
        oS.getCellByPosition(1, ro).setString(mKid(idx))    ' klant_id
        ' kolom 2 = "Voornaam2 Familienaam2": leeg (manueel in te vullen)
        oS.getCellByPosition(3, ro).setString(mEmail(idx))
        oS.getCellByPosition(4, ro).setString(mVoor(idx))
        oS.getCellByPosition(5, ro).setString(sMaandNaam)
        oS.getCellByPosition(10, ro).setValue(mSaldo(idx))  ' K = Besteld in maand (hardgetal)
        oS.getCellByPosition(6, ro).setFormula("=K" & (ro + 1) & "+J" & (ro + 1))  ' G Saldo = Besteld + Verschil
        If mHist(idx) Then
            oS.getCellByPosition(7, ro).setValue(mVorig(idx))   ' Vorig saldo (uit vorige maand)
            oS.getCellByPosition(8, ro).setValue(mOntv(idx))    ' Ontvangen (Totaal betaald vorige maand)
        End If
        ' J Verschil = Vorig saldo - Ontvangen, maar eerst beide naar centen ronden
        ' zodat een sub-cent afrondingsresidu (Saldo heeft soms 3-4 decimalen) niet
        ' als spook-saldo (bv. -0,01) blijft hangen of mee overgedragen wordt.
        oS.getCellByPosition(9, ro).setFormula("=ROUND(H" & (ro + 1) & ";2)-ROUND(I" & (ro + 1) & ";2)")   ' J Verschil
        If Trim(mKid(idx)) = "" Then sGeenKid = sGeenKid & "  - " & mNaam(idx) & Chr(10)
        If Trim(mEmail(idx)) = "" Then sGeenEmail = sGeenEmail & "  - " & mNaam(idx) & Chr(10)
        For wi = 0 To NWEKEN - 1
            ' ruwe inhoud (enkel voor weken die deze maand bestaan)
            If wi < nWk Then
                If mPak(idx, wi)  <> "" Then oS.getCellByPosition(11 + wi * 2,     ro).setString(mPak(idx, wi))
                If mBijA(idx, wi) <> "" Then oS.getCellByPosition(11 + wi * 2 + 1, ro).setString(mBijA(idx, wi))
            End If
            ' "als"-formules: lege ruwe cel -> "|"
            oS.getCellByPosition(21 + wi * 2, ro).setFormula( _
                "=IF(" & KolomLetter(11 + wi * 2) & (ro + 1) & "="""";""|"";" & _
                KolomLetter(11 + wi * 2) & (ro + 1) & ")")
            oS.getCellByPosition(21 + wi * 2 + 1, ro).setFormula( _
                "=IF(" & KolomLetter(11 + wi * 2 + 1) & (ro + 1) & "="""";""|"";" & _
                KolomLetter(11 + wi * 2 + 1) & (ro + 1) & ")")
        Next wi
        ro = ro + 1
        VolgendeUit:
    Next i2

    ' Getalopmaak kolom F (Saldo) zodat =SOM() werkt en het leesbaar is
    Dim oFmtsMb As Object : oFmtsMb = oOut.getNumberFormats()
    Dim oLocMb As New com.sun.star.lang.Locale
    oLocMb.Language = "nl" : oLocMb.Country = "BE"
    Dim nFmtMb As Long, sFmtMb As String
    sFmtMb = "0,00"
    nFmtMb = oFmtsMb.queryKey(sFmtMb, oLocMb, False)
    If nFmtMb = -1 Then nFmtMb = oFmtsMb.addNew(sFmtMb, oLocMb)
    If ro > 6 Then oS.getCellRangeByPosition(6, 6, 10, ro - 1).NumberFormat = nFmtMb

    ' Opmaak
    Dim oHdr As Object
    oHdr = oS.getCellRangeByPosition(0, 0, nKol - 1, 0)
    oHdr.CharWeight = com.sun.star.awt.FontWeight.BOLD
    oHdr.CellBackColor = RGB(204, 204, 204)
    oS.getCellRangeByPosition(0, 1, nKol - 1, 5).CellBackColor = RGB(242, 242, 242)
    Dim oHint As Object
    oHint = oS.getCellRangeByPosition(0, 1, 0, 3)   ' A2:A4
    oHint.CharHeight = 8
    oHint.CharPosture = com.sun.star.awt.FontSlant.ITALIC
    oS.getCellByPosition(0, 1).setString("sneltoetsen: Ctrl + F = zoeken op naam in kolom A")
    oS.getCellByPosition(0, 2).setString("Ctrl + A = alle rijen tonen")
    oS.getCellByPosition(0, 3).setString("Ctrl + 0 (nul) = cursor bovenaan met begin zichtbaar")
    oS.Columns.getByIndex(0).Width = 5260   ' A Voornaam Familienaam = 5,26 cm
    oS.Columns.getByIndex(1).Width = 1500   ' B klant_id = 1,50 cm
    oS.Columns.getByIndex(2).Width = 5260   ' C Voornaam2 Familienaam2 = 5,26 cm
    oS.Columns.getByIndex(3).Width = 5000   ' D Email
    oS.Columns.getByIndex(4).Width = 2400   ' E Voornaam = 2,40 cm
    oS.Columns.getByIndex(5).Width = 1750   ' F Maand = 1,75 cm
    oS.Columns.getByIndex(6).Width  = 1300   ' G Saldo = 1,30 cm
    oS.Columns.getByIndex(10).Width = 1500   ' K Besteld in maand = 1,50 cm
    For wi = 0 To NWEKEN - 1
        oS.Columns.getByIndex(11 + wi * 2).Width      = 8000
        oS.Columns.getByIndex(11 + wi * 2 + 1).Width  = 9000
        oS.Columns.getByIndex(21 + wi * 2).Width      = 8000
        oS.Columns.getByIndex(21 + wi * 2 + 1).Width  = 9000
    Next wi

    ' Tabblad "opvolgen betalingen"
    oOut.Sheets.insertNewByName("opvolgen betalingen", 1)
    Dim oOp As Object : oOp = oOut.Sheets.getByName("opvolgen betalingen")
    ' Zelfde kolomvolgorde als afrekening: A naam, B klant_id, C Voornaam2 Familienaam2.
    oOp.getCellByPosition(0, 0).setString("Voornaam Familienaam")
    oOp.getCellByPosition(1, 0).setString("klant_id")
    oOp.getCellByPosition(2, 0).setString("Voornaam2 Familienaam2")
    oOp.getCellByPosition(3, 0).setString("Saldo")
    oOp.getCellByPosition(4, 0).setString("Betaling 1")
    oOp.getCellByPosition(5, 0).setString("Betaling 2")
    oOp.getCellByPosition(6, 0).setString("Totaal betaald")
    oOp.getCellByPosition(7, 0).setString("Nog te betalen")
    oOp.getCellByPosition(8, 0).setString("Email")        ' I = afrekening.D (Email)
    oOp.getCellByPosition(9, 0).setString("Voornaam")     ' J = afrekening.E (Voornaam)
    Dim oHdrOp As Object : oHdrOp = oOp.getCellRangeByPosition(0, 0, 9, 0)
    oHdrOp.CharWeight = com.sun.star.awt.FontWeight.BOLD
    oHdrOp.CellBackColor = RGB(204, 204, 204)
    oOp.getCellRangeByPosition(0, 1, 9, 5).CellBackColor = RGB(242, 242, 242)
    Dim roOp As Integer, sRij As String
    For roOp = 6 To ro - 1
        sRij = CStr(roOp + 1)
        oOp.getCellByPosition(0, roOp).setFormula("=afrekening.A" & sRij)   ' Voornaam Familienaam
        oOp.getCellByPosition(1, roOp).setFormula("=afrekening.B" & sRij)   ' klant_id
        oOp.getCellByPosition(2, roOp).setFormula("=IF(afrekening.C" & sRij & "="""";"""";afrekening.C" & sRij & ")")   ' Voornaam2 Familienaam2
        oOp.getCellByPosition(3, roOp).setFormula("=afrekening.G" & sRij)   ' Saldo
        oOp.getCellByPosition(6, roOp).setFormula("=E" & sRij & "+F" & sRij)   ' Totaal betaald
        ' Nog te betalen = Saldo - Totaal betaald; beide eerst naar centen ronden
        ' zodat een sub-cent afrondingsresidu niet als -0,01 blijft staan.
        oOp.getCellByPosition(7, roOp).setFormula("=ROUND(D" & sRij & ";2)-ROUND(G" & sRij & ";2)")   ' Nog te betalen
        oOp.getCellByPosition(8, roOp).setFormula("=afrekening.D" & sRij)   ' Email
        oOp.getCellByPosition(9, roOp).setFormula("=afrekening.E" & sRij)   ' Voornaam
    Next roOp
    ' Getalopmaak D (Saldo), G (Totaal betaald), H (Nog te betalen)
    Dim oFmtsOp As Object : oFmtsOp = oOut.getNumberFormats()
    Dim oLocOp As New com.sun.star.lang.Locale
    oLocOp.Language = "nl" : oLocOp.Country = "BE"
    Dim nFmtOp As Long
    nFmtOp = oFmtsOp.queryKey("0,00", oLocOp, False)
    If nFmtOp = -1 Then nFmtOp = oFmtsOp.addNew("0,00", oLocOp)
    If ro > 6 Then
        oOp.getCellRangeByPosition(3, 6, 3, ro - 1).NumberFormat = nFmtOp
        oOp.getCellRangeByPosition(6, 6, 7, ro - 1).NumberFormat = nFmtOp
    End If
    oOp.Columns.getByIndex(0).Width = 5260   ' A Voornaam Familienaam
    oOp.Columns.getByIndex(1).Width = 1500   ' B klant_id
    oOp.Columns.getByIndex(2).Width = 5260   ' C Voornaam2 Familienaam2
    oOp.Columns.getByIndex(3).Width = 5000   ' D Saldo
    oOp.Columns.getByIndex(6).Width = 2700   ' G Totaal betaald = 2,70 cm
    oOp.Columns.getByIndex(8).Width = 5000   ' I Email
    oOp.Columns.getByIndex(9).Width = 2400   ' J Voornaam = 2,40 cm

    ' Opslaan (verborgen opgebouwd), dan zichtbaar heropenen vanaf schijf
    ' zodat het venster de juiste titel heeft en freezeAtPosition werkt.
    Dim sUit As String : sUit = JaarMap(iJaar) & "afrekening_" & sMaandNaam & "_" & iJaar & sOmg & ".ods"
    Dim sUrlUit As String : sUrlUit = ConvertToURL(sUit)

    ' Sluit het doelbestand als het nog open staat (bv. van een vorige run),
    ' anders faalt storeToURL met een AlreadyExists-lock.
    If FileExists(sUit) Then
        Dim oComp As Object, oEnum As Object
        oEnum = StarDesktop.Components.createEnumeration()
        Do While oEnum.hasMoreElements()
            oComp = oEnum.nextElement()
            If HasUnoInterfaces(oComp, "com.sun.star.lang.XServiceInfo") Then
                If oComp.supportsService("com.sun.star.sheet.SpreadsheetDocument") Then
                    If sUrlUit = oComp.getURL() Then oComp.close(True)
                End If
            End If
        Loop
    End If

    Dim aSave(1) As New com.sun.star.beans.PropertyValue
    aSave(0).Name = "FilterName" : aSave(0).Value = "calc8"
    aSave(1).Name = "Overwrite"  : aSave(1).Value = True
    oOut.storeToURL(sUrlUit, aSave())
    oOut.close(True)

    Dim aOpen(0) As New com.sun.star.beans.PropertyValue
    aOpen(0).Name = "Hidden" : aOpen(0).Value = False
    Dim oOut2 As Object
    oOut2 = oDesktop.loadComponentFromURL(sUrlUit, "_blank", 0, aOpen())
    ' Eerste rij + eerste 2 kolommen vastzetten op BEIDE tabbladen. freezeAtPosition
    ' werkt enkel op het actieve blad, dus eerst "opvolgen betalingen" bevriezen en
    ' dan terug naar "afrekening" (dat blijft zo ook het actieve blad bij openen).
    Dim oCtrl2 As Object : oCtrl2 = oOut2.getCurrentController()
    oCtrl2.setActiveSheet(oOut2.Sheets.getByName("opvolgen betalingen"))
    oCtrl2.freezeAtPosition(2, 1)
    oCtrl2.setActiveSheet(oOut2.Sheets.getByName("afrekening"))
    oCtrl2.freezeAtPosition(2, 1)

    Dim sMsgWijz As String : sMsgWijz = ""
    If sEmailWijzigingen <> "" Then
        sMsgWijz = Chr(10) & Chr(10) & "Let op - gewijzigde e-mailadressen (meest recente gebruikt):" & Chr(10) & sEmailWijzigingen
    End If
    Dim sMsgVorig As String
    If bVorigGevonden Then
        sMsgVorig = Chr(10) & Chr(10) & "Vorige maand verrekend uit: " & sVorigNaam & Chr(10) & _
                    nOvergedragen & " klant(en) zonder " & sMaandNaam & "-bestelling overgedragen (openstaand saldo)."
    Else
        sMsgVorig = Chr(10) & Chr(10) & "LET OP: vorige-maandbestand niet gevonden of kolomkoppen niet herkend:" & Chr(10) & "  " & sVorigNaam & Chr(10) & _
                    "'Vorig saldo' en 'Ontvangen' zijn leeg gelaten."
    End If
    Dim sMsgKid As String : sMsgKid = ""
    If sGeenKid <> "" Then
        sMsgKid = Chr(10) & Chr(10) & "Klanten zonder klant_id (gematcht op e-mail/naam, minder betrouwbaar):" & Chr(10) & sGeenKid
    End If
    If sGeenEmail <> "" Then
        sMsgKid = sMsgKid & Chr(10) & Chr(10) & "Klanten zonder e-mail (kunnen geen mail ontvangen):" & Chr(10) & sGeenEmail
    End If
    MsgBox "Maandafrekening klaar:" & Chr(10) & sUit & Chr(10) & Chr(10) & _
           (ro - 6) & " klanten met saldo, uit " & nVerwerkt & " weekbestand(en) (" & _
           sMaandNaam & " " & iJaar & ")." & Chr(10) & Chr(10) & _
           "Ruwe kolommen 'Pakket week n'/'Bijbestellingen week n' + " & _
           "mailmerge-kolommen 'Pakket n als'/'Bijb n als' (lege week -> ""|"")." & _
           sMsgWijz & sMsgVorig & sMsgKid, _
           64, "Maandafrekening"

End Sub

