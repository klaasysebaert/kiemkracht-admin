        ' zodat een sub-cent afrondingsresidu niet als -0,01 blijft staan.
        oOp.getCellByPosition(7, roOp).setFormula("=ROUND(D" & sRij & ";2)-ROUND(G" & sRij & ";2)")   ' Nog te betalen
        oOp.getCellByPosition(8, roOp).setFormula("=afrekening.D" & sRij)   ' Email
        oOp.getCellByPosition(9, roOp).setFormula("=afrekening.E" & sRij)   ' Voornaam
    Next roOp
    ' Getalopmaak D (Saldo), G (Totaal betaald), H (Nog te betalen)
    Dim oFmtsOp As Object : oFmtsOp = oOut.getNumberFormats()
    Dim oLocOp As New com.sun.star.lang.Locale
    oLocOp.Language = "nl" : oLocOp.Country = "BE"
    Dim nFmtOp As Long
    nFmtOp = oFmtsOp.queryKey("0,00", oLocOp, False)
    If nFmtOp = -1 Then nFmtOp = oFmtsOp.addNew("0,00", oLocOp)
    If ro > 6 Then
        oOp.getCellRangeByPosition(3, 6, 3, ro - 1).NumberFormat = nFmtOp
        oOp.getCellRangeByPosition(6, 6, 7, ro - 1).NumberFormat = nFmtOp
    End If
    oOp.Columns.getByIndex(0).Width = 5260   ' A Voornaam Familienaam
    oOp.Columns.getByIndex(1).Width = 1500   ' B klant_id
    oOp.Columns.getByIndex(2).Width = 5260   ' C Voornaam2 Familienaam2
    oOp.Columns.getByIndex(3).Width = 5000   ' D Saldo
    oOp.Columns.getByIndex(6).Width = 2700   ' G Totaal betaald = 2,70 cm
    oOp.Columns.getByIndex(8).Width = 5000   ' I Email
    oOp.Columns.getByIndex(9).Width = 2400   ' J Voornaam = 2,40 cm

    ' --- Tabblad "weekcontrole": kruiscontrole per week ---
    ' Per week: wat het maandbestand uit dat weekbestand samentelde (maand-aggregaat)
    ' vs het WEEKTOTAAL dat het weekbestand zelf bovenaan berekent. Wijken ze af, dan
    ' is er iets mis (overgeslagen klant, kapotte/verschoven rij, ontbrekend definitief).
    Dim sMsgControle As String : sMsgControle = ""
    Dim oWc As Object
    oOut.Sheets.insertNewByName("weekcontrole", 2)
    oWc = oOut.Sheets.getByName("weekcontrole")
    Dim oLocWc As New com.sun.star.lang.Locale
    oLocWc.Language = "nl" : oLocWc.Country = "BE"
    Dim nCurWc As Long
    nCurWc = oOut.getNumberFormats().queryKey("#.##0,00"" " & Chr(8364) & """", oLocWc, False)
    If nCurWc = -1 Then nCurWc = oOut.getNumberFormats().addNew("#.##0,00"" " & Chr(8364) & """", oLocWc)
    oWc.getCellByPosition(0, 0).setString("WEEKCONTROLE - " & sMaandNaam & " " & iJaar)
    oWc.getCellByPosition(0, 0).CharWeight = com.sun.star.awt.FontWeight.BOLD
    oWc.getCellByPosition(0, 1).setString("Vergelijkt per week het maand-aggregaat (som van wat dit maandbestand uit het " & _
        "weekbestand telde) met het WEEKTOTAAL dat het weekbestand zelf berekent.")
    oWc.getCellByPosition(0, 3).setString("week")
    oWc.getCellByPosition(1, 3).setString("weekbestand")
    oWc.getCellByPosition(2, 3).setString("maand-aggregaat")
    oWc.getCellByPosition(3, 3).setString("weektotaal (weekbestand)")
    oWc.getCellByPosition(4, 3).setString("verschil")
    oWc.getCellByPosition(5, 3).setString("status")
    oWc.getCellRangeByPosition(0, 3, 5, 3).CharWeight = com.sun.star.awt.FontWeight.BOLD
    Dim rc As Integer : rc = 4
    Dim dSomMaand As Double, dSomWeek As Double
    dSomMaand = 0 : dSomWeek = 0
    For wi = 0 To nWk - 1
        oWc.getCellByPosition(0, rc).setValue(wkNr(wi))
        If Not bWeekDone(wi) Then
            oWc.getCellByPosition(1, rc).setString("ontbreekt")
            oWc.getCellByPosition(5, rc).setString("OVERGESLAGEN (geen _definitief)")
        Else
            oWc.getCellByPosition(1, rc).setString(sWeekNaam(wi))
            oWc.getCellByPosition(2, rc).setValue(mWeekMaand(wi))
            dSomMaand = dSomMaand + mWeekMaand(wi)
            If bWeekWT(wi) Then
                oWc.getCellByPosition(3, rc).setValue(mWeekFile(wi))
                oWc.getCellByPosition(4, rc).setFormula("=C" & (rc + 1) & "-D" & (rc + 1))
                dSomWeek = dSomWeek + mWeekFile(wi)
                If Abs(mWeekMaand(wi) - mWeekFile(wi)) < 0.005 Then
                    oWc.getCellByPosition(5, rc).setString("OK")
                Else
                    oWc.getCellByPosition(5, rc).setString("AFWIJKING")
                    sMsgControle = sMsgControle & "  - week " & wkNr(wi) & ": maand " & FmtNum2(mWeekMaand(wi)) & _
                        " " & Chr(8364) & " vs weekbestand " & FmtNum2(mWeekFile(wi)) & " " & Chr(8364) & _
                        " (verschil " & FmtNum2(mWeekMaand(wi) - mWeekFile(wi)) & " " & Chr(8364) & ")" & Chr(10)
                End If
            Else
                oWc.getCellByPosition(3, rc).setString("-")
                oWc.getCellByPosition(5, rc).setString("geen weektotaal-cel (oud weekbestand)")
            End If
        End If
        rc = rc + 1
    Next wi
    oWc.getCellByPosition(0, rc).setString("TOTAAL")
    oWc.getCellByPosition(2, rc).setValue(dSomMaand)
    oWc.getCellByPosition(3, rc).setValue(dSomWeek)
    oWc.getCellByPosition(4, rc).setFormula("=C" & (rc + 1) & "-D" & (rc + 1))
    oWc.getCellRangeByPosition(0, rc, 5, rc).CharWeight = com.sun.star.awt.FontWeight.BOLD
    oWc.getCellRangeByPosition(2, 4, 4, rc).NumberFormat = nCurWc
    oWc.Columns.getByIndex(0).Width = 1400
    oWc.Columns.getByIndex(1).Width = 8000
    oWc.Columns.getByIndex(2).Width = 3500
    oWc.Columns.getByIndex(3).Width = 4400
    oWc.Columns.getByIndex(4).Width = 2400
    oWc.Columns.getByIndex(5).Width = 6800

    ' Opslaan (verborgen opgebouwd), dan zichtbaar heropenen vanaf schijf
    ' zodat het venster de juiste titel heeft en freezeAtPosition werkt.
    Dim sUit As String : sUit = JaarMap(iJaar) & "afrekening_" & sMaandNaam & "_" & iJaar & sOmg & ".ods"
    Dim sUrlUit As String : sUrlUit = ConvertToURL(sUit)

    ' Sluit het doelbestand als het nog open staat (bv. van een vorige run),
    ' anders faalt storeToURL met een AlreadyExists-lock.
    If FileExists(sUit) Then
        Dim oComp As Object, oEnum As Object
        oEnum = StarDesktop.Components.createEnumeration()
        Do While oEnum.hasMoreElements()
            oComp = oEnum.nextElement()
            If HasUnoInterfaces(oComp, "com.sun.star.lang.XServiceInfo") Then
                If oComp.supportsService("com.sun.star.sheet.SpreadsheetDocument") Then
                    If sUrlUit = oComp.getURL() Then oComp.close(True)
                End If
            End If
        Loop
    End If

    Dim aSave(1) As New com.sun.star.beans.PropertyValue
    aSave(0).Name = "FilterName" : aSave(0).Value = "calc8"
    aSave(1).Name = "Overwrite"  : aSave(1).Value = True
    oOut.storeToURL(sUrlUit, aSave())
    oOut.close(True)

    Dim aOpen(0) As New com.sun.star.beans.PropertyValue
    aOpen(0).Name = "Hidden" : aOpen(0).Value = False
    Dim oOut2 As Object
    oOut2 = oDesktop.loadComponentFromURL(sUrlUit, "_blank", 0, aOpen())
    ' Eerste rij + eerste 2 kolommen vastzetten op BEIDE tabbladen. freezeAtPosition
    ' werkt enkel op het actieve blad, dus eerst "opvolgen betalingen" bevriezen en
    ' dan terug naar "afrekening" (dat blijft zo ook het actieve blad bij openen).
    Dim oCtrl2 As Object : oCtrl2 = oOut2.getCurrentController()
    oCtrl2.setActiveSheet(oOut2.Sheets.getByName("opvolgen betalingen"))
    oCtrl2.freezeAtPosition(2, 1)
    oCtrl2.setActiveSheet(oOut2.Sheets.getByName("afrekening"))
    oCtrl2.freezeAtPosition(2, 1)

    Dim sMsgWijz As String : sMsgWijz = ""
    If sEmailWijzigingen <> "" Then
        sMsgWijz = Chr(10) & Chr(10) & "Let op - gewijzigde e-mailadressen (meest recente gebruikt):" & Chr(10) & sEmailWijzigingen
    End If
    Dim sMsgVorig As String
    If bVorigGevonden Then
        sMsgVorig = Chr(10) & Chr(10) & "Vorige maand verrekend uit: " & sVorigNaam & Chr(10) & _
                    nOvergedragen & " klant(en) zonder " & sMaandNaam & "-bestelling overgedragen (openstaand saldo)."
    Else
        sMsgVorig = Chr(10) & Chr(10) & "LET OP: vorige-maandbestand niet gevonden of kolomkoppen niet herkend:" & Chr(10) & "  " & sVorigNaam & Chr(10) & _
                    "'Vorig saldo' en 'Ontvangen' zijn leeg gelaten."
    End If
    Dim sMsgKid As String : sMsgKid = ""
    If sGeenKid <> "" Then
        sMsgKid = Chr(10) & Chr(10) & "Klanten zonder klant_id (gematcht op e-mail/naam, minder betrouwbaar):" & Chr(10) & sGeenKid
    End If
    If sGeenEmail <> "" Then
        sMsgKid = sMsgKid & Chr(10) & Chr(10) & "Klanten zonder e-mail (kunnen geen mail ontvangen):" & Chr(10) & sGeenEmail
    End If
    Dim sMsgAfr As String : sMsgAfr = ""
    If Not bAfrPrefOk Then
        sMsgAfr = Chr(10) & Chr(10) & "LET OP: afrekening-voorkeuren NIET geladen (geen DB-verbinding):" & Chr(10) & _
                  "  email_afrekening en nooit_afrekening zijn deze run niet toegepast."
    Else
        If sNooitLijst <> "" Then
            sMsgAfr = sMsgAfr & Chr(10) & Chr(10) & "Overgeslagen (nooit_afrekening):" & Chr(10) & sNooitLijst
        End If
        If sAfwijkendAdres <> "" Then
            sMsgAfr = sMsgAfr & Chr(10) & Chr(10) & "Afwijkend afrekening-adres (email_afrekening):" & Chr(10) & sAfwijkendAdres
        End If
    End If
    Dim sMsgWeken As String : sMsgWeken = ""
    If sWeekLijst <> "" Then
        sMsgWeken = Chr(10) & Chr(10) & "Verwerkte weekbestanden (per week):" & Chr(10) & sWeekLijst
    End If
    ' Weekcontrole-blok + icoon: waarschuwing als maand en weekbestand afwijken.
    Dim sMsgCtrl As String, iIcon As Integer : iIcon = 64
    If sMsgControle <> "" Then
        sMsgCtrl = Chr(10) & Chr(10) & "!! WEEKCONTROLE - AFWIJKING tussen maand-aggregaat en weektotaal:" & Chr(10) & _
                   sMsgControle & "Zie tabblad 'weekcontrole'."
        iIcon = 48
    Else
        sMsgCtrl = Chr(10) & Chr(10) & "Weekcontrole OK: maand-aggregaat = weektotaal voor alle gecontroleerde weken (tabblad 'weekcontrole')."
    End If
    If Not bAfrPrefOk Then iIcon = 48
    MsgBox "Maandafrekening klaar:" & Chr(10) & sUit & Chr(10) & Chr(10) & _
           (ro - 6) & " klanten met saldo, uit " & nVerwerkt & " weekbestand(en) (" & _
           sMaandNaam & " " & iJaar & ")." & _
           sMsgCtrl & _
           sMsgWeken & Chr(10) & Chr(10) & _
           "Ruwe kolommen 'Pakket week n'/'Bijbestellingen week n' + " & _
           "mailmerge-kolommen 'Pakket n als'/'Bijb n als' (lege week -> ""|"")." & _
           sMsgWijz & sMsgVorig & sMsgKid & sMsgAfr, _
           iIcon, "Maandafrekening"

End Sub

