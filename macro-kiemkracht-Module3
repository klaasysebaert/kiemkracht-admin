' =============================================
' Kiemkracht - Etiketten bijbestellingen losse groenten
' Etiket: naam / "Bijbestelling" / afhaalpunt
' Volgorde: afhaalpunt (weekbestand), pakket, volgnummer BD
' =============================================
Sub MaakEtikettenBijbestelling()

    Const cNaam       = 0
    Const cAfh        = 1
    Const cKG         = 17
    Const cGG         = 18
    Const cEGG        = 19
    Const cMINI       = 20
    Const cGroent0    = 22  ' kolom W
    Const cGroentLast = 46  ' kolom AU
    Const cVolgNr     = 55  ' kolom BD
    Const cBestelMin  = 56  ' kolom BE: enkel etiket als waarde > 5

    Dim oDoc     As Object
    Dim oWkSheet As Object
    oDoc     = ThisComponent
    oWkSheet = oDoc.Sheets.getByIndex(0)

    Dim oCalcCursor As Object
    oCalcCursor = oWkSheet.createCursor()
    oCalcCursor.gotoEndOfUsedArea(True)
    Dim nLastRow As Long
    nLastRow = oCalcCursor.getRangeAddress().EndRow

    ' Data verzamelen
    Dim eNaam(500)   As String
    Dim eAfh(500)    As String
    Dim ePakOrd(500) As Integer
    Dim eVolgNr(500) As Long
    Dim nEt          As Integer
    nEt = 0

    Dim i       As Long
    Dim g       As Integer
    Dim sNaam   As String
    Dim sAfh    As String
    Dim iPakOrd As Integer
    Dim bHasG   As Boolean

    For i = 6 To nLastRow
        sNaam = oWkSheet.getCellByPosition(cNaam, i).getString()
        sAfh  = oWkSheet.getCellByPosition(cAfh,  i).getString()
        If sNaam = "" Or sAfh = "afhaalpunt/dag" Then GoTo VolgendeRijBij

        ' Controleer of er losse groenten zijn (kolom W t.e.m. AU)
        bHasG = False
        For g = cGroent0 To cGroentLast
            If oWkSheet.getCellByPosition(g, i).getValue() > 0 Then
                bHasG = True : Exit For
            End If
        Next g
        If Not bHasG Then GoTo VolgendeRijBij

        ' Enkel etiket als kolom BE > 5
        If oWkSheet.getCellByPosition(cBestelMin, i).getValue() <= 5 Then GoTo VolgendeRijBij

        ' Pakketorde voor sortering
        If      oWkSheet.getCellByPosition(cKG,   i).getValue() > 0 Then : iPakOrd = 1
        ElseIf  oWkSheet.getCellByPosition(cGG,   i).getValue() > 0 Then : iPakOrd = 2
        ElseIf  oWkSheet.getCellByPosition(cEGG,  i).getValue() > 0 Then : iPakOrd = 3
        ElseIf  oWkSheet.getCellByPosition(cMINI, i).getValue() > 0 Then : iPakOrd = 4
        Else                                                               : iPakOrd = 5
        End If

        If nEt <= 500 Then
            eNaam(nEt)   = sNaam
            eAfh(nEt)    = sAfh
            ePakOrd(nEt) = iPakOrd
            eVolgNr(nEt) = CLng(oWkSheet.getCellByPosition(cVolgNr, i).getValue())
            nEt = nEt + 1
        End If

        VolgendeRijBij:
    Next i

    If nEt = 0 Then
        MsgBox "Geen bijbestellingen losse groenten gevonden.", 48, "Etiketten bijbestelling"
        Exit Sub
    End If

    ' Afhaalpunten in volgorde van eerste verschijning
    Dim aAfhOrd(50) As String
    Dim nAfhOrd     As Integer
    Dim k           As Integer
    Dim bNieuw      As Boolean
    nAfhOrd = 0
    For i = 0 To nEt - 1
        bNieuw = True
        For k = 0 To nAfhOrd - 1
            If aAfhOrd(k) = eAfh(i) Then bNieuw = False : Exit For
        Next k
        If bNieuw And nAfhOrd <= 50 Then
            aAfhOrd(nAfhOrd) = eAfh(i)
            nAfhOrd = nAfhOrd + 1
        End If
    Next i

    ' Gesorteerde uitvoerindex: afhaalpunt → pakket → volgnummer
    Dim aIdx(500) As Integer
    Dim nIdx      As Integer
    Dim p         As Integer
    Dim aTmp(500) As Integer
    Dim nTmp      As Integer
    Dim t1        As Integer
    Dim t2        As Integer
    Dim tSwap     As Integer
    nIdx = 0
    For k = 0 To nAfhOrd - 1
        For p = 1 To 5
            nTmp = 0
            For i = 0 To nEt - 1
                If eAfh(i) = aAfhOrd(k) And ePakOrd(i) = p Then
                    aTmp(nTmp) = i
                    nTmp = nTmp + 1
                End If
            Next i
            For t1 = 0 To nTmp - 2
                For t2 = 0 To nTmp - t1 - 2
                    If eVolgNr(aTmp(t2)) > eVolgNr(aTmp(t2 + 1)) Then
                        tSwap = aTmp(t2) : aTmp(t2) = aTmp(t2+1) : aTmp(t2+1) = tSwap
                    End If
                Next t2
            Next t1
            For t1 = 0 To nTmp - 1
                aIdx(nIdx) = aTmp(t1)
                nIdx = nIdx + 1
            Next t1
        Next p
    Next k

    ' Nieuw Calc-document aanmaken
    Dim oDesktop As Object
    oDesktop = CreateUnoService("com.sun.star.frame.Desktop")
    Dim aArgs(0) As New com.sun.star.beans.PropertyValue
    aArgs(0).Name  = "Hidden"
    aArgs(0).Value = True

    Dim oCalc    As Object
    Dim oEtSheet As Object
    oCalc    = oDesktop.loadComponentFromURL("private:factory/scalc", "_blank", 0, aArgs())
    oEtSheet = oCalc.Sheets.getByIndex(0)
    oEtSheet.Name = "bijbestelling"

    ' Paginaopmaak: marges 0, geen kop- of voettekst
    Dim oPSB As Object
    oPSB = oCalc.StyleFamilies.getByName("PageStyles").getByName("Default")
    oPSB.TopMargin    = 0 : oPSB.BottomMargin = 0
    oPSB.LeftMargin   = 0 : oPSB.RightMargin  = 0
    oPSB.HeaderIsOn   = False
    oPSB.FooterIsOn   = False

    ' Eerste lege rij van 0,80 cm
    Dim oRows As Object
    Dim oCols As Object
    oRows = oEtSheet.getRows()
    oCols = oEtSheet.getColumns()
    oRows.getByIndex(0).Height        = 800
    oRows.getByIndex(0).OptimalHeight = False

    ' Kolombreedte kolom A
    oCols.getByIndex(0).Width        = 6900
    oCols.getByIndex(0).OptimalWidth = False

    ' Etiketten schrijven
    Dim oCell As Object
    Dim iEt   As Integer
    For iEt = 0 To nIdx - 1
        i = aIdx(iEt)
        oCell = oEtSheet.getCellByPosition(0, iEt + 1)
        oCell.setString(eNaam(i) & Chr(10) & "Bijbestelling" & Chr(10) & eAfh(i))
        oCell.setPropertyValue("IsTextWrapped", True)
        oCell.setPropertyValue("HoriJustify", com.sun.star.table.CellHoriJustify.LEFT)
        oCell.setPropertyValue("VertJustify", com.sun.star.table.CellVertJustify2.CENTER)
        oCell.setPropertyValue("ParaLeftMargin", 605)
        oCell.setPropertyValue("CharFontName", "Calibri")
        oCell.setPropertyValue("CharHeight", 17.5)
        oRows.getByIndex(iEt + 1).Height        = 3500
        oRows.getByIndex(iEt + 1).OptimalHeight = False
    Next iEt

    ' Extra kolommen B, C, ... met formules
    Const nLabPerKol = 8
    Dim nExtraKols   As Integer
    Dim iKol         As Integer
    Dim iRij         As Integer
    Dim iSrcRij      As Integer
    Dim sFormule     As String
    Dim oCelF        As Object
    nExtraKols = Int((nIdx - 1) / nLabPerKol)
    For iKol = 1 To nExtraKols
        oCols.getByIndex(iKol).Width        = 6900
        oCols.getByIndex(iKol).OptimalWidth = False
        For iRij = 2 To nLabPerKol + 1
            iSrcRij  = iRij + iKol * nLabPerKol
            oCelF = oEtSheet.getCellByPosition(iKol, iRij - 1)
            oCelF.FormulaLocal = "=ALS(A" & iSrcRij & "="""";"""";A" & iSrcRij & ")"
            oCelF.setPropertyValue("IsTextWrapped", True)
            oCelF.setPropertyValue("HoriJustify", com.sun.star.table.CellHoriJustify.LEFT)
            oCelF.setPropertyValue("VertJustify", com.sun.star.table.CellVertJustify2.CENTER)
            oCelF.setPropertyValue("ParaLeftMargin", 605)
            oCelF.setPropertyValue("CharFontName", "Calibri")
            oCelF.setPropertyValue("CharHeight", 17.5)
        Next iRij
    Next iKol

    ' Opslaan naast weekbestand
    Dim aSave(0) As New com.sun.star.beans.PropertyValue
    aSave(0).Name  = "FilterName"
    aSave(0).Value = "calc8"
    Dim sWkPath   As String
    Dim sCalcPath As String
    sWkPath   = ConvertFromURL(oDoc.getURL())
    sCalcPath = Left(sWkPath, Len(sWkPath) - 4) & "_etiketten_bijbestelling.ods"
    oCalc.storeToURL(ConvertToURL(sCalcPath), aSave())
    oCalc.close(True)

    MsgBox nEt & " etiketten bijbestelling aangemaakt." & Chr(10) & sCalcPath, 64, "Etiketten klaar"

End Sub

' =============================================
' Kiemkracht - Weglatingen per pakket en dag invullen
' Leest weekbestand (tabblad 1) en schrijft tellingen naar tabblad 2:
'   Kolom A: pakket ("KG","GG","EGG","MINI")
'   Kolom C: groente naam
'   Kolom E: aantal weglatingen op donderdag
'   Kolom F: aantal weglatingen op vrijdag
' =============================================
Sub VulWeglatingen()

    Const cKlaarDag = 2   ' kolom C: dag klaarmaken
    Const cKG       = 17  ' kolom R
    Const cGG       = 18  ' kolom S
    Const cEGG      = 19  ' kolom T
    Const cMINI     = 20  ' kolom U
    Const cWeg0     = 49  ' kolom AX: start weglatingen

    Dim oDoc     As Object : oDoc = ThisComponent
    Dim oWkSheet As Object : oWkSheet  = oDoc.Sheets.getByIndex(0)
    Dim oWegSheet As Object : oWegSheet = oDoc.Sheets.getByIndex(1)

    ' Laatste rij weekblad
    Dim oCalcCursor As Object
    oCalcCursor = oWkSheet.createCursor()
    oCalcCursor.gotoEndOfUsedArea(True)
    Dim nLastRow As Long
    nLastRow = oCalcCursor.getRangeAddress().EndRow

    ' Weglatingsnamen uit weekblad rij 3 (index 2) vanaf kolom AX
    Dim wegNaam(99) As String
    Dim nWeg        As Integer
    nWeg = 0
    Do While oWkSheet.getCellByPosition(cWeg0 + nWeg, 2).getString() <> ""
        wegNaam(nWeg) = oWkSheet.getCellByPosition(cWeg0 + nWeg, 2).getString()
        nWeg = nWeg + 1
        If nWeg >= 100 Then Exit Do
    Loop

    ' Loop over rijen tweede tabblad (vanaf rij 3 = index 2), kolom C niet leeg
    Dim r        As Integer : r = 2
    Dim sGroente As String
    Dim sPakket  As String
    Dim iPakKol  As Integer
    Dim iWegKol  As Integer
    Dim w        As Integer
    Dim i        As Long
    Dim nDon     As Long
    Dim nVrij    As Long
    Dim sKlaarDag As String

    Do While oWegSheet.getCellByPosition(0, r).getString() <> ""
        sGroente = oWegSheet.getCellByPosition(2, r).getString()  ' kolom C
        sPakket  = oWegSheet.getCellByPosition(0, r).getString()  ' kolom A

        ' Rij overslaan als groente niet ingevuld
        If sGroente = "" Then GoTo VolgendeRijWeg2

        Select Case sPakket
            Case "KG"   : iPakKol = cKG
            Case "GG"   : iPakKol = cGG
            Case "EGG"  : iPakKol = cEGG
            Case "MINI" : iPakKol = cMINI
            Case Else   : iPakKol = -1
        End Select

        iWegKol = -1
        For w = 0 To nWeg - 1
            If wegNaam(w) = sGroente Then
                iWegKol = cWeg0 + w
                Exit For
            End If
        Next w

        nDon = 0 : nVrij = 0

        If iPakKol >= 0 And iWegKol >= 0 Then
            For i = 6 To nLastRow
                If oWkSheet.getCellByPosition(iPakKol,  i).getValue()  = 0  Then GoTo VolgendeRijWeg
                If oWkSheet.getCellByPosition(iWegKol,  i).getString() = "" Then GoTo VolgendeRijWeg
                sKlaarDag = oWkSheet.getCellByPosition(cKlaarDag, i).getString()
                If sKlaarDag = "donderdag" Then nDon  = nDon  + 1
                If sKlaarDag = "vrijdag"   Then nVrij = nVrij + 1
                VolgendeRijWeg:
            Next i
        End If

        oWegSheet.getCellByPosition(4, r).setValue(nDon)         ' kolom E
        oWegSheet.getCellByPosition(5, r).setValue(nVrij)        ' kolom F
        oWegSheet.getCellByPosition(3, r).setValue(nDon + nVrij) ' kolom D: totaal

        VolgendeRijWeg2:
        r = r + 1
    Loop

    MsgBox "Weglatingen verwerkt.", 64, "Klaar"

End Sub

Const WEBAPP_URL = "https://script.google.com/macros/s/AKfycby4YLRd9N_loZHkHWh03R2Q9c5UofI5jg4Vol4XtOXomd5_fsJ8Ge_RZvjP4TSYpNcbIQ/exec"

' =============================================
' LeesUitSheets
' Leest O7:Q52 uit Google Sheets → Blad2 A3:C48
' Geeft True terug bij succes
' =============================================

Function LeesUitSheets() As Boolean

    Dim oBlad2   As Object
    Dim oHttp    As Object
    Dim sAll     As String
    Dim aLines() As String
    Dim aVelden() As String
    Dim i As Integer, r As Integer, c As Integer

    LeesUitSheets = False
    oBlad2 = ThisComponent.Sheets.getByIndex(1)

    On Error GoTo HttpFout
    oHttp = CreateObject("WinHttp.WinHttpRequest.5.1")
    oHttp.Open "GET", WEBAPP_URL, False
    oHttp.SetTimeouts 0, 30000, 30000, 30000
    oHttp.Send

    If oHttp.Status <> 200 Then
        MsgBox "Fout bij lezen uit Google Sheets: HTTP " & oHttp.Status, 16, "Fout"
        Exit Function
    End If

    sAll = oHttp.ResponseText
    On Error GoTo 0

    If Left(sAll, 1) = "<" Then
        MsgBox "Google Sheets gaf een fout terug. Controleer de tabnaam in het Apps Script." & Chr(10) & Chr(10) & Left(sAll, 300), 16, "Fout"
        Exit Function
    End If

    aLines = Split(sAll, Chr(10))
    r = 2
    For i = 0 To UBound(aLines)
        Dim sRegel As String
        sRegel = Trim(aLines(i))
        If sRegel = "" Then GoTo VolgendeLeesRij
        aVelden = Split(sRegel, Chr(9))
        For c = 0 To UBound(aVelden)
            If c > 2 Then Exit For
            oBlad2.getCellByPosition(c, r).setString(aVelden(c))
        Next c
        r = r + 1
        If r > 47 Then Exit For
        VolgendeLeesRij:
    Next i

    LeesUitSheets = True
    Exit Function

HttpFout:
    MsgBox "Verbindingsfout met Google Sheets:" & Chr(10) & Error$, 16, "Fout"

End Function

' =============================================
' SyncMetSheets
' Leest O7:Q52 uit Google Sheets → Blad2 A3:C48
' Roept VulWeglatingen aan
' Schrijft Blad2 D3:F48 → Google Sheets U7:W52
' =============================================

Sub SyncMetSheets()

    Dim oDoc     As Object
    Dim oBlad2   As Object
    Dim oHttp    As Object
    Dim sBody    As String
    Dim r As Integer, c As Integer

    oDoc   = ThisComponent
    oBlad2 = oDoc.Sheets.getByIndex(1)

    ' ---------- STAP 1: lees O7:Q52 uit Google Sheets ----------
    If Not LeesUitSheets() Then Exit Sub

    ' ---------- STAP 2: vul weglatingen ----------
    VulWeglatingen()

    ' ---------- STAP 3: schrijf Blad2 D3:F48 → Google Sheets U7:W52 ----------
    sBody = ""
    For r = 2 To 47
        Dim sRij As String
        sRij = ""
        For c = 3 To 5
            Dim sWaarde As String
            sWaarde = CStr(CLng(oBlad2.getCellByPosition(c, r).getValue()))
            If c = 3 Then
                sRij = sWaarde
            Else
                sRij = sRij & Chr(9) & sWaarde
            End If
        Next c
        If r = 2 Then
            sBody = sRij
        Else
            sBody = sBody & Chr(10) & sRij
        End If
    Next r

    On Error GoTo HttpFout
    oHttp = CreateObject("WinHttp.WinHttpRequest.5.1")
    oHttp.Open "POST", WEBAPP_URL & "?target=U7", False
    oHttp.SetRequestHeader "Content-Type", "text/plain; charset=utf-8"
    oHttp.SetTimeouts 0, 30000, 30000, 30000
    oHttp.Send sBody

    If oHttp.Status <> 200 Then
        MsgBox "Fout bij terugschrijven naar Google Sheets: HTTP " & oHttp.Status, 16, "Fout"
        Exit Sub
    End If
    On Error GoTo 0

    ' ---------- STAP 4: schrijf R5:U6 → Google Sheets E4:H5 ----------
    Dim oWkSheet As Object
    oWkSheet = oDoc.Sheets.getByIndex(0)
    Dim sBody2 As String
    Dim r2 As Integer, c2 As Integer
    sBody2 = ""
    For r2 = 4 To 5  ' rij-index 4..5 = rijen 5..6
        Dim sRij2 As String
        sRij2 = ""
        For c2 = 17 To 20  ' kolommen R..U (index 17..20)
            Dim oCell2 As Object
            Dim sWaarde2 As String
            oCell2 = oWkSheet.getCellByPosition(c2, r2)
            If oCell2.getType() = 1 Then
                sWaarde2 = CStr(oCell2.getValue())
            Else
                sWaarde2 = oCell2.getString()
            End If
            If c2 = 17 Then
                sRij2 = sWaarde2
            Else
                sRij2 = sRij2 & Chr(9) & sWaarde2
            End If
        Next c2
        If r2 = 4 Then
            sBody2 = sRij2
        Else
            sBody2 = sBody2 & Chr(10) & sRij2
        End If
    Next r2

    On Error GoTo HttpFout
    oHttp.Open "POST", WEBAPP_URL & "?target=E4", False
    oHttp.SetRequestHeader "Content-Type", "text/plain; charset=utf-8"
    oHttp.SetTimeouts 0, 30000, 30000, 30000
    oHttp.Send sBody2

    If oHttp.Status <> 200 Then
        MsgBox "Fout bij schrijven R5:U6 naar Google Sheets: HTTP " & oHttp.Status, 16, "Fout"
        Exit Sub
    End If
    On Error GoTo 0

    MsgBox "Sync met Google Sheets voltooid.", 64, "Klaar"
    Exit Sub

HttpFout:
    MsgBox "Verbindingsfout met Google Sheets:" & Chr(10) & Error$, 16, "Fout"

End Sub


