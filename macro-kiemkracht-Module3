Option Explicit

' =============================================
' Kiemkracht - Overzichten
' Maakt drie Writer-printdocumenten (.odt) aan
' naast het weekbestand, vanuit het weekbestand.
' =============================================

Sub MaakOverzichten()
    On Error GoTo DebugFout

    ' Kolomindices weekblad (moeten overeenkomen met MaakWeekbestand)
    Const cNaam        = 0
    Const cAfh         = 1
    Const cKlaarDag    = 2
    Const cKG          = 17
    Const cGG          = 18
    Const cEGG         = 19
    Const cMINI        = 20
    Const cGroent0     = 22
    Const nGroentSlots = 24
    Const cWeg0        = 49

    Dim oDoc     As Object
    Dim oWkSheet As Object
    oDoc     = ThisComponent
    oWkSheet = oDoc.Sheets.getByIndex(0)

    ' Groente-namen en eenheden uit rij 1/2
    Dim groentNaam(23) As String
    Dim groentEenh(23) As String
    Dim g As Integer
    For g = 0 To nGroentSlots - 1
        groentNaam(g) = oWkSheet.getCellByPosition(cGroent0 + g, 1).getString()
        groentEenh(g) = oWkSheet.getCellByPosition(cGroent0 + g, 2).getString()
    Next g

    ' Weglatingen uit rij 2
    Dim nWeg    As Integer
    Dim wegNaam(99) As String
    nWeg = 0
    Do While oWkSheet.getCellByPosition(cWeg0 + nWeg, 2).getString() <> ""
        wegNaam(nWeg) = oWkSheet.getCellByPosition(cWeg0 + nWeg, 2).getString()
        nWeg = nWeg + 1
        If nWeg >= 100 Then Exit Do
    Loop

    ' Laatste rij weekblad
    Dim oCalcCursor As Object
    oCalcCursor = oWkSheet.createCursor()
    oCalcCursor.gotoEndOfUsedArea(True)
    Dim nLastRow As Long
    nLastRow = oCalcCursor.getRangeAddress().EndRow

    ' --- Declaraties voor data-verzameling ---
    Dim aBlok(500)   As String
    Dim aAfh2(500)   As String
    Dim aPakket(500) As String
    Dim aDag2(500)   As String
    Dim nBlok        As Integer
    Dim aTotaal(23)  As Double
    Dim aTotDon(23)  As Double
    Dim aTotVrij(23) As Double
    Dim aDagen(9)    As String
    Dim nDagen       As Integer
    nBlok  = 0
    nDagen = 0

    Dim i          As Long
    Dim w          As Integer
    Dim d          As Integer
    Dim sNaam      As String
    Dim sAfh2      As String
    Dim sKlaarDag  As String
    Dim sPakket    As String
    Dim sBlok      As String
    Dim sAant      As String
    Dim sWeg       As String
    Dim nAant      As Double
    Dim bHasG      As Boolean
    Dim bNieuwedag As Boolean

    ' --- Klantblokken + groententotalen + unieke dagen ---
    For i = 6 To nLastRow
        sNaam = oWkSheet.getCellByPosition(cNaam, i).getString()
        sAfh2 = oWkSheet.getCellByPosition(cAfh,  i).getString()
        If sNaam = "" Or sAfh2 = "afhaalpunt/dag" Then GoTo VolgendeRij

        bHasG = False
        For g = 0 To nGroentSlots - 1
            If oWkSheet.getCellByPosition(cGroent0 + g, i).getValue() > 0 Then
                bHasG = True : Exit For
            End If
        Next g
        If Not bHasG Then GoTo VolgendeRij

        sKlaarDag = oWkSheet.getCellByPosition(cKlaarDag, i).getString()

        ' Unieke dag bijhouden
        If sKlaarDag <> "" Then
            bNieuwedag = True
            For d = 0 To nDagen - 1
                If aDagen(d) = sKlaarDag Then bNieuwedag = False : Exit For
            Next d
            If bNieuwedag And nDagen < 10 Then
                aDagen(nDagen) = sKlaarDag
                nDagen = nDagen + 1
            End If
        End If

        If      oWkSheet.getCellByPosition(cKG,   i).getValue() > 0 Then : sPakket = "klein"
        ElseIf  oWkSheet.getCellByPosition(cGG,   i).getValue() > 0 Then : sPakket = "groot"
        ElseIf  oWkSheet.getCellByPosition(cEGG,  i).getValue() > 0 Then : sPakket = "extra groot"
        ElseIf  oWkSheet.getCellByPosition(cMINI, i).getValue() > 0 Then : sPakket = "mini"
        Else                                                               : sPakket = "geen pakket"
        End If

        sBlok = sNaam & " (" & sAfh2 & "): " & sPakket
        For g = 0 To nGroentSlots - 1
            nAant = oWkSheet.getCellByPosition(cGroent0 + g, i).getValue()
            If nAant > 0 Then
                If nAant = Int(nAant) Then sAant = CStr(CLng(nAant)) Else sAant = CStr(nAant)
                sBlok = sBlok & Chr(10) & groentNaam(g) & ": " & sAant & " " & groentEenh(g)
                aTotaal(g) = aTotaal(g) + nAant
                If sKlaarDag = "donderdag" Then aTotDon(g)  = aTotDon(g)  + nAant
                If sKlaarDag = "vrijdag"   Then aTotVrij(g) = aTotVrij(g) + nAant
            End If
        Next g
        For w = 0 To nWeg - 1
            sWeg = oWkSheet.getCellByPosition(cWeg0 + w, i).getString()
            If sWeg <> "" Then sBlok = sBlok & Chr(10) & "Geen: " & sWeg
        Next w

        If nBlok <= 500 Then
            aBlok(nBlok)   = sBlok
            aAfh2(nBlok)   = sAfh2
            aPakket(nBlok) = sPakket
            aDag2(nBlok)   = sKlaarDag
            nBlok = nBlok + 1
        End If

        VolgendeRij:
    Next i

    If nBlok = 0 Then
        MsgBox "Geen klanten met losse groenten gevonden.", 48, "Overzichten"
        Exit Sub
    End If

    ' --- Gedeelde Writer-hulpobjecten ---
    Dim oDesktop As Object
    oDesktop = CreateUnoService("com.sun.star.frame.Desktop")

    Dim aArgs(0) As New com.sun.star.beans.PropertyValue
    aArgs(0).Name  = "Hidden"
    aArgs(0).Value = True

    Dim aSave(0) As New com.sun.star.beans.PropertyValue
    aSave(0).Name  = "FilterName"
    aSave(0).Value = "writer8"

    Dim sWkPath As String
    sWkPath = ConvertFromURL(oDoc.getURL())

    ' -------------------------------------------------------
    ' Document 1: orderpicking afhaalpunt, per dag één document
    ' -------------------------------------------------------
    Dim oWriter   As Object
    Dim oPS       As Object
    Dim oTC       As Object
    Dim oFText    As Object
    Dim oFCurs    As Object
    Dim oFldPN    As Object
    Dim oFldPC    As Object
    Dim oText     As Object
    Dim oWCursor  As Object

    Dim oBL As New com.sun.star.table.BorderLine2
    oBL.LineStyle = com.sun.star.table.BorderLineStyle.SOLID
    oBL.LineWidth = 26
    Dim oNoBL As New com.sun.star.table.BorderLine2

    Dim b          As Integer
    Dim aLines()   As String
    Dim l          As Integer
    Dim nStreepjes As Integer
    Dim bNieuwAfh  As Boolean

    ' Sorteer per dag dan per afhaalpunt
    Dim aBlok1(500) As String
    Dim aAfh21(500) As String
    Dim aDag1(500)  As String
    Dim n1          As Integer : n1 = 0
    Dim dd          As Integer
    Dim sD          As String
    Dim bNieuwDag   As Boolean
    For dd = 0 To nDagen - 1
        sD = aDagen(dd)
        For b = 0 To nBlok - 1
            If aDag2(b) = sD Then
                aBlok1(n1) = aBlok(b)
                aAfh21(n1) = aAfh2(b)
                aDag1(n1)  = sD
                n1 = n1 + 1
            End If
        Next b
    Next dd

    Const nPgHP2   = 29700
    Const nKolBod  = 26000
    Const nZoneP2  = 4000
    Const nKolBr   = 8900
    Const nStreepBr = 200
    Const nLetterBr = 310

    Dim oCtrl      As Object
    Dim oVC        As Object
    Dim bEersteKop As Boolean
    Dim oEnP2      As Object
    Dim oParaP2    As Object
    Dim oKopCurs   As Object
    Dim oPtP2      As Object
    Dim nYInPg     As Long
    Dim nCharH     As Single
    Dim oBrCurs    As Object
    Dim aTabStops(1) As New com.sun.star.style.TabStop
    Dim sOdtPath     As String
    Dim aOdtPath1(9) As String
    Dim nOdtPath1    As Integer : nOdtPath1 = 0
    Dim bFirstInDoc1 As Boolean
    Dim sPrevAfh1    As String

    For dd = 0 To nDagen - 1
        sD = aDagen(dd)

        oWriter = oDesktop.loadComponentFromURL("private:factory/swriter", "_blank", 0, aArgs())

        oPS = oWriter.StyleFamilies.getByName("PageStyles").getByIndex(0)
        oPS.IsLandscape  = False
        oPS.Width        = 21000 : oPS.Height       = 29700
        oPS.TopMargin    = 1500  : oPS.BottomMargin = 1500
        oPS.LeftMargin   = 1200  : oPS.RightMargin  = 1200

        oTC = oPS.TextColumns
        oTC.ColumnCount = 2 : oTC.AutomaticDistance = 800
        oPS.TextColumns = oTC

        oPS.FooterIsOn = True
        oFText = oPS.FooterText
        oFCurs = oFText.createTextCursor()
        oFCurs.setPropertyValue("CharFontName", "Calibri")
        oFCurs.setPropertyValue("CharHeight",   10)
        oFCurs.setPropertyValue("ParaAdjust",   com.sun.star.style.ParagraphAdjust.LEFT)
        aTabStops(0).Position    = 8700
        aTabStops(0).Alignment   = com.sun.star.style.TabAlign.RIGHT
        aTabStops(0).DecimalChar = ASC(".")
        aTabStops(0).FillChar    = ASC(" ")
        aTabStops(1).Position    = 9500
        aTabStops(1).Alignment   = com.sun.star.style.TabAlign.CENTER
        aTabStops(1).DecimalChar = ASC(".")
        aTabStops(1).FillChar    = ASC(" ")
        oFCurs.setPropertyValue("ParaTabStops", aTabStops())
        oFText.insertString(oFCurs, Chr(9), False)
        oFText.insertString(oFCurs, "Losse groenten " & sD & " (afh.punt)", False)
        oFText.insertString(oFCurs, Chr(9), False)
        oFldPN = oWriter.createInstance("com.sun.star.text.textfield.PageNumber")
        oFldPN.SubType        = com.sun.star.text.PageNumberType.CURRENT
        oFldPN.NumberingType  = com.sun.star.style.NumberingType.ARABIC
        oFText.insertTextContent(oFCurs, oFldPN, False)
        oFText.insertString(oFCurs, " / ", False)
        oFldPC = oWriter.createInstance("com.sun.star.text.textfield.PageCount")
        oFldPC.NumberingType  = com.sun.star.style.NumberingType.ARABIC
        oFText.insertTextContent(oFCurs, oFldPC, False)

        oText    = oWriter.getText()
        oWCursor = oText.createTextCursor()
        oWCursor.setPropertyValue("CharFontName", "Calibri")
        oWCursor.setPropertyValue("CharHeight", 16)
        oWCursor.setPropertyValue("CharWeight", com.sun.star.awt.FontWeight.BOLD)
        oWCursor.setPropertyValue("ParaTopMargin", 0)
        oWCursor.setPropertyValue("ParaBottomMargin", 200)
        oText.insertString(oWCursor, "Losse groenten " & sD & " ", False)
        oWCursor.setPropertyValue("CharPosture", com.sun.star.awt.FontSlant.ITALIC)
        oText.insertString(oWCursor, "(afh.punt)", False)
        oWCursor.setPropertyValue("CharPosture", com.sun.star.awt.FontSlant.NONE)
        oWCursor.setPropertyValue("CharWeight", com.sun.star.awt.FontWeight.NORMAL)
        oText.insertControlCharacter(oWCursor, _
            com.sun.star.text.ControlCharacter.PARAGRAPH_BREAK, False)
        bFirstInDoc1 = True
        sPrevAfh1    = ""

        For b = 0 To n1 - 1
            If aDag1(b) <> sD Then GoTo VolgendBlok1
            bNieuwAfh = (sPrevAfh1 = "") Or (aAfh21(b) <> sPrevAfh1)
            If bNieuwAfh Then
                oWCursor.setPropertyValue("CharFontName",     "Calibri")
                oWCursor.setPropertyValue("CharHeight",       16)
                oWCursor.setPropertyValue("CharWeight",       com.sun.star.awt.FontWeight.BOLD)
                oWCursor.setPropertyValue("ParaAdjust",       com.sun.star.style.ParagraphAdjust.CENTER)
                oWCursor.setPropertyValue("TopBorder",        oNoBL)
                oWCursor.setPropertyValue("BottomBorder",     oNoBL)
                oWCursor.setPropertyValue("LeftBorder",       oNoBL)
                oWCursor.setPropertyValue("RightBorder",      oNoBL)
                oWCursor.setPropertyValue("ParaTopMargin",    IIf(bFirstInDoc1, 0, 400))
                oWCursor.setPropertyValue("ParaBottomMargin", 200)
                nStreepjes = CInt((nKolBr - (Len(aAfh21(b)) * nLetterBr) - 2 * nLetterBr) / 2 / nStreepBr)
                If nStreepjes < 3 Then nStreepjes = 3
                oText.insertString(oWCursor, String(nStreepjes, "-") & " " & aAfh21(b) & " " & String(nStreepjes, "-"), False)
                oWCursor.setPropertyValue("CharWeight", com.sun.star.awt.FontWeight.NORMAL)
                oWCursor.setPropertyValue("ParaAdjust", com.sun.star.style.ParagraphAdjust.LEFT)
                oText.insertControlCharacter(oWCursor, _
                    com.sun.star.text.ControlCharacter.PARAGRAPH_BREAK, False)
                sPrevAfh1 = aAfh21(b)
            End If

            oWCursor.setPropertyValue("CharFontName",          "Calibri")
            oWCursor.setPropertyValue("CharHeight",            14)
            oWCursor.setPropertyValue("ParaTopMargin",         0)
            oWCursor.setPropertyValue("TopBorder",             oBL)
            oWCursor.setPropertyValue("BottomBorder",          oBL)
            oWCursor.setPropertyValue("LeftBorder",            oBL)
            oWCursor.setPropertyValue("RightBorder",           oBL)
            oWCursor.setPropertyValue("TopBorderDistance",     100)
            oWCursor.setPropertyValue("BottomBorderDistance",  100)
            oWCursor.setPropertyValue("LeftBorderDistance",    150)
            oWCursor.setPropertyValue("RightBorderDistance",   150)
            oWCursor.setPropertyValue("ParaBottomMargin",      300)

            aLines = Split(aBlok1(b), Chr(10))
            oWCursor.setPropertyValue("CharWeight", com.sun.star.awt.FontWeight.BOLD)
            oText.insertString(oWCursor, aLines(0), False)
            oWCursor.setPropertyValue("CharWeight", com.sun.star.awt.FontWeight.NORMAL)

            For l = 1 To UBound(aLines)
                oText.insertControlCharacter(oWCursor, _
                    com.sun.star.text.ControlCharacter.LINE_BREAK, False)
                oText.insertString(oWCursor, aLines(l), False)
            Next l

            oText.insertControlCharacter(oWCursor, _
                com.sun.star.text.ControlCharacter.PARAGRAPH_BREAK, False)
            bFirstInDoc1 = False

            VolgendBlok1:
        Next b

        oWriter.getCurrentController().getFrame().getContainerWindow().setVisible(True)
        Wait 400
        oCtrl      = oWriter.getCurrentController()
        oVC        = oCtrl.getViewCursor()
        bEersteKop = True
        oEnP2 = oText.createEnumeration()
        Do While oEnP2.hasMoreElements()
            oParaP2 = oEnP2.nextElement()
            If Not oParaP2.supportsService("com.sun.star.text.Paragraph") Then GoTo VolgP2
            oKopCurs = oText.createTextCursorByRange(oParaP2.getStart())
            nCharH = oKopCurs.getPropertyValue("CharHeight")
            If nCharH = 16 Then
                If bEersteKop Then : bEersteKop = False : GoTo VolgP2 : End If
                oCtrl.select(oKopCurs)
                oPtP2  = oVC.getPosition()
                nYInPg = oPtP2.Y Mod nPgHP2
                If nYInPg > nKolBod - nZoneP2 Then
                    oBrCurs = oText.createTextCursorByRange(oParaP2.getStart())
                    oBrCurs.setPropertyValue("BreakType", com.sun.star.style.BreakType.COLUMN_BEFORE)
                End If
            ElseIf nCharH = 14 Then
                oCtrl.select(oKopCurs)
                oPtP2  = oVC.getPosition()
                nYInPg = oPtP2.Y Mod nPgHP2
                If nYInPg > nKolBod - 700 Then
                    oBrCurs = oText.createTextCursorByRange(oParaP2.getStart())
                    oBrCurs.setPropertyValue("BreakType", com.sun.star.style.BreakType.COLUMN_BEFORE)
                End If
            End If
            VolgP2:
        Loop

        sOdtPath = Left(sWkPath, Len(sWkPath) - 4) & "_losse_groenten_per_klant_afhaalpunt_" & LCase(sD) & ".odt"
        oWriter.storeToURL(ConvertToURL(sOdtPath), aSave())
        If nOdtPath1 <= 9 Then : aOdtPath1(nOdtPath1) = sOdtPath : nOdtPath1 = nOdtPath1 + 1 : End If
        oWriter.close(True)
    Next dd

    ' -------------------------------------------------------
    ' Document 1b: orderpicking formaat, per dag één document
    ' -------------------------------------------------------
    Dim aFmVgl(4) As String : Dim aFmNam(4) As String
    aFmVgl(0) = "geen pakket"  : aFmNam(0) = "Geen pakket"
    aFmVgl(1) = "klein"        : aFmNam(1) = "Klein pakket"
    aFmVgl(2) = "groot"        : aFmNam(2) = "Groot pakket"
    aFmVgl(3) = "extra groot"  : aFmNam(3) = "Extra groot pakket"
    aFmVgl(4) = "mini"         : aFmNam(4) = "Mini pakket"

    Dim aBlokF(500) As String : Dim aGrpF(500) As String
    Dim aDagF(500)  As String
    Dim nBlokF As Integer : nBlokF = 0
    Dim fi As Integer
    For dd = 0 To nDagen - 1
        sD = aDagen(dd)
        For fi = 0 To 4
            For b = 0 To nBlok - 1
                If aDag2(b) = sD And aPakket(b) = aFmVgl(fi) Then
                    aBlokF(nBlokF) = aBlok(b)
                    aGrpF(nBlokF)  = aFmNam(fi)
                    aDagF(nBlokF)  = sD
                    nBlokF = nBlokF + 1
                End If
            Next b
        Next fi
    Next dd

    Dim oWriterF  As Object
    Dim oPSF      As Object
    Dim oTCF      As Object
    Dim oFTextF   As Object : Dim oFCursF As Object
    Dim oFldPNF   As Object : Dim oFldPCF As Object
    Dim oTextF    As Object : Dim oWCursF As Object

    Dim oBLF As New com.sun.star.table.BorderLine2
    oBLF.LineStyle = com.sun.star.table.BorderLineStyle.SOLID
    oBLF.LineWidth = 26
    Dim oNoBLF As New com.sun.star.table.BorderLine2

    Dim bF           As Integer : Dim aLinesF() As String
    Dim lF           As Integer : Dim nStreepjesF As Integer
    Dim bNieuwGrp    As Boolean
    Dim aTabStopsF(1) As New com.sun.star.style.TabStop
    Dim sOdtPathF     As String
    Dim aOdtPath1b(9) As String
    Dim nOdtPath1b    As Integer : nOdtPath1b = 0
    Dim bFirstInDocF  As Boolean
    Dim sPrevGrpF     As String
    Dim oBrCursF      As Object

    For dd = 0 To nDagen - 1
        sD = aDagen(dd)

        oWriterF = oDesktop.loadComponentFromURL("private:factory/swriter", "_blank", 0, aArgs())

        oPSF = oWriterF.StyleFamilies.getByName("PageStyles").getByIndex(0)
        oPSF.IsLandscape  = False
        oPSF.Width        = 21000 : oPSF.Height       = 29700
        oPSF.TopMargin    = 1500  : oPSF.BottomMargin = 1500
        oPSF.LeftMargin   = 1200  : oPSF.RightMargin  = 1200

        oTCF = oPSF.TextColumns
        oTCF.ColumnCount = 2 : oTCF.AutomaticDistance = 800
        oPSF.TextColumns = oTCF

        oPSF.FooterIsOn = True
        oFTextF = oPSF.FooterText
        oFCursF = oFTextF.createTextCursor()
        oFCursF.setPropertyValue("CharFontName", "Calibri")
        oFCursF.setPropertyValue("CharHeight",   10)
        oFCursF.setPropertyValue("ParaAdjust",   com.sun.star.style.ParagraphAdjust.LEFT)
        aTabStopsF(0).Position    = 8700
        aTabStopsF(0).Alignment   = com.sun.star.style.TabAlign.RIGHT
        aTabStopsF(0).DecimalChar = ASC(".")
        aTabStopsF(0).FillChar    = ASC(" ")
        aTabStopsF(1).Position    = 9500
        aTabStopsF(1).Alignment   = com.sun.star.style.TabAlign.CENTER
        aTabStopsF(1).DecimalChar = ASC(".")
        aTabStopsF(1).FillChar    = ASC(" ")
        oFCursF.setPropertyValue("ParaTabStops", aTabStopsF())
        oFTextF.insertString(oFCursF, Chr(9), False)
        oFTextF.insertString(oFCursF, "Losse groenten " & sD & " (formaat)", False)
        oFTextF.insertString(oFCursF, Chr(9), False)
        oFldPNF = oWriterF.createInstance("com.sun.star.text.textfield.PageNumber")
        oFldPNF.SubType        = com.sun.star.text.PageNumberType.CURRENT
        oFldPNF.NumberingType  = com.sun.star.style.NumberingType.ARABIC
        oFTextF.insertTextContent(oFCursF, oFldPNF, False)
        oFTextF.insertString(oFCursF, " / ", False)
        oFldPCF = oWriterF.createInstance("com.sun.star.text.textfield.PageCount")
        oFldPCF.NumberingType  = com.sun.star.style.NumberingType.ARABIC
        oFTextF.insertTextContent(oFCursF, oFldPCF, False)

        oTextF  = oWriterF.getText()
        oWCursF = oTextF.createTextCursor()
        oWCursF.setPropertyValue("CharFontName", "Calibri")
        oWCursF.setPropertyValue("CharHeight", 16)
        oWCursF.setPropertyValue("CharWeight", com.sun.star.awt.FontWeight.BOLD)
        oWCursF.setPropertyValue("ParaTopMargin", 0)
        oWCursF.setPropertyValue("ParaBottomMargin", 200)
        oTextF.insertString(oWCursF, "Losse groenten " & sD & " ", False)
        oWCursF.setPropertyValue("CharPosture", com.sun.star.awt.FontSlant.ITALIC)
        oTextF.insertString(oWCursF, "(formaat)", False)
        oWCursF.setPropertyValue("CharPosture", com.sun.star.awt.FontSlant.NONE)
        oWCursF.setPropertyValue("CharWeight", com.sun.star.awt.FontWeight.NORMAL)
        oTextF.insertControlCharacter(oWCursF, _
            com.sun.star.text.ControlCharacter.PARAGRAPH_BREAK, False)
        bFirstInDocF = True
        sPrevGrpF    = ""

        For bF = 0 To nBlokF - 1
            If aDagF(bF) <> sD Then GoTo VolgendBlokF
            bNieuwGrp = (sPrevGrpF = "") Or (aGrpF(bF) <> sPrevGrpF)
            If bNieuwGrp Then
                oWCursF.setPropertyValue("CharFontName",     "Calibri")
                oWCursF.setPropertyValue("CharHeight",       16)
                oWCursF.setPropertyValue("CharWeight",       com.sun.star.awt.FontWeight.BOLD)
                oWCursF.setPropertyValue("ParaAdjust",       com.sun.star.style.ParagraphAdjust.CENTER)
                oWCursF.setPropertyValue("TopBorder",        oNoBLF)
                oWCursF.setPropertyValue("BottomBorder",     oNoBLF)
                oWCursF.setPropertyValue("LeftBorder",       oNoBLF)
                oWCursF.setPropertyValue("RightBorder",      oNoBLF)
                oWCursF.setPropertyValue("ParaTopMargin",    IIf(bFirstInDocF, 0, 400))
                oWCursF.setPropertyValue("ParaBottomMargin", 200)
                nStreepjesF = CInt((8900 - (Len(aGrpF(bF)) * 310) - 620) / 2 / 200)
                If nStreepjesF < 3 Then nStreepjesF = 3
                oTextF.insertString(oWCursF, String(nStreepjesF, "-") & " " & aGrpF(bF) & " " & String(nStreepjesF, "-"), False)
                oWCursF.setPropertyValue("CharWeight", com.sun.star.awt.FontWeight.NORMAL)
                oWCursF.setPropertyValue("ParaAdjust", com.sun.star.style.ParagraphAdjust.LEFT)
                oTextF.insertControlCharacter(oWCursF, _
                    com.sun.star.text.ControlCharacter.PARAGRAPH_BREAK, False)
                sPrevGrpF = aGrpF(bF)
            End If

            oWCursF.setPropertyValue("CharFontName",          "Calibri")
            oWCursF.setPropertyValue("CharHeight",            14)
            oWCursF.setPropertyValue("ParaTopMargin",         0)
            oWCursF.setPropertyValue("TopBorder",             oBLF)
            oWCursF.setPropertyValue("BottomBorder",          oBLF)
            oWCursF.setPropertyValue("LeftBorder",            oBLF)
