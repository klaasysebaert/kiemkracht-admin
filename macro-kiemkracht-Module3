            oWriter3.storeToURL(ConvertToURL(sOdtPath3), aSave())
            oWriter3.close(True)

            If nOdtPath3 <= 9 Then
                aOdtPath3(nOdtPath3) = sOdtPath3
                nOdtPath3 = nOdtPath3 + 1
            End If
        Next d
    End If

    ' -------------------------------------------------------
    ' Document 4: overzicht weglatingen, per dag één document
    ' -------------------------------------------------------
    Dim aFmtCols(3)  As Integer
    Dim aFmtNamen(3) As String
    Dim f            As Integer
    Dim sKlanten     As String
    Dim nKlanten     As Integer
    Dim bEersteFmt4  As Boolean
    Dim bEersteGr    As Boolean
    Dim bHasAnyWeg   As Boolean
    Dim aKlantLines() As String
    Dim kl           As Integer
    Dim aOdtPath4(9) As String
    Dim nOdtPath4    As Integer
    nOdtPath4 = 0

    aFmtCols(0) = cKG   : aFmtNamen(0) = "Klein pakket"
    aFmtCols(1) = cGG   : aFmtNamen(1) = "Groot pakket"
    aFmtCols(2) = cEGG  : aFmtNamen(2) = "Extra groot pakket"
    aFmtCols(3) = cMINI : aFmtNamen(3) = "Mini pakket"

    bHasAnyWeg = False
    If nWeg > 0 And nDagen > 0 Then
        For i = 6 To nLastRow
            sNaam = oWkSheet.getCellByPosition(cNaam, i).getString()
            If sNaam = "" Then GoTo CheckWegNext
            If oWkSheet.getCellByPosition(cAfh, i).getString() = "afhaalpunt/dag" Then GoTo CheckWegNext
            For w = 0 To nWeg - 1
                If oWkSheet.getCellByPosition(cWeg0 + w, i).getString() <> "" Then
                    bHasAnyWeg = True : Exit For
                End If
            Next w
            If bHasAnyWeg Then Exit For
            CheckWegNext:
        Next i
    End If

    If bHasAnyWeg Then
        Dim oWriter4  As Object
        Dim oPS4      As Object
        Dim oFText4   As Object
        Dim oFCurs4   As Object
        Dim oFldPN4   As Object
        Dim oFldPC4   As Object
        Dim aTS4(1)   As New com.sun.star.style.TabStop
        Dim oText4    As Object
        Dim oCurs4    As Object
        Dim sOdtPath4 As String
        Dim oCtrl4    As Object
        Dim oVC4      As Object
        Dim oEnP4     As Object
        Dim oParaP4   As Object
        Dim oKopCurs4 As Object
        Dim oPtP4     As Object
        Dim nYInPg4   As Long
        Dim nCharH4   As Single
        Dim oBrCurs4  As Object
        Dim bEersteFmtKop As Boolean

        For d = 0 To nDagen - 1
            oWriter4 = oDesktop.loadComponentFromURL("private:factory/swriter", "_blank", 0, aArgs())

            oPS4 = oWriter4.StyleFamilies.getByName("PageStyles").getByIndex(0)
            oPS4.IsLandscape  = False
            oPS4.Width        = 21000 : oPS4.Height       = 29700
            oPS4.TopMargin    = 1500  : oPS4.BottomMargin = 1500
            oPS4.LeftMargin   = 1500  : oPS4.RightMargin  = 1500

            oPS4.FooterIsOn = True
            oFText4 = oPS4.FooterText
            oFCurs4 = oFText4.createTextCursor()
            oFCurs4.setPropertyValue("CharFontName", "Calibri")
            oFCurs4.setPropertyValue("CharHeight",   10)
            oFCurs4.setPropertyValue("ParaAdjust",   com.sun.star.style.ParagraphAdjust.LEFT)
            aTS4(0).Position    = 8700
            aTS4(0).Alignment   = com.sun.star.style.TabAlign.RIGHT
            aTS4(0).DecimalChar = ASC(".")
            aTS4(0).FillChar    = ASC(" ")
            aTS4(1).Position    = 9500
            aTS4(1).Alignment   = com.sun.star.style.TabAlign.CENTER
            aTS4(1).DecimalChar = ASC(".")
            aTS4(1).FillChar    = ASC(" ")
            oFCurs4.setPropertyValue("ParaTabStops", aTS4())
            oFText4.insertString(oFCurs4, Chr(9), False)
            oFText4.insertString(oFCurs4, "Weglatingen " & aDagen(d), False)
            oFText4.insertString(oFCurs4, Chr(9), False)
            oFldPN4 = oWriter4.createInstance("com.sun.star.text.textfield.PageNumber")
            oFldPN4.SubType       = com.sun.star.text.PageNumberType.CURRENT
            oFldPN4.NumberingType = com.sun.star.style.NumberingType.ARABIC
            oFText4.insertTextContent(oFCurs4, oFldPN4, False)
            oFText4.insertString(oFCurs4, " / ", False)
            oFldPC4 = oWriter4.createInstance("com.sun.star.text.textfield.PageCount")
            oFldPC4.NumberingType = com.sun.star.style.NumberingType.ARABIC
            oFText4.insertTextContent(oFCurs4, oFldPC4, False)

            oText4 = oWriter4.getText()
            oCurs4 = oText4.createTextCursor()
            oCurs4.setPropertyValue("CharFontName", "Calibri")
            oCurs4.setPropertyValue("CharHeight", 20)
            oCurs4.setPropertyValue("CharWeight", com.sun.star.awt.FontWeight.BOLD)
            oText4.insertString(oCurs4, "Weglatingen " & UCase(Left(aDagen(d), 1)) & Mid(aDagen(d), 2), False)
            oCurs4.setPropertyValue("CharWeight", com.sun.star.awt.FontWeight.NORMAL)
            oText4.insertControlCharacter(oCurs4, com.sun.star.text.ControlCharacter.PARAGRAPH_BREAK, False)
            oText4.insertControlCharacter(oCurs4, com.sun.star.text.ControlCharacter.PARAGRAPH_BREAK, False)
            oCurs4.setPropertyValue("CharHeight", 16)

            bEersteFmt4 = True

            For f = 0 To 3
                bEersteGr = True

                For w = 0 To nWeg - 1
                    sKlanten = ""
                    nKlanten = 0
                    For i = 6 To nLastRow
                        sNaam = oWkSheet.getCellByPosition(cNaam, i).getString()
                        If sNaam = "" Then GoTo VolgendeRijWeg
                        sAfh2 = oWkSheet.getCellByPosition(cAfh, i).getString()
                        If sAfh2 = "afhaalpunt/dag" Then GoTo VolgendeRijWeg
                        If oWkSheet.getCellByPosition(cKlaarDag, i).getString() <> aDagen(d) Then GoTo VolgendeRijWeg
                        If oWkSheet.getCellByPosition(aFmtCols(f), i).getValue() = 0 Then GoTo VolgendeRijWeg
                        If oWkSheet.getCellByPosition(cWeg0 + w, i).getString() = "" Then GoTo VolgendeRijWeg
                        nKlanten = nKlanten + 1
                        If nKlanten = 1 Then
                            sKlanten = sNaam & " (" & sAfh2 & ")"
                        Else
                            sKlanten = sKlanten & Chr(10) & sNaam & " (" & sAfh2 & ")"
                        End If
                        VolgendeRijWeg:
                    Next i

                    If nKlanten = 0 Then GoTo VolgendeWeg

                    If bEersteGr Then
                        oCurs4.setPropertyValue("CharHeight", 18)
                        oCurs4.setPropertyValue("CharWeight", com.sun.star.awt.FontWeight.BOLD)
                        oText4.insertString(oCurs4, String(11, "-") & " " & aFmtNamen(f) & " " & String(11, "-"), False)
                        oText4.insertControlCharacter(oCurs4, _
                            com.sun.star.text.ControlCharacter.PARAGRAPH_BREAK, False)
                        oText4.insertControlCharacter(oCurs4, _
                            com.sun.star.text.ControlCharacter.PARAGRAPH_BREAK, False)
                        oCurs4.setPropertyValue("CharHeight", 16)
                        oCurs4.setPropertyValue("CharWeight", com.sun.star.awt.FontWeight.NORMAL)
                        bEersteFmt4 = False
                        bEersteGr   = False
                    End If

                    oCurs4.setPropertyValue("CharWeight", com.sun.star.awt.FontWeight.BOLD)
                    oText4.insertString(oCurs4, wegNaam(w) & ":", False)
                    oCurs4.setPropertyValue("CharWeight", com.sun.star.awt.FontWeight.NORMAL)
                    aKlantLines = Split(sKlanten, Chr(10))
                    For kl = 0 To UBound(aKlantLines)
                        oText4.insertControlCharacter(oCurs4, _
                            com.sun.star.text.ControlCharacter.LINE_BREAK, False)
                        oText4.insertString(oCurs4, "    " & aKlantLines(kl), False)
                    Next kl
                    oText4.insertControlCharacter(oCurs4, _
                        com.sun.star.text.ControlCharacter.PARAGRAPH_BREAK, False)
                    oText4.insertControlCharacter(oCurs4, _
                        com.sun.star.text.ControlCharacter.PARAGRAPH_BREAK, False)

                    VolgendeWeg:
                Next w
            Next f

            If Not bEersteFmt4 Then
                ' Pass 2: formaatkoppen en wegnamen die te ver onderaan staan, verplaatsen naar volgend blad
                oWriter4.getCurrentController().getFrame().getContainerWindow().setVisible(True)
                Wait 400
                oCtrl4 = oWriter4.getCurrentController()
                oVC4   = oCtrl4.getViewCursor()
                bEersteFmtKop = True
                oEnP4 = oText4.createEnumeration()
                Do While oEnP4.hasMoreElements()
                    oParaP4 = oEnP4.nextElement()
                    If Not oParaP4.supportsService("com.sun.star.text.Paragraph") Then GoTo VolgP4
                    If oParaP4.getString() = "" Then GoTo VolgP4
                    oKopCurs4 = oText4.createTextCursorByRange(oParaP4.getStart())
                    nCharH4 = oKopCurs4.getPropertyValue("CharHeight")
                    If nCharH4 = 18 Then
                        If bEersteFmtKop Then : bEersteFmtKop = False : GoTo VolgP4 : End If
                        oCtrl4.select(oKopCurs4)
                        oPtP4   = oVC4.getPosition()
                        nYInPg4 = oPtP4.Y Mod 29700
                        If nYInPg4 > 24000 Then
                            oBrCurs4 = oText4.createTextCursorByRange(oParaP4.getStart())
                            oBrCurs4.setPropertyValue("BreakType", com.sun.star.style.BreakType.PAGE_BEFORE)
                        End If
                    ElseIf nCharH4 = 16 Then
                        oCtrl4.select(oKopCurs4)
                        oPtP4   = oVC4.getPosition()
                        nYInPg4 = oPtP4.Y Mod 29700
                        If nYInPg4 > 25300 Then
                            oBrCurs4 = oText4.createTextCursorByRange(oParaP4.getStart())
                            oBrCurs4.setPropertyValue("BreakType", com.sun.star.style.BreakType.PAGE_BEFORE)
                        End If
                    End If
                    VolgP4:
                Loop

                sOdtPath4 = Left(sWkPath, Len(sWkPath) - 4) & "_weglatingen_" & LCase(aDagen(d)) & ".odt"
                oWriter4.storeToURL(ConvertToURL(sOdtPath4), aSave())
                If d = nDagen - 1 Then
                    ' tweede write op het laatste bestand: vangt verloren Explorer-notificatie op
                    oWriter4.storeToURL(ConvertToURL(sOdtPath4), aSave())
                End If
                If nOdtPath4 <= 9 Then
                    aOdtPath4(nOdtPath4) = sOdtPath4
                    nOdtPath4 = nOdtPath4 + 1
                End If
            End If
            oWriter4.close(True)
        Next d
    End If

    Dim sMsgWeg As String
    sMsgWeg = ""
    Dim p4 As Integer
    For p4 = 0 To nOdtPath4 - 1
        sMsgWeg = sMsgWeg & Chr(10) & aOdtPath4(p4)
    Next p4
    Dim sMsgAfweeg As String : sMsgAfweeg = ""
    Dim p3 As Integer
    For p3 = 0 To nOdtPath3 - 1
        sMsgAfweeg = sMsgAfweeg & Chr(10) & aOdtPath3(p3)
    Next p3
    Dim sMsgOp As String : sMsgOp = ""
    Dim p1 As Integer
    For p1 = 0 To nOdtPath1 - 1
        sMsgOp = sMsgOp & Chr(10) & aOdtPath1(p1)
    Next p1
    Dim p1b As Integer
    For p1b = 0 To nOdtPath1b - 1
        sMsgOp = sMsgOp & Chr(10) & aOdtPath1b(p1b)
    Next p1b
    Dim sMsgGr As String : sMsgGr = ""
    Dim p2 As Integer
    For p2 = 0 To nOdtPath2 - 1
        sMsgGr = sMsgGr & Chr(10) & aOdtPath2(p2)
    Next p2
    MsgBox nBlok & " klanten (orderpicking)" & Chr(10) & _
           nGroentActief & " groenten (totalen)" & Chr(10) & _
           nDagen & " dag(en) (afweeglijst)" & Chr(10) & Chr(10) & _
           sMsgOp & sMsgGr & sMsgAfweeg & sMsgWeg, _
           64, "Overzichten klaar"
    Exit Sub

DebugFout:
    MsgBox "Fout " & Err & ": " & Error & Chr(10) & "Regel: " & Erl, 16, "Debug MaakOverzichten"

End Sub

' =============================================
' Kiemkracht - Alle overzichten afdrukken
' Drukt alle gegenereerde .odt-bestanden af naast het weekbestand.
' Afweeglijst per dag wordt 2x afgedrukt (dubbel exemplaar).
' =============================================
Sub MaakPrint()
    On Error GoTo PrintFout

    Dim oDoc As Object
    oDoc = ThisComponent

    Dim sWkPath As String
    sWkPath = ConvertFromURL(oDoc.getURL())
    Dim sBase As String
    sBase = Left(sWkPath, Len(sWkPath) - 4)

    Dim oDesktop As Object
    oDesktop = CreateUnoService("com.sun.star.frame.Desktop")

    Dim aArgs(0) As New com.sun.star.beans.PropertyValue
    aArgs(0).Name  = "Hidden"
    aArgs(0).Value = True

    Dim aPrintArgs(0) As New com.sun.star.beans.PropertyValue
    aPrintArgs(0).Name  = "Wait"
    aPrintArgs(0).Value = True

    Dim sPaths(30) As String
    Dim nPaths     As Integer
    nPaths = 0

    Dim aDagNamen(6) As String
    aDagNamen(0) = "maandag"  : aDagNamen(1) = "dinsdag"
    aDagNamen(2) = "woensdag" : aDagNamen(3) = "donderdag"
    aDagNamen(4) = "vrijdag"  : aDagNamen(5) = "zaterdag"
    aDagNamen(6) = "zondag"

    Dim dd As Integer
    Dim sOPad As String
    For dd = 0 To 6
        sOPad = sBase & "_losse_groenten_per_klant_afhaalpunt_" & aDagNamen(dd) & ".odt"
        If FileExists(sOPad) Then
            sPaths(nPaths) = sOPad : nPaths = nPaths + 1
        End If
    Next dd
    For dd = 0 To 6
        sOPad = sBase & "_losse_groenten_per_klant_formaat_" & aDagNamen(dd) & ".odt"
        If FileExists(sOPad) Then
            sPaths(nPaths) = sOPad : nPaths = nPaths + 1
        End If
    Next dd
    Dim sGrPad As String
    For dd = 0 To 6
        sGrPad = sBase & "_losse_groenten_oogstlijst_" & aDagNamen(dd) & ".odt"
        If FileExists(sGrPad) Then
            sPaths(nPaths) = sGrPad : nPaths = nPaths + 1
        End If
    Next dd

    Dim sWegPad As String
    Dim sAfweeg As String
    For dd = 0 To 6
        sWegPad = sBase & "_weglatingen_" & aDagNamen(dd) & ".odt"
        If FileExists(sWegPad) Then
            sPaths(nPaths) = sWegPad : nPaths = nPaths + 1
        End If
    Next dd
    For dd = 0 To 6
        sAfweeg = sBase & "_losse_groenten_afweeglijst_" & aDagNamen(dd) & ".odt"
        If FileExists(sAfweeg) Then
            sPaths(nPaths) = sAfweeg : nPaths = nPaths + 1
            sPaths(nPaths) = sAfweeg : nPaths = nPaths + 1
        End If
    Next dd

    If nPaths = 0 Then
        MsgBox "Geen documenten gevonden om af te drukken.", 48, "Print"
        Exit Sub
    End If

    Dim p        As Integer
    Dim oPDoc    As Object
    Dim nPrinted As Integer
    nPrinted = 0
    For p = 0 To nPaths - 1
        If FileExists(sPaths(p)) Then
            oPDoc = oDesktop.loadComponentFromURL(ConvertToURL(sPaths(p)), "_blank", 0, aArgs())
            oPDoc.print(aPrintArgs())
            oPDoc.close(True)
            nPrinted = nPrinted + 1
        End If
    Next p

    MsgBox nPrinted & " afdrukopdrachten verzonden.", 64, "Print klaar"
    Exit Sub

PrintFout:
    MsgBox "Fout " & Err & ": " & Error, 16, "Fout bij afdrukken"
End Sub

' =============================================
' Kiemkracht - Etiketten groentenpakketten
' Maakt een Calc-document met één etiket per cel:
'   regel 1: naam
'   regel 2: afhaalpunt
'   regel 3: naam pakket voluit
' Volgorde: per afhaalpunt, dan Klein → Groot → Extra groot → Mini
' =============================================
Sub MaakEtiketten()

    Const cNaam    = 0
    Const cAfh     = 1
    Const cKG      = 17
    Const cGG      = 18
    Const cEGG     = 19
    Const cMINI    = 20
    Const cVolgNr  = 55  ' kolom BD

    Dim oDoc     As Object
    Dim oWkSheet As Object
    oDoc     = ThisComponent
    oWkSheet = oDoc.Sheets.getByIndex(0)

    Dim oCalcCursor As Object
    oCalcCursor = oWkSheet.createCursor()
    oCalcCursor.gotoEndOfUsedArea(True)
    Dim nLastRow As Long
    nLastRow = oCalcCursor.getRangeAddress().EndRow

    ' Data verzamelen
    Dim eNaam(500)   As String
    Dim eAfh(500)    As String
    Dim ePakket(500) As String
    Dim ePakOrd(500) As Integer
    Dim eVolgNr(500) As Long
    Dim nEt          As Integer
    nEt = 0

    Dim i       As Long
    Dim sNaam   As String
    Dim sAfh    As String
    Dim sPakket As String
    Dim iPakOrd As Integer

    For i = 6 To nLastRow
        sNaam = oWkSheet.getCellByPosition(cNaam, i).getString()
        sAfh  = oWkSheet.getCellByPosition(cAfh,  i).getString()
        If sNaam = "" Or sAfh = "afhaalpunt/dag" Then GoTo VolgendeRijEt

        If      oWkSheet.getCellByPosition(cKG,   i).getValue() > 0 Then
            sPakket = "Klein groentenpakket"  : iPakOrd = 1
        ElseIf  oWkSheet.getCellByPosition(cGG,   i).getValue() > 0 Then
            sPakket = "Groot groentenpakket"  : iPakOrd = 2
        ElseIf  oWkSheet.getCellByPosition(cEGG,  i).getValue() > 0 Then
            sPakket = "Extra groot groentenpakket" : iPakOrd = 3
        ElseIf  oWkSheet.getCellByPosition(cMINI, i).getValue() > 0 Then
            sPakket = "Mini groentenpakket"   : iPakOrd = 4
        Else
            GoTo VolgendeRijEt
        End If

        If nEt <= 500 Then
            eNaam(nEt)   = sNaam
            eAfh(nEt)    = sAfh
            ePakket(nEt) = sPakket
            ePakOrd(nEt) = iPakOrd
            eVolgNr(nEt) = CLng(oWkSheet.getCellByPosition(cVolgNr, i).getValue())
            nEt = nEt + 1
        End If

        VolgendeRijEt:
    Next i

    If nEt = 0 Then
        MsgBox "Geen groentenpakketten gevonden.", 48, "Etiketten"
        Exit Sub
    End If

    ' Unieke afhaalpunten in volgorde van eerste verschijning (= weekbestandvolgorde)
    Dim aAfhOrd(50) As String
    Dim nAfhOrd     As Integer
    Dim k           As Integer
    Dim bNieuw      As Boolean
    nAfhOrd = 0
    For i = 0 To nEt - 1
        bNieuw = True
        For k = 0 To nAfhOrd - 1
            If aAfhOrd(k) = eAfh(i) Then bNieuw = False : Exit For
        Next k
        If bNieuw And nAfhOrd <= 50 Then
            aAfhOrd(nAfhOrd) = eAfh(i)
            nAfhOrd = nAfhOrd + 1
        End If
    Next i

    ' Gesorteerde uitvoerindex opbouwen: per afhaalpunt (weekbestandvolgorde),
    ' binnen afhaalpunt op pakketorde (1=Klein, 2=Groot, 3=EGG, 4=Mini),
    ' binnen pakket op volgnummer (kolom BD, oplopend)
    Dim aIdx(500)  As Integer
    Dim nIdx       As Integer
    Dim p          As Integer
    Dim aTmp(500)  As Integer
    Dim nTmp       As Integer
    Dim t1         As Integer
    Dim t2         As Integer
    Dim tSwap      As Integer
    nIdx = 0
    For k = 0 To nAfhOrd - 1
        For p = 1 To 4
            ' Verzamel kandidaten voor dit afhaalpunt + pakket
            nTmp = 0
            For i = 0 To nEt - 1
                If eAfh(i) = aAfhOrd(k) And ePakOrd(i) = p Then
                    aTmp(nTmp) = i
                    nTmp = nTmp + 1
                End If
            Next i
            ' Bubble sort op volgnummer (oplopend)
            For t1 = 0 To nTmp - 2
                For t2 = 0 To nTmp - t1 - 2
                    If eVolgNr(aTmp(t2)) > eVolgNr(aTmp(t2 + 1)) Then
                        tSwap        = aTmp(t2)
                        aTmp(t2)     = aTmp(t2 + 1)
                        aTmp(t2 + 1) = tSwap
                    End If
                Next t2
            Next t1
            ' Toevoegen aan uitvoerindex
            For t1 = 0 To nTmp - 1
                aIdx(nIdx) = aTmp(t1)
                nIdx = nIdx + 1
            Next t1
        Next p
    Next k

    ' Nieuw Calc-document aanmaken
    Dim oDesktop As Object
    oDesktop = CreateUnoService("com.sun.star.frame.Desktop")
    Dim aArgs(0) As New com.sun.star.beans.PropertyValue
    aArgs(0).Name  = "Hidden"
    aArgs(0).Value = True

    Dim oCalc    As Object
    Dim oEtSheet As Object
    oCalc    = oDesktop.loadComponentFromURL("private:factory/scalc", "_blank", 0, aArgs())
    oEtSheet = oCalc.Sheets.getByIndex(0)
    oEtSheet.Name = "etiketten"

    ' Paginaopmaak: marges 0, geen kop- of voettekst
    Dim oPS As Object
    oPS = oCalc.StyleFamilies.getByName("PageStyles").getByName("Default")
    oPS.TopMargin    = 0 : oPS.BottomMargin = 0
    oPS.LeftMargin   = 0 : oPS.RightMargin  = 0
    oPS.HeaderIsOn   = False
    oPS.FooterIsOn   = False

    ' Eerste lege rij van 0,80 cm voor correcte printuitlijning
    Dim oRows As Object
    oRows = oEtSheet.getRows()
    oRows.getByIndex(0).Height       = 800
    oRows.getByIndex(0).OptimalHeight = False

    ' Kolombreedte: 6,90 cm
    Dim oCols As Object
    oCols = oEtSheet.getColumns()
    oCols.getByIndex(0).Width        = 6900
    oCols.getByIndex(0).OptimalWidth = False

    ' Etiketten schrijven: één per cel, regels gescheiden door Chr(10)
    ' Starten op rij 1 (na de lege uitlijnrij)
    Dim oCell As Object
    Dim iEt   As Integer
    For iEt = 0 To nIdx - 1
        i = aIdx(iEt)
        oCell = oEtSheet.getCellByPosition(0, iEt + 1)
        oCell.setString(eNaam(i) & Chr(10) & ePakket(i) & Chr(10) & eAfh(i))
        oCell.setPropertyValue("IsTextWrapped", True)
        oCell.setPropertyValue("HoriJustify", com.sun.star.table.CellHoriJustify.LEFT)
        oCell.setPropertyValue("VertJustify", com.sun.star.table.CellVertJustify2.CENTER)
        oCell.setPropertyValue("ParaLeftMargin", 605)
        oCell.setPropertyValue("CharFontName", "Calibri")
        oCell.setPropertyValue("CharHeight", 17.5)

        oRows.getByIndex(iEt + 1).Height        = 3500
        oRows.getByIndex(iEt + 1).OptimalHeight = False
    Next iEt

    ' Extra kolommen B, C, D, ... met formules naar kolom A
    ' 8 etiketten per kolom (rijen 2-9)
    Const nLabPerKol = 8
    Dim nExtraKols   As Integer
    Dim iKol         As Integer
    Dim iRij         As Integer
    Dim iSrcRij      As Integer
    Dim sFormule     As String
    nExtraKols = Int((nIdx - 1) / nLabPerKol)  ' 0 als <= 8 etiketten

    For iKol = 1 To nExtraKols
        oCols.getByIndex(iKol).Width        = 6900
        oCols.getByIndex(iKol).OptimalWidth = False
        For iRij = 2 To nLabPerKol + 1
            iSrcRij  = iRij + iKol * nLabPerKol
            Dim oCelF As Object
            oCelF = oEtSheet.getCellByPosition(iKol, iRij - 1)
            oCelF.FormulaLocal = "=ALS(A" & iSrcRij & "="""";"""";A" & iSrcRij & ")"
            oCelF.setPropertyValue("IsTextWrapped", True)
            oCelF.setPropertyValue("HoriJustify", com.sun.star.table.CellHoriJustify.LEFT)
            oCelF.setPropertyValue("VertJustify", com.sun.star.table.CellVertJustify2.CENTER)
            oCelF.setPropertyValue("ParaLeftMargin", 605)
            oCelF.setPropertyValue("CharFontName", "Calibri")
            oCelF.setPropertyValue("CharHeight", 17.5)

        Next iRij
    Next iKol

    ' Opslaan naast weekbestand
    Dim aSave(0) As New com.sun.star.beans.PropertyValue
    aSave(0).Name  = "FilterName"
    aSave(0).Value = "calc8"
    Dim sWkPath   As String
    Dim sCalcPath As String
    sWkPath   = ConvertFromURL(oDoc.getURL())
    sCalcPath = Left(sWkPath, Len(sWkPath) - 4) & "_etiketten.ods"
