            "=IF($A" & sB & "="""";"""";ROUND(" & _
            "Samenstelling.D" & sS & "*MAX(B$" & CStr(BST_RIJ_AANT + 1) & "-B" & sB & ";0)+" & _
            "Samenstelling.F" & sS & "*MAX(C$" & CStr(BST_RIJ_AANT + 1) & "-C" & sB & ";0)+" & _
            "Samenstelling.H" & sS & "*MAX(D$" & CStr(BST_RIJ_AANT + 1) & "-D" & sB & ";0)+" & _
