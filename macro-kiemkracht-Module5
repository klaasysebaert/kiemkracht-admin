' ---------------------------------------------------------------------------
' SamLaadDagcijfers — momentopname uit de DB in de g*-arrays: aantal pakketten
' per maat per dag (donderdag/vrijdag, dag = klant-afhaalpunt > bestelling-
' afhaalpunt > leverdag) en de weglatingen per (groente, maat, dag).
' Zelfde drie takken als de klant-query in MaakWeekbestand: bestellingen,
' ritme-abonnees zonder bestelling, weekperweek/toekomst-klanten met
' vooruitbestelling.
' LET OP: aggregaat-kopie van de MaakWeekbestand-logica — wijzigt die query
' (Module1, stap 3), pas dan ook hier aan. Het weekbestand blijft de
' gezaghebbende telling; dit is de vooraf-indicatie voor de groothandel.
' Gedeeld door de tab-layout (Bestellijst + Afweeglijst) en de klassieke
' layout (Module6).
' ---------------------------------------------------------------------------
Sub SamLaadDagcijfers(oConn As Object, iWeek As Integer, iJaar As Integer)
    Dim oStmt As Object
    Dim oRS   As Object
    Dim iMaat As Integer
    Dim iWg   As Integer
    Dim iVind As Integer
    Dim sDag  As String
    Dim nTel  As Long
    Dim sParRitmes As String
    Dim iWeekNum   As Long
    Dim sMaatCase  As String
    Dim sTakJoins  As String
    Dim sSql  As String

    If (iWeek Mod 2) = 0 Then
        sParRitmes = "'wekelijks','pare-week'"
    Else
        sParRitmes = "'wekelijks','onpare-week'"
    End If
    iWeekNum = CLng(iJaar) * 100 + iWeek

    ' pakket-tekst → sleutel (zelfde normalisatie als MaakWeekbestand/vb_week)
    sMaatCase = "CASE LOWER(TRIM(REPLACE(%s, ' pakket', ''))) " & _
                "WHEN 'klein' THEN 'klein' WHEN 'groot' THEN 'groot' " & _
                "WHEN 'extra groot' THEN 'extra-groot' WHEN 'extra-groot' THEN 'extra-groot' " & _
                "WHEN 'mini' THEN 'mini' END"
    ' klant/afhaalpunt-joins voor de dag-bepaling van een bestelling
    ' (zelfde COALESCE-volgorde als MaakWeekbestand: klant-afhaalpunt wint)
    sTakJoins = " LEFT JOIN klanten k ON (k.id = b.klant_id OR (b.klant_id IS NULL " & _
                "     AND k.email1 = b.klant_email)) " & _
                " LEFT JOIN afhaalpunten kap ON kap.id = k.afhaalpunt_id " & _
                " LEFT JOIN afhaalpunten bap ON bap.naam = b.afhaalpunt "

    ' --- 1. Aantal pakketten per maat per dag ---
    For iMaat = 0 To 3
        gDgTot(iMaat)     = 0
        gDgAant(iMaat, 0) = 0
        gDgAant(iMaat, 1) = 0
    Next iMaat

    sSql = "WITH vb_week AS (" & _
           " SELECT klant_id, LOWER(klant_email) AS email_l, " & _
           Replace(sMaatCase, "%s", "formaat") & " AS sleutel " & _
           " FROM vooruitbestellingen " & _
           " WHERE jaar = " & iJaar & " AND week_bestelling = " & iWeek & _
           "   AND formaat IS NOT NULL), " & _
           "alle AS (" & _
           " SELECT " & Replace(sMaatCase, "%s", "b.pakket") & " AS sleutel, " & _
           " LOWER(COALESCE(kap.dag_klaarmaken, bap.dag_klaarmaken, b.leverdag, '')) AS dag " & _
           " FROM bestellingen b " & sTakJoins & _
           " WHERE b.weeknummer = " & iWeek & " AND b.jaar = " & iJaar & _
           "  AND NOT EXISTS (SELECT 1 FROM annulaties ann1 " & _
           "   WHERE ann1.jaar = " & iJaar & " AND ann1.week_annulatie = " & iWeek & _
           "    AND (ann1.klant_id = b.klant_id OR (b.klant_id IS NULL " & _
           "         AND LOWER(ann1.klant_email) = LOWER(b.klant_email)))) " & _
           " UNION ALL " & _
           " SELECT COALESCE(vb.sleutel, a.formaat), LOWER(COALESCE(ap.dag_klaarmaken,'')) " & _
           " FROM abonnementen a JOIN klanten k ON k.id = a.klant_id " & _
           " LEFT JOIN afhaalpunten ap ON ap.id = k.afhaalpunt_id " & _
           " LEFT JOIN vb_week vb ON (vb.klant_id = k.id OR (vb.klant_id IS NULL " & _
           "      AND vb.email_l = LOWER(k.email1))) " & _
           " WHERE a.status = 'actief' AND a.ritme IN (" & sParRitmes & ") " & _
           "  AND (a.eind_jaar IS NULL OR (a.eind_jaar * 100 + a.eind_week) > " & iWeekNum & ") " & _
           "  AND (a.start_jaar IS NULL OR (a.start_jaar * 100 + a.start_week) <= " & iWeekNum & ") " & _
           "  AND (a.pauze_vanaf_week IS NULL OR " & _
           "       (a.pauze_vanaf_jaar * 100 + a.pauze_vanaf_week) > " & iWeekNum & ") " & _
           "  AND NOT EXISTS (SELECT 1 FROM bestellingen bx " & _
           "   WHERE bx.weeknummer = " & iWeek & " AND bx.jaar = " & iJaar & _
           "    AND (bx.klant_id = k.id OR (bx.klant_id IS NULL " & _
           "         AND LOWER(bx.klant_email) = LOWER(k.email1)))) " & _
           "  AND NOT EXISTS (SELECT 1 FROM annulaties ann2 " & _
           "   WHERE ann2.jaar = " & iJaar & " AND ann2.week_annulatie = " & iWeek & _
           "    AND (ann2.klant_id = k.id OR (ann2.klant_id IS NULL " & _
           "         AND LOWER(ann2.klant_email) = LOWER(k.email1)))) " & _
           "  AND NOT EXISTS (SELECT 1 FROM annulaties ann3 " & _
           "   WHERE ann3.jaar = " & iJaar & _
           "    AND ann3.week_stopzetten_abonnement > 0 " & _
           "    AND ann3.week_stopzetten_abonnement <= " & iWeek & _
           "    AND (ann3.klant_id = k.id OR (ann3.klant_id IS NULL " & _
           "         AND LOWER(ann3.klant_email) = LOWER(k.email1)))) " & _
           " UNION ALL " & _
           " SELECT vb.sleutel, LOWER(COALESCE(ap.dag_klaarmaken,'')) " & _
           " FROM klanten k " & _
           " LEFT JOIN afhaalpunten ap ON ap.id = k.afhaalpunt_id " & _
           " INNER JOIN vb_week vb ON (vb.klant_id = k.id OR (vb.klant_id IS NULL " & _
           "      AND vb.email_l = LOWER(k.email1))) " & _
           " WHERE k.status = 'actief' AND vb.sleutel IS NOT NULL " & _
           "  AND NOT EXISTS (SELECT 1 FROM abonnementen a3 WHERE a3.klant_id = k.id " & _
           "   AND a3.status = 'actief' AND a3.ritme IN (" & sParRitmes & ") " & _
           "   AND (a3.pauze_vanaf_week IS NULL OR " & _
           "        (a3.pauze_vanaf_jaar * 100 + a3.pauze_vanaf_week) > " & iWeekNum & ") " & _
           "   AND (a3.eind_jaar IS NULL OR (a3.eind_jaar * 100 + a3.eind_week) > " & iWeekNum & ") " & _
           "   AND (a3.start_jaar IS NULL OR (a3.start_jaar * 100 + a3.start_week) <= " & iWeekNum & ")) " & _
           "  AND NOT EXISTS (SELECT 1 FROM bestellingen bx " & _
           "   WHERE bx.weeknummer = " & iWeek & " AND bx.jaar = " & iJaar & _
           "    AND (bx.klant_id = k.id OR (bx.klant_id IS NULL " & _
           "         AND LOWER(bx.klant_email) = LOWER(k.email1)))) " & _
           "  AND NOT EXISTS (SELECT 1 FROM annulaties ann4 " & _
           "   WHERE ann4.jaar = " & iJaar & " AND ann4.week_annulatie = " & iWeek & _
           "    AND (ann4.klant_id = k.id OR (ann4.klant_id IS NULL " & _
           "         AND LOWER(ann4.klant_email) = LOWER(k.email1))))) " & _
           "SELECT sleutel, dag, COUNT(*) FROM alle WHERE sleutel IS NOT NULL GROUP BY 1, 2"

    oStmt = oConn.createStatement()
    oRS = oStmt.executeQuery(sSql)
    Do While oRS.next()
        iMaat = SamMaatIdx(oRS.getString(1))
        sDag  = oRS.getString(2)
        nTel  = oRS.getLong(3)
        If iMaat >= 0 Then
            gDgTot(iMaat) = gDgTot(iMaat) + nTel
            If sDag = "donderdag" Then gDgAant(iMaat, 0) = gDgAant(iMaat, 0) + nTel
            If sDag = "vrijdag"   Then gDgAant(iMaat, 1) = gDgAant(iMaat, 1) + nTel
        End If
    Loop
    oRS.close() : oStmt.close()

    ' --- 2. Weglatingen per (groente, maat, dag) ---
    gNWg = 0
    oStmt = oConn.createStatement()
    oRS = oStmt.executeQuery( _
        "SELECT bw.groente_naam, " & Replace(sMaatCase, "%s", "b.pakket") & " AS sleutel, " & _
        "LOWER(COALESCE(kap.dag_klaarmaken, bap.dag_klaarmaken, b.leverdag, '')) AS dag, COUNT(*) " & _
        "FROM bestelling_weglatingen bw " & _
        "INNER JOIN bestellingen b ON b.id = bw.bestelling_id " & sTakJoins & _
        "WHERE b.weeknummer = " & iWeek & " AND b.jaar = " & iJaar & _
        " AND NOT EXISTS (SELECT 1 FROM annulaties ann1 " & _
        "  WHERE ann1.jaar = " & iJaar & " AND ann1.week_annulatie = " & iWeek & _
        "   AND (ann1.klant_id = b.klant_id OR (b.klant_id IS NULL " & _
        "        AND LOWER(ann1.klant_email) = LOWER(b.klant_email)))) " & _
        "GROUP BY 1, 2, 3")
    Do While oRS.next()
        iMaat = SamMaatIdx(oRS.getString(2))
        If iMaat >= 0 And gNWg < 200 Then
            iVind = -1
            For iWg = 0 To gNWg - 1
                If gWgNaam(iWg) = oRS.getString(1) And gWgMaat(iWg) = iMaat Then
                    iVind = iWg
                    Exit For
                End If
            Next iWg
            If iVind = -1 Then
                iVind = gNWg
                gWgNaam(gNWg) = oRS.getString(1)
                gWgMaat(gNWg) = iMaat
                gWgDon(gNWg) = 0 : gWgVrij(gNWg) = 0 : gWgOnb(gNWg) = 0
                gNWg = gNWg + 1
            End If
            sDag = oRS.getString(3)
            nTel = oRS.getLong(4)
            If sDag = "donderdag" Then
                gWgDon(iVind) = gWgDon(iVind) + nTel
            ElseIf sDag = "vrijdag" Then
                gWgVrij(iVind) = gWgVrij(iVind) + nTel
            Else
                gWgOnb(iVind) = gWgOnb(iVind) + nTel
            End If
        End If
    Loop
    oRS.close() : oStmt.close()
End Sub

' ---------------------------------------------------------------------------
' SamVulBestellijst — de Bestellijst-tab (TAB_BST) vullen met de momentopname
' uit SamLaadDagcijfers: aantal pakketten per maat, weglatingen per (groente,
' maat), besteld-tellers. Bouwt daarna de Afweeglijst-tab opnieuw op.
' ---------------------------------------------------------------------------
Private Sub SamVulBestellijst(oDoc As Object, oConn As Object, _
                              iWeek As Integer, iJaar As Integer)
    Dim oBst  As Object
    Dim oSam  As Object
    Dim iMaat As Integer
    Dim iSlot As Integer
    Dim iWg   As Integer
    Dim iVind As Integer
    Dim sNaam As String
    Dim sOnbekend As String

    oBst = oDoc.Sheets.getByName(TAB_BST)
    oSam = oDoc.Sheets.getByName(TAB_SAM)

    SamLaadDagcijfers(oConn, iWeek, iJaar)

    ' --- 1. Aantal pakketten per maat (alle dagen samen) ---
    For iMaat = 0 To 3
        oBst.getCellByPosition(1 + iMaat, BST_RIJ_AANT).setValue(gDgTot(iMaat))
    Next iMaat

    ' --- 2. Weglatingen per (groente, maat), match op naam ---
    oBst.getCellRangeByPosition(1, BST_RIJ0, 4, BST_RIJ0 + SAM_SLOTS - 1).clearContents(7)
    sOnbekend = ""
    For iWg = 0 To gNWg - 1
        sNaam = gWgNaam(iWg)
        iVind = -1
        For iSlot = 0 To SAM_SLOTS - 1
            If oSam.getCellByPosition(0, SAM_RIJ0 + iSlot).getString() = sNaam Then
                iVind = iSlot
                Exit For
            End If
        Next iSlot
        If iVind >= 0 Then
            oBst.getCellByPosition(1 + gWgMaat(iWg), BST_RIJ0 + iVind).setValue( _
                gWgDon(iWg) + gWgVrij(iWg) + gWgOnb(iWg))
        ElseIf InStr(sOnbekend, "| " & sNaam) = 0 Then
            sOnbekend = sOnbekend & "| " & sNaam
        End If
    Next iWg

    ' --- 3. Besteld-tellers verversen op de Los-tab (kolom I) ---
    SamVerversLosBesteld(oDoc, oConn, iWeek, iJaar)

    ' --- 4. Afweeglijsten en printbladen opnieuw opbouwen ---
    SamVulAfweeglijst(oDoc, iWeek, iJaar)
    SamVulPrintbladen(oDoc, iWeek, iJaar)

    ' Tijdstempel + eventuele niet-gematchte weglating-groenten
    oBst.getCellByPosition(6, BST_RIJ_AANT).setString( _
        "ververst: " & Format(Now(), "DD/MM/YYYY HH:MM"))
    If sOnbekend <> "" Then
        oBst.getCellByPosition(0, BST_RIJ0 + SAM_SLOTS + 1).setString( _
            "Weglatingen voor groenten die niet in de samenstelling staan: " & _
            Mid(sOnbekend, 3))
    Else
        oBst.getCellByPosition(0, BST_RIJ0 + SAM_SLOTS + 1).setString("")
    End If
End Sub

' ---------------------------------------------------------------------------
' SamVulAfweeglijst — de twee afweegbladen (donderdag/vrijdag) herbouwen.
' Leest de samenstelling van de Samenstelling-tab en de aantallen/weglatingen
' per dag uit de g*-arrays (SamLaadDagcijfers moet dus eerst gedraaid zijn).
' Volledig afgeleid: geen invulvelden, wordt bij elke ververs herbouwd.
' ---------------------------------------------------------------------------
Private Sub SamVulAfweeglijst(oDoc As Object, iWeek As Integer, iJaar As Integer)
    SamVulAfweegDag(oDoc, 0, iWeek, iJaar)
    SamVulAfweegDag(oDoc, 1, iWeek, iJaar)
End Sub

' ---------------------------------------------------------------------------
' Eén afweegblad (iDag: 0 = donderdag, 1 = vrijdag), naar het model van de
' gelijknamige Sheet-tabbladen:
'   - per pakketgroente een blok: naam, dan per maat die de groente in dat
'     pakket heeft "MINI | aantal | x hoeveelheid | = nodig | alle/N niet!",
'     dan "donderdag nodig: | = totaal". Maten zonder hoeveelheid krijgen
'     géén rij, blokken zijn dus ongelijk hoog.
'   - blokken staan aaneengesloten (twee lege rijen ertussen) en worden over
'     twee bladhelften verdeeld (links A..E, rechts G..K, vanaf rij 3) op het
'     blokovergang die beide helften het meest gelijk maakt.
'   - lettergrootte 20 en de kolombreedtes van de Sheet; pagina-instelling
'     A4 staand, op één bladzijde geschaald.
' ---------------------------------------------------------------------------
Private Sub SamVulAfweegDag(oDoc As Object, iDag As Integer, _
                            iWeek As Integer, iJaar As Integer)
    Dim oAfw   As Object
    Dim oSam   As Object
    Dim iSlot  As Integer
    Dim iRij   As Integer
    Dim iKol   As Integer
    Dim iMaat  As Integer
    Dim iMaatVolg As Integer
    Dim iWg    As Integer
    Dim iG     As Integer
    Dim sNaam  As String
    Dim sTab   As String
    Dim sDagLbl As String
    Dim nAantalDag As Long
    Dim nWegDag    As Long
    Dim dNodig  As Double
    Dim dSom    As Double
    Dim aMaatLabel(3) As String

    aMaatLabel(0) = "KG" : aMaatLabel(1) = "GG"
    aMaatLabel(2) = "EGG" : aMaatLabel(3) = "MINI"
    If iDag = 0 Then
        sTab = TAB_AFW_DO : sDagLbl = "DONDERDAG"
    Else
        sTab = TAB_AFW_VR : sDagLbl = "VRIJDAG"
    End If

    oAfw = SamZorgTab(oDoc, sTab)
    oSam = oDoc.Sheets.getByName(TAB_SAM)
    ' inhoud én harde opmaak wissen (1+2+4+16+32), zodat een korter blad geen
    ' resten van de vorige week overhoudt
    oAfw.getCellRangeByPosition(0, 0, 10, AFW_MAX_RIJ).clearContents(55)

    ' --- Groenten + hoeveelheid per maat van de Samenstelling-tab ---
    Dim gN(SAM_SLOTS - 1) As String
    Dim gH(SAM_SLOTS - 1, 3) As Double
    Dim gHoogte(SAM_SLOTS - 1) As Integer   ' naamrij + maatrijen + totaalrij
    Dim nG As Integer
    Dim nMaten As Integer
    nG = 0
    For iSlot = 0 To SAM_SLOTS - 1
        sNaam = oSam.getCellByPosition(0, SAM_RIJ0 + iSlot).getString()
        If sNaam <> "" Then
            nMaten = 0
            For iMaat = 0 To 3
                gH(nG, iMaat) = oSam.getCellByPosition(3 + iMaat * 2, SAM_RIJ0 + iSlot).getValue()
                If gH(nG, iMaat) > 0 Then nMaten = nMaten + 1
            Next iMaat
            If nMaten > 0 Then
                gN(nG) = sNaam
                gHoogte(nG) = 2 + nMaten
                nG = nG + 1
            End If
        End If
    Next iSlot

    ' --- Breekpunt: eerste blok van de rechterhelft (helften zo gelijk mogelijk) ---
    Dim iBreek  As Integer
    Dim iLinks  As Integer
    Dim iRechts As Integer
    Dim iBeste  As Integer
    Dim iHoogst As Integer
    Dim iTotaal As Integer
    iTotaal = 0
    For iG = 0 To nG - 1
        iTotaal = iTotaal + gHoogte(iG) + 2       ' blok + twee lege rijen
    Next iG
    iBreek = nG                                    ' alles links (bij weinig blokken)
    iBeste = iTotaal
    iLinks = 0
    For iG = 1 To nG - 1
        iLinks = iLinks + gHoogte(iG - 1) + 2
        iRechts = iTotaal - iLinks
        If iLinks > iRechts Then iHoogst = iLinks Else iHoogst = iRechts
        If iHoogst < iBeste Then
            iBeste = iHoogst
            iBreek = iG
        End If
    Next iG

    ' --- Titel ---
    oAfw.getCellByPosition(0, 0).setString(sDagLbl)
    oAfw.getCellByPosition(4, 0).setString( _
        "week " & iWeek & "/" & iJaar & " — ververst: " & Format(Now(), "DD/MM/YYYY HH:MM"))

    ' --- Blokken schrijven ---
    Dim iRijL As Integer
    Dim iRijR As Integer
    Dim iEindL As Integer
    Dim iEindR As Integer
    iRijL = AFW_RIJ0
    iRijR = AFW_RIJ0
    For iG = 0 To nG - 1
        If iG < iBreek Then
            iKol = 0 : iRij = iRijL
        Else
            iKol = AFW_KOL_R : iRij = iRijR
        End If

        oAfw.getCellByPosition(iKol, iRij).setString(gN(iG))
        iRij = iRij + 1
        dSom = 0
        For iMaatVolg = 0 To 3
            iMaat = 3 - iMaatVolg                  ' MINI, EGG, GG, KG
            If gH(iG, iMaat) > 0 Then
                nWegDag = 0
                For iWg = 0 To gNWg - 1
                    If gWgNaam(iWg) = gN(iG) And gWgMaat(iWg) = iMaat Then
                        If iDag = 0 Then nWegDag = gWgDon(iWg) Else nWegDag = gWgVrij(iWg)
                        Exit For
                    End If
                Next iWg
                nAantalDag = gDgAant(iMaat, iDag) - nWegDag
                If nAantalDag < 0 Then nAantalDag = 0
                dNodig = Int(nAantalDag * gH(iG, iMaat) * 100 + 0.5) / 100
                oAfw.getCellByPosition(iKol, iRij).setString(aMaatLabel(iMaat))
                oAfw.getCellByPosition(iKol + 1, iRij).setValue(nAantalDag)
                oAfw.getCellByPosition(iKol + 2, iRij).setString( _
                    "x " & Format(gH(iG, iMaat), "0.00"))
                oAfw.getCellByPosition(iKol + 3, iRij).setString( _
                    "= " & Format(dNodig, "0.00"))
                If nWegDag > 0 Then
                    oAfw.getCellByPosition(iKol + 4, iRij).setString(nWegDag & " niet!")
                Else
                    oAfw.getCellByPosition(iKol + 4, iRij).setString("alle")
                End If
                dSom = dSom + dNodig
                iRij = iRij + 1
            End If
        Next iMaatVolg
        oAfw.getCellByPosition(iKol, iRij).setString(LCase(sDagLbl) & " nodig:")
        oAfw.getCellByPosition(iKol + 3, iRij).setString( _
            "= " & Format(Int(dSom * 100 + 0.5) / 100, "0.00"))
        iRij = iRij + 3                            ' totaalrij + twee lege rijen

        If iG < iBreek Then iRijL = iRij Else iRijR = iRij
    Next iG
    iEindL = iRijL : iEindR = iRijR
    If iEindL < AFW_RIJ0 + 1 Then iEindL = AFW_RIJ0 + 1
    If iEindR < AFW_RIJ0 + 1 Then iEindR = AFW_RIJ0 + 1

    ' --- Opmaak: lettergrootte 20 zoals de Sheet (afweeglijst leest van ver) ---
    oAfw.getCellRangeByPosition(0, 0, 4, iEindL - 1).CharHeight = 20
    oAfw.getCellRangeByPosition(AFW_KOL_R, 0, AFW_KOL_R + 4, iEindR - 1).CharHeight = 20
    oAfw.getCellByPosition(4, 0).CharHeight = 10   ' week/tijdstempel klein houden

    ' --- Kolombreedtes (1/100 mm, omgerekend uit de Sheet) ---
    For iKol = 0 To AFW_KOL_R Step AFW_KOL_R
        oAfw.Columns.getByIndex(iKol + 0).Width = 2400   ' maat / groentenaam
        oAfw.Columns.getByIndex(iKol + 1).Width = 1350   ' aantal
        oAfw.Columns.getByIndex(iKol + 2).Width = 2000   ' x hoeveelheid
        oAfw.Columns.getByIndex(iKol + 3).Width = 2725   ' = nodig
        oAfw.Columns.getByIndex(iKol + 4).Width = 2000   ' alle / N niet!
    Next iKol
    oAfw.Columns.getByIndex(5).Width = 760               ' tussenkolom F

    SamZetAfweegPagina(oDoc, oAfw)
End Sub

' Pagina-instelling voor de afweegbladen: A4 staand, smalle marges, horizontaal
' gecentreerd en op één bladzijde geschaald (ScaleToPages = 1), zodat het blad
' altijd op één A4 past — ook als er een week veel groenten zijn.
Private Sub SamZetAfweegPagina(oDoc As Object, oSheet As Object)
    Dim oStyles As Object
    Dim oStyle  As Object
    On Error Resume Next
    oStyles = oDoc.StyleFamilies.getByName("PageStyles")
    If Not oStyles.hasByName("Afweeglijst") Then
        oStyle = oDoc.createInstance("com.sun.star.style.PageStyle")
        oStyles.insertByName("Afweeglijst", oStyle)
    End If
    oStyle = oStyles.getByName("Afweeglijst")
    oStyle.IsLandscape        = False
    oStyle.Width              = 21000
    oStyle.Height             = 29700
    oStyle.LeftMargin         = 1000
    oStyle.RightMargin        = 1000
    oStyle.TopMargin          = 1000
    oStyle.BottomMargin       = 1000
    oStyle.HeaderIsOn         = False
    oStyle.FooterIsOn         = False
    oStyle.CenterHorizontally = True
    oStyle.ScaleToPages       = 1
    oSheet.PageStyle = "Afweeglijst"
    On Error GoTo 0
End Sub

' ---------------------------------------------------------------------------
' SamVulPrintbladen — de vier printbladen herbouwen (oogst + vullen, per dag).
' Vervangen de printpagina's van Blad1 in de Google Sheet:
'   "Oogst donderdag/vrijdag"  = overzicht bij het oogsten/bestellen: de vier
'       maat-blokken met prijzen en Nodig, daaronder de totale hoeveelheid per
'       groente voor die dag en de bijbestellijst van losse groenten.
'   "Vullen donderdag/vrijdag" = aftikblad bij het vullen van de bakken: per
'       maat welke groente er in gaat, hoeveel per pakket en hoeveel in totaal.
' Alles wordt gelezen uit de Samenstelling-/Los-tab en de g*-arrays
' (SamLaadDagcijfers moet dus eerst gedraaid zijn). Volledig afgeleid.
' ---------------------------------------------------------------------------
Private Sub SamVulPrintbladen(oDoc As Object, iWeek As Integer, iJaar As Integer)
    SamVulPrintOogst(oDoc, 0, iWeek, iJaar)
    SamVulPrintOogst(oDoc, 1, iWeek, iJaar)
    SamVulPrintVullen(oDoc, 0, iWeek, iJaar)
    SamVulPrintVullen(oDoc, 1, iWeek, iJaar)
End Sub

' Weglatingen van één groente/maat op één dag (0 = donderdag, 1 = vrijdag)
Private Function SamWegDag(sNaam As String, iMaat As Integer, iDag As Integer) As Long
    Dim iWg As Integer
    SamWegDag = 0
    For iWg = 0 To gNWg - 1
        If gWgNaam(iWg) = sNaam And gWgMaat(iWg) = iMaat Then
            If iDag = 0 Then SamWegDag = gWgDon(iWg) Else SamWegDag = gWgVrij(iWg)
            Exit Function
        End If
    Next iWg
End Function

' ---------------------------------------------------------------------------
' Oogst/bestelblad voor één dag (kolommen A..H)
' ---------------------------------------------------------------------------
Private Sub SamVulPrintOogst(oDoc As Object, iDag As Integer, _
                             iWeek As Integer, iJaar As Integer)
    Dim oPr    As Object
    Dim oSam   As Object
    Dim oLos   As Object
    Dim iSlot  As Integer
    Dim iMaat  As Integer
    Dim iRij   As Integer
    Dim iKol   As Integer
    Dim iG     As Integer
    Dim sNaam  As String
    Dim sTab   As String
    Dim sDagLbl As String
    Dim nAant  As Long
    Dim nWeg   As Long
    Dim dNodig As Double
    Dim dPakket As Double
    Dim dOmzet As Double
    Dim dTot   As Double
    Dim clKop  As Long
    Dim aMaatNaam(3) As String
    Dim aMaatKort(3) As String

    aMaatNaam(0) = "Klein groentenpakket"
    aMaatNaam(1) = "Groot groentenpakket"
    aMaatNaam(2) = "Extra groot groentenpakket"
    aMaatNaam(3) = "Mini groentenpakket"
    aMaatKort(0) = "KG" : aMaatKort(1) = "GG"
    aMaatKort(2) = "EGG" : aMaatKort(3) = "MINI"
    clKop = RGB(220, 233, 200)
    If iDag = 0 Then
        sTab = TAB_PR_OD : sDagLbl = "DONDERDAG"
    Else
        sTab = TAB_PR_OV : sDagLbl = "VRIJDAG"
    End If

    oPr  = SamZorgTab(oDoc, sTab)
    oSam = oDoc.Sheets.getByName(TAB_SAM)
    oLos = oDoc.Sheets.getByName(TAB_LOS)
    oPr.getCellRangeByPosition(0, 0, 7, PR_MAX_RIJ).clearContents(55)

    ' --- Pakketgroenten inlezen ---
    Dim gN(SAM_SLOTS - 1)     As String
    Dim gGr(SAM_SLOTS - 1)    As Double
    Dim gCo(SAM_SLOTS - 1)    As Double
    Dim gHv(SAM_SLOTS - 1, 3) As Double
    Dim gIn(SAM_SLOTS - 1, 3) As Double
    Dim nG As Integer
    nG = 0
    For iSlot = 0 To SAM_SLOTS - 1
        sNaam = oSam.getCellByPosition(0, SAM_RIJ0 + iSlot).getString()
        If sNaam <> "" Then
            gN(nG)  = sNaam
            gGr(nG) = oSam.getCellByPosition(1, SAM_RIJ0 + iSlot).getValue()
            gCo(nG) = oSam.getCellByPosition(2, SAM_RIJ0 + iSlot).getValue()
            For iMaat = 0 To 3
                gHv(nG, iMaat) = oSam.getCellByPosition(3 + iMaat * 2, SAM_RIJ0 + iSlot).getValue()
                gIn(nG, iMaat) = oSam.getCellByPosition(4 + iMaat * 2, SAM_RIJ0 + iSlot).getValue()
            Next iMaat
            nG = nG + 1
        End If
    Next iSlot

    ' --- Kop: dag + PAKKETTEN-matrix ---
    oPr.getCellByPosition(0, 0).setString(sDagLbl)
    oPr.getCellByPosition(0, 0).CharWeight = com.sun.star.awt.FontWeight.BOLD
    oPr.getCellByPosition(0, 0).CharHeight = 16
    ' week + tijdstempel op een eigen rij: in kolom G/H loopt de tekst voorbij
    ' de laatste printkolom en dat levert een lege overloop-pagina op
    oPr.getCellByPosition(0, 1).setString("week " & iWeek & "/" & iJaar & _
        " — ververst: " & Format(Now(), "DD/MM/YYYY HH:MM"))

    oPr.getCellByPosition(1, 2).setString("PAKKETTEN")
    For iMaat = 0 To 3
        oPr.getCellByPosition(2 + iMaat, 2).setString(aMaatKort(iMaat))
        oPr.getCellByPosition(2 + iMaat, 3).setValue(gDgTot(iMaat))
        oPr.getCellByPosition(2 + iMaat, 4).setValue(gDgAant(iMaat, 0))
        oPr.getCellByPosition(2 + iMaat, 5).setValue(gDgAant(iMaat, 1))
    Next iMaat
    oPr.getCellByPosition(1, 3).setString("don en vrij")
    oPr.getCellByPosition(1, 4).setString("don")
    oPr.getCellByPosition(1, 5).setString("vrij")
    oPr.getCellRangeByPosition(1, 2, 5, 2).CellBackColor = clKop
    oPr.getCellRangeByPosition(1, 2, 5, 2).CharWeight = com.sun.star.awt.FontWeight.BOLD
    oPr.getCellRangeByPosition(1, 4 + iDag, 5, 4 + iDag).CharWeight = _
        com.sun.star.awt.FontWeight.BOLD

    ' --- Kolomkoppen ---
    iRij = 7
    oPr.getCellByPosition(0, iRij).setString("Aantal")
    oPr.getCellByPosition(1, iRij).setString("Groente")
    oPr.getCellByPosition(2, iRij).setString("Grooth.")
    oPr.getCellByPosition(3, iRij).setString("Cons.")
    oPr.getCellByPosition(4, iRij).setString("Hoeveelh.")
    oPr.getCellByPosition(5, iRij).setString("In pakket")
    oPr.getCellByPosition(6, iRij).setString("Nodig")
    oPr.getCellByPosition(7, iRij).setString("Weglating")
    oPr.getCellRangeByPosition(0, iRij, 7, iRij).CellBackColor = clKop
    oPr.getCellRangeByPosition(0, iRij, 7, iRij).CharWeight = com.sun.star.awt.FontWeight.BOLD
    iRij = iRij + 1

    ' --- Vier maat-blokken ---
    Dim dNodigTot(SAM_SLOTS - 1) As Double
    For iG = 0 To nG - 1
        dNodigTot(iG) = 0
    Next iG

    Dim iKopRij As Integer
    For iMaat = 0 To 3
        iKopRij = iRij
        oPr.getCellByPosition(0, iRij).setValue(gDgAant(iMaat, iDag))
        oPr.getCellByPosition(1, iRij).setString(aMaatNaam(iMaat) & ":")
        oPr.getCellByPosition(6, iRij).setString("omzet:")
        oPr.getCellRangeByPosition(0, iRij, 7, iRij).CharWeight = com.sun.star.awt.FontWeight.BOLD
        iRij = iRij + 1
        dPakket = 0
        dOmzet  = 0
        For iG = 0 To nG - 1
            If gHv(iG, iMaat) > 0 Then
                nWeg  = SamWegDag(gN(iG), iMaat, iDag)
                nAant = gDgAant(iMaat, iDag) - nWeg
                If nAant < 0 Then nAant = 0
                dNodig = Int(nAant * gHv(iG, iMaat) * 100 + 0.5) / 100
                oPr.getCellByPosition(0, iRij).setValue(nAant)
                oPr.getCellByPosition(1, iRij).setString(gN(iG))
                oPr.getCellByPosition(2, iRij).setString(Format(gGr(iG), "0.00"))
                oPr.getCellByPosition(3, iRij).setString(Format(gCo(iG), "0.00"))
                oPr.getCellByPosition(4, iRij).setString(Format(gHv(iG, iMaat), "0.00"))
                oPr.getCellByPosition(4, iRij).CharWeight = com.sun.star.awt.FontWeight.BOLD
                oPr.getCellByPosition(5, iRij).setString(Format(gIn(iG, iMaat), "0.00"))
                oPr.getCellByPosition(6, iRij).setString(Format(dNodig, "0.00"))
                If nWeg > 0 Then
                    oPr.getCellByPosition(7, iRij).setString(nWeg & " niet!")
                End If
                dPakket = dPakket + gIn(iG, iMaat)
                dOmzet  = dOmzet + nAant * gIn(iG, iMaat)
                dNodigTot(iG) = dNodigTot(iG) + dNodig
                iRij = iRij + 1
            End If
        Next iG
        oPr.getCellByPosition(4, iRij).setString("Pakket EUR:")
        oPr.getCellByPosition(5, iRij).setString(Format(dPakket, "0.00"))
        oPr.getCellByPosition(6, iRij).setString("doel " & Format(mPakPrijs(iMaat), "0.00"))
        oPr.getCellRangeByPosition(4, iRij, 7, iRij).CharWeight = com.sun.star.awt.FontWeight.BOLD
        ' omzet van dit blok hoort bij de blok-kop (kolom H blijft vrij voor
        ' de weglating-markering per groente)
        oPr.getCellByPosition(7, iKopRij).setString( _
            Format(Int(dOmzet * 100 + 0.5) / 100, "0.00"))
        iRij = iRij + 2
    Next iMaat

    ' --- Totale hoeveelheid per groente voor deze dag ---
    iRij = iRij + 1
    oPr.getCellByPosition(0, iRij).setString("TOTAAL NODIG " & sDagLbl & " (alle pakketten samen)")
    oPr.getCellByPosition(0, iRij).CharWeight = com.sun.star.awt.FontWeight.BOLD
    iRij = iRij + 1
    oPr.getCellByPosition(0, iRij).setString("Groente")
    oPr.getCellByPosition(2, iRij).setString("Nodig")
    oPr.getCellByPosition(3, iRij).setString("Grooth.")
    oPr.getCellByPosition(4, iRij).setString("Kost")
    oPr.getCellRangeByPosition(0, iRij, 4, iRij).CellBackColor = clKop
    oPr.getCellRangeByPosition(0, iRij, 4, iRij).CharWeight = com.sun.star.awt.FontWeight.BOLD
    iRij = iRij + 1
    For iG = 0 To nG - 1
        If dNodigTot(iG) > 0 Then
            oPr.getCellByPosition(0, iRij).setString(gN(iG))
            oPr.getCellByPosition(2, iRij).setString(Format(dNodigTot(iG), "0.00"))
            oPr.getCellByPosition(3, iRij).setString(Format(gGr(iG), "0.00"))
            oPr.getCellByPosition(4, iRij).setString( _
                Format(Int(dNodigTot(iG) * gGr(iG) * 100 + 0.5) / 100, "0.00"))
            iRij = iRij + 1
        End If
    Next iG

    ' --- Bijbestellijst losse groenten (besteld = teller van de hele week) ---
    iRij = iRij + 2
    oPr.getCellByPosition(0, iRij).setString("BIJBESTELLEN — losse groenten (besteld: hele week)")
    oPr.getCellByPosition(0, iRij).CharWeight = com.sun.star.awt.FontWeight.BOLD
    iRij = iRij + 1
    oPr.getCellByPosition(0, iRij).setString("Losse groente")
    oPr.getCellByPosition(2, iRij).setString("Besteld")
    oPr.getCellByPosition(3, iRij).setString("Eenheid")
    oPr.getCellByPosition(4, iRij).setString("Grooth.")
    oPr.getCellByPosition(5, iRij).setString("Kost")
    oPr.getCellRangeByPosition(0, iRij, 5, iRij).CellBackColor = clKop
    oPr.getCellRangeByPosition(0, iRij, 5, iRij).CharWeight = com.sun.star.awt.FontWeight.BOLD
    iRij = iRij + 1
    Dim dBesteld As Double
    Dim dGrooth  As Double
    For iSlot = 0 To LOS_SLOTS - 1
        sNaam = oLos.getCellByPosition(0, LOS_RIJ0 + iSlot).getString()
        If sNaam <> "" Then
            dBesteld = oLos.getCellByPosition(8, LOS_RIJ0 + iSlot).getValue()
            dGrooth  = oLos.getCellByPosition(2, LOS_RIJ0 + iSlot).getValue()
            If dBesteld > 0 Then
                oPr.getCellByPosition(0, iRij).setString(sNaam)
                oPr.getCellByPosition(2, iRij).setString(Format(dBesteld, "0.00"))
                oPr.getCellByPosition(3, iRij).setString( _
                    oLos.getCellByPosition(3, LOS_RIJ0 + iSlot).getString())
                If dGrooth > 0 Then
                    oPr.getCellByPosition(4, iRij).setString(Format(dGrooth, "0.00"))
                    oPr.getCellByPosition(5, iRij).setString( _
                        Format(Int(dBesteld * dGrooth * 100 + 0.5) / 100, "0.00"))
                End If
                iRij = iRij + 1
            End If
        End If
    Next iSlot

    ' --- Opmaak: enkel de getalkolommen rechts uitlijnen (kolom A/B links,
    ' anders kappen lange groentenamen en sectietitels links af) ---
    oPr.getCellRangeByPosition(2, 7, 7, iRij).HoriJustify = com.sun.star.table.CellHoriJustify.RIGHT

    ' --- Kolombreedtes (samen 175 mm, past staand op A4) ---
    oPr.Columns.getByIndex(0).Width = 1500
    oPr.Columns.getByIndex(1).Width = 4200
    For iKol = 2 To 5
        oPr.Columns.getByIndex(iKol).Width = 2000
    Next iKol
    oPr.Columns.getByIndex(6).Width = 1900
    oPr.Columns.getByIndex(7).Width = 1900

    SamZetPrintPagina(oDoc, oPr)
End Sub

' ---------------------------------------------------------------------------
' Vulblad voor één dag (kolommen A..E): per maat wat er in de bak gaat
' ---------------------------------------------------------------------------
Private Sub SamVulPrintVullen(oDoc As Object, iDag As Integer, _
                              iWeek As Integer, iJaar As Integer)
    Dim oPr    As Object
    Dim oSam   As Object
    Dim iSlot  As Integer
    Dim iMaat  As Integer
    Dim iRij   As Integer
    Dim iKol   As Integer
    Dim iG     As Integer
    Dim sNaam  As String
    Dim sTab   As String
    Dim sDagLbl As String
    Dim nAant  As Long
    Dim nWeg   As Long
    Dim dNodig As Double
    Dim clKop  As Long
    Dim aMaatNaam(3) As String
    Dim aMaatKleur(3) As Long

    aMaatNaam(0) = "Klein groentenpakket"
    aMaatNaam(1) = "Groot groentenpakket"
    aMaatNaam(2) = "Extra groot groentenpakket"
    aMaatNaam(3) = "Mini groentenpakket"
    ' maat-kleuren zoals het weekbestand
    aMaatKleur(0) = RGB(204, 255, 153) : aMaatKleur(1) = RGB(153, 204, 255)
    aMaatKleur(2) = RGB(178, 178, 178) : aMaatKleur(3) = RGB(255, 153, 204)
    clKop = RGB(238, 238, 238)
    If iDag = 0 Then
        sTab = TAB_PR_VD : sDagLbl = "DONDERDAG"
    Else
        sTab = TAB_PR_VV : sDagLbl = "VRIJDAG"
    End If

    oPr  = SamZorgTab(oDoc, sTab)
    oSam = oDoc.Sheets.getByName(TAB_SAM)
    oPr.getCellRangeByPosition(0, 0, 4, PR_MAX_RIJ).clearContents(55)

    Dim gN(SAM_SLOTS - 1)     As String
    Dim gHv(SAM_SLOTS - 1, 3) As Double
    Dim nG As Integer
    nG = 0
    For iSlot = 0 To SAM_SLOTS - 1
        sNaam = oSam.getCellByPosition(0, SAM_RIJ0 + iSlot).getString()
        If sNaam <> "" Then
            gN(nG) = sNaam
            For iMaat = 0 To 3
                gHv(nG, iMaat) = oSam.getCellByPosition(3 + iMaat * 2, SAM_RIJ0 + iSlot).getValue()
            Next iMaat
            nG = nG + 1
        End If
    Next iSlot

    oPr.getCellByPosition(0, 0).setString(sDagLbl & " — pakketten vullen")
    oPr.getCellByPosition(0, 0).CharWeight = com.sun.star.awt.FontWeight.BOLD
    oPr.getCellByPosition(0, 0).CharHeight = 18
    oPr.getCellByPosition(0, 1).setString("week " & iWeek & "/" & iJaar & _
        " — ververst: " & Format(Now(), "DD/MM/YYYY HH:MM"))
    oPr.getCellByPosition(0, 1).CharHeight = 10

    iRij = 3
    For iMaat = 0 To 3
        oPr.getCellByPosition(0, iRij).setValue(gDgAant(iMaat, iDag))
        oPr.getCellByPosition(1, iRij).setString(aMaatNaam(iMaat))
        oPr.getCellRangeByPosition(0, iRij, 4, iRij).CellBackColor = aMaatKleur(iMaat)
        oPr.getCellRangeByPosition(0, iRij, 4, iRij).CharWeight = com.sun.star.awt.FontWeight.BOLD
        iRij = iRij + 1
        oPr.getCellByPosition(0, iRij).setString("Aantal")
        oPr.getCellByPosition(1, iRij).setString("Groente")
        oPr.getCellByPosition(2, iRij).setString("Per pakket")
        oPr.getCellByPosition(3, iRij).setString("Samen")
        oPr.getCellByPosition(4, iRij).setString("Weglatingen")
        oPr.getCellRangeByPosition(0, iRij, 4, iRij).CellBackColor = clKop
        iRij = iRij + 1
        For iG = 0 To nG - 1
            If gHv(iG, iMaat) > 0 Then
                nWeg  = SamWegDag(gN(iG), iMaat, iDag)
                nAant = gDgAant(iMaat, iDag) - nWeg
                If nAant < 0 Then nAant = 0
                dNodig = Int(nAant * gHv(iG, iMaat) * 100 + 0.5) / 100
                oPr.getCellByPosition(0, iRij).setValue(nAant)
                oPr.getCellByPosition(1, iRij).setString(gN(iG))
                oPr.getCellByPosition(2, iRij).setString("x " & Format(gHv(iG, iMaat), "0.00"))
                oPr.getCellByPosition(3, iRij).setString("= " & Format(dNodig, "0.00"))
                If nWeg > 0 Then
                    oPr.getCellByPosition(4, iRij).setString(nWeg & " niet!")
                Else
                    oPr.getCellByPosition(4, iRij).setString("alle")
                End If
                iRij = iRij + 1
            End If
        Next iG
        iRij = iRij + 1
    Next iMaat

    oPr.getCellRangeByPosition(0, 3, 4, iRij).CharHeight = 14
    oPr.getCellByPosition(0, 0).CharHeight = 18
    oPr.getCellByPosition(0, 1).CharHeight = 10
    oPr.getCellRangeByPosition(0, 3, 0, iRij).HoriJustify = com.sun.star.table.CellHoriJustify.RIGHT

    oPr.Columns.getByIndex(0).Width = 1600
    oPr.Columns.getByIndex(1).Width = 6000
    oPr.Columns.getByIndex(2).Width = 2700
    oPr.Columns.getByIndex(3).Width = 2400
    oPr.Columns.getByIndex(4).Width = 2400

    SamZetPrintPagina(oDoc, oPr)
End Sub

' Pagina-instelling voor de printbladen: A4 staand, marges 10 mm, geen
' schaling (de kolombreedtes passen op de breedte; lange bladen lopen gewoon
' door naar een tweede pagina). Elk blad is een eigen tab, dus elke dag-kop
' begint sowieso bovenaan een pagina.
Private Sub SamZetPrintPagina(oDoc As Object, oSheet As Object)
    Dim oStyles As Object
    Dim oStyle  As Object
    On Error Resume Next
    oStyles = oDoc.StyleFamilies.getByName("PageStyles")
    If Not oStyles.hasByName("Printblad") Then
        oStyle = oDoc.createInstance("com.sun.star.style.PageStyle")
        oStyles.insertByName("Printblad", oStyle)
    End If
    oStyle = oStyles.getByName("Printblad")
    oStyle.IsLandscape  = False
    oStyle.Width        = 21000
    oStyle.Height       = 29700
    oStyle.LeftMargin   = 1000
    oStyle.RightMargin  = 1000
    oStyle.TopMargin    = 1000
    oStyle.BottomMargin = 1000
    oStyle.HeaderIsOn   = False
    oStyle.FooterIsOn   = False
    oStyle.ScaleToPages = 0
    oStyle.PageScale    = 100
    oSheet.PageStyle = "Printblad"
    On Error GoTo 0
End Sub
' ---------------------------------------------------------------------------
' Besteld-tellers op de Los-tab verversen (kolom I, match op naam).
' Gedeeld door de tab-layout (Module5) en de klassieke layout (Module6).
' De kolom wordt eerst leeggemaakt: staat er een groente in het document die
' intussen uit de DB verdween of hernoemd werd, dan mag haar oude teller niet
' blijven staan (dat leest als een fout cijfer bij die groente).
' ---------------------------------------------------------------------------
Sub SamVerversLosBesteld(oDoc As Object, oConn As Object, _
                         iWeek As Integer, iJaar As Integer)
    Dim oLos  As Object
    Dim oStmt As Object
    Dim oRS   As Object
    Dim iSlot As Integer
    Dim sNaam As String
    oLos = oDoc.Sheets.getByName(TAB_LOS)
    oLos.getCellRangeByPosition(8, LOS_RIJ0, 8, LOS_RIJ0 + LOS_SLOTS - 1).clearContents(7)
    oStmt = oConn.createStatement()
    oRS = oStmt.executeQuery( _
        "SELECT naam, besteld FROM groenten " & _
        "WHERE jaar = " & iJaar & " AND weeknummer = " & iWeek)
    Do While oRS.next()
        sNaam = oRS.getString(1)
        For iSlot = 0 To LOS_SLOTS - 1
            If oLos.getCellByPosition(0, LOS_RIJ0 + iSlot).getString() = sNaam Then
                oLos.getCellByPosition(8, LOS_RIJ0 + iSlot).setValue(oRS.getDouble(2))
                Exit For
            End If
        Next iSlot
    Loop
    oRS.close() : oStmt.close()
End Sub

