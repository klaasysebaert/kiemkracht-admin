' Tabnamen van oudere documenten bijwerken (tab-layout).
Sub SamMigreerTabnamen(oDoc As Object)
    If oDoc.Sheets.hasByName(TAB_BST_OUD) And Not oDoc.Sheets.hasByName(TAB_BST) Then
        oDoc.Sheets.getByName(TAB_BST_OUD).Name = TAB_BST
    End If
    ' eerste versie had één Afweeglijst-tab; nu één per dag (volledig afgeleid,
    ' dus weggooien kan zonder verlies)
    If oDoc.Sheets.hasByName(TAB_AFW_OUD) Then
        oDoc.Sheets.removeByName(TAB_AFW_OUD)
    End If
End Sub

' Tabblad ophalen; aanmaken (achteraan) als het nog niet bestaat.
' (publiek: ook gebruikt door de klassieke layout in Module6)
Function SamZorgTab(oDoc As Object, sTabNaam As String) As Object
    If Not oDoc.Sheets.hasByName(sTabNaam) Then
        oDoc.Sheets.insertNewByName(sTabNaam, oDoc.Sheets.Count)
    End If
    SamZorgTab = oDoc.Sheets.getByName(sTabNaam)
End Function

' pakketten.sleutel → maat-index (0=KG 1=GG 2=EGG 3=MINI), -1 = onbekend
Function SamMaatIdx(sSleutel As String) As Integer
    Select Case sSleutel
        Case "klein"       : SamMaatIdx = 0
        Case "groot"       : SamMaatIdx = 1
        Case "extra-groot" : SamMaatIdx = 2
        Case "mini"        : SamMaatIdx = 3
        Case Else          : SamMaatIdx = -1
    End Select
End Function

' Is dit document een samenstelling-bestand (marker in Samenstelling.A1)?
Function SamIsSamenstellingDoc(oDoc As Object) As Boolean
    SamIsSamenstellingDoc = False
    If IsNull(oDoc) Then Exit Function
    If Not HasUnoInterfaces(oDoc, "com.sun.star.lang.XServiceInfo") Then Exit Function
    If Not oDoc.supportsService("com.sun.star.sheet.SpreadsheetDocument") Then Exit Function
    If Not oDoc.Sheets.hasByName(TAB_SAM) Then Exit Function
    If oDoc.Sheets.getByName(TAB_SAM).getCellByPosition(0, 0).getString() <> SAM_MARKER Then Exit Function
    SamIsSamenstellingDoc = True
End Function

' Omgeving van een samenstelling-document (bestandsnaam met/zonder -dev)
Function SamDocOmgeving(oDoc As Object) As String
    If InStr(LCase(oDoc.getURL()), "-dev.ods") > 0 Then
        SamDocOmgeving = "dev"
    Else
        SamDocOmgeving = "prod"
    End If
End Function

' Guard: de omgeving van het document moet overeenkomen met BepaalOmgeving()
' (die het open kiemkracht-data-bestand volgt; zonder data-bestand = dev),
' anders zouden lezen/schrijven op de verkeerde database kunnen gebeuren.
Function SamOmgevingOk(oDoc As Object) As Boolean
    Dim sDocOmg As String
    sDocOmg = SamDocOmgeving(oDoc)
    If sDocOmg = BepaalOmgeving() Then
        SamOmgevingOk = True
    Else
        SamOmgevingOk = False
        MsgBox "Omgeving klopt niet: dit document is '" & sDocOmg & "', maar de " & _
               "actieve omgeving is '" & BepaalOmgeving() & "' (bepaald door het open " & _
               "kiemkracht-data-bestand; zonder data-bestand = dev)." & Chr(10) & _
               "Open het juiste kiemkracht-data-bestand of sluit het verkeerde.", _
               16, "Samenstelling"
    End If
End Function

