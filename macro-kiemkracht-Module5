    oSheet.Columns.getByIndex(6).Width = 2000

    nNot = 0
    oStmt = oConn.createStatement()
    oRS = oStmt.executeQuery( _
        "SELECT tekst, voor_begeleidend, voor_weekplanner, voor_teeltplan, geaccepteerd, " & _
        "COALESCE(groente_naam,''), COALESCE(groente_id::text,'') " & _
        "FROM week_notitie WHERE jaar = " & iJaar & " AND weeknummer = " & iWeek & _
        " ORDER BY volgorde, id")
    Do While oRS.next()
        If nNot < NOT_SLOTS Then
            iRij = NOT_RIJ0 + nNot
            oSheet.getCellByPosition(0, iRij).setString(oRS.getString(1))
            If oRS.getBoolean(2) Then oSheet.getCellByPosition(1, iRij).setString("x")
            If oRS.getBoolean(3) Then oSheet.getCellByPosition(2, iRij).setString("x")
            If oRS.getBoolean(4) Then oSheet.getCellByPosition(3, iRij).setString("x")
            If oRS.getBoolean(5) Then oSheet.getCellByPosition(4, iRij).setString("x")
            oSheet.getCellByPosition(5, iRij).setString(oRS.getString(6))
            If oRS.getString(7) <> "" Then
                oSheet.getCellByPosition(6, iRij).setValue(CLng(oRS.getString(7)))
            End If
            nNot = nNot + 1
        End If
    Loop
    oRS.close() : oStmt.close()

    oSheet.getCellByPosition(0, NOT_RIJ_BEGLABEL).setString("Begeleidende tekst (aanbod-mail):")
    oSheet.getCellByPosition(0, NOT_RIJ_BEGLABEL).CharWeight = com.sun.star.awt.FontWeight.BOLD
    oSheet.getCellByPosition(0, NOT_RIJ_BEG).setString(sBegTekst)
    oSheet.getCellByPosition(0, NOT_RIJ_BEG).IsTextWrapped = True
    oSheet.getCellByPosition(0, NOT_RIJ_BEG).CellBackColor = clInput
End Sub

