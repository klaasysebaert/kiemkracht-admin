End Function

' COCKPIT_WACHTWOORD uit een lokaal bestand (buiten git); eerste keer via
' InputBox en meteen bewaren. Enkel ASCII (Base64-encoder is byte-per-teken).
Function SamCockpitWachtwoord(sOmg As String) As String
    Dim sPad As String
    Dim sPw  As String
    Dim iBestand As Integer
    SamCockpitWachtwoord = ""
    sPad = Environ("APPDATA") & "\LibreOffice\cockpit-wachtwoord-" & sOmg & ".txt"
    If FileExists(sPad) Then
        iBestand = FreeFile
        Open sPad For Input As #iBestand
        Line Input #iBestand, sPw
        Close #iBestand
        SamCockpitWachtwoord = Trim(sPw)
        Exit Function
    End If
    sPw = InputBox("Cockpit-wachtwoord (" & sOmg & ") — COCKPIT_WACHTWOORD uit Coolify." & _
                   Chr(10) & "Wordt lokaal bewaard in:" & Chr(10) & sPad, "Cockpit-wachtwoord")
    sPw = Trim(sPw)
    If sPw = "" Then Exit Function
    iBestand = FreeFile
    Open sPad For Output As #iBestand
    Print #iBestand, sPw
    Close #iBestand
    SamCockpitWachtwoord = sPw
End Function

' JSON-tekst: JsonEsc (backslash + quote) + newlines/tabs escapen.
Function SamJsonTekst(sTekst As String) As String
    Dim sUit As String
    sUit = JsonEsc(sTekst)
    sUit = Replace(sUit, Chr(13) & Chr(10), "\n")
    sUit = Replace(sUit, Chr(10), "\n")
    sUit = Replace(sUit, Chr(13), "\n")
    sUit = Replace(sUit, Chr(9), "\t")
    SamJsonTekst = sUit
End Function

' Getal → JSON (Str gebruikt altijd punt-decimaal, ongeacht de locale).
' LET OP: Str(0.9) geeft ".9" — JSON eist een voorloopnul, anders faalt
' json_decode server-side op de hele body (getest: API antwoordt dan
' "Ongeldige jaar/week" en er wordt niets opgeslagen).
Function SamJsNum(dWaarde As Double) As String
    Dim sUit As String
    sUit = Trim(Str(dWaarde))
    If Left(sUit, 1) = "." Then
        sUit = "0" & sUit
    ElseIf Left(sUit, 2) = "-." Then
        sUit = "-0." & Mid(sUit, 3)
    End If
    SamJsNum = sUit
End Function

Function SamJsBool(bWaarde As Boolean) As String
    If bWaarde Then
        SamJsBool = "true"
    Else
        SamJsBool = "false"
    End If
End Function

' Base64 voor de HTTP Basic-header (invoer: ASCII-tekens)
Function SamBase64(sTekst As String) As String
    Const B64TEKENS = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
    Dim iPos As Integer
    Dim iLen As Integer
    Dim b1   As Integer
    Dim b2   As Integer
    Dim b3   As Integer
    Dim sUit As String
    sUit = ""
    iLen = Len(sTekst)
    iPos = 1
    Do While iPos <= iLen
        b1 = Asc(Mid(sTekst, iPos, 1)) And 255
        b2 = -1
        b3 = -1
        If iPos + 1 <= iLen Then b2 = Asc(Mid(sTekst, iPos + 1, 1)) And 255
        If iPos + 2 <= iLen Then b3 = Asc(Mid(sTekst, iPos + 2, 1)) And 255
        sUit = sUit & Mid(B64TEKENS, (b1 \ 4) + 1, 1)
        If b2 >= 0 Then
            sUit = sUit & Mid(B64TEKENS, ((b1 Mod 4) * 16 + b2 \ 16) + 1, 1)
            If b3 >= 0 Then
                sUit = sUit & Mid(B64TEKENS, ((b2 Mod 16) * 4 + b3 \ 64) + 1, 1)
                sUit = sUit & Mid(B64TEKENS, (b3 Mod 64) + 1, 1)
            Else
                sUit = sUit & Mid(B64TEKENS, ((b2 Mod 16) * 4) + 1, 1) & "="
            End If
        Else
            sUit = sUit & Mid(B64TEKENS, ((b1 Mod 4) * 16) + 1, 1) & "=="
        End If
        iPos = iPos + 3
    Loop
    SamBase64 = sUit
End Function
