' ===========================================================================
' Module5 — Samenstelling-document
' Vervangt de Google Sheet "Samenstelling_deze_week" (fase A van de
' weekcockpit-migratie, zie kiemkracht-bestel).
'
' Architectuur: PostgreSQL is de enige bron van waarheid. De cockpit
' (cockpit.php) en dit Calc-document zijn twee UI's op dezelfde data:
'   - LEZEN gebeurt rechtstreeks uit de DB (MaakDBVerbinding, zoals
'     LaadAlleTabellen) — geen JSON-parsing in Basic nodig.
'   - TERUGSCHRIJVEN gaat via cockpit-api.php?actie=week_opslaan, zodat
'     dezelfde server-regels gelden als voor de cockpit: waarde =
'     round(round(grooth × marge × hoeveelheid, 4), 2), demand-teller
'     "besteld" blijft behouden, status (concept/gepubliceerd) blijft staan.
'
' Macro's (Start-wrappers in Standard/Module2):
'   MaakSamenstellingDoc : nieuw samenstelling-bestand voor een gekozen week,
'                          gevuld uit de DB (neemt de cockpit-inhoud over).
'   HerlaadSamenstelling : het actieve samenstelling-document opnieuw vullen
'                          uit de DB (verse cockpit-inhoud overnemen).
'                          LET OP: overschrijft lokale niet-opgeslagen invoer.
'   SchrijfSamenstelling : het actieve document terugschrijven naar de DB
'                          (de cockpit ziet de wijzigingen bij de volgende
'                          open). Last-write-wins, zoals de cockpit zelf.
'   VerversBestellijst   : de tabs "Oogstlijst (bestellijst)" (aantal pakketten
'                          per maat, weglatingen, Nodig, besteld-tellers) en
'                          "Afweeglijst donderdag"/"Afweeglijst vrijdag" en de
'                          vier printbladen (Oogst/Vullen per dag) verversen.
'
' Wachtwoord: COCKPIT_WACHTWOORD wordt gelezen uit
'   %APPDATA%\LibreOffice\cockpit-wachtwoord-<omgeving>.txt
' (eerste run: InputBox + automatisch bewaren; enkel ASCII-tekens).
'
' NOG NIET OP PROD: de cockpit-migraties (06 t/m 12) en cockpit-api.php
' draaien enkel op dev. MaakSamenstellingDoc blokkeert daarom prod tot de
' cockpit-prod-rollout; daarna mag die guard weg.
' ===========================================================================

' --- Tab-namen -------------------------------------------------------------
Const TAB_SAM = "Samenstelling"
Const TAB_LOS = "Los"
Const TAB_NOT = "Notities"
Const TAB_BST = "Oogstlijst (bestellijst)"
Const TAB_BST_OUD = "Bestellijst"     ' oudere documenten -> wordt hernoemd
Const TAB_AFW_DO  = "Afweeglijst donderdag"
Const TAB_AFW_VR  = "Afweeglijst vrijdag"
Const TAB_AFW_OUD = "Afweeglijst"     ' eerste versie: één blad -> wordt gewist
Const TAB_PR_OD   = "Oogst donderdag"
Const TAB_PR_OV   = "Oogst vrijdag"
Const TAB_PR_VD   = "Vullen donderdag"
Const TAB_PR_VV   = "Vullen vrijdag"

Const SAM_MARKER = "Kiemkracht samenstelling"

' --- Vaste posities (0-based indices) --------------------------------------
' Tab Samenstelling: rij 1 = titel/week/jaar/status, rij 2 = marge,
' rij 3 = maat-labels + pakket_id's, rij 4 = kolomkoppen, rij 5.. = data.
' Kolommen: A naam, B grooth, C cons (formule), D/E KG hoev+€, F/G GG,
' H/I EGG, J/K MINI, L groente_id.
Const SAM_RIJ_MAAT = 2
Const SAM_RIJ_KOP  = 3
Const SAM_RIJ0     = 4
Const SAM_SLOTS    = 16   ' rijen 5-20; server-maximum blijft 12 pakketgroenten

' Tab Los: rij 3 = koppen, rij 4.. = data.
' Kolommen: A naam, B prijs, C grooth, D eenheid, E ×-notatie, F stap,
' G beschikbaar, H max/klant, I besteld (info, niet teruggeschreven).
Const LOS_RIJ_KOP = 2
Const LOS_RIJ0    = 3
Const LOS_SLOTS   = 50

' Tab Notities: rij 3 = koppen, rij 4.. = data; daaronder begeleidende tekst.
' Kolommen: A tekst, B klantmail, C weekplanner, D teeltplan, E verwerkt,
' F groente, G groente_id.
Const NOT_RIJ_KOP      = 2
Const NOT_RIJ0         = 3
Const NOT_SLOTS        = 20
Const NOT_RIJ_BEGLABEL = 24
Const NOT_RIJ_BEG      = 25

' Tab Bestellijst: rij 2 = maat-labels, rij 3 = aantallen per maat,
' rij 5 = koppen pakketgroenten, rij 6-21 = data (loopt gelijk met
' Samenstelling rij 5-20), rij 24 = koppen losse, rij 25.. = losse.
Const BST_RIJ_AANT = 2
Const BST_RIJ_KOP  = 4
Const BST_RIJ0     = 5
Const BST_LOS_KOP  = 23
Const BST_LOS0     = 24

' Tabs Afweeglijst donderdag / vrijdag: nabouw van de gelijknamige tabbladen
' in de Google Sheet (print-layout, lettergrootte 20, één A4 per dag).
' Per pakketgroente één blok: naamrij + één rij per maat die de groente
' écht in het pakket heeft (MINI/EGG/GG/KG, maten zonder hoeveelheid krijgen
' géén rij) + de rij "donderdag nodig:". Blokken staan aaneengesloten met
' twee lege rijen ertussen en worden over twee bladhelften verdeeld:
' links A..E, rechts G..K, allebei vanaf rij 3 (A1 = dag-titel).
Const AFW_RIJ0    = 2             ' eerste blokrij (rij 3, 0-based)
Const AFW_KOL_R   = 6             ' rechterhelft begint in kolom G
Const AFW_MAX_RIJ = 200           ' wisbereik

' Printbladen (oogst/vullen per dag): wisbereik
Const PR_MAX_RIJ  = 200

' --- Module-variabelen (gezet door SamLaadWeekMeta / SamLaadPakketten) -----
Private mPakId(3)    As Long      ' pakket_id per maat: 0=KG 1=GG 2=EGG 3=MINI
Private mPakPrijs(3) As Double    ' doelprijs per maat
Private mSamStatus   As String    ' nieuw / concept / gepubliceerd
Private mSamMarge    As Double
Private mSamBegTekst As String

' --- Weekcijfers-momentopname (gezet door SamLaadDagcijfers) ---------------
' Publiek: ook de klassieke layout (Module6) leest deze arrays.
Public gDgAant(3, 1) As Long      ' aantal pakketten (maat, 0=don 1=vrij)
Public gDgTot(3)     As Long      ' aantal pakketten per maat, alle dagen
Public gWgNaam(199)  As String    ' weglatingen per (groente, maat)
Public gWgMaat(199)  As Integer
Public gWgDon(199)   As Long
Public gWgVrij(199)  As Long
Public gWgOnb(199)   As Long      ' dag onbekend -> telt enkel in het totaal mee
Public gNWg          As Integer

' ===========================================================================
' MaakSamenstellingDoc — nieuw samenstelling-bestand voor een gekozen week
' ===========================================================================
Sub MaakSamenstellingDoc()
    Dim sOmg        As String
    Dim sOmgSuffix  As String
    Dim sWeekIn     As String
    Dim iWeek       As Integer
    Dim iJaar       As Integer
    Dim iVoorstel   As Integer
    Dim dDonderdag  As Date
    Dim sWeekMap    As String
    Dim sBestand    As String
    Dim sUrl        As String
    Dim oDesktop    As Object
    Dim oNieuwDoc   As Object
    Dim oConn       As Object
    Dim oComp       As Object
    Dim oEnum       As Object
    Dim oTabTmp     As Object
    Dim aLaadProps()

    sOmg = BepaalOmgeving()

    ' Week vragen; voorstel = de komende week (samenstelling wordt vooraf gemaakt)
    iVoorstel = DatePart("ww", Now() + 7, 2, 2)
    sWeekIn = InputBox("Weeknummer voor de samenstelling (ENTER = " & iVoorstel & "):", _
                       "Samenstelling maken (" & sOmg & ")", CStr(iVoorstel))
    If sWeekIn = "" Then Exit Sub
    If Not IsNumeric(sWeekIn) Then
        MsgBox "Geen geldig weeknummer: " & sWeekIn, 16, "Samenstelling"
        Exit Sub
    End If
    iWeek = CInt(sWeekIn)
    If iWeek < 1 Or iWeek > 53 Then
        MsgBox "Weeknummer buiten bereik (1-53): " & iWeek, 16, "Samenstelling"
        Exit Sub
    End If
    dDonderdag = WeekNaarDonderdag(iWeek)
    If dDonderdag = 0 Then
        MsgBox "Kon geen (komende) donderdag vinden voor week " & iWeek & ".", 16, "Samenstelling"
        Exit Sub
    End If
    iJaar = Year(dDonderdag)

    ' Bestandspad: zelfde week-submap als het weekbestand
    If sOmg = "dev" Then sOmgSuffix = "-dev" Else sOmgSuffix = ""
    sWeekMap = JaarMap(iJaar) & iJaar & "_week_" & iWeek & "\"
    If Not FileExists(sWeekMap) Then MkDir(sWeekMap)
    sBestand = sWeekMap & "samenstelling_" & iWeek & "_" & iJaar & sOmgSuffix & ".ods"
    sUrl = ConvertToURL(sBestand)

    ' Staat het doelbestand al open? Eigen venster sluiten mag niet vanuit
    ' de lopende macro als het het aanroepende document is → dan Herlaad.
    oEnum = StarDesktop.Components.createEnumeration()
    Do While oEnum.hasMoreElements()
        oComp = oEnum.nextElement()
        If HasUnoInterfaces(oComp, "com.sun.star.lang.XServiceInfo") Then
            If oComp.supportsService("com.sun.star.sheet.SpreadsheetDocument") Then
                If oComp.getURL() = sUrl Then
                    If oComp Is ThisComponent Then
                        MsgBox "Dit samenstelling-bestand is al open. Gebruik " & _
                               "StartHerlaadSamenstelling om het te verversen uit de DB.", _
                               48, "Samenstelling"
                        Exit Sub
                    End If
                    oComp.close(True)
                End If
            End If
        End If
    Loop

    ' Nieuw Calc-document met de vier tabbladen
    oDesktop = createUnoService("com.sun.star.frame.Desktop")
    oNieuwDoc = oDesktop.loadComponentFromURL("private:factory/scalc", "_blank", 0, aLaadProps())
    oNieuwDoc.Sheets.getByIndex(0).Name = TAB_SAM
    oTabTmp = SamZorgTab(oNieuwDoc, TAB_LOS)
    oTabTmp = SamZorgTab(oNieuwDoc, TAB_NOT)
    oTabTmp = SamZorgTab(oNieuwDoc, TAB_BST)
    oTabTmp = SamZorgTab(oNieuwDoc, TAB_AFW_DO)
    oTabTmp = SamZorgTab(oNieuwDoc, TAB_AFW_VR)
    oTabTmp = SamZorgTab(oNieuwDoc, TAB_PR_OD)
    oTabTmp = SamZorgTab(oNieuwDoc, TAB_PR_VD)
    oTabTmp = SamZorgTab(oNieuwDoc, TAB_PR_OV)
    oTabTmp = SamZorgTab(oNieuwDoc, TAB_PR_VV)

    On Error GoTo SamMaakFout
    oConn = MaakDBVerbinding()
    BouwEnVulSamenstelling(oNieuwDoc, oConn, iWeek, iJaar)
    oConn.close()
    On Error GoTo 0
    SluitSSHTunnels()

    ' storeAsURL koppelt het open venster aan het bestand (zoals KoffieWeekbestand)
    Dim aSaveProps(0) As New com.sun.star.beans.PropertyValue
    aSaveProps(0).Name  = "FilterName"
    aSaveProps(0).Value = "calc8"
    oNieuwDoc.storeAsURL(sUrl, aSaveProps())

    oNieuwDoc.getCurrentController().setActiveSheet(oNieuwDoc.Sheets.getByName(TAB_SAM))
    MsgBox "Samenstelling-bestand aangemaakt:" & Chr(10) & sBestand & Chr(10) & Chr(10) & _
           "Week " & iWeek & "/" & iJaar & " — status in DB: " & mSamStatus & Chr(10) & Chr(10) & _
           "Terugschrijven naar de cockpit/DB: StartSchrijfSamenstelling.", 64, "Klaar"
    Exit Sub

SamMaakFout:
    MsgBox "Fout bij het opbouwen van de samenstelling:" & Chr(10) & Error$, 16, "Samenstelling"
    SluitSSHTunnels()
End Sub

' ===========================================================================
' HerlaadSamenstelling — actief samenstelling-document verversen uit de DB
' ===========================================================================
Sub HerlaadSamenstelling()
    Dim oDoc  As Object
    Dim oConn As Object
    Dim iWeek As Integer
    Dim iJaar As Integer
    Dim iAntw As Integer
    Dim bKlassiek As Boolean
    Dim sStatusNa As String

    oDoc = ThisComponent
    bKlassiek = SamIsKlassiekDoc(oDoc)
    If Not (bKlassiek Or SamIsSamenstellingDoc(oDoc)) Then
        MsgBox "Het actieve document is geen samenstelling-bestand " & _
               "(tab '" & TAB_SAM & "' met marker in A1 ontbreekt).", 48, "Samenstelling"
        Exit Sub
    End If
    If Not SamOmgevingOk(oDoc) Then Exit Sub

    If bKlassiek Then
        iWeek = CInt(oDoc.Sheets.getByName(TAB_SAM).getCellByPosition(9, 0).getValue())
        iJaar = CInt(oDoc.Sheets.getByName(TAB_SAM).getCellByPosition(11, 0).getValue())
    Else
        iWeek = CInt(oDoc.Sheets.getByName(TAB_SAM).getCellByPosition(3, 0).getValue())
        iJaar = CInt(oDoc.Sheets.getByName(TAB_SAM).getCellByPosition(5, 0).getValue())
    End If
    If iWeek < 1 Or iWeek > 53 Or iJaar < 2020 Then
        MsgBox "Week/jaar niet leesbaar uit de kop-rij.", 16, "Samenstelling"
        Exit Sub
    End If

    iAntw = MsgBox("Week " & iWeek & "/" & iJaar & " opnieuw laden uit de database?" & Chr(10) & _
                   "Niet-teruggeschreven wijzigingen in dit document gaan verloren.", _
                   4 + 32, "Herladen")
    If iAntw <> 6 Then Exit Sub

    On Error GoTo SamHerlaadFout
    oConn = MaakDBVerbinding()
    If bKlassiek Then
        KlasBouwEnVul(oDoc, oConn, iWeek, iJaar)
        sStatusNa = KlasLaatsteStatus()
    Else
        BouwEnVulSamenstelling(oDoc, oConn, iWeek, iJaar)
        sStatusNa = mSamStatus
    End If
    oConn.close()
    On Error GoTo 0
    SluitSSHTunnels()
    MsgBox "Samenstelling week " & iWeek & "/" & iJaar & " herladen uit de DB " & _
           "(status: " & sStatusNa & ").", 64, "Klaar"
    Exit Sub

SamHerlaadFout:
    MsgBox "Fout bij het herladen:" & Chr(10) & Error$, 16, "Samenstelling"
    SluitSSHTunnels()
End Sub

' ===========================================================================
' SchrijfSamenstelling — actief document → cockpit-api week_opslaan
' ===========================================================================
Sub SchrijfSamenstelling()
    Dim oDoc     As Object
    Dim oSam     As Object
    Dim oLos     As Object
    Dim oNot     As Object
    Dim oConn    As Object
    Dim oStmt    As Object
    Dim oRS      As Object
    Dim sOmg     As String
    Dim iWeek    As Integer
    Dim iJaar    As Integer
    Dim dMarge   As Double
    Dim sStatus  As String
    Dim sPw      As String
    Dim sJson    As String
    Dim sPGJson  As String
    Dim sLosJson As String
    Dim sNotJson As String
    Dim sHoevJson As String
    Dim sNaam    As String
    Dim sGid     As String
    Dim sTmp     As String
    Dim dWaarde  As Double
    Dim dHoev    As Double
    Dim iSlot    As Integer
    Dim iMaat    As Integer
    Dim iVolg    As Integer
    Dim nPG      As Integer
    Dim nLos     As Integer
    Dim nNot     As Integer
    Dim iAntw    As Integer
    Dim iRij     As Integer
    Dim oHttp    As Object
    Dim bKlassiek As Boolean

    oDoc = ThisComponent
    bKlassiek = SamIsKlassiekDoc(oDoc)
    If Not (bKlassiek Or SamIsSamenstellingDoc(oDoc)) Then
        MsgBox "Het actieve document is geen samenstelling-bestand.", 48, "Samenstelling"
        Exit Sub
    End If
    If Not SamOmgevingOk(oDoc) Then Exit Sub
    sOmg = SamDocOmgeving(oDoc)

    oSam = oDoc.Sheets.getByName(TAB_SAM)
    oLos = oDoc.Sheets.getByName(TAB_LOS)
    oNot = oDoc.Sheets.getByName(TAB_NOT)

    If bKlassiek Then
        iWeek  = CInt(oSam.getCellByPosition(9, 0).getValue())
        iJaar  = CInt(oSam.getCellByPosition(11, 0).getValue())
        dMarge = oSam.getCellByPosition(13, 0).getValue()
    Else
        iWeek  = CInt(oSam.getCellByPosition(3, 0).getValue())
        iJaar  = CInt(oSam.getCellByPosition(5, 0).getValue())
        dMarge = oSam.getCellByPosition(1, 1).getValue()
    End If
    If iWeek < 1 Or iWeek > 53 Or iJaar < 2020 Then
        MsgBox "Week/jaar niet leesbaar uit D1/F1.", 16, "Samenstelling"
        Exit Sub
    End If
    If dMarge < 1 Or dMarge > 9.99 Then
        MsgBox "Marge (B2) buiten bereik 1-9,99: " & dMarge, 16, "Samenstelling"
        Exit Sub
    End If

    ' pakket_id's uit rij 3 (tab-layout; de klassieke layout leest ze zelf
    ' van de blok-totaalrijen in KlasLeesPakketgroentenJson)
    Dim aMaatId(3) As Long
    If Not bKlassiek Then
        For iMaat = 0 To 3
            aMaatId(iMaat) = CLng(oSam.getCellByPosition(4 + iMaat * 2, SAM_RIJ_MAAT).getValue())
            If aMaatId(iMaat) = 0 Then
                MsgBox "pakket_id ontbreekt in rij 3 — document eerst (her)laden.", 16, "Samenstelling"
                Exit Sub
            End If
        Next iMaat
    End If

    ' --- Statuscheck in de DB (en meteen de omgevings-/tabelcontrole) ---
    On Error GoTo SamSchrijfDbFout
    oConn = MaakDBVerbinding()
    oStmt = oConn.createStatement()
    oRS = oStmt.executeQuery("SELECT status FROM weken WHERE jaar = " & iJaar & _
                             " AND weeknummer = " & iWeek)
    sStatus = "nieuw"
    If oRS.next() Then sStatus = oRS.getString(1)
    oRS.close() : oStmt.close()
    oConn.close()
    On Error GoTo 0
    SluitSSHTunnels()

    If sStatus = "gepubliceerd" Then
        iAntw = MsgBox("Week " & iWeek & "/" & iJaar & " is GEPUBLICEERD (live op het " & _
                       "bestelformulier)." & Chr(10) & _
                       "Terugschrijven overschrijft de live samenstelling (bestelde " & _
                       "aantallen blijven behouden). Doorgaan?", 4 + 48, "Week is live")
        If iAntw <> 6 Then Exit Sub
    End If

    ' --- Pakketgroenten (tab-layout: vaste slots; klassiek: vier maat-blokken) ---
    sPGJson = ""
    nPG = 0
    iVolg = 0
    If bKlassiek Then
        sPGJson = KlasLeesPakketgroentenJson(oDoc, nPG)
        If nPG < 0 Then
            MsgBox "pakket_id's ontbreken op de blok-totaalrijen — document eerst " & _
                   "(her)laden.", 16, "Samenstelling"
            Exit Sub
        End If
    End If
    If Not bKlassiek Then
    For iSlot = 0 To SAM_SLOTS - 1
        iRij = SAM_RIJ0 + iSlot
        sNaam = Trim(oSam.getCellByPosition(0, iRij).getString())
        If sNaam <> "" Then
            iVolg = iVolg + 1
            dWaarde = oSam.getCellByPosition(1, iRij).getValue()   ' grooth
            sGid = Trim(oSam.getCellByPosition(11, iRij).getString())
            sHoevJson = ""
            For iMaat = 0 To 3
                dHoev = oSam.getCellByPosition(3 + iMaat * 2, iRij).getValue()
                If dHoev > 0 Then
                    If sHoevJson <> "" Then sHoevJson = sHoevJson & ","
                    sHoevJson = sHoevJson & """" & aMaatId(iMaat) & """:" & SamJsNum(dHoev)
                End If
            Next iMaat
            If sPGJson <> "" Then sPGJson = sPGJson & ","
            sPGJson = sPGJson & "{""groente_naam"":""" & SamJsonTekst(sNaam) & """," & _
                      """groothandel_prijs"":" & SamJsNum(dWaarde) & "," & _
                      """volgorde"":" & iVolg
            If sGid <> "" And IsNumeric(sGid) Then
                sPGJson = sPGJson & ",""groente_id"":" & CLng(sGid)
            End If
            sPGJson = sPGJson & ",""hoeveelheden"":{" & sHoevJson & "}}"
            nPG = nPG + 1
        End If
    Next iSlot
    End If   ' Not bKlassiek

    If nPG > 12 Then
        iAntw = MsgBox("Er staan " & nPG & " pakketgroenten in het document; het maximum " & _
                       "is 12. Opslaan kan, maar publiceren zal geweigerd worden. Doorgaan?", _
                       4 + 48, "Meer dan 12 pakketgroenten")
        If iAntw <> 6 Then Exit Sub
    End If

    ' --- Losse groenten uit de Los-tab ---
    sLosJson = ""
    nLos = 0
    iVolg = 0
    For iSlot = 0 To LOS_SLOTS - 1
        iRij = LOS_RIJ0 + iSlot
        sNaam = Trim(oLos.getCellByPosition(0, iRij).getString())
        If sNaam <> "" Then
            iVolg = iVolg + 1
            If sLosJson <> "" Then sLosJson = sLosJson & ","
            sLosJson = sLosJson & "{""naam"":""" & SamJsonTekst(sNaam) & """," & _
                       """prijs"":" & SamJsNum(oLos.getCellByPosition(1, iRij).getValue()) & "," & _
                       """eenheid"":""" & SamJsonTekst(Trim(oLos.getCellByPosition(3, iRij).getString())) & """," & _
                       """x_notatie"":" & SamJsBool(Trim(oLos.getCellByPosition(4, iRij).getString()) <> "") & "," & _
                       """volgorde"":" & iVolg
            sTmp = Trim(oLos.getCellByPosition(2, iRij).getString())    ' grooth (optioneel)
            If sTmp <> "" Then
                sLosJson = sLosJson & ",""groothandel_prijs"":" & _
                           SamJsNum(oLos.getCellByPosition(2, iRij).getValue())
            End If
            dWaarde = oLos.getCellByPosition(5, iRij).getValue()        ' stap
            If dWaarde > 0 Then sLosJson = sLosJson & ",""stap"":" & SamJsNum(dWaarde)
            sTmp = Trim(oLos.getCellByPosition(6, iRij).getString())    ' beschikbaar
            If sTmp <> "" Then
                sLosJson = sLosJson & ",""aantal_beschikbaar"":" & _
                           SamJsNum(oLos.getCellByPosition(6, iRij).getValue())
            End If
            sTmp = Trim(oLos.getCellByPosition(7, iRij).getString())    ' max/klant
            If sTmp <> "" And IsNumeric(sTmp) Then
                sLosJson = sLosJson & ",""max_per_klant"":" & _
                           CLng(oLos.getCellByPosition(7, iRij).getValue())
            End If
            sLosJson = sLosJson & "}"
            nLos = nLos + 1
        End If
    Next iSlot

    ' --- Notities uit de Notities-tab ---
    sNotJson = ""
    nNot = 0
    For iSlot = 0 To NOT_SLOTS - 1
        iRij = NOT_RIJ0 + iSlot
        sNaam = Trim(oNot.getCellByPosition(0, iRij).getString())   ' de tekst
        If sNaam <> "" Then
            sGid = Trim(oNot.getCellByPosition(6, iRij).getString())
            If sNotJson <> "" Then sNotJson = sNotJson & ","
            sNotJson = sNotJson & "{""tekst"":""" & SamJsonTekst(sNaam) & """," & _
                "" & """voor_begeleidend"":" & SamJsBool(Trim(oNot.getCellByPosition(1, iRij).getString()) <> "") & "," & _
                """voor_weekplanner"":" & SamJsBool(Trim(oNot.getCellByPosition(2, iRij).getString()) <> "") & "," & _
                """voor_teeltplan"":" & SamJsBool(Trim(oNot.getCellByPosition(3, iRij).getString()) <> "") & "," & _
                """geaccepteerd"":" & SamJsBool(Trim(oNot.getCellByPosition(4, iRij).getString()) <> "") & "," & _
                """groente_naam"":""" & SamJsonTekst(Trim(oNot.getCellByPosition(5, iRij).getString())) & """"
            If sGid <> "" And IsNumeric(sGid) Then
                sNotJson = sNotJson & ",""groente_id"":" & CLng(sGid)
            End If
            sNotJson = sNotJson & "}"
            nNot = nNot + 1
        End If
    Next iSlot

    sJson = "{""jaar"":" & iJaar & ",""weeknummer"":" & iWeek & _
            ",""marge"":" & SamJsNum(dMarge) & _
            ",""begeleidende_tekst"":""" & _
            SamJsonTekst(oNot.getCellByPosition(0, NOT_RIJ_BEG).getString()) & """" & _
            ",""pakketgroenten"":[" & sPGJson & "]" & _
            ",""losse_groenten"":[" & sLosJson & "]" & _
            ",""notities"":[" & sNotJson & "]}"

    ' --- POST naar de cockpit-api (HTTP Basic; gebruikersnaam vrij) ---
    sPw = SamCockpitWachtwoord(sOmg)
    If sPw = "" Then Exit Sub

    On Error GoTo SamHttpFout
    oHttp = createObject("MSXML2.ServerXMLHTTP.6.0")
    oHttp.open("POST", SamCockpitUrl(sOmg) & "?actie=week_opslaan", False)
    oHttp.setRequestHeader("Content-Type", "application/json")
    oHttp.setRequestHeader("Authorization", "Basic " & SamBase64("lo:" & sPw))
    oHttp.send(sJson)
    On Error GoTo 0

    If oHttp.status = 200 Then
        If sStatus = "nieuw" Then sStatus = "concept"
        If bKlassiek Then
            oSam.getCellByPosition(15, 0).setString(sStatus)
        Else
            oSam.getCellByPosition(7, 0).setString(sStatus)
        End If
        MsgBox "Week " & iWeek & "/" & iJaar & " teruggeschreven naar de database." & Chr(10) & _
               nPG & " pakketgroenten, " & nLos & " losse groenten, " & nNot & " notities." & Chr(10) & _
               "Status: " & sStatus & " (publiceren doe je in de cockpit).", 64, "Opgeslagen"
    ElseIf oHttp.status = 401 Then
        MsgBox "Cockpit-wachtwoord geweigerd (HTTP 401). Verwijder het bestand" & Chr(10) & _
               Environ("APPDATA") & "\LibreOffice\cockpit-wachtwoord-" & sOmg & ".txt" & Chr(10) & _
               "en probeer opnieuw.", 16, "Fout"
    Else
        MsgBox "Terugschrijven mislukt (HTTP " & oHttp.status & "):" & Chr(10) & _
               Left(oHttp.responseText, 600), 16, "Fout"
    End If
    Exit Sub

SamSchrijfDbFout:
    MsgBox "Databasefout bij de statuscontrole:" & Chr(10) & Error$, 16, "Samenstelling"
    SluitSSHTunnels()
    Exit Sub

SamHttpFout:
    MsgBox "Verbindingsfout met de cockpit-api:" & Chr(10) & Error$, 16, "Samenstelling"
End Sub

' ===========================================================================
' VerversBestellijst — het hele document verversen uit de DB: eerst de
' samenstelling zelf opnieuw laden (zoals HerlaadSamenstelling, maar zonder
' bevestigingsvraag), dan de verse tellingen erop zetten.
'
' Waarom de volledige herlaad: de tabs Los en Notities zijn een momentopname
' van het moment waarop je het document maakte of laadde. Voegde je in de
' cockpit nadien een losse groente toe, dan kende dit document ze niet en
' klopte de bijbestel-lijst niet. De database is de bron van waarheid, dus
' halen we die er hier altijd bij.
' LET OP: net als bij HerlaadSamenstelling gaan lokale wijzigingen die je nog
' niet met StartSchrijfSamenstelling hebt teruggeschreven, hierbij verloren.
' ===========================================================================
Sub VerversBestellijst()
    Dim oDoc  As Object
    Dim oConn As Object
    Dim iWeek As Integer
    Dim iJaar As Integer
    Dim bKlassiek As Boolean

    oDoc = ThisComponent
    bKlassiek = SamIsKlassiekDoc(oDoc)
    If Not (bKlassiek Or SamIsSamenstellingDoc(oDoc)) Then
        MsgBox "Het actieve document is geen samenstelling-bestand.", 48, "Bestellijst"
        Exit Sub
    End If
    If Not SamOmgevingOk(oDoc) Then Exit Sub

    If bKlassiek Then
        iWeek = CInt(oDoc.Sheets.getByName(TAB_SAM).getCellByPosition(9, 0).getValue())
        iJaar = CInt(oDoc.Sheets.getByName(TAB_SAM).getCellByPosition(11, 0).getValue())
    Else
        iWeek = CInt(oDoc.Sheets.getByName(TAB_SAM).getCellByPosition(3, 0).getValue())
        iJaar = CInt(oDoc.Sheets.getByName(TAB_SAM).getCellByPosition(5, 0).getValue())
    End If

    On Error GoTo SamVervFout
    oConn = MaakDBVerbinding()
    If bKlassiek Then
        ' KlasBouwEnVul eindigt zelf met KlasVulWeekcijfers
        KlasBouwEnVul(oDoc, oConn, iWeek, iJaar)
    Else
        SamMigreerTabnamen(oDoc)
        ' BouwEnVulSamenstelling eindigt zelf met SamVulBestellijst
        BouwEnVulSamenstelling(oDoc, oConn, iWeek, iJaar)
    End If
    oConn.close()
    On Error GoTo 0
    SluitSSHTunnels()
    oDoc.calculateAll()
    MsgBox "Week " & iWeek & "/" & iJaar & " opnieuw geladen uit de database " & _
           "(samenstelling, losse groenten en notities) en de aantallen, " & _
           "weglatingen en afweeglijsten ververst.", 64, "Klaar"
    Exit Sub

SamVervFout:
    MsgBox "Fout bij het verversen van de bestellijst:" & Chr(10) & Error$, 16, "Bestellijst"
    SluitSSHTunnels()
End Sub

' ===========================================================================
' BouwEnVulSamenstelling — alle tabbladen (her)opbouwen en vullen uit de DB
' (idempotent: wist eerst de datazones, herschrijft koppen + formules)
' ===========================================================================
Private Sub BouwEnVulSamenstelling(oDoc As Object, oConn As Object, _
                                   iWeek As Integer, iJaar As Integer)
    Dim oStmt As Object
    Dim oRS   As Object
    Dim iMaat As Integer

    SamMigreerTabnamen(oDoc)

    ' --- Week-meta (weken-rij kan nog ontbreken → 'nieuw') ---
    mSamStatus   = "nieuw"
    mSamMarge    = 1.65
    mSamBegTekst = ""
    oStmt = oConn.createStatement()
    oRS = oStmt.executeQuery("SELECT status, marge, COALESCE(begeleidende_tekst,'') " & _
                             "FROM weken WHERE jaar = " & iJaar & " AND weeknummer = " & iWeek)
    If oRS.next() Then
        mSamStatus   = oRS.getString(1)
        mSamMarge    = oRS.getDouble(2)
        mSamBegTekst = oRS.getString(3)
    End If
    oRS.close() : oStmt.close()

    ' --- Pakketten: id + doelprijs per maat (klein/groot/extra-groot/mini) ---
    For iMaat = 0 To 3
        mPakId(iMaat) = 0
        mPakPrijs(iMaat) = 0
    Next iMaat
    oStmt = oConn.createStatement()
    oRS = oStmt.executeQuery("SELECT sleutel, id, prijs FROM pakketten")
    Do While oRS.next()
        iMaat = SamMaatIdx(oRS.getString(1))
        If iMaat >= 0 Then
            mPakId(iMaat)    = oRS.getLong(2)
            mPakPrijs(iMaat) = oRS.getDouble(3)
        End If
    Loop
    oRS.close() : oStmt.close()

    SamBouwTabSamenstelling(oDoc, oConn, iWeek, iJaar)
    SamBouwTabLos(oDoc, oConn, iWeek, iJaar)
    SamBouwTabNotities(oDoc, oConn, iWeek, iJaar, mSamBegTekst)
    SamBouwTabBestellijst(oDoc)
    SamVulBestellijst(oDoc, oConn, iWeek, iJaar)

    oDoc.calculateAll()
End Sub

' ---------------------------------------------------------------------------
' Tab Samenstelling: pakketgroenten-rekentabel + totalen vs doelprijzen
' ---------------------------------------------------------------------------
Private Sub SamBouwTabSamenstelling(oDoc As Object, oConn As Object, _
                                    iWeek As Integer, iJaar As Integer)
    Dim oSheet   As Object
    Dim oStmt    As Object
    Dim oRS      As Object
    Dim iSlot    As Integer
    Dim iMaat    As Integer
    Dim iRij     As Integer
    Dim iKol     As Integer
    Dim sRij     As String
    Dim sTotRij  As String
    Dim sDoelRij As String
    Dim clInput  As Long
    Dim clAfgeleid As Long
    Dim clKop    As Long
    Dim aMaatLabel(3) As String

    clInput    = RGB(255, 249, 196)
    clAfgeleid = RGB(238, 238, 238)
    clKop      = RGB(220, 233, 200)
    aMaatLabel(0) = "KG" : aMaatLabel(1) = "GG"
    aMaatLabel(2) = "EGG" : aMaatLabel(3) = "MINI"

    oSheet = SamZorgTab(oDoc, TAB_SAM)
    oSheet.getCellRangeByPosition(0, 0, 12, SAM_RIJ0 + SAM_SLOTS + 4).clearContents(23)

    ' Kop / week-info
    oSheet.getCellByPosition(0, 0).setString(SAM_MARKER)
    oSheet.getCellByPosition(0, 0).CharWeight = com.sun.star.awt.FontWeight.BOLD
    oSheet.getCellByPosition(2, 0).setString("Week:")
    oSheet.getCellByPosition(3, 0).setValue(iWeek)
    oSheet.getCellByPosition(4, 0).setString("Jaar:")
    oSheet.getCellByPosition(5, 0).setValue(iJaar)
    oSheet.getCellByPosition(6, 0).setString("Status:")
    oSheet.getCellByPosition(7, 0).setString(mSamStatus)
    oSheet.getCellByPosition(0, 1).setString("Marge:")
    oSheet.getCellByPosition(1, 1).setValue(mSamMarge)
    oSheet.getCellByPosition(1, 1).CellBackColor = clInput
    oSheet.getCellByPosition(2, 1).setString("(grooth. excl. BTW -> cons. incl. BTW)")

    ' Maat-labels + pakket_id's (rij 3): label boven de hoev-kolom, id ernaast
    For iMaat = 0 To 3
        iKol = 3 + iMaat * 2
        oSheet.getCellByPosition(iKol, SAM_RIJ_MAAT).setString(aMaatLabel(iMaat))
        oSheet.getCellByPosition(iKol, SAM_RIJ_MAAT).CharWeight = com.sun.star.awt.FontWeight.BOLD
        oSheet.getCellByPosition(iKol + 1, SAM_RIJ_MAAT).setValue(mPakId(iMaat))
        oSheet.getCellByPosition(iKol + 1, SAM_RIJ_MAAT).CellBackColor = clAfgeleid
    Next iMaat
    oSheet.getCellByPosition(11, SAM_RIJ_MAAT).setString("(pakket_id's — niet wijzigen)")

    ' Kolomkoppen (rij 4)
    oSheet.getCellByPosition(0, SAM_RIJ_KOP).setString("Pakketgroente")
    oSheet.getCellByPosition(1, SAM_RIJ_KOP).setString("Grooth.EUR")
    oSheet.getCellByPosition(2, SAM_RIJ_KOP).setString("Cons.EUR")
    For iMaat = 0 To 3
        iKol = 3 + iMaat * 2
        oSheet.getCellByPosition(iKol, SAM_RIJ_KOP).setString("hoev")
        oSheet.getCellByPosition(iKol + 1, SAM_RIJ_KOP).setString("EUR in pakket")
    Next iMaat
    oSheet.getCellByPosition(11, SAM_RIJ_KOP).setString("groente_id")
    oSheet.getCellRangeByPosition(0, SAM_RIJ_KOP, 11, SAM_RIJ_KOP).CellBackColor = clKop
    oSheet.getCellRangeByPosition(0, SAM_RIJ_KOP, 11, SAM_RIJ_KOP).CharWeight = _
        com.sun.star.awt.FontWeight.BOLD

    ' Data-rijen: formules voor Cons.EUR en EUR-in-pakket (zelfde dubbele
    ' afronding als de server: round(round(g*m*h,4),2))
    For iSlot = 0 To SAM_SLOTS - 1
        iRij = SAM_RIJ0 + iSlot
        sRij = CStr(iRij + 1)
        oSheet.getCellByPosition(2, iRij).setFormula( _
            "=IF($B" & sRij & "="""";"""";ROUND($B" & sRij & "*$B$2;2))")
        oSheet.getCellByPosition(2, iRij).CellBackColor = clAfgeleid
        oSheet.getCellByPosition(4, iRij).setFormula( _
            "=IF(OR($B" & sRij & "="""";D" & sRij & "="""");"""";ROUND(ROUND($B" & sRij & "*$B$2*D" & sRij & ";4);2))")
        oSheet.getCellByPosition(6, iRij).setFormula( _
            "=IF(OR($B" & sRij & "="""";F" & sRij & "="""");"""";ROUND(ROUND($B" & sRij & "*$B$2*F" & sRij & ";4);2))")
        oSheet.getCellByPosition(8, iRij).setFormula( _
            "=IF(OR($B" & sRij & "="""";H" & sRij & "="""");"""";ROUND(ROUND($B" & sRij & "*$B$2*H" & sRij & ";4);2))")
        oSheet.getCellByPosition(10, iRij).setFormula( _
            "=IF(OR($B" & sRij & "="""";J" & sRij & "="""");"""";ROUND(ROUND($B" & sRij & "*$B$2*J" & sRij & ";4);2))")
        oSheet.getCellByPosition(4, iRij).CellBackColor = clAfgeleid
        oSheet.getCellByPosition(6, iRij).CellBackColor = clAfgeleid
        oSheet.getCellByPosition(8, iRij).CellBackColor = clAfgeleid
        oSheet.getCellByPosition(10, iRij).CellBackColor = clAfgeleid
        oSheet.getCellByPosition(0, iRij).CellBackColor = clInput
        oSheet.getCellByPosition(1, iRij).CellBackColor = clInput
        oSheet.getCellByPosition(3, iRij).CellBackColor = clInput
        oSheet.getCellByPosition(5, iRij).CellBackColor = clInput
        oSheet.getCellByPosition(7, iRij).CellBackColor = clInput
        oSheet.getCellByPosition(9, iRij).CellBackColor = clInput
    Next iSlot

    ' Totalen / doelprijzen / verschil / teller
    iRij = SAM_RIJ0 + SAM_SLOTS
    sTotRij  = CStr(iRij + 1)
    sDoelRij = CStr(iRij + 2)
    oSheet.getCellByPosition(0, iRij).setString("Pakket EUR")
    oSheet.getCellByPosition(0, iRij).CharWeight = com.sun.star.awt.FontWeight.BOLD
    oSheet.getCellByPosition(0, iRij + 1).setString("Doelprijs")
    oSheet.getCellByPosition(0, iRij + 2).setString("Verschil")
    For iMaat = 0 To 3
        iKol = 4 + iMaat * 2
        oSheet.getCellByPosition(iKol, iRij).setFormula( _
            "=SUM(" & KolomLetter(iKol) & CStr(SAM_RIJ0 + 1) & ":" & _
            KolomLetter(iKol) & CStr(SAM_RIJ0 + SAM_SLOTS) & ")")
        oSheet.getCellByPosition(iKol, iRij).CharWeight = com.sun.star.awt.FontWeight.BOLD
        oSheet.getCellByPosition(iKol, iRij + 1).setValue(mPakPrijs(iMaat))
        oSheet.getCellByPosition(iKol, iRij + 1).CellBackColor = clAfgeleid
        oSheet.getCellByPosition(iKol, iRij + 2).setFormula( _
            "=ROUND(" & KolomLetter(iKol) & sTotRij & "-" & KolomLetter(iKol) & sDoelRij & ";2)")
    Next iMaat
    oSheet.getCellByPosition(5, iRij + 1).setString("(doelprijzen indexeren doe je in de cockpit)")
    oSheet.getCellByPosition(0, iRij + 3).setString("Aantal pakketgroenten (max 12):")
    oSheet.getCellByPosition(1, iRij + 3).setFormula( _
        "=COUNTA(A" & CStr(SAM_RIJ0 + 1) & ":A" & CStr(SAM_RIJ0 + SAM_SLOTS) & ")")

    ' Kolombreedtes
    oSheet.Columns.getByIndex(0).Width = 4500
    For iKol = 1 To 10
        oSheet.Columns.getByIndex(iKol).Width = 2100
    Next iKol
    oSheet.Columns.getByIndex(11).Width = 2000

    ' --- Data: week_pakketgroente + pakket_inhoud ---
    Dim aPgNaam(SAM_SLOTS - 1) As String
    Dim nPG   As Integer
    Dim iVind As Integer
    Dim sNaam As String
    nPG = 0
    oStmt = oConn.createStatement()
    oRS = oStmt.executeQuery( _
        "SELECT groente_naam, groothandel_prijs, COALESCE(groente_id::text,'') " & _
        "FROM week_pakketgroente WHERE jaar = " & iJaar & " AND weeknummer = " & iWeek & _
        " ORDER BY volgorde, groente_naam")
    Do While oRS.next()
        If nPG < SAM_SLOTS Then
            iRij = SAM_RIJ0 + nPG
            aPgNaam(nPG) = oRS.getString(1)
            oSheet.getCellByPosition(0, iRij).setString(oRS.getString(1))
            oSheet.getCellByPosition(1, iRij).setValue(oRS.getDouble(2))
            If oRS.getString(3) <> "" Then
                oSheet.getCellByPosition(11, iRij).setValue(CLng(oRS.getString(3)))
            End If
            nPG = nPG + 1
        End If
    Loop
    oRS.close() : oStmt.close()

    ' Hoeveelheden (pakket_inhoud.hoeveelheid; NULL bij legacy-weken → leeg)
    oStmt = oConn.createStatement()
    oRS = oStmt.executeQuery( _
        "SELECT pakket_id, groente_naam, hoeveelheid FROM pakket_inhoud " & _
        "WHERE jaar = " & iJaar & " AND weeknummer = " & iWeek & _
        " AND hoeveelheid IS NOT NULL")
    Do While oRS.next()
        iVind = -1
        sNaam = oRS.getString(2)
        For iSlot = 0 To nPG - 1
            If aPgNaam(iSlot) = sNaam Then
                iVind = iSlot
                Exit For
            End If
        Next iSlot
        iMaat = -1
        For iKol = 0 To 3
            If mPakId(iKol) = oRS.getLong(1) Then iMaat = iKol
        Next iKol
        If iVind >= 0 And iMaat >= 0 Then
            oSheet.getCellByPosition(3 + iMaat * 2, SAM_RIJ0 + iVind).setValue(oRS.getDouble(3))
        End If
    Loop
    oRS.close() : oStmt.close()
End Sub

